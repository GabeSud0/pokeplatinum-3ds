; hello3d vertex shader (PICA200 assembly, assembled by picasso)
; Transforms each vertex by modelView then projection, passes its color through.

; Uniforms
.fvec projection[4], modelView[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outclr color

; Inputs
.alias inpos v0
.alias inclr v1

.proc main
	; r0 = vec4(inpos, 1.0)
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; outclr = vec4(inclr, 1.0)
	mov outclr.xyz, inclr
	mov outclr.w,   ones

	end
.end
