From: Platinum 3DS port contributors
Subject: [PATCH] Send original ARM9 G3 commands to the virtual geometry engine

---
diff --git a/include/nitro/gx/g3imm.h b/include/nitro/gx/g3imm.h
--- a/include/nitro/gx/g3imm.h
+++ b/include/nitro/gx/g3imm.h
@@ -5,6 +5,11 @@
 #include <nitro/gx/g3.h>
 #include <nitro/fx/fx_const.h>
 
+#if defined(SDK_PORT_3DS)
+/* The 3DS has no DS geometry command ports. Model their write side effects. */
+void NitroPort_GxDirectWrite(int opcode, u32 parameter);
+#endif
+
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -62,79 +67,159 @@
 
 static inline void G3_Direct0 (int op)
 {
+	#if defined(SDK_PORT_3DS)
+	NitroPort_GxDirectWrite(op, 0);
+#else
 	*(REGType32v *)(REG_MTX_MODE_ADDR + ((op - G3OP_MTX_MODE) * 4)) = 0;
+#endif
 }
 
 static inline void G3_Direct1 (int op, u32 param0)
 {
+	#if defined(SDK_PORT_3DS)
+	NitroPort_GxDirectWrite(op, param0);
+#else
 	*(REGType32v *)(REG_MTX_MODE_ADDR + ((op - G3OP_MTX_MODE) * 4)) = param0;
+#endif
 }
 
 static inline void G3_Direct2 (int op, u32 param0, u32 param1)
