+#endif
+	#if defined(SDK_PORT_3DS)
+	NitroPort_GxDirectWrite(op, param1);
+#else
 	*(REGType32v *)(REG_MTX_MODE_ADDR + ((op - G3OP_MTX_MODE) * 4)) = param1;
+#endif
