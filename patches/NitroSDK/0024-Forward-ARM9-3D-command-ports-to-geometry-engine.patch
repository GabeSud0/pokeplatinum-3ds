 void G3_LoadMtx44 (const MtxFx44 *m)
 {
 	SDK_NULL_ASSERT(m);
 
+#if defined(SDK_PORT_3DS)
+	{
+		const u32 *words = (const u32 *)(&m->_00);
+		int i;
+		for (i = 0; i < 16; ++i) NitroPort_GxDirectWrite(G3OP_MTX_LOAD_4x4, words[i]);
+	}
+#else
 	reg_G3X_GXFIFO = G3OP_MTX_LOAD_4x4;
 	GX_SendFifo64B(&m->_00, (void *)&reg_G3X_GXFIFO);
+#endif
 }
 
