 static GXVRamTexPltt sTexPltt = (GXVRamTexPltt)(0);
 static u32 sTexPlttLCDCBlk = 0;
 
-static const u16 sTexPlttStartAddrTable[8] = {
-	0,
-	(u16)(HW_LCDC_VRAM_E >> 12),
-	(u16)(HW_LCDC_VRAM_F >> 12),
-	(u16)(HW_LCDC_VRAM_E >> 12),
-	(u16)(HW_LCDC_VRAM_G >> 12),
-	0,
