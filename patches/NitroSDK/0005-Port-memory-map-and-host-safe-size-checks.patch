+#ifdef SDK_PORT_3DS
+__attribute__((constructor)) static void GXi_PortInitLoad3dTables (void)
+{
+	const GXTexStartAddr tex[16] = TEX_START_ADDR_TABLE_INIT;
+	const u16 pltt[8] = TEX_PLTT_START_ADDR_TABLE_INIT;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		sTexStartAddrTable[i] = tex[i];
