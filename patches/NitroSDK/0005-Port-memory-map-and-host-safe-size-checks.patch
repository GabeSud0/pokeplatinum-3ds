From 0103530c731ac6ba1c4a50e2dfc6f784f220e9cc Mon Sep 17 00:00:00 2001
From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Thu, 8 Oct 2026 20:32:34 -0700
Subject: [PATCH 5/6] Port memory map and host-safe size checks

With SDK_PORT_3DS, DS memory areas (main memory, ITCM, WRAM, palettes, OAM, VRAM) point at ordinary memory blocks provided by the port. Tables that used those addresses as compile-time constants are filled at startup instead. Struct-size checks are skipped on 64-bit PC test builds only.
---
 include/nitro/hw/ARM9/mmap_global.h |  85 +++++++++++++++
 include/nitro/misc.h                |   7 ++
 libraries/card/src/card_rom.c       |  10 ++
 libraries/gx/src/gx_load3d.c        | 161 +++++++++++++++++-----------
 4 files changed, 201 insertions(+), 62 deletions(-)

diff --git a/include/nitro/hw/ARM9/mmap_global.h b/include/nitro/hw/ARM9/mmap_global.h
index 6e663a1..c0e1f99 100644
--- a/include/nitro/hw/ARM9/mmap_global.h
+++ b/include/nitro/hw/ARM9/mmap_global.h
@@ -108,6 +108,91 @@ extern unsigned char NitroPort_IoReg[];
 #define HW_EXT_WRAM_ARM7         0x06000000
 #define HW_EXT_WRAM_ARM7_END     0x06040000
 #define HW_EXT_WRAM_ARM7_SIZE    (HW_EXT_WRAM_ARM7_END-HW_EXT_WRAM_ARM7)
+
+#ifdef SDK_PORT_3DS
+/* 3DS port: the DS memory areas the SDK reads and writes directly become
+ * ordinary memory blocks (3ds_port/nitro/src/port_memory.c). Same sizes and
+ * offsets as on the DS, so code that indexes into them works unchanged.
+ *
+ * Main memory is 8 MB because the SDK's shared/system area sits at the top of
+ * the 8 MB development-unit range (it is mirrored on retail units).
+ *
+ * VRAM: for now each CPU view of VRAM (BG, OBJ, LCDC, per engine) is its own
+ * block. On the DS they are windows onto the same banks, chosen by the VRAM
+ * bank registers; the 2D renderer will add that mapping. */
+    #ifndef SDK_ASM
+extern unsigned char NitroPort_Itcm[];
+extern unsigned char NitroPort_MainMem[];
+extern unsigned char NitroPort_Wram[];
+extern unsigned char NitroPort_Pltt[];
+extern unsigned char NitroPort_Oam[];
+extern unsigned char NitroPort_BgVram[];
+extern unsigned char NitroPort_DbBgVram[];
+extern unsigned char NitroPort_ObjVram[];
+extern unsigned char NitroPort_DbObjVram[];
+extern unsigned char NitroPort_LcdcVram[];
+    #endif
+
+    #undef HW_ITCM_IMAGE
+    #undef HW_ITCM
+    #define HW_ITCM_IMAGE           ((u32)NitroPort_Itcm)
+    #define HW_ITCM                 ((u32)NitroPort_Itcm)
+
+    #undef HW_MAIN_MEM
+    #define HW_MAIN_MEM             ((u32)NitroPort_MainMem)
+
+    #undef HW_WRAM
+    #undef HW_WRAM_END
+    #define HW_WRAM                 ((u32)NitroPort_Wram)
+    #define HW_WRAM_END             (HW_WRAM + 0x8000)
+
+    #undef HW_BG_PLTT
+    #undef HW_BG_PLTT_END
+    #undef HW_OBJ_PLTT
+    #undef HW_OBJ_PLTT_END
+    #undef HW_DB_BG_PLTT
+    #undef HW_DB_BG_PLTT_END
+    #undef HW_DB_OBJ_PLTT
+    #undef HW_DB_OBJ_PLTT_END
+    #define HW_BG_PLTT              ((u32)NitroPort_Pltt)
+    #define HW_BG_PLTT_END          (HW_BG_PLTT + 0x200)
+    #define HW_OBJ_PLTT             (HW_BG_PLTT + 0x200)
+    #define HW_OBJ_PLTT_END         (HW_BG_PLTT + 0x400)
+    #define HW_DB_BG_PLTT           (HW_BG_PLTT + 0x400)
+    #define HW_DB_BG_PLTT_END       (HW_BG_PLTT + 0x600)
+    #define HW_DB_OBJ_PLTT          (HW_BG_PLTT + 0x600)
+    #define HW_DB_OBJ_PLTT_END      (HW_BG_PLTT + 0x800)
+
+    #undef HW_BG_VRAM
+    #undef HW_BG_VRAM_END
+    #undef HW_DB_BG_VRAM
+    #undef HW_DB_BG_VRAM_END
+    #undef HW_OBJ_VRAM
+    #undef HW_OBJ_VRAM_END
+    #undef HW_DB_OBJ_VRAM
+    #undef HW_DB_OBJ_VRAM_END
+    #undef HW_LCDC_VRAM
+    #undef HW_LCDC_VRAM_END
+    #define HW_BG_VRAM              ((u32)NitroPort_BgVram)
+    #define HW_BG_VRAM_END          (HW_BG_VRAM + 0x80000)
+    #define HW_DB_BG_VRAM           ((u32)NitroPort_DbBgVram)
+    #define HW_DB_BG_VRAM_END       (HW_DB_BG_VRAM + 0x20000)
+    #define HW_OBJ_VRAM             ((u32)NitroPort_ObjVram)
+    #define HW_OBJ_VRAM_END         (HW_OBJ_VRAM + 0x40000)
+    #define HW_DB_OBJ_VRAM          ((u32)NitroPort_DbObjVram)
+    #define HW_DB_OBJ_VRAM_END      (HW_DB_OBJ_VRAM + 0x20000)
+    #define HW_LCDC_VRAM            ((u32)NitroPort_LcdcVram)
+    #define HW_LCDC_VRAM_END        (HW_LCDC_VRAM + 0xA4000)
+
+    #undef HW_OAM
+    #undef HW_OAM_END
+    #undef HW_DB_OAM
+    #undef HW_DB_OAM_END
+    #define HW_OAM                  ((u32)NitroPort_Oam)
+    #define HW_OAM_END              (HW_OAM + 0x400)
+    #define HW_DB_OAM               (HW_OAM + 0x400)
+    #define HW_DB_OAM_END           (HW_OAM + 0x800)
+#endif
 #ifdef __cplusplus
 } /* extern "C" */
 #endif
diff --git a/include/nitro/misc.h b/include/nitro/misc.h
index 546f7e3..8917bc4 100644
--- a/include/nitro/misc.h
+++ b/include/nitro/misc.h
@@ -26,8 +26,15 @@ extern "C" {
     #endif
 #endif
 
+#if defined(SDK_PORT_3DS) && defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ != 4
+/* 64-bit PC test builds: structs holding pointers are bigger than on the DS
+ * or 3DS, so size checks would fail. They still run in 3DS builds. */
+#define SDK_COMPILER_ASSERT(expr) \
+	extern int sdk_compiler_assert_skipped_
+#else
 #define SDK_COMPILER_ASSERT(expr) \
 	extern void sdk_compiler_assert ## __LINE__ (char is[(expr) ? +1 : -1])
+#endif
 
 #ifdef SDK_DEBUG
         #ifndef SDK_ASSERTMSG
diff --git a/libraries/card/src/card_rom.c b/libraries/card/src/card_rom.c
index 8cfecea..930eac9 100644
--- a/libraries/card/src/card_rom.c
+++ b/libraries/card/src/card_rom.c
@@ -7,7 +7,17 @@ CARDRomStat rom_stat ATTRIBUTE_ALIGN(32);
 
 extern u32 cardi_rom_base;
 u32 cardi_rom_base;
+#ifdef SDK_PORT_3DS
+/* 3DS port: HW_ROM_HEADER_BUF isn't a compile-time constant, so set it at startup. */
+u32 cardi_rom_header_addr;
+
+__attribute__((constructor)) static void CARDi_PortInitRomHeaderAddr (void)
+{
+	cardi_rom_header_addr = HW_ROM_HEADER_BUF;
+}
+#else
 u32 cardi_rom_header_addr = HW_ROM_HEADER_BUF;
+#endif
 
 SDK_COMPILER_ASSERT(sizeof(rom_stat) % 32 == 0);
 
diff --git a/libraries/gx/src/gx_load3d.c b/libraries/gx/src/gx_load3d.c
index 09bb27e..830a61f 100644
--- a/libraries/gx/src/gx_load3d.c
+++ b/libraries/gx/src/gx_load3d.c
@@ -11,63 +11,78 @@ static u32 sSzTexBlk1 = 0;
 static u32 sTexLCDCBlk2 = 0;
 static GXVRamTex sTex = (GXVRamTex)(0);
 
-static const struct {
