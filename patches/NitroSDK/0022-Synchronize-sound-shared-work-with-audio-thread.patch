From: Platinum 3DS port contributors
Subject: [PATCH] Synchronize ARM9 sound getters with audio-thread shared work

---
diff --git a/libraries/snd/src/snd_work.c b/libraries/snd/src/snd_work.c
--- a/libraries/snd/src/snd_work.c
+++ b/libraries/snd/src/snd_work.c
@@ -1,3 +1,18 @@
-#include <nitro/snd/common/work.h>
+#include <nitro/snd/common/work.h>
+#if defined(SDK_PORT_3DS) && defined(SDK_ARM9)
+/* All ARM7 writes run under the port's audio spinlock. The ARM9 getter
+ * must take the same lock to read shared player/voice/alarm state. */
+extern void NitroPort_SoundSharedLock(void);
+extern void NitroPort_SoundSharedUnlock(void);
+#define NITRO_SOUND_SHARED_READ(expr) ({ \
+    __typeof__(expr) value_; \
+    NitroPort_SoundSharedLock(); \
+    value_ = (expr); \
+    NitroPort_SoundSharedUnlock(); \
+    value_; \
+})
+#else
+#define NITRO_SOUND_SHARED_READ(expr) (expr)
+#endif
 
 #ifndef SDK_FROM_TOOL
@@ -71,5 +86,5 @@
 #endif
 
-    return SNDi_SharedWork->playerStatus;
+    return NITRO_SOUND_SHARED_READ(SNDi_SharedWork->playerStatus);
 }
 
@@ -83,5 +98,5 @@
 #endif
 
-    return SNDi_SharedWork->channelStatus;
+    return NITRO_SOUND_SHARED_READ(SNDi_SharedWork->channelStatus);
 }
 
@@ -95,5 +110,5 @@
 #endif
 
-    return SNDi_SharedWork->captureStatus;
+    return NITRO_SOUND_SHARED_READ(SNDi_SharedWork->captureStatus);
 }
 
@@ -108,5 +123,5 @@
 #endif
 
-    return SNDi_SharedWork->player[playerNo].tickCounter;
+    return NITRO_SOUND_SHARED_READ(SNDi_SharedWork->player[playerNo].tickCounter);
 }
 
@@ -122,5 +137,5 @@
 #endif
 
-    return SNDi_SharedWork->player[playerNo].variable[varNo];
+    return NITRO_SOUND_SHARED_READ(SNDi_SharedWork->player[playerNo].variable[varNo]);
 }
 
@@ -135,5 +150,5 @@
 #endif
 
-    return SNDi_SharedWork->globalVariable[varNo];
+    return NITRO_SOUND_SHARED_READ(SNDi_SharedWork->globalVariable[varNo]);
 }
 
@@ -349,5 +364,5 @@
 #endif
 
-    return SNDi_SharedWork->finishCommandTag;
+    return NITRO_SOUND_SHARED_READ(SNDi_SharedWork->finishCommandTag);
 }
 
