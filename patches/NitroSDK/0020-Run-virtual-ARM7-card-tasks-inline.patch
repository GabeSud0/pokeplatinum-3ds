From: Platinum 3DS port contributors
Subject: [PATCH] Use immediate CARD tasks for virtual ARM7 on the port

---
diff --git a/libraries/card/src/card_common.c b/libraries/card/src/card_common.c
--- a/libraries/card/src/card_common.c
+++ b/libraries/card/src/card_common.c
@@ -16,13 +16,20 @@
 {
 	CARDiCommon *const p = &cardi_common;
 
-	(void)OS_SetThreadPriority(p->thread, p->priority);
-
-	p->cur_th = p->thread;
-	p->task_func = task;
-	p->flag |= CARD_STAT_TASK;
-
-	OS_WakeupThreadDirect(p->thread);
+#if defined(SDK_PORT_3DS)
+	/* No DS thread switching yet. Complete the task immediately, including
+	 * its callback; synchronous PXI replies are already delivered. */
+	p->cur_th = OS_GetCurrentThread();
+	task(p);
+#else
+	(void)OS_SetThreadPriority(p->thread, p->priority);
+
+	p->cur_th = p->thread;
+	p->task_func = task;
+	p->flag |= CARD_STAT_TASK;
+
+	OS_WakeupThreadDirect(p->thread);
+#endif
 }
 
 static void CARDi_LockResource (CARDiOwner owner, CARDTargetMode target)
@@ -99,12 +106,14 @@
 #if !defined(SDK_NO_THREAD)
 	OS_InitThreadQueue(p->lock_queue);
 	OS_InitThreadQueue(p->busy_q);
-	p->priority = CARD_THREAD_PRIORITY_DEFAULT;
-	OS_CreateThread(p->thread,
-	                CARDi_TaskThread, NULL,
-	                cardi_thread_stack + sizeof(cardi_thread_stack),
-	                sizeof(cardi_thread_stack), p->priority);
-	OS_WakeupThreadDirect(p->thread);
+	p->priority = CARD_THREAD_PRIORITY_DEFAULT;
+#if !defined(SDK_PORT_3DS)
+	OS_CreateThread(p->thread,
+	                CARDi_TaskThread, NULL,
+	                cardi_thread_stack + sizeof(cardi_thread_stack),
+	                sizeof(cardi_thread_stack), p->priority);
+	OS_WakeupThreadDirect(p->thread);
+#endif
 #endif
 
 	PXI_SetFifoRecvCallback(PXI_FIFO_TAG_FS, CARDi_OnFifoRecv);
diff --git a/libraries/card/src/card_request.c b/libraries/card/src/card_request.c
--- a/libraries/card/src/card_request.c
+++ b/libraries/card/src/card_request.c
@@ -12,8 +12,10 @@
 		CARDiCommon *const p = &cardi_common;
 
 		SDK_ASSERT(data == CARD_REQ_ACK);
-		p->flag &= ~CARD_STAT_REQ;
-		OS_WakeupThreadDirect(p->cur_th);
+		p->flag &= ~CARD_STAT_REQ;
+#if !defined(SDK_PORT_3DS)
+		OS_WakeupThreadDirect(p->cur_th);
+#endif
 	}
 }
 
