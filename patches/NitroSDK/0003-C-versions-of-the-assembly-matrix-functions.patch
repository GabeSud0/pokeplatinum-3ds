From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Thu, 8 Oct 2026 19:54:51 -0700
Subject: [PATCH 3/4] C versions of the assembly matrix functions

Metrowerks inline assembly is kept for the original build; GCC gets equivalent C decoded from the assembly.
---
 libraries/fx/src/fx_mtx22.c |  40 ++++++++++++++-
 libraries/fx/src/fx_mtx33.c |  96 +++++++++++++++++++++++++++++++++-
 libraries/fx/src/fx_mtx43.c |  87 +++++++++++++++++++++++++++++++
 libraries/fx/src/fx_mtx44.c | 100 +++++++++++++++++++++++++++++++++++-
 4 files changed, 320 insertions(+), 3 deletions(-)

diff --git a/libraries/fx/src/fx_mtx22.c b/libraries/fx/src/fx_mtx22.c
index ce669bf..9b2e48d 100644
--- a/libraries/fx/src/fx_mtx22.c
+++ b/libraries/fx/src/fx_mtx22.c
@@ -2,13 +2,14 @@
 #include <nitro/fx/fx_const.h>
 #include <nitro/fx/fx_cp.h>
 
-inline fx32 mul64 (fx64 x, fx32 y)
+static inline fx32 mul64 (fx64 x, fx32 y)
 {
 	return (fx32)((x * y) >> FX32_SHIFT);
 }
 
 #include <nitro/code32.h>
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void MTX_Identity22_ (register MtxFx22 *pDst)
 {
 	mov r1, #0
@@ -18,7 +19,16 @@ asm void MTX_Identity22_ (register MtxFx22 *pDst)
 	stmia r0 !, {r1, r2}
 	bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void MTX_Identity22_ (MtxFx22 *pDst)
+{
+	pDst->_00 = FX32_ONE; pDst->_01 = 0;
+	pDst->_10 = 0;        pDst->_11 = FX32_ONE;
+}
+#endif
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void MTX_Transpose22_ (const register MtxFx22 *pSrc, register MtxFx22 *pDst)
 {
 	stmfd sp !, {r4}
@@ -28,9 +38,20 @@ asm void MTX_Transpose22_ (const register MtxFx22 *pSrc, register MtxFx22 *pDst)
 	ldmfd sp !, {r4}
 	bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void MTX_Transpose22_ (const MtxFx22 *pSrc, MtxFx22 *pDst)
+{
+	MtxFx22 s = *pSrc;
+
+	pDst->_00 = s._00; pDst->_01 = s._10;
+	pDst->_10 = s._01; pDst->_11 = s._11;
+}
+#endif
 
 #include <nitro/code16.h>
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void MTX_Scale22_ (register MtxFx22 *pDst, register fx32 x, register fx32 y)
 {
 	stmia r0 !, {r1}
@@ -40,7 +61,16 @@ asm void MTX_Scale22_ (register MtxFx22 *pDst, register fx32 x, register fx32 y)
 	stmia r0 !, {r1, r2}
 	bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void MTX_Scale22_ (MtxFx22 *pDst, fx32 x, fx32 y)
+{
+	pDst->_00 = x; pDst->_01 = 0;
+	pDst->_10 = 0; pDst->_11 = y;
+}
+#endif
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void MTX_Rot22_ (register MtxFx22 *pDst, register fx32 sinVal, register fx32 cosVal)
 {
 	str r2, [r0, #0]
@@ -50,6 +80,14 @@ asm void MTX_Rot22_ (register MtxFx22 *pDst, register fx32 sinVal, register fx32
 	str r2, [r0, #12]
 	bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void MTX_Rot22_ (MtxFx22 *pDst, fx32 sinVal, fx32 cosVal)
+{
+	pDst->_00 = cosVal;  pDst->_01 = sinVal;
+	pDst->_10 = -sinVal; pDst->_11 = cosVal;
+}
+#endif
 
 #include <nitro/codereset.h>
 
