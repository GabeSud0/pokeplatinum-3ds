@@ -55,7 +79,23 @@ asm void MTX_Copy33To44_ (const register MtxFx33 *pSrc, register MtxFx44 *pDst)
 	ldmfd sp !, {r4}
 	bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
