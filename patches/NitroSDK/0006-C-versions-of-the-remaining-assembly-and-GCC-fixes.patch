@@ -349,6 +365,7 @@ u16 OS_ReadOwnerOfLockWord (OSLockWord * lockp)
 
 #include <nitro/code32.h>
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm s32 OS_GetLockID (void)
 {
     ldr r3, = OSi_ANYP_LOCK_ID_FLAG
@@ -417,7 +434,28 @@ _1:
     str r2, [r3, #0]
     bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+s32 OS_GetLockID (void)
+{
+    /* Two words of free-ID bits; the highest set bit is the next free ID. */
+    vu32 *flag = (vu32 *)OSi_ANYP_LOCK_ID_FLAG;
+    u32 base = OSi_ANYP_LOCK_ID_START;
+    int i;
+
+    for (i = 0; i < 2; i++, flag++, base += 32) {
+        u32 bits = *flag;
+        if (bits != 0) {
+            u32 n = (u32)__builtin_clz(bits);
+            *flag = bits & ~(0x80000000u >> n);
+            return (s32)(base + n);
+        }
+    }
+    return OS_LOCK_ID_ERROR;
+}
+#endif
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void OS_ReleaseLockID (register u16 lockID)
 {
 #pragma unused(lockID)
@@ -451,5 +489,21 @@ asm void OS_ReleaseLockID (register u16 lockID)
     str r2, [r3, #0]
     bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void OS_ReleaseLockID (u16 lockID)
+{
+    vu32 *flag = (vu32 *)OSi_ANYP_LOCK_ID_FLAG;
+    u32 n = lockID;
+
+    if (n >= OSi_ANYP_LOCK_ID_START + 32) {
+        flag++;
+        n -= OSi_ANYP_LOCK_ID_START + 32;
+    } else {
+        n -= OSi_ANYP_LOCK_ID_START;
+    }
+    *flag |= 0x80000000u >> n;
+}
+#endif
 
