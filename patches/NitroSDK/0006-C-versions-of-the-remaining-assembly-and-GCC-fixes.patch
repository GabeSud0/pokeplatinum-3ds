diff --git a/libraries/os/src/os_irqHandler.c b/libraries/os/src/os_irqHandler.c
index 945cb76..4e155cb 100644
--- a/libraries/os/src/os_irqHandler.c
+++ b/libraries/os/src/os_irqHandler.c
@@ -27,6 +27,7 @@
     #include <nitro/itcm_begin.h>
 #endif
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void OS_IrqHandler (void)
 {
 #ifdef SDK_NO_THREAD
@@ -123,7 +124,34 @@ asm void OS_IrqHandler (void)
     bx r0
 #endif
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void OS_IrqHandler (void)
+{
+    /* The DS calls this when an interrupt fires; on the 3DS port the
+     * emulated hardware calls it (NitroPort_RaiseIrq). Same rules: nothing
+     * happens unless IME is on; the lowest pending enabled interrupt is
+     * acknowledged and its handler from OS_IRQTable runs. */
+    u32 pending;
+    u32 bit;
 
+    if (reg_OS_IME == 0) {
+        return;
+    }
+    pending = reg_OS_IE & reg_OS_IF;
+    if (pending == 0) {
+        return;
+    }
+    bit = (u32)__builtin_ctz(pending);
+    reg_OS_IF &= ~(1u << bit); /* hardware: writing 1 clears; here we clear it */
+    OS_IRQTable[bit]();
+#ifndef SDK_NO_THREAD
+    OS_IrqHandler_ThreadSwitch();
+#endif
+}
+#endif
+
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void OS_IrqHandler_ThreadSwitch (void)
 {
 #ifdef SDK_NO_THREAD
@@ -292,6 +320,17 @@ _dont_switched_:
     ldmfd sp !, { pc }
 #endif
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void OS_IrqHandler_ThreadSwitch (void)
+{
+    /* Wake every thread waiting in OS_WaitIrq; the scheduler then picks
+     * the highest-priority ready thread. */
+#ifndef SDK_NO_THREAD
+    OS_WakeupThread(&OSi_IrqThreadQueue);
+#endif
+}
+#endif
 
