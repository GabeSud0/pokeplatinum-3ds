--- a/libraries/os/src/os_context.c
+++ b/libraries/os/src/os_context.c
@@ -7,6 +7,7 @@
 
 #include <nitro/code32.h>
 
+#if defined(SDK_CW) || defined(__MWERKS__)
 asm void OS_InitContext (register OSContext * context, register u32 newpc, register u32 newsp)
 {
     add newpc, newpc, #4
@@ -60,11 +61,38 @@ asm void OS_InitContext (register OSContext * context, register u32 newpc, regis
     str r1, [context, #OS_CONTEXT_LR]
     bx lr
 }
+#else
+/* C version for compilers without Metrowerks inline assembly. */
+void OS_InitContext (OSContext * context, u32 newpc, u32 newsp)
+{
+    /* Same fields the DS sets up: entry point, an 8-byte aligned stack, and
+     * system mode (Thumb if the entry address is odd). */
+    context->pc_plus4 = newpc + 4;
+#ifdef SDK_CONTEXT_HAS_SP_SVC
+    context->sp_svc = newsp;
+    newsp -= HW_SVC_STACK_SIZE;
+#endif
+    if (newsp & 4) {
+        newsp -= 4;
+    }
+    context->sp = newsp;
+    context->cpsr = (newpc & 1) ? (HW_PSR_SYS_MODE | HW_PSR_THUMB_STATE)
+                                : (HW_PSR_SYS_MODE | HW_PSR_ARM_STATE);
+    {
+        int i;
+        for (i = 0; i < 13; i++) {
+            context->r[i] = 0;
+        }
+    }
+    context->lr = 0;
+}
+#endif
 
