From: Platinum 3DS port contributors
Subject: [PATCH] Forward NitroSystem direct FIFO stores to portable GX3D

On the DS, each GXFIFO assignment is a hardware command word. In the 3DS
port that address points at a RAM array, so replace the writes with the
same stream entrypoint used by DMA and MI_CpuSend32.
Only enabled under SDK_PORT_3DS.

---
diff --git a/libraries/g3d/src/gecom.c b/libraries/g3d/src/gecom.c
--- a/libraries/g3d/src/gecom.c
+++ b/libraries/g3d/src/gecom.c
@@ -1,4 +1,8 @@
-#include <nnsys/g3d/gecom.h>
+#if defined(SDK_PORT_3DS)
+/* FIFO register stores have side effects, unlike ordinary port memory. */
+extern void NitroPort_GxFifoWord(u32 value);
+#endif
+#include <nnsys/g3d/gecom.h>
 
 static volatile int NNS_G3dFlagGXDmaAsync = 0;
 
@@ -145,7 +149,11 @@
         }
     }
 
-    reg_G3X_GXFIFO = op;
+    #if defined(SDK_PORT_3DS)
+    NitroPort_GxFifoWord(op);
+    #else
+    reg_G3X_GXFIFO = op;
+    #endif
     sendNB(args, (void *)&reg_G3X_GXFIFO, num << 2);
 }
 
diff --git a/libraries/g3d/src/sbc.c b/libraries/g3d/src/sbc.c
--- a/libraries/g3d/src/sbc.c
+++ b/libraries/g3d/src/sbc.c
@@ -1,4 +1,8 @@
