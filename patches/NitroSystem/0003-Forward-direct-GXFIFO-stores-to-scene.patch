+#if defined(SDK_PORT_3DS)
+/* FIFO register stores have side effects, unlike ordinary port memory. */
+extern void NitroPort_GxFifoWord(u32 value);
+#endif
+#include <nnsys/g3d/sbc.h>
 #include <nnsys/g3d/kernel.h>
 #include <nnsys/g3d/binres/res_struct.h>
 #include <nnsys/g3d/glbstate.h>
@@ -726,9 +730,21 @@
 
         NNS_G3dGeFlushBuffer();
 
-        reg_G3X_GXFIFO = GX_PACK_OP(G3OP_MTX_MODE, G3OP_MTX_PUSH, G3OP_MTX_IDENTITY, G3OP_NOP);
+        #if defined(SDK_PORT_3DS)
+        NitroPort_GxFifoWord(GX_PACK_OP(G3OP_MTX_MODE, G3OP_MTX_PUSH, G3OP_MTX_IDENTITY, G3OP_NOP));
+        #else
+        reg_G3X_GXFIFO = GX_PACK_OP(G3OP_MTX_MODE, G3OP_MTX_PUSH, G3OP_MTX_IDENTITY, G3OP_NOP);
+        #endif
-        reg_G3X_GXFIFO = (u32)GX_MTXMODE_PROJECTION;
+        #if defined(SDK_PORT_3DS)
+        NitroPort_GxFifoWord((u32)GX_MTXMODE_PROJECTION);
+        #else
+        reg_G3X_GXFIFO = (u32)GX_MTXMODE_PROJECTION;
+        #endif
-        reg_G3X_GXFIFO = 0;
+        #if defined(SDK_PORT_3DS)
+        NitroPort_GxFifoWord(0);
+        #else
+        reg_G3X_GXFIFO = 0;
+        #endif
 
         while (G3X_GetClipMtx(&m))
             ;
@@ -757,7 +773,11 @@
 
         if (NNS_G3dGlb.flag & NNS_G3D_GLB_FLAG_FLUSH_WVP) {
 
-            reg_G3X_GXFIFO = GX_PACK_OP(G3OP_MTX_POP, G3OP_MTX_MODE, G3OP_MTX_LOAD_4x3, G3OP_NOP);
+            #if defined(SDK_PORT_3DS)
+            NitroPort_GxFifoWord(GX_PACK_OP(G3OP_MTX_POP, G3OP_MTX_MODE, G3OP_MTX_LOAD_4x3, G3OP_NOP));
+            #else
+            reg_G3X_GXFIFO = GX_PACK_OP(G3OP_MTX_POP, G3OP_MTX_MODE, G3OP_MTX_LOAD_4x3, G3OP_NOP);
+            #endif
             MI_CpuSend32(&bbcmd1[1],
                          &reg_G3X_GXFIFO,
                          2 * sizeof(u32));
@@ -765,12 +785,20 @@
                          &reg_G3X_GXFIFO,
                          G3OP_MTX_LOAD_4x3_NPARAMS * sizeof(u32));
 
-            reg_G3X_GXFIFO = GX_PACK_OP(G3OP_MTX_MULT_4x3, G3OP_MTX_SCALE, G3OP_NOP, G3OP_NOP);
+            #if defined(SDK_PORT_3DS)
+            NitroPort_GxFifoWord(GX_PACK_OP(G3OP_MTX_MULT_4x3, G3OP_MTX_SCALE, G3OP_NOP, G3OP_NOP));
+            #else
