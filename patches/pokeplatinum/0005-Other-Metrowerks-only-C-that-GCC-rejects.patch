--- a/src/nintendo_wfc/main.c
+++ b/src/nintendo_wfc/main.c
@@ -671,7 +671,12 @@ static void ReceiveCallback(u8 aid, u8 *data, int size)
         return;
     }
 
+#ifdef SDK_PORT_3DS
+    // The first parameter is an enum; Metrowerks accepted NULL for it.
+    void *buffer = NintendoWFCAlloc((DWCAllocType)0, size - 4, 4);
+#else
     void *buffer = NintendoWFCAlloc(NULL, size - 4, 4);
+#endif
     if (buffer == NULL) {
         return;
     }
@@ -688,7 +693,12 @@ static void ReceiveCallback(u8 aid, u8 *data, int size)
         }
     }
 
+#ifdef SDK_PORT_3DS
+    // The first parameter is an enum; Metrowerks accepted NULL for it.
+    NintendoWFCFree((DWCAllocType)0, buffer, size - 4);
+#else
     NintendoWFCFree(NULL, buffer, size - 4);
+#endif
 }
 
 static void ConnectionClosedCallback(DWCError error, BOOL selfClosed, BOOL hostClosed, u8 aid, int closingFriendIdx, void *userParam)
