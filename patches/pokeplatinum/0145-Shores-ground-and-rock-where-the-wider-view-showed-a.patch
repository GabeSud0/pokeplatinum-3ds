     { 0, 668, 24, 32, 669 }, // (Route 207's west filler: its last row of ground, z 728-735)
     { 0, 521, 0, 16, 491, TRUE }, // (Route 211's south filler: its first two rows, z 544-559; its copies under it over the canyon)
     { 0, 461, 16, 32, 491, TRUE, 8, 32 }, // (and its north filler's last two, z 496-511, over the canyon: x 360-383)
@@ -7430,6 +7431,8 @@ static void Port_FreeCutCopies(void)
 
 // The loaded map's copy with its rows left out: found, or made now; NULL if
 // it has none, its pieces' map isn't loaded with them, or it can't be.
+static BOOL Port_ShoreCutReady(const LandDataManager *landDataMan, int mapMatrixIndex);
+
 static PortPieceCopy *Port_CutCopyOf(const LandDataManager *landDataMan, u8 index)
 {
     extern void NitroPort_Log(const char *fmt, ...);
@@ -7447,6 +7450,10 @@ static PortPieceCopy *Port_CutCopyOf(const LandDataManager *landDataMan, u8 inde
 
     BOOL pieces = FALSE;
 
+    if (cut != NULL && !Port_ShoreCutReady(landDataMan, mapMatrixIndex)) {
