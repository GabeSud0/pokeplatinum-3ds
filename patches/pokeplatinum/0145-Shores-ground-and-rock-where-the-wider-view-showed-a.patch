@@ -7739,6 +7746,434 @@ static void Port_RenderStandInMaps(const LandDataManager *landDataMan)
 }
 #endif
 
+#ifdef SDK_PORT_3DS
+// Shores (2026-11-12): the forest's filler east of Veilstone (matrix 563)
+// stands on its square right to its north edge, the sea's filler's water
+// lower beside it (and Veilstone's own sea in the notch west of it): in the
+// wider view its first rows of trees stood over the water ("sections of
+// the forest floating, we need to add ground"; asked: a grass strip with a
+// rock cliff down to the water). Drawn here: from the forest's edge (a
+// line of points, in tiles), a strip of its own ground (its texture) out
+// over the water, and from there a slope of rock down under the water,
+// round a corner where the edge turns. Textures by name from the area's
+// set (as its maps are bound to them).
+typedef struct PortShorePoint {
+    s16 x, z;      // (tiles)
+    u8 grass;      // (the ground strip's width from here to the next point, eighths of a tile; 0: the shore's)
+} PortShorePoint;
+
+typedef struct PortShore {
+    u8 matrixID;
+    u16 nearMap;   // (drawn while the player's map is it or next to it)
+    const PortShorePoint *points;
+    u8 count;
+    s8 waterSide;  // (+1: the water left of the way along the points, as seen from above with north up; -1 right)
+    u8 grass;      // (the ground strip's width, in eighths of a tile)
+    u8 slope;      // (the rock slope's run, eighths)
+    s16 groundY, seaY, bottomY; // (world units)
+    const char *groundTex;
+    const char *rockTex;
+    const char *rockPltt; // (its palette's name: NULL, the texture's own)
+    u8 back;              // (and a strip of the land's own top behind the edge, eighths: where its own is left out, sPortMapCuts)
+    const char *backTex;
+    s8 backX, backZ;      // (where the way out is this, unit: the strip behind drawn there only)
+    u8 rockFirst;         // (the rock down from the edge first, the ground strip after it, at the rock's foot)
+    u16 cutMap;           // (the map left out under the strip behind, sPortMapCuts: left whole if the shore can't be drawn; 0 none)
+    u8 square;            // (its corners square, not round)
+    u8 tierRun;           // (the rock in two tiers, as the cliff beside it: the upper one's run, eighths; 0 one)
+    s16 tierY;            // (the step between them, world units)
+    u8 rimEdge;           // (the rock a coast's edge, as Veilstone's own: lit as the ground, 16 texels a tile along)
+} PortShore;
+
+// (the forest's ground starts 3 tiles in from its west side for its first
+// 8 rows, Veilstone's sea under its first trees there: the strip fills that,
+// to x 736, 2026-11-12, "move what you did to the right to fill in the gap
+// in the trees ... make it a straight corner". Its edge Veilstone's own
+// coast's (seaside3, the wavy dirt edge), on all sides: "add the dirt edge
+// to the top section, and the wavy dirt edge texture is missing". All of
+// it above 19: Veilstone's model has a second sea over that notch at 19,
+// above the forest's ground (16), and its north edge drawn on north over
+// the sea's filler takes it there too; under it the strip and the edge
+// didn't show, "I can clearly still see the sea")
+static const PortShorePoint sPortShoreVeilstoneForest[] = {
+    { 770, 576, 16 }, { 739, 576, 28 }, { 739, 584, 28 },
+};
+
+// (the mountain's filler west of Route 210's forest, north of Solaceon
+// (matrix 586): its rock plain a tile above the forest's floor, no side to
+// it: the trees' first column stood on the rock, 2026-11-12, "the rock
+// looks strange ... it is clashing with the trees". Its side, of rock,
+// down to the forest's floor.)
+static const PortShorePoint sPortShoreSolaceonRock[] = {
+    { 544, 624, 0 }, { 541, 624, 0 }, { 541, 640, 0 },
+};
+
+static const PortShore sPortShores[] = {
+    { 0, 563, sPortShoreVeilstoneForest, NELEMS(sPortShoreVeilstoneForest), -1, 16, 4, 21, 8, 20, "ngrass", "seaside3", NULL, 0, NULL, 0, 0, FALSE, 0, TRUE, 0, 0, TRUE },
+    { 0, 587, sPortShoreSolaceonRock, NELEMS(sPortShoreSolaceonRock), 1, 8, 16, 48, 32, 32, "ngrass", "criffp", "criff", 40, "criff", 1, 0, TRUE, 586, FALSE, 8, 40, FALSE },
+};
+
+// (a texture of the area's map set: its image parameter as the maps' are
+// bound to it, and its palette's base; FALSE if it isn't there)
+static BOOL Port_AreaTexture(const AreaDataManager *area, const char *texName, const char *plttName, u32 *imageParam, u32 *plttBase, int *width, int *height)
+{
+    const NNSG3dResTex *tex = AreaDataManager_GetMapTexture(area);
+    NNSG3dResName name;
+    const NNSG3dResDictTexData *texData;
+    const NNSG3dResDict *dict;
+    u32 vramOffset, i, n = (u32)strlen(texName);
+
+    if (tex == NULL || n > NNS_G3D_RESNAME_SIZE) {
+        return FALSE;
+    }
+
+    memset(&name, 0, sizeof(name));
+    memcpy(name.name, texName, n);
+    texData = NNS_G3dGetTexDataByName(tex, &name);
+
+    if (texData == NULL) {
+        return FALSE;
+    }
+
+    if ((texData->texImageParam & REG_G3_TEXIMAGE_PARAM_TEXFMT_MASK) != (GX_TEXFMT_COMP4x4 << REG_G3_TEXIMAGE_PARAM_TEXFMT_SHIFT)) {
+        vramOffset = NNS_GfdGetTexKeyAddr(tex->texInfo.vramKey) >> NNS_GFD_TEXKEY_ADDR_SHIFT;
+    } else {
+        vramOffset = NNS_GfdGetTexKeyAddr(tex->tex4x4Info.vramKey) >> NNS_GFD_TEXKEY_ADDR_SHIFT;
+    }
+
+    // (repeated both ways)
+    *imageParam = (texData->texImageParam + vramOffset) | (1u << 16) | (1u << 17);
+    *width = 8 << ((texData->texImageParam >> 20) & 7);
+    *height = 8 << ((texData->texImageParam >> 23) & 7);
+    *plttBase = 0;
+
+    // (its palette: the one named as it is with "_pl", else as it is, else
+    // the first whose name starts with its)
+    dict = (const NNSG3dResDict *)((const u8 *)tex + tex->plttInfo.ofsDict);
+
+    for (int pass = 0; pass < 3; pass++) {
+        for (i = 0; i < dict->numEntry; i++) {
+            const NNSG3dResName *pn = NNS_G3dGetResNameByIdx(dict, i);
+            char pl[NNS_G3D_RESNAME_SIZE + 1];
+
+            memcpy(pl, pn->name, NNS_G3D_RESNAME_SIZE);
+            pl[NNS_G3D_RESNAME_SIZE] = 0;
+
+            if (plttName != NULL ? pass == 0 && strcmp(pl, plttName) == 0 : (pass == 0 && strncmp(pl, texName, n) == 0 && strcmp(pl + n, "_pl") == 0)
+                || (pass == 1 && strcmp(pl, texName) == 0)
+                || (pass == 2 && strncmp(pl, texName, n) == 0)) {
+                const NNSG3dResDictPlttData *pd = (const NNSG3dResDictPlttData *)NNS_G3dGetResDataByIdx(dict, i);
+                u16 base = pd->offset, off = (u16)(NNS_GfdGetPlttKeyAddr(tex->plttInfo.vramKey) >> NNS_GFD_PLTTKEY_ADDR_SHIFT);
+
+                if (!(pd->flag & 1)) {
+                    base >>= 1;
+                    off >>= 1;
+                }
+
+                *plttBase = (u16)(base + off);
+                return TRUE;
+            }
+        }
+    }
+
+    return FALSE;
+}
+
+// (the same from a loaded map's material with that texture, as it's bound:
+// its palette as the map has it)
+static BOOL Port_LoadedTexture(const LandDataManager *landDataMan, const char *texName, u32 *imageParam, u32 *plttBase, int *width, int *height)
+{
+    u32 n = (u32)strlen(texName);
+
+    for (u8 q = 0; q < QUADRANT_COUNT && n <= NNS_G3D_RESNAME_SIZE; q++) {
+        const LoadedMap *loadedMap = landDataMan->loadedMaps[q];
+        const NNSG3dResMdl *model = loadedMap->mapRenderObj.resMdl;
+
+        if (loadedMap->mapMatrixIndex == INVALID_MAP_MATRIX_INDEX || loadedMap->valid != TRUE || model == NULL) {
+            continue;
+        }
+
+        const NNSG3dResMat *mat = NNS_G3dGetMat((NNSG3dResMdl *)model);
+        const NNSG3dResDict *textures = (const NNSG3dResDict *)((const u8 *)mat + mat->ofsDictTexToMatList);
+
+        for (u32 t = 0; t < textures->numEntry; t++) {
+            const NNSG3dResName *name = NNS_G3dGetResNameByIdx(textures, t);
+            const NNSG3dResDictTexToMatIdxData *data = (const NNSG3dResDictTexToMatIdxData *)NNS_G3dGetResDataByIdx(textures, t);
+            char nm[NNS_G3D_RESNAME_SIZE + 1];
+
+            memcpy(nm, name->name, NNS_G3D_RESNAME_SIZE);
+            nm[NNS_G3D_RESNAME_SIZE] = 0;
+
+            if (strcmp(nm, texName) != 0 || data->numIdx == 0 || !(data->flag & 1)) {
+                continue;
+            }
+
+            const NNSG3dResMatData *md = NNS_G3dGetMatDataByIdx((NNSG3dResMat *)mat, *((const u8 *)mat + data->offset));
+
+            *imageParam = md->texImageParam | (1u << 16) | (1u << 17);
+            *plttBase = md->texPlttBase;
+            *width = 8 << ((md->texImageParam >> 20) & 7);
+            *height = 8 << ((md->texImageParam >> 23) & 7);
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+// (a point along the shore: the edge's (in tiles, x and z) and the way out
+// over the water, unit length)
+typedef struct PortShoreAt {
+    fx32 x, z, nx, nz; // (the way out: unit; at a square corner the two ways' sum)
+    fx32 gx, gz;       // (the ground strip's far side from it)
+} PortShoreAt;
+
+#define PORT_SHORE_AT 64
+
+static u32 Port_ShoreLine(const PortShore *shore, PortShoreAt *at)
+{
+    u32 n = 0;
+    fx32 lastNx = 0, lastNz = 0, lastW = 0;
+
+    for (u32 k = 0; k + 1 < shore->count; k++) {
+        fx32 dx = (shore->points[k + 1].x - shore->points[k].x) * FX32_ONE, dz = (shore->points[k + 1].z - shore->points[k].z) * FX32_ONE;
+        fx32 len = FX_Sqrt(FX_Mul(dx, dx) + FX_Mul(dz, dz));
+        fx32 ux = FX_Div(dx, len), uz = FX_Div(dz, len);
+        // (out over the water: left of the way is (uz, -ux) with north up and z south)
+        fx32 nx = shore->waterSide > 0 ? uz : -uz, nz = shore->waterSide > 0 ? -ux : ux;
+        fx32 w = (shore->points[k].grass != 0 ? shore->points[k].grass : shore->grass) * FX32_ONE / 8;
+        int steps = (int)(len >> FX32_SHIFT);
+
+        if (k > 0 && n > 0 && n + 4 < PORT_SHORE_AT) {
+            const fx32 cx = shore->points[k].x * FX32_ONE, cz = shore->points[k].z * FX32_ONE;
+
+            if (shore->square) {
+                // (a corner: square, the two strips' far sides meeting)
+                at[n].x = cx;
+                at[n].z = cz;
+                at[n].nx = lastNx + nx;
+                at[n].nz = lastNz + nz;
+                at[n].gx = FX_Mul(lastNx, lastW) + FX_Mul(nx, w);
+                at[n].gz = FX_Mul(lastNz, lastW) + FX_Mul(nz, w);
+                n++;
+            } else {
+                // (a corner: round, from the last way out to this one)
+                s32 a0 = FX_Atan2Idx(lastNz, lastNx), a1 = FX_Atan2Idx(nz, nx);
+                s32 d = (s32)(s16)(u16)(a1 - a0);
+
+                for (int j = 1; j < 4; j++) {
+                    u16 a = (u16)(a0 + d * j / 4);
+
+                    at[n].x = cx;
+                    at[n].z = cz;
+                    at[n].nx = FX_CosIdx(a);
+                    at[n].nz = FX_SinIdx(a);
+                    at[n].gx = FX_Mul(at[n].nx, w);
+                    at[n].gz = FX_Mul(at[n].nz, w);
+                    n++;
+                }
+            }
+        }
+
+        // (along it, a point a tile; a square corner's own point taken)
+        for (int j = k > 0 && shore->square ? 1 : 0; j <= steps && n < PORT_SHORE_AT; j++) {
+            if (j == steps && k + 2 < shore->count && shore->square) {
+                break;
+            }
+
+            at[n].x = shore->points[k].x * FX32_ONE + ux * j;
+            at[n].z = shore->points[k].z * FX32_ONE + uz * j;
+            at[n].nx = nx;
+            at[n].nz = nz;
+            at[n].gx = FX_Mul(nx, w);
+            at[n].gz = FX_Mul(nz, w);
+            n++;
+        }
+
+        lastNx = nx;
+        lastNz = nz;
+        lastW = w;
+    }
+
+    return n;
+}
+
+// (the shores' textures that need them: there, for the map left out under one)
+static BOOL Port_ShoreTextures(const LandDataManager *landDataMan, const PortShore *shore, u32 image[3], u32 pltt[3], int w[3], int h[3])
+{
+    const char *names[3] = { shore->groundTex, shore->rockTex, shore->back != 0 ? shore->backTex : NULL };
+    const char *pltts[3] = { NULL, shore->rockPltt, NULL };
+
+    for (int k = 0; k < 3; k++) {
+        if (names[k] != NULL && !Port_LoadedTexture(landDataMan, names[k], &image[k], &pltt[k], &w[k], &h[k])
+            && !Port_AreaTexture(landDataMan->areaDataMan, names[k], pltts[k], &image[k], &pltt[k], &w[k], &h[k])) {
+            return FALSE;
+        }
+    }
+
+    return TRUE;
+}
+
+static BOOL Port_ShoreCutReady(const LandDataManager *landDataMan, int mapMatrixIndex)
+{
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+
+    for (int k = 0; k < (int)NELEMS(sPortShores); k++) {
+        u32 image[3], pltt[3];
+        int w[3], h[3];
+
+        if (sPortShores[k].matrixID == matrixID && sPortShores[k].cutMap == mapMatrixIndex && !Port_ShoreTextures(landDataMan, &sPortShores[k], image, pltt, w, h)) {
+            return FALSE;
+        }
+    }
+
+    return TRUE;
+}
+
+static void Port_RenderShores(const LandDataManager *landDataMan)
+{
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix), width = landDataMan->mapMatrixWidth;
+
+    if (NitroPort_WideScreenExtra() == 0 || landDataMan->inDistortionWorld) {
+        return;
+    }
+
+    for (int k = 0; k < (int)NELEMS(sPortShores); k++) {
+        const PortShore *shore = &sPortShores[k];
+        int here = (int)landDataMan->trackedTargetMapMatrixIndex;
+        PortShoreAt at[PORT_SHORE_AT];
+        u32 groundImage, groundPltt, rockImage, rockPltt, n;
+        int gw, gh, rw, rh;
+
+        if (shore->matrixID != matrixID || here < 0 || here / width - shore->nearMap / width > 1 || shore->nearMap / width - here / width > 1
+            || here % width - shore->nearMap % width > 1 || shore->nearMap % width - here % width > 1) {
+            continue;
+        }
+
+        u32 image[3] = { 0, 0, 0 }, pltt[3] = { 0, 0, 0 }, backImage, backPltt;
+        int w[3], h[3];
+
+        if (!Port_ShoreTextures(landDataMan, shore, image, pltt, w, h)) {
+            continue;
+        }
+
+        // (with a map left out under it: only while it's drawn so, loaded)
+        if (shore->cutMap != 0) {
+            BOOL cut = FALSE;
+
+            for (u8 q = 0; q < QUADRANT_COUNT; q++) {
+                cut |= landDataMan->loadedMaps[q]->mapMatrixIndex == shore->cutMap && Port_CutCopyOf(landDataMan, q) != NULL;
+            }
+
+            if (!cut) {
+                continue;
+            }
+        }
+
+        groundImage = image[0]; groundPltt = pltt[0]; gw = w[0]; gh = h[0];
+        rockImage = image[1]; rockPltt = pltt[1]; rw = w[1]; rh = h[1];
+        backImage = image[2]; backPltt = pltt[2];
+
+        n = Port_ShoreLine(shore, at);
+
+        if (n < 2) {
+            continue;
+        }
+
+        // (a tile a unit, from the first point, the world's offset added)
+        VecFx32 origin = { landDataMan->offset.x + shore->points[0].x * MAP_OBJECT_TILE_SIZE, landDataMan->offset.y, landDataMan->offset.z + shore->points[0].z * MAP_OBJECT_TILE_SIZE };
+        // (8 tiles a unit: a vertex's coordinates in 16 bits reach 64 tiles)
+        VecFx32 tileScale = { MAP_OBJECT_TILE_SIZE * 8, MAP_OBJECT_TILE_SIZE * 8, MAP_OBJECT_TILE_SIZE * 8 };
+        MtxFx33 identity = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+        VecFx32 one = { FX32_ONE, FX32_ONE, FX32_ONE };
+        fx32 ox = shore->points[0].x * FX32_ONE, oz = shore->points[0].z * FX32_ONE;
+        fx32 groundY = FX_Div(shore->groundY * FX32_ONE, MAP_OBJECT_TILE_SIZE), bottomY = FX_Div(shore->bottomY * FX32_ONE, MAP_OBJECT_TILE_SIZE);
+        fx32 run = shore->slope * FX32_ONE / 8;
+
+        NNS_G3dGlbSetBaseTrans(&origin);
+        NNS_G3dGlbSetBaseRot(&identity);
+        NNS_G3dGlbSetBaseScale(&one);
+        NNS_G3dGlbFlush();
+        NNS_G3dGePushMtx();
+        NNS_G3dGeScaleVec(&tileScale);
+        // (either way round: the side the water is on turns the strips)
+        NNS_G3dGePolygonAttr(GX_LIGHTMASK_0, GX_POLYGONMODE_MODULATE, GX_CULL_NONE, 0, 31, 0);
+        // (as the land models' materials: 25 diffuse, the vertex colour too, 31 ambient)
+        NNS_G3dGeMaterialColorDiffAmb(GX_RGB(25, 25, 25), GX_RGB(31, 31, 31), TRUE);
+        NNS_G3dGeMaterialColorSpecEmi(GX_RGB(0, 0, 0), GX_RGB(0, 0, 0), FALSE);
+
+        for (int part = shore->back != 0 ? -1 : 0; part < (shore->tierRun != 0 ? 3 : 2); part++) {
+            const u32 image = part < 0 ? backImage : part == 0 ? groundImage : rockImage;
+            const int tw = part == 0 ? gw : rw, th = part == 0 ? gh : rh;
+
+            if (part == 0 && shore->grass == 0) {
+                continue;
+            }
+
+            NNS_G3dGeTexImageParam((GXTexFmt)((image >> 26) & 7), GX_TEXGEN_TEXCOORD, (GXTexSizeS)((image >> 20) & 7), (GXTexSizeT)((image >> 23) & 7),
+                GX_TEXREPEAT_ST, GX_TEXFLIP_NONE, (GXTexPlttColor0)((image >> 29) & 1), (image & 0xFFFF) << 3);
+            // (the base as a material keeps it: 8-byte units for a 4-colour palette, 16 else)
+            NNS_G3dGeTexPlttBase((part < 0 ? backPltt : part == 0 ? groundPltt : rockPltt) << (((image >> 26) & 7) == GX_TEXFMT_PLTT4 ? 3 : 4), (GXTexFmt)((image >> 26) & 7));
+            NNS_G3dGeBegin(GX_BEGIN_QUAD_STRIP);
+
+            for (u32 i = 0; i < n; i++) {
+                fx32 x0, z0, y0, x1, z1, y1;
+                s32 s0, t0, s1, t1;
+
+                if (part < 0 && (FX_Mul(at[i].nx, shore->backX * FX32_ONE) + FX_Mul(at[i].nz, shore->backZ * FX32_ONE)) < FX32_ONE * 15 / 16) {
+                    // (the land's top only where its own is left out: the way out there backX, backZ)
+                    continue;
+                }
+
+                if (part < 0) {
+                    // (the land's own top behind the edge, from back there to it; its texture as the ground's)
+                    fx32 back = shore->back * FX32_ONE / 8;
+
+                    x0 = at[i].x - FX_Mul(at[i].nx, back); z0 = at[i].z - FX_Mul(at[i].nz, back);
+                    x1 = at[i].x; z1 = at[i].z;
+                    y0 = y1 = groundY;
