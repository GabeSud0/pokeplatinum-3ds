-// A walk straight up or down (the waits and turns before it as the script
-// has them) ending past the DS's top or bottom, in the taller picture: the
-// extra tiles out added, if they're clear; else NULL.
+// A way out of the taller picture from (x, z), depth steps taken: on the
+// way out (up or down) first, else east, else west (never back), as far as
+// it goes before turning; or out beside the wider picture.
+static BOOL ScrCmd_PortTallFindWay(PortWidePathSearch *search, int x, int z, fx32 y, int depth)
+{
+    const int dirs[3] = { search->outDir, DIR_EAST, DIR_WEST };
+    int i;
+
+    if (depth > 0 && (ScrCmd_PortTallOut(search->fieldSystem, x, z, y, search->outDir, PORT_TALL_ROWS) || ScrCmd_PortTallBeside(search->fieldSystem, x))) {
+        search->path[depth] = 0xFF;
+        return TRUE;
+    }
+
+    if (depth >= PORT_WIDE_PATH_MAX - 1 || ++search->nodes > PORT_WIDE_SEARCH_MAX) {
+        return FALSE;
+    }
+
+    for (i = 0; i < 3; i++) {
+        int toX = x + MapObject_GetDxFromDir(dirs[i]), toZ = z + MapObject_GetDzFromDir(dirs[i]);
+        fx32 toY = y;
+
+        if (ScrCmd_PortWideSeen(search, toX, toZ) || ScrCmd_PortWideBlocked(search->fieldSystem, x, z, &toY, dirs[i])
+            || ScrCmd_PortWideSomeoneThere(search->fieldSystem, search->mapObj, toX, toZ)) {
+            continue;
+        }
+
+        ScrCmd_PortWideSee(search, toX, toZ);
+        search->path[depth] = dirs[i];
+
+        if (ScrCmd_PortTallFindWay(search, toX, toZ, toY, depth + 1)) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+// The script's walk (count commands), then a way round from where it ends,
+// (x, z) at height y, out of the taller picture past its top or bottom
+// (dir), at the walk's last speed; else NULL.
+static MapObjectAnimCmd *ScrCmd_PortTallWayRound(FieldSystem *fieldSystem, MapObject *mapObj, const MapObjectAnimCmd *cmds, int count, int x, int z, fx32 y, int dir, int speed)
+{
+    PortWidePathSearch *search = Heap_Alloc(HEAP_ID_FIELD1, sizeof(PortWidePathSearch));
+    MapObjectAnimCmd *copy = NULL;
+    int steps, runs, i, wayX = x, wayZ = z, midX, midZ;
+
+    memset(search, 0, sizeof(*search));
+    ScrCmd_PortWideMiddle(fieldSystem, &midX, &midZ);
+    search->fieldSystem = fieldSystem;
+    search->mapObj = mapObj;
+    search->midX = midX;
+    search->midZ = midZ;
+    search->outDir = dir;
+    ScrCmd_PortWideSee(search, x, z);
+
+    if (!ScrCmd_PortTallFindWay(search, x, z, y, 0)) {
+        Heap_Free(search);
+        return NULL;
+    }
+
+    for (steps = 0, runs = 0; search->path[steps] != 0xFF; steps++) {
+        if (steps == 0 || search->path[steps] != search->path[steps - 1]) {
+            runs++;
+        }
+
+        wayX += MapObject_GetDxFromDir(search->path[steps]);
+        wayZ += MapObject_GetDzFromDir(search->path[steps]);
+    }
+
+    if (!ScrCmd_PortWideRemember(fieldSystem, mapObj, wayX - x, wayZ - z, PORT_WIDE_TALL_SENT)) {
+        Heap_Free(search);
+        return NULL;
+    }
+
+    copy = Heap_Alloc(HEAP_ID_FIELD1, sizeof(MapObjectAnimCmd) * (count + runs + 1));
+    memcpy(copy, cmds, sizeof(MapObjectAnimCmd) * count);
+
+    for (i = 0, runs = count; i < steps; i++) {
+        if (i == 0 || search->path[i] != search->path[i - 1]) {
+            copy[runs].movementAction = sPortWideWalks[speed][search->path[i]];
+            copy[runs].count = 0;
+            runs++;
+        }
+
+        copy[runs - 1].count++;
+    }
+
+    copy[runs].movementAction = MOVEMENT_ACTION_END;
+    copy[runs].count = 0;
+    Heap_Free(search);
+    return copy;
+}
