 }
 
+// The player's square on the Town Map, as TownMapContext_Init works it out
+// (outside the main map: the place left it by), roughly (not the Distortion
+// World's): to tell when the map needs telling again.
+static void StartMenu_PortMapSquare(FieldSystem *fieldSystem, int *x, int *z)
+{
+    int playerX = PlayerAvatar_GetXPos(fieldSystem->playerAvatar);
+    int playerZ = PlayerAvatar_GetZPos(fieldSystem->playerAvatar);
+
+    if (!MapHeader_IsOnMainMatrix(MapMatrix_GetMapHeaderIDAtCoords(fieldSystem->mapMatrix, playerX / MAP_TILES_COUNT_X, playerZ / MAP_TILES_COUNT_Z))) {
+        Location *exit = FieldOverworldState_GetExitLocation(SaveData_GetFieldOverworldState(fieldSystem->saveData));
+
+        playerX = exit->x;
+        playerZ = exit->z;
+    }
+
+    *x = playerX / MAP_TILES_COUNT_X;
+    *z = playerZ / MAP_TILES_COUNT_Z;
+}
+
+// A window's pixels (4 bits each, tiled) through its palette into the
+// port's buffer: each pixel 0x8000 | its colour, or 0 where nothing is.
+static void StartMenu_PortWindowPixels(const Window *window, const u16 *palette, u16 *out, int rows)
+{
+    const u8 *pixels = window->pixels;
+    int w = window->width * TILE_WIDTH_PIXELS;
+
+    for (int y = 0; y < rows && y < window->height * TILE_HEIGHT_PIXELS; y++) {
+        for (int x = 0; x < w; x++) {
+            int tile = (y / TILE_HEIGHT_PIXELS) * window->width + x / TILE_WIDTH_PIXELS;
+            int v = pixels[tile * TILE_SIZE_4BPP + (y % TILE_HEIGHT_PIXELS) * 4 + (x % TILE_WIDTH_PIXELS) / 2];
+
+            v = (x & 1) ? v >> 4 : v & 0xF;
+            out[y * w + x] = v ? (0x8000 | (palette[v] & 0x7FFF)) : 0;
+        }
+    }
+}
+
+// The place's name as the Town Map's LoadMapName has it (some squares off
+// the main map's headers have their own).
+static void StartMenu_PortMapName(MainMapMatrixData *matrix, int x, int z, String *name)
+{
+    static const struct {
+        u8 x, z;
+        u16 header;
+    } notOnMainMatrix[] = {
+        { 11, 19, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 11, 20, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 11, 21, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 11, 22, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 12, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 13, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 14, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 15, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 16, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 17, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 18, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 12, 19, MAP_HEADER_MT_CORONET_1F_SOUTH },
+        { 20, 12, MAP_HEADER_BATTLE_FRONTIER_GATE_TO_FIGHT_AREA },
+    };
+    enum MapHeaderID header = MainMapMatrixData_GetMapHeaderIDAtCoords(matrix, x, z);
+
+    if (header == MAP_HEADER_EVERYWHERE) {
+        for (int i = 0; i < NELEMS(notOnMainMatrix); i++) {
+            if (notOnMainMatrix[i].x == x && notOnMainMatrix[i].z == z) {
+                header = notOnMainMatrix[i].header;
+                break;
+            }
+        }
+    }
+
+    MapHeader_LoadName(header, HEAP_ID_FIELD2, name);
+}
+
+// The map, laid out as the Town Map item lays out its upper screen
+// (TownMap_LoadGraphics: CreateSprites, TownMap_LoadFlyLocations,
+// LoadLocationHistory, PrintLocationName) and its guide page's description
+// (MoveZoomedInMap, PrintLocationDescription), told to the port.
+static void StartMenu_PortSendMap(FieldSystem *fieldSystem)
+{
+    TownMapContext *ctx = Heap_AllocAtEnd(HEAP_ID_FIELD2, sizeof(TownMapContext));
+    int x, z, zoomX, zoomY, dots = 0;
+    int dotX[TOWN_MAP_HISTORY_LENGTH], dotZ[TOWN_MAP_HISTORY_LENGTH];
+
+    TownMapContext_Init(fieldSystem, ctx, TOWN_MAP_MODE_ITEM);
+
+    if (ctx->playerX == 0 && ctx->playerZ == 0) {
+        x = 3;
+        z = 27;
+    } else {
+        x = ctx->playerX / MAP_TILES_COUNT_X;
+        z = ctx->playerZ / MAP_TILES_COUNT_Z;
+    }
+
+    NitroPort_LowerMenuMapBegin();
+
+    // The sprites, the front one first: the cursor, the player's head, the
+    // towns' blocks (unlocked: their colour; Pal Park's and Victory Road's
+    // only once unlocked).
+    NitroPort_LowerMenuMapSprite(PORT_MAP_CURSOR, TOWN_MAP_GRID_X(x), TOWN_MAP_GRID_Y(z), 0, 0);
+    NitroPort_LowerMenuMapSprite(PORT_MAP_PLAYER, TOWN_MAP_GRID_X(x), TOWN_MAP_GRID_Y(z), ctx->trainerGender, ctx->trainerGender == GENDER_MALE ? 1 : 0);
+
+    for (int i = 0; i < NUM_FLY_LOCATIONS; i++) {
+        const TownMapFlyLocationDescriptor *fly = &sFlyLocations[i];
+        BOOL unlocked = ctx->unlockedFlyLocations[i];
+
+        // (specialFlyLocationID: 1 Pal Park, 2 Victory Road)
+        if (!unlocked && (fly->specialFlyLocationID == 1 || fly->specialFlyLocationID == 2)) {
+            continue;
+        }
+
+        NitroPort_LowerMenuMapSprite(PORT_MAP_BLOCK, fly->spriteX + TOWN_MAP_GRID_X_OFFSET, fly->spriteY + TOWN_MAP_GRID_Y_OFFSET, fly->blockShape, unlocked ? 5 + fly->palette + 1 : 5);
+    }
+
+    // The places been through before, not where the player is, each once.
+    for (int i = 0; i < TOWN_MAP_HISTORY_LENGTH; i++) {
+        TownMapLocationHistoryEntry *entry = &ctx->locationHistory[i];
+        int k;
+
+        if (entry->isSet == FALSE) {
+            break;
+        }
+
+        if (entry->x == x && entry->z == z) {
+            continue;
+        }
+
+        for (k = 0; k < dots; k++) {
+            if (dotX[k] == entry->x && dotZ[k] == entry->z) {
+                break;
+            }
+        }
+
+        if (k == dots) {
+            dotX[dots] = entry->x;
+            dotZ[dots] = entry->z;
+            dots++;
+        }
+    }
+
+    for (int k = 0; k < dots; k++) {
+        NitroPort_LowerMenuMapDot(TOWN_MAP_GRID_X(dotX[k]), TOWN_MAP_GRID_Y(dotZ[k]));
+    }
+
+    zoomX = x * 16 + 8 - 112;
+    zoomX = zoomX < 8 ? 8 : zoomX > 256 - 8 ? 256 - 8 : zoomX;
+    zoomY = z * 16 - 96;
+    zoomY = zoomY < 72 + 8 ? 72 + 8 : zoomY > 240 + 72 - 8 ? 240 + 72 - 8 : zoomY;
+    NitroPort_LowerMenuMapLayout(ctx->unlockedHiddenLocations, zoomX, zoomY);
+
+    // The name and the description: only for a square that has a block.
+    TownMapBlockList *blocks = TownMap_ReadBlocks("data/tmap_block.dat", HEAP_ID_FIELD2);
+    TownMapBlock *block = blocks != NULL ? TownMap_GetMapBlockAtPosition(blocks, x, z, ctx->unlockedHiddenLocations) : NULL;
+
+    if (block != NULL) {
+        NNSG2dPaletteData *paletteData;
+        MessageLoader *loader = MessageLoader_Init(MSG_LOADER_LOAD_ON_DEMAND, NARC_INDEX_MSGDATA__PL_MSG, TEXT_BANK_TOWN_MAP, HEAP_ID_FIELD2);
+        Window window;
+        u16 *out;
+
+        // The name: its window (3, 21), 29 x 3 tiles, in the main BG's
+        // palette 15 (the font's), the name in the middle of the bar.
+        void *fontPalette = Graphics_GetPlttData(NARC_INDEX_GRAPHIC__PL_FONT, font_NCLR, &paletteData, HEAP_ID_FIELD2);
+        String *name = String_Init(22, HEAP_ID_FIELD2);
+        MainMapMatrixData *matrix = MainMapMatrixData_Load(HEAP_ID_FIELD2);
+
+        StartMenu_PortMapName(matrix, x, z, name);
+        Window_Init(&window);
+        Window_AddToTopLeftCorner(fieldSystem->bgConfig, &window, 29, 3, 0, 0);
+        Text_AddPrinterWithParamsAndColor(&window, FONT_SYSTEM, name, (HW_LCD_WIDTH - 6 * TILE_WIDTH_PIXELS - Font_CalcStringWidth(FONT_SYSTEM, name, 0)) / 2, 6, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(1, 2, 0), NULL);
+        out = NitroPort_LowerMenuMapText(0, 3 * TILE_WIDTH_PIXELS, 21 * TILE_HEIGHT_PIXELS, 29 * TILE_WIDTH_PIXELS, 3 * TILE_HEIGHT_PIXELS);
+        if (out != NULL) {
+            StartMenu_PortWindowPixels(&window, paletteData->pRawData, out, 3 * TILE_HEIGHT_PIXELS);
+        }
+        Window_Remove(&window);
+        MainMapMatrixData_Free(matrix);
+        String_Free(name);
+        Heap_Free(fontPalette);
+
+        // The description: its window on the guide page (1, 8), 28 x 14
+        // tiles, in the signpost's palette (its kind's), the area's and the
+        // landmark's as the place's checks allow.
+        void *signpostPalette = Graphics_GetPlttData(NARC_INDEX_GRAPHIC__FIELD_BOARD, signpost_NCLR, &paletteData, HEAP_ID_FIELD2);
+        const TownMapLocationDescCheckResults *checks = &ctx->descCheckResults[block->index];
+
+        Window_Init(&window);
+        Window_AddToTopLeftCorner(fieldSystem->bgConfig, &window, 28, 14, 0, 0);
+
+        if (block->areaDescString != 0xFFFF && (checks->areaDescHasCheck == FALSE || checks->areaDescCheckResult)) {
+            String *string = MessageLoader_GetNewString(loader, block->areaDescString);
+
+            Text_AddPrinterWithParamsAndColor(&window, FONT_SYSTEM, string, block->areaDescX, block->areaDescY, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(1, 2, 0), NULL);
+            String_Free(string);
+        }
+
+        if (block->landmarkDescString != 0xFFFF && (checks->landmarkDescHasCheck == FALSE || checks->landmarkCheckResult)) {
+            String *string = MessageLoader_GetNewString(loader, block->landmarkDescString);
+
+            Text_AddPrinterWithParamsAndColor(&window, FONT_SYSTEM, string, block->landmarkDescX, block->landmarkDescY, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(1, 2, 0), NULL);
+            String_Free(string);
+        }
+
+        out = NitroPort_LowerMenuMapText(1, 1 * TILE_WIDTH_PIXELS, 8 * TILE_HEIGHT_PIXELS, 28 * TILE_WIDTH_PIXELS, 14 * TILE_HEIGHT_PIXELS);
+        if (out != NULL) {
+            StartMenu_PortWindowPixels(&window, (const u16 *)paletteData->pRawData + block->signpostType * 16, out, 14 * TILE_HEIGHT_PIXELS);
+        }
+        Window_Remove(&window);
+        Heap_Free(signpostPalette);
+        MessageLoader_Free(loader);
+    }
+
+    if (blocks != NULL) {
+        TownMap_FreeBlocks(blocks);
+    }
+
+    NitroPort_LowerMenuMapEnd();
+    Heap_Free(ctx);
+}
+
+void StartMenu_PortMapStale(void)
+{
+    sPortMapStale = TRUE;
+}
+
 void StartMenu_PortUpdateButtons(FieldSystem *fieldSystem)
 {
     u32 buttons = 0;
+    BOOL hasMap;
 
     if (!NitroPort_LowerMenuOn()) {
         return;
@@ -1956,6 +2219,27 @@ void StartMenu_PortUpdateButtons(FieldSystem *fieldSystem)
 
     sPortFieldButtons = buttons;
     NitroPort_LowerMenuSetEnabled(buttons);
+
+    // The map: told again when the field starts again, the player's square
+    // changes, or the place does (its description may have come with the
+    // first arrival); shown if chosen and the player has the Town Map.
+    hasMap = StartMenu_PortHasTownMap(fieldSystem);
+
+    if (hasMap) {
+        int x, z;
+
+        StartMenu_PortMapSquare(fieldSystem, &x, &z);
+
+        if (sPortMapStale || x != sPortMapX || z != sPortMapZ || (int)fieldSystem->location->mapHeaderID != sPortMapHeader) {
+            StartMenu_PortSendMap(fieldSystem);
+            sPortMapStale = FALSE;
+            sPortMapX = x;
+            sPortMapZ = z;
+            sPortMapHeader = fieldSystem->location->mapHeaderID;
+        }
+    }
+
+    NitroPort_LowerMenuSetPanel(hasMap && sPortPanelChoice == PORT_PANEL_MAP ? PORT_PANEL_MAP : PORT_PANEL_DS);
 }
 
 BOOL StartMenu_PortTapOpens(void)
@@ -1966,11 +2250,24 @@ BOOL StartMenu_PortTapOpens(void)
         return FALSE;
     }
 
+    // The map tapped: the menu opens on the Town Map app.
+    if (button == PORT_PANEL_PRESS) {
+        return NitroPort_LowerMenuPanel() == PORT_PANEL_MAP;
+    }
+
     // A tap on a button that can't be used here (made before the field
-    // said so: during a warp's fade, say) or on POKéTCH (with the menu
-    // closed, the panel's the Pokétch already): nothing.
-    if (button >= PORT_BUTTON_COUNT || button == PORT_BUTTON_POKETCH || !(sPortFieldButtons & (1u << button))) {
+    // said so: during a warp's fade, say): nothing.
+    if (button >= PORT_BUTTON_COUNT || !(sPortFieldButtons & (1u << button))) {
+        NitroPort_LowerMenuTakePress();
+        return FALSE;
+    }
+
+    // POKéTCH, or MAP with the Pokétch shown: the panel shows it, the menu
+    // stays closed. (MAP with the map shown opens the Town Map app.)
+    if (button == PORT_BUTTON_POKETCH || (button == PORT_BUTTON_MAP && NitroPort_LowerMenuPanel() != PORT_PANEL_MAP)) {
         NitroPort_LowerMenuTakePress();
+        sPortPanelChoice = button == PORT_BUTTON_MAP ? PORT_PANEL_MAP : PORT_PANEL_DS;
+        NitroPort_LowerMenuSetPanel(sPortPanelChoice);
         return FALSE;
     }
 
@@ -2061,7 +2358,12 @@ static BOOL StartMenu_PortSelect(FieldTask *fieldTask)
     StartMenu *menu = FieldTask_GetEnv(fieldTask);
     int button = NitroPort_LowerMenuTakePress();
 
-    if (button >= 0 && button < PORT_BUTTON_COUNT && (sPortButtons & (1u << button))) {
+    if (button == PORT_PANEL_PRESS && (sPortButtons & (1u << PORT_BUTTON_MAP)) && NitroPort_LowerMenuPanel() == PORT_PANEL_MAP) {
+        // (the map tapped: the Town Map app, as MAP with the map shown)
+        Sound_PlayEffect(SE_CONFIRM_sseq_3);
+        StartMenu_PortSetCursor(fieldSystem, menu, PORT_BUTTON_MAP);
+        button = PORT_BUTTON_MAP;
+    } else if (button >= 0 && button < PORT_BUTTON_COUNT && (sPortButtons & (1u << button))) {
         Sound_PlayEffect(SE_CONFIRM_sseq_3);
         StartMenu_PortSetCursor(fieldSystem, menu, button);
     } else if (JOY_NEW(PAD_BUTTON_A) && sPortCursor >= 0) {
@@ -2092,12 +2394,24 @@ static BOOL StartMenu_PortSelect(FieldTask *fieldTask)
 
     switch (button) {
     case PORT_BUTTON_MAP:
+        if (NitroPort_LowerMenuPanel() != PORT_PANEL_MAP) {
+            // The map in the panel; the menu goes.
+            sPortPanelChoice = PORT_PANEL_MAP;
+            NitroPort_LowerMenuSetPanel(PORT_PANEL_MAP);
+            menu->state = START_MENU_STATE_END;
+            return TRUE;
+        }
+
+        // The map shown already: the Town Map app.
         FieldMap_FadeScreen(FADE_TYPE_BRIGHTNESS_OUT);
         menu->callback = StartMenu_PortOpenTownMap;
         menu->state = START_MENU_STATE_APP_START;
         return TRUE;
     case PORT_BUTTON_POKETCH:
-        // The menu goes: the Pokétch is in the panel, the player's to use.
+        // The Pokétch in the panel; the menu goes (the Pokétch is the
+        // player's to use).
+        sPortPanelChoice = PORT_PANEL_DS;
+        NitroPort_LowerMenuSetPanel(PORT_PANEL_DS);
         menu->state = START_MENU_STATE_END;
         return TRUE;
     default:
