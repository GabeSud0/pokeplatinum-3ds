+void StartMenu_PortMapStale(void)
+{
+    sPortMapStale = TRUE;
+}
+
+// The panel as the player chose it: the map once they have the Town Map
+// (told again first when the field has started again, the player's square
+// has changed, or the place has: its description may have come with the
+// first arrival), else the Pokétch.
+static void StartMenu_PortShowPanel(FieldSystem *fieldSystem)
+{
+    BOOL showMap = sPortPanelChoice == PORT_PANEL_MAP && StartMenu_PortHasTownMap(fieldSystem);
+
+    if (showMap) {
+        int x, z;
+
+        StartMenu_PortMapSquare(fieldSystem, &x, &z);
+
+        if (sPortMapStale || x != sPortMapX || z != sPortMapZ || (int)fieldSystem->location->mapHeaderID != sPortMapHeader) {
+            // (the field started again: the text printed again too)
+            if (sPortMapStale) {
+                sPortMapNameHeader = -2;
+                sPortMapDescKey = -2;
+            }
+
+            StartMenu_PortSendMap(fieldSystem);
+            sPortMapStale = FALSE;
+            sPortMapX = x;
+            sPortMapZ = z;
+            sPortMapHeader = fieldSystem->location->mapHeaderID;
+        }
+    }
+
+    NitroPort_LowerMenuSetPanel(showMap ? PORT_PANEL_MAP : PORT_PANEL_DS);
+}
+
+// MAP: the map in the panel. FALSE if the port can't show it (it couldn't
+// read the Town Map's pictures): then MAP opens the Town Map app.
+static BOOL StartMenu_PortChooseMap(FieldSystem *fieldSystem)
+{
+    sPortPanelChoice = PORT_PANEL_MAP;
+    StartMenu_PortShowPanel(fieldSystem);
+
+    return NitroPort_LowerMenuPanel() == PORT_PANEL_MAP;
+}
