+extern void NitroPort_LowerMenuMapNoText(int which);
+extern void NitroPort_LowerMenuMapEnd(void);
+
+#define PORT_PANEL_DS 0 // NITRO_LOWERMENU_PANEL_DS
+#define PORT_PANEL_MAP 1 // NITRO_LOWERMENU_PANEL_MAP
+#define PORT_MAP_CURSOR 0 // NITRO_LOWERMAP_CURSOR
