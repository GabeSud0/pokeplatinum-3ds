+
 // The lower menu's buttons, top to bottom (its NITRO_LOWERMENU_...).
 enum PortMenuButton {
     PORT_BUTTON_MAP,
@@ -330,6 +366,9 @@ static u32 sPortButtons; // the buttons it can use (a bit each)
 static u32 sPortOptionCount; // its entries (menu->options)
 static int sPortCursor = -1; // its cursor, a button (kept from one opening to the next)
 static u32 sPortFieldButtons; // the buttons the field said can be used (StartMenu_PortUpdateButtons)
+static int sPortPanelChoice = PORT_PANEL_MAP; // what the panel shows, as the player chose (the map once they have it)
+static BOOL sPortMapStale = TRUE; // the map to be told again (the field started again)
