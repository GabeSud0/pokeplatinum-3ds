+// The panel beside the buttons shows the Town Map (once the player has it),
+// or the Pokétch (the DS's lower screen, running underneath all along):
+// MAP and POKéTCH choose, and a tap on the map (or MAP with the map shown)
+// opens the Town Map app. The port draws the map from the Town Map's own
+// pictures, laid out as the game tells it (nitro_port_lowermenu.h): the
+// Town Map item's upper screen as TownMap_LoadGraphics makes it, and its
+// guide page's description under it.
+extern void NitroPort_LowerMenuSetPanel(int shows);
+extern int NitroPort_LowerMenuPanel(void);
+extern void NitroPort_LowerMenuMapBegin(void);
+extern void NitroPort_LowerMenuMapSprite(int kind, int x, int y, int frame, int palette);
+extern void NitroPort_LowerMenuMapDot(int x, int y);
+extern void NitroPort_LowerMenuMapLayout(int hidden, int zoomX, int zoomY);
+extern u16 *NitroPort_LowerMenuMapText(int which, int x, int y, int w, int h);
+extern void NitroPort_LowerMenuMapEnd(void);
+
+#define PORT_PANEL_DS 0 // NITRO_LOWERMENU_PANEL_DS
+#define PORT_PANEL_MAP 1 // NITRO_LOWERMENU_PANEL_MAP
+#define PORT_MAP_CURSOR 0 // NITRO_LOWERMAP_CURSOR
+#define PORT_MAP_PLAYER 1 // NITRO_LOWERMAP_PLAYER
