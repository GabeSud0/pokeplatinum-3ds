From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Sun, 8 Nov 2026 01:40:00 -0700
Subject: [PATCH] Route 206's corner closed past Route 207 (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

North of Route 207's east map, Route 206's south-east ground is 2 tiles
above the mountain's filler east of it, with no side: from the route a
black notch showed past it. Route 207's east map's own top row (the same
height) is drawn north over the filler between them (sPortMapPieces), to
its cliffs carried north.
---
diff --git a/src/overlay005/land_data.c b/src/overlay005/land_data.c
index 442f1d40..86bfc2f5 100644
--- a/src/overlay005/land_data.c
+++ b/src/overlay005/land_data.c
@@ -6695,7 +6695,11 @@ static void Port_RenderForestOnSouth(const LandDataManager *landDataMan)
 // past the map's south edge with no rim; Oreburgh's west of it has one, a
 // tile further south. Its own rim and the corner below its south cliffs,
 // a tile lower and 6 tiles south (a tile west, its corner by the slope at
-// the cliffs' foot carried south), its ground on to the rim.
+// the cliffs' foot carried south), its ground on to the rim. North of the
+// east map, Route 206's south-east ground is 2 tiles above the mountain's
+// filler east of it, with no side: a black notch past it from the route.
+// The east map's own top row (the same height) drawn north over the filler
+// between them, to the east map's cliffs carried north.
 typedef struct PortMapPiece {
     u8 matrixID;
     u16 mapMatrixIndex;
@@ -6726,6 +6730,9 @@ static const PortMapPiece sPortMapPieces[] = {
     { 0, 670, 4, { 24, 40, 232, 240 }, 1, 0, 1, 1, 0, -24, -8, 48, 2, 0, 16 }, // (the rim, a tile lower, z 739, x 320-323)
     { 0, 670, 4, { 40, 112, 232, 256 }, 6, 0, 1, 1, 0, -8, -8, 48, 1, 0 },    // (x 324-331, its corner and the slope by the cliffs, x 332)
     { 0, 670, 4, { 104, 112, 240, 256 }, 1, 0, 1, 1, 0, -8, -8, 64, 2, 16 },  // (the slope on south, z 742-745)
+    { 0, 670, 3, { 0, 64, 0, 8 }, 1, 0, 1, 1, 0, 0, 0, -88, 11, 8 },         // (its top row north over the filler: x 320-327, z 693-703)
+    { 0, 670, 3, { 64, 128, 0, 8 }, 1, 0, 1, 1, 0, 0, 0, -72, 9, 8 },        // (x 328-335, z 695-703: east of x 330 under its cliffs carried north)
+    { 0, 670, 3, { 192, 208, 0, 16 }, 1, 0, 1, 1, 0, -16, 0, -88, 1, 0 },    // (x 328-329, z 693-694)
 };
 
 #define PORT_PIECE_COPIES 3
