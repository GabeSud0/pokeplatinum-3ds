+
+static void MapProp_PortBuildingShadow(const MapProp *prop, const VecFx32 *position, const MtxFx33 *rotation, const VecFx32 *scale)
+{
+    const NNSG3dResMdlInfo *info = NNS_G3dGetMdlInfo(prop->model);
+    const PortHull *hull;
+    const PortGround *ground;
+    VecFx32 quarter;
+    s32 way[3], y, rim;
+    u32 part;
+
+    if (info->posScale <= 0 || !NitroPort_SunWayNow(way)) {
+        return;
+    }
+
+    hull = MapProp_PortHull(prop->model, way);
+
+    if (hull->parts == 0) {
+        return;
+    }
+
+    y = (s32)(FX_Div(FX32_ONE, info->posScale) / 4);
+    rim = (s32)(FX_Div(6 * FX32_ONE, info->posScale) / 4);
+    ground = MapProp_PortGroundOf(hull, info, position, scale, y);
+    quarter.x = quarter.y = quarter.z = info->posScale * 4;
+
+    NNS_G3dGlbSetBaseTrans(position);
+    NNS_G3dGlbSetBaseRot(rotation);
+    NNS_G3dGlbSetBaseScale(scale);
+    NNS_G3dGlbFlush();
+    NNS_G3dGePushMtx();
+    NNS_G3dGeScaleVec(&quarter);
+    NNS_G3dGeTexImageParam(GX_TEXFMT_NONE, GX_TEXGEN_NONE, GX_TEXSIZE_S8, GX_TEXSIZE_T8, GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_USE, 0);
+    NNS_G3dGePolygonAttr(GX_LIGHTMASK_NONE, GX_POLYGONMODE_MODULATE, GX_CULL_NONE, 0, 31, 0);
+
+    for (part = 0; part < hull->parts; part++) {
+        MapProp_PortHullShadow(hull->corners[part], hull->count[part], y, rim);
+
+        if (ground->top[part] != 0) {
+            MapProp_PortHullShadow(hull->corners[part], hull->count[part], ground->top[part], rim);
+        }
+    }
+
     NNS_G3dGePopMtx(1);
     NNS_G3dGeFlushBuffer();
     NitroPort_Gx3dTag(0);
