             NitroPort_Log("[follower] in its ball (%s)", why);
+            sCarry = FALSE;
 
             if (sOut < 0 || MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_HIDE)) {
                 PortFollower_Remove(fieldSystem, mapObj); // (never seen: its ball, if it was there, goes)
@@ -1090,6 +1101,27 @@ void PortFollower_Update(FieldSystem *fieldSystem)
                 PortFollower_ShowBall(fieldSystem, mapObj, sIn + BALL_AFTER + BALL_POP, TRUE); // (open as it goes in)
                 PortFollower_Sound(SEQ_SE_DP_SLOT02_sseq_1); // (SEQ_SE_DP_SUIKOMU: the battle's recall)
             }
+        } else if (sOut == -4 || sOut == -5) {
+            // Coming out without its ball: through a door or up the stairs
+            // with the player (-4: at its size), or as they set off walking
+            // (-5: growing to it). On the player's tile (a door's, the
+            // stairs'), hidden till they've stepped off it: shown once they
+            // stand or it sets off after them (not in them as they go).
+            BOOL onTile = dx == 0 && dz == 0;
+            BOOL playerGoing = PortFollower_PlayerStepping(fieldSystem) || MapObject_IsMoving(player);
+
+            if ((!sWaitsOff || (!onTile && (!playerGoing || MapObject_IsMoving(mapObj))))
+                && PortFollower_SetScale(mapObj, sOut == -4 ? POP_FRAMES : 0)) {
+                MapObject_SetHidden(mapObj, FALSE);
+
