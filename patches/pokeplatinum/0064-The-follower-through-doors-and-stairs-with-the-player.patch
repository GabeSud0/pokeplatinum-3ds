+                    PortFollower_Sound(SEQ_SE_DP_SLOT01_sseq_1); // (SEQ_SE_DP_BOWA2: the battle's send-out)
+                }
+            }
         } else if (sOut == -3) {
             // Coming out: its ball there, then open.
             if (sOpenIn > 0) {
@@ -1126,6 +1158,12 @@ void PortFollower_Update(FieldSystem *fieldSystem)
             sub_02062A0C(mapObj, 1);
         }
 
+        // (out as the player goes through a door: it goes with them; out on
+        // the other side: with them as before)
+        if (mapObj != NULL && sIn == 0 && sOut == POP_FRAMES) {
+            sCarry = inWarp;
+        }
+
         // (no shadow under it while it's smaller than itself)
         if (mapObj != NULL && (sIn > 0 || sOut < POP_FRAMES)) {
             PortFollower_HideShadow(mapObj);
@@ -1137,11 +1175,21 @@ void PortFollower_Update(FieldSystem *fieldSystem)
     sPlayerX = x;
     sPlayerZ = z;
 
-    // Out (not during a script's or a menu's task: when it ends).
-    if (mapObj == NULL && graphicsID != 0 && !scripted && !PortFollower_PlayerStepping(fieldSystem)) {
-        if (sWait > 0) {
-            sWait--;
-        } else if (MapObjectMan_PortFreeSlots(fieldSystem->mapObjMan) > 1
+    if (mapObj == NULL && graphicsID == 0 && !inWarp) {
+        sCarry = FALSE; // (not to be out where the player went)
+    }
+
+    // Out (not during a script's or a menu's task: when it ends). Through a
+    // warp with the player: at once on the other side, without its ball.
+    // The player setting off walking (out of its ball a moment ago, not
+    // stopping): behind them, growing out of nothing; standing, out of its
+    // ball (which would be left behind by someone walking on).
+    if (mapObj == NULL && sWait > 0 && !sCarry) {
+        sWait--;
+    } else if (mapObj == NULL && graphicsID != 0 && (sCarry || (!scripted && !PortFollower_PlayerJumping(fieldSystem, player)))) {
+        BOOL walking = !sCarry && PortFollower_PlayerStepping(fieldSystem);
+
+        if (MapObjectMan_PortFreeSlots(fieldSystem->mapObjMan) > 1
             && (!PortFollower_IsGfx(graphicsID) || Bundle_Ready()) && MapObjectGfx_PortHasRoom(fieldSystem->mapObjMan, graphicsID)) {
             BOOL onPlayer;
 
@@ -1155,10 +1203,13 @@ void PortFollower_Update(FieldSystem *fieldSystem)
             if (mapObj != NULL) {
                 MapObject_SetHidden(mapObj, TRUE); // (shown as it comes out of its ball)
                 PortFollower_SetScale(mapObj, 0);  // (its picture made with it, before it was the follower)
-                sOut = onPlayer ? -2 : -1;
+                sOut = sCarry ? -4 : walking ? -5 : onPlayer ? -2 : -1;
+                sWaitsOff = onPlayer;
                 sIn = 0;
             }
 
+            sCarry = FALSE;
+
             sNoRoom = 0;
         } else {
             sWait = 4;
diff --git a/src/unk_02056B30.c b/src/unk_02056B30.c
index 83db0919..a232c6e3 100644
--- a/src/unk_02056B30.c
+++ b/src/unk_02056B30.c
@@ -116,6 +116,24 @@ void sub_02056B30(FieldTask *taskMan, int param1, int param2, int param3, u16 pa
     FieldTask_InitCall(taskMan, sub_02056B70, v0);
 }
 
+#ifdef SDK_PORT_3DS
+// (the port's follower, port_follower.c) Whether the field is in a warp's
+// way in or out: a door, stairs, a cave's or a forest's entrance (the task
+// sub_02056BDC and sub_02056C18 start), before or after the map changes.
+BOOL FieldSystem_PortInWarp(FieldSystem *fieldSystem)
+{
+    FieldTask *task;
+
+    for (task = fieldSystem->task; task != NULL; task = task->prev) {
+        if (task->func == sub_02056CFC) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+#endif
+
 static BOOL sub_02056B70(FieldTask *taskMan)
 {
     FieldSystem *fieldSystem = FieldTask_GetFieldSystem(taskMan);
