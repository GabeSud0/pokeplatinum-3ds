+extern BOOL gStartMenuPortMenu;       // (start_menu.c)
+extern BOOL gStartMenuPortInstantApp; // (start_menu.c)
+extern int gStartMenuPortAppPress;    // (start_menu.c)
+
+// The field's bag, the lower start menu's (gStartMenuPortMenu): one of the
+// menu's buttons tapped while the item list waits closes the bag, and the
+// start menu does what the button says.
+static BOOL sBagPortMenu;
+
+// Opened from the lower menu, the bag comes like a window brought back:
+// no fade in (both screens kept as they were till it's whole: shown two
+// frames on), none out when it's closed (B, CLOSE BAG, or one of the
+// menu's buttons tapped).
+static BOOL sBagPortInstant;
+static BOOL sBagPortClosedInstantly;
+static int sBagPortReveal;
+
+#define BAG_PORT_MENU_BUTTONS 8 // NITRO_LOWERMENU_ITEM1: the menu's buttons before it
+
+// One of the menu's buttons tapped (-1: none).
+static int BagPort_MenuPress(void)
+{
+    int press = NitroPort_LowerMenuPressPending();
+
+    return press >= 0 && press < BAG_PORT_MENU_BUTTONS ? press : -1;
+}
+#define PORT_PANEL_DS 0 // NITRO_LOWERMENU_PANEL_DS
+
+// The bag in the lower menu's panel, as its approved tall mock-up has it
+// (2026-10-24): its main screen (the list, the pockets, the description)
+// on the lower screen, 248 lines tall; its touch screen not shown (nor
+// touched: the panel's touches are nobody's); the upper screen keeps the
+// field. In tiles: the list's box 7 rows longer (row 14 again, as on the
+// DS between its top and bottom borders), its bottom border and the
+// description bar below it 7 rows lower; the pockets' panel 7 rows lower;
+// above it, the bag 1.25 times as big in the space left, its shadow
+// under it (BagPortTall_LayOutTilemap); the list 12 lines long.
+static void BagPortTall_LayOutTilemap(BgConfig *bgConfig, enum BgLayer layer)
+{
+    u16 *map = Bg_GetTilemapBuffer(bgConfig, layer);
+    u16 dsRows[32 * 24];
+
+    memcpy(dsRows, map, sizeof(dsRows));
+
+    for (int row = 0; row < 31; row++) {
+        for (int col = 0; col < 32; col++) {
+            int from;
+
+            if (col >= 13) {
+                // the list's side: the box's middle row again
+                from = row <= 14 ? row : row < 22 ? 14 : row - 7;
+            } else if (col == 12) {
+                // where the pockets' panel meets the list's frame: the
+                // frame's plain edge (row 7) again
+                from = row <= 9 ? row : row < 17 ? 7 : row - 7;
+            } else if (row <= 4) {
+                from = row; // the BAG label
+            } else if (row == 12 || row == 13) {
+                // the bag's shadow (rows 8 and 9, columns 3-9) under the
+                // bigger bag, its middle (column 6) two tiles longer
+                from = row - 4;
+                map[row * 32 + col] = dsRows[from * 32 + (col <= 1 || col >= 11 ? col : col <= 4 ? col + 1 : col <= 7 ? 6 : col - 1)];
+                continue;
+            } else if (row < 17) {
+                from = 7; // the stripes (row 7: all its tiles the stripes)
+            } else {
+                from = row - 7; // the pockets' panel, the description bar
+            }
+
+            map[row * 32 + col] = dsRows[from * 32 + col];
+        }
+    }
+
+    Bg_CopyTilemapBufferToVRAM(bgConfig, layer);
+}
 
