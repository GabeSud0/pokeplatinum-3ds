+        *state != BAG_APP_STATE_SWITCH_POCKET && *state != BAG_APP_STATE_EXIT && NitroPort_LowerMenuPressPending() >= 0) {
+        NitroPort_LowerMenuTakePress();
+    }
+#endif
+
     switch (*state) {
     case BAG_APP_STATE_WAIT_INITIAL_SCREEN_FADE:
         if (IsScreenFadeDone() == TRUE) {
@@ -664,7 +807,9 @@ int BagApplication_Exit(ApplicationManager *appMan, int *state)
     BagController *controller = ApplicationManager_Data(appMan);
 
 #ifdef SDK_PORT_3DS
-    WIDE_LAYOUT_NONE(WIDE_ENGINE_MAIN);
