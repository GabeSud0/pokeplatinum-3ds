     FreeItemListMenu(controller);
@@ -692,6 +783,20 @@ int BagApplication_Exit(ApplicationManager *appMan, int *state)
     Heap_Destroy(HEAP_ID_BAG);
     SetAutorepeat(4, 8);
 
+#ifdef SDK_PORT_3DS
+    // Out of the lower menu's panel: the screens as they were (the menu
+    // off till the field has it again; the upper screen the game's once
+    // it's as bright as what was kept).
+    if (gBagPortTall) {
+        SpriteUtil_PortTallMainScreen(FALSE);
+        NitroPort_Render2DSmoothObjs(0, FALSE);
+        GXLayers_SwapDisplay();
+        NitroPort_LowerMenuShow(FALSE);
+        NitroPort_LowerMenuHoldUpper(FALSE);
+        gBagPortTall = FALSE;
+    }
+#endif
+
     return TRUE;
 }
 
