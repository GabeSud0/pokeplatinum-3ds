+// The 3DS remaster's lower menu (3ds_port/nitro/include/
+// nitro_port_lowermenu.h; the game has no port headers: plain calls).
+extern int NitroPort_LowerMenuAvailable(void);
+extern void NitroPort_LowerMenuShow(int on);
+extern void NitroPort_LowerMenuSetTall(int tall);
+extern void NitroPort_LowerMenuSetPanel(int shows);
+extern void NitroPort_LowerMenuSetPanelTouch(int on);
+extern void NitroPort_LowerMenuHoldUpper(int hold);
+extern void NitroPort_LowerMenuHoldLower(int hold);
+extern int NitroPort_LowerMenuPressPending(void);
+extern int NitroPort_LowerMenuTakePress(void);
