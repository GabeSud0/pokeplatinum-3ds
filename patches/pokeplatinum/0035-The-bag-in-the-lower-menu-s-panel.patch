 static void FreeBGLayers(BgConfig *bgConfig)
@@ -1121,11 +1239,23 @@ static void RestrictItemListCursor(u16 *cursorScroll, u16 *cursorPos, u8 numEntr
         numShownEntries = numEntries - 1;
     }
 
+#ifdef SDK_PORT_3DS
+    // (down to the row the list menu scrolls from: half its rows, rounded
+    // up (list_menu.c), as with the DS's 9; with the bag tall's 12 too)
+    u8 scrollRow = (numVisibleSlots >> 1) + (numVisibleSlots & 1);
+
+    if (!(*cursorPos >= scrollRow + 1)) {
+        return;
+    }
+
+    for (u8 i = 0; i <= *cursorPos - scrollRow - 1; i++) {
+#else
     if (!(*cursorPos >= (numVisibleSlots >> 1) + 2)) {
         return;
     }
 
     for (u8 i = 0; i <= *cursorPos - (numVisibleSlots >> 1) - 2; i++) {
+#endif
         if (*cursorScroll + numShownEntries == numEntries - 1) {
             break;
         }
@@ -1141,6 +1271,9 @@ static void CreateItemListMenu(BagController *controller, u16 initialScroll, u16
     template.window = &controller->windows[BAG_UI_WINDOW_ITEM_LIST];
     template.count = controller->bagCtx->accessiblePockets[controller->bagCtx->currPocketIdx].listEntryCount;
     template.parent = (void *)controller;
+#ifdef SDK_PORT_3DS
