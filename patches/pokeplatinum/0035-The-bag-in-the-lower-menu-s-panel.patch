+        // upper screen the game's once it's as bright as what was kept)
+        if (!sBagPortClosedInstantly) {
+            NitroPort_LowerMenuHoldLower(FALSE);
+            NitroPort_LowerMenuHoldUpper(FALSE);
+        }
+
+        gBagPortTall = FALSE;
+        sBagPortMenu = FALSE;
+        sBagPortInstant = FALSE;
+    }
+#endif
+
     return TRUE;
 }
 
