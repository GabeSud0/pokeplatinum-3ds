+#else
         Bg_LoadToTilemapRect(controller->bgConfig, BG_LAYER_MAIN_1, sHiddenItemSpriteBoxTiles, 0, 18, 5, 5);
+#endif
         ManagedSprite_SetDrawFlag(controller->sprites[BAG_SPRITE_ITEM], FALSE);
     }
 
