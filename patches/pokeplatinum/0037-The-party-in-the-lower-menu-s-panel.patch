+    sPartyPortBlack = FALSE;
+    NitroPort_LowerMenuKeepShown(TRUE);
+    NitroPort_LowerMenuFadePanel(TRUE);
+
+    if (application->partyMenu->menuSelectionResult == PARTY_MENU_EXIT_CODE_DONE) {
+        StartMenu_PortAppLeaving(gStartMenuPortAppPress);
+    } else {
+        gStartMenuPortAppPress = -1;
+    }
+}
 
