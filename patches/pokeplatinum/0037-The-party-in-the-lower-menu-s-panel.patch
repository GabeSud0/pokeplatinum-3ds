+        int dy = PARTY_PORT_TALL_SLOT_DY(slot);
+
+        sPartyPortTallPanels[slot] = templates[slot];
+        sPartyPortTallPanels[slot].panelY += dy / 8;
+        sPartyPortTallPanels[slot].speciesIconY += dy;
+        sPartyPortTallPanels[slot].ballSpriteY += dy;
+    }
+
+    return sPartyPortTallPanels;
+}
+
+static const GridMenuCursorPosition *PartyPortTall_Cursor(const GridMenuCursorPosition *table)
+{
+    for (int pos = 0; pos <= POS_CANCEL; pos++) {
+        sPartyPortTallCursor[pos] = table[pos];
+
+        if (pos < MAX_PARTY_SIZE) {
+            sPartyPortTallCursor[pos].yCoord1 += PARTY_PORT_TALL_SLOT_DY(pos);
+        } else if (table[pos].yCoord1 != 0) {
+            sPartyPortTallCursor[pos].yCoord1 += PARTY_PORT_TALL_BOTTOM_DY;
+        }
+    }
+
+    return sPartyPortTallCursor;
+}
+
+// BG3, the background, drawn anew in BG3's colours (palette 1) as the
+// mock-up was made from the DS's: the plain border, the stripes (from 7, 7:
+// the DS's start at 16 on the left), the panels' rows of the DS's
+// background each moved with its row, their teal bands between the columns
+// run on from one panel to the next along the DS's diagonal, the dashed
+// line beside each right panel, the message's rows 56 lower. Its tiles
+// after the party's own (the same ones and new ones), BG2's panels' top
+// edges without the edge (PartyPortTall_FixEdges) after them.
+enum {
+    PARTY_PORT_EDGE = 1,
+    PARTY_PORT_PLAIN = 2,
+    PARTY_PORT_LIGHT = 4,
+    PARTY_PORT_DARK = 5,
+    PARTY_PORT_TEAL_DARK = 9,
+    PARTY_PORT_TEAL = 10,
+};
+#define PARTY_PORT_TALL_LINES 248 // (31 tile rows)
+#define PARTY_PORT_BG3_PALETTE 1
+#define PARTY_PORT_MAX_NEW_TILES 256 // (about 50 used)
+
+static u8 sPartyPortPixels[PARTY_PORT_TALL_LINES][256];
+static u8 sPartyPortNewTiles[PARTY_PORT_MAX_NEW_TILES * TILE_SIZE_4BPP];
+static u16 sPartyPortEdgeOrig[2][MEMBER_PANEL_WIDTH]; // a back panel's and an empty one's top row's tiles
+static u16 sPartyPortEdgeless[2][MEMBER_PANEL_WIDTH]; // the same without the edge (the same tile if none)
+
+static u8 PartyPortTall_Pixel(const u16 *map, const u8 *chars, int x, int y)
+{
+    u16 entry = map[(y >> 3) * 32 + (x >> 3)];
+    int px = (entry & 0x400) ? 7 - (x & 7) : (x & 7);
+    int py = (entry & 0x800) ? 7 - (y & 7) : (y & 7);
+    u8 pair = chars[(entry & 0x3FF) * TILE_SIZE_4BPP + py * 4 + (px >> 1)];
+
+    return (px & 1) ? (pair >> 4) : (pair & 15);
+}
+
+static u8 PartyPortTall_Stripe(int y)
+{
+    return (y & 1) ? PARTY_PORT_LIGHT : PARTY_PORT_DARK;
+}
+
+static u8 PartyPortTall_Band(int y)
+{
+    return (y & 1) ? PARTY_PORT_TEAL : PARTY_PORT_TEAL_DARK;
+}
+
+static BOOL PartyPortTall_IsStripe(u8 c)
+{
+    return c == PARTY_PORT_DARK || c == PARTY_PORT_LIGHT;
+}
+
+// A tile among the new ones (added if it's not there yet): its index. (Each
+// one's hash first: the party opens no slower on an Old 3DS.)
+static int PartyPortTall_AddTile(const u8 *tile, int *count, int first)
+{
+    static u32 hashes[PARTY_PORT_MAX_NEW_TILES];
+    u32 hash = 2166136261u;
+
+    for (int i = 0; i < TILE_SIZE_4BPP; i++) {
+        hash = (hash ^ tile[i]) * 16777619u;
+    }
+
+    for (int i = 0; i < *count; i++) {
+        if (hashes[i] == hash && memcmp(&sPartyPortNewTiles[i * TILE_SIZE_4BPP], tile, TILE_SIZE_4BPP) == 0) {
+            return first + i;
+        }
+    }
+
+    GF_ASSERT(*count < PARTY_PORT_MAX_NEW_TILES);
+    if (*count >= PARTY_PORT_MAX_NEW_TILES) {
+        return first; // (never: a tile of the party's own, rather than past the buffer)
+    }
+
+    hashes[*count] = hash;
+    memcpy(&sPartyPortNewTiles[*count * TILE_SIZE_4BPP], tile, TILE_SIZE_4BPP);
+    return first + (*count)++;
+}
+
+static void PartyPortTall_LayOutBackground(PartyMenuApplication *application, NARC *narc)
+{
+    static const u8 left[3][2] = { { 0, 48 }, { 51, 95 }, { 100, 143 } };   // x 0-125 (the first takes in the cursor's frame)
+    static const u8 rail[3][2] = { { 7, 48 }, { 49, 96 }, { 97, 153 } };    // x 126-128: the dashes, each right panel's arrow's tip
+    static const u8 right[3][2] = { { 7, 55 }, { 56, 103 }, { 104, 153 } }; // x 129-255
+    static const u8 dashes[3][3] = { { 128, 43, 60 }, { 127, 103, 122 }, { 127, 168, 189 } }; // (from x, to 128)
+    static const u8 tips[6][2] = { { 127, 94 }, { 128, 94 }, { 127, 95 }, { 127, 158 }, { 128, 158 }, { 127, 159 } };
+    void *ncgr = NARC_AllocAndReadWholeMember(narc, menu_tiles_NCGR, HEAP_ID_PARTY_MENU);
+    NNSG2dCharacterData *charData;
+    u16 *map = Bg_GetTilemapBuffer(application->bgConfig, BG_LAYER_MAIN_3);
+    u16 dsMap[32 * 24];
+    int x, y, k, count = 0, first;
+    u8 tile[TILE_SIZE_4BPP];
+
+    NNS_G2dGetUnpackedCharacterData(ncgr, &charData);
+    const u8 *chars = charData->pRawData;
+    first = (int)(charData->szByte / TILE_SIZE_4BPP);
+    memcpy(dsMap, map, sizeof(dsMap));
+
+    for (y = 0; y < PARTY_PORT_TALL_LINES; y++) {
+        for (x = 0; x < 256; x++) {
+            sPartyPortPixels[y][x] = (y >= 7 && x >= 7) ? PartyPortTall_Stripe(y) : PARTY_PORT_PLAIN;
+        }
+    }
+
+    // the panels' rows, each moved with its row
+    for (k = 0; k < 3; k++) {
+        int dy = 16 * (k + 1);
+
+        for (y = left[k][0]; y <= left[k][1]; y++) {
+            for (x = 0; x < 126; x++) {
+                sPartyPortPixels[y + dy][x] = PartyPortTall_Pixel(dsMap, chars, x, y);
+            }
+        }
+
+        for (y = right[k][0]; y <= right[k][1]; y++) {
+            for (x = 129; x < 256; x++) {
+                sPartyPortPixels[y + dy][x] = PartyPortTall_Pixel(dsMap, chars, x, y);
+            }
+        }
+
+        for (y = rail[k][0]; y <= rail[k][1]; y++) {
+            for (x = 126; x < 129; x++) {
+                sPartyPortPixels[y + dy][x] = PartyPortTall_Pixel(dsMap, chars, x, y);
+            }
+        }
+    }
+
+    // each right panel's arrow's narrow stem (joining it to the panel above
+    // on the DS) goes: the band below takes that over
+    for (k = 1; k < 3; k++) {
+        for (int y0 = 49 + 48 * (k - 1); y0 < 56 + 48 * (k - 1); y0++) {
+            for (x = 126; x <= 129; x++) {
+                if ((x == 129 && y0 != 55 + 48 * (k - 1)) || (x == 126 && y0 > 52 + 48 * (k - 1))) {
+                    continue;
+                }
+
+                y = y0 + (x < 129 ? 16 * (k + 1) : 16 * k);
+                sPartyPortPixels[y][x] = PartyPortTall_Stripe(y);
+            }
+        }
+    }
+
+    // the second left panel without its top edge (BG2's: the stripes behind
+    // it), whether it's a Pokémon's or empty
+    for (x = 21; x < 126; x++) {
+        if (PartyPortTall_Pixel(application->backMemberPanel, chars, x, 4) == PARTY_PORT_EDGE ||
+            PartyPortTall_Pixel(application->noneMemberPanel, chars, x, 4) == PARTY_PORT_EDGE) {
+            sPartyPortPixels[52 + 32][x] = PartyPortTall_Stripe(52 + 32);
+        }
+    }
+
+    // the teal band between the panels, 20 wide: from under the right panel
+    // above down to the left panel's top edge (that row too), both its
+    // edges on the DS's wedge's diagonal
+    for (k = 1; k < 3; k++) {
+        int top = 56 + 48 * (k - 1) + 16 * (k + 1);
+        int firstRow = right[k - 1][1] + 16 * k + 2;
+        int boxTop = 52 + 48 * (k - 1) + 16 * (k + 1);
+
+        for (y = firstRow; y < top; y++) {
+            int x1 = 134 + (top - y), x0 = x1 - 19;
+
+            for (x = x0 > 16 ? x0 : 16; x <= (x1 < 254 ? x1 : 254); x++) {
+                if (x <= 126 && y > boxTop) {
+                    continue;
+                }
+
+                if (PartyPortTall_IsStripe(sPartyPortPixels[y][x])) {
+                    sPartyPortPixels[y][x] = PartyPortTall_Band(y);
+                }
+            }
+        }
+    }
+
+    // the dashed line between the columns beside each right panel
+    for (k = 0; k < 3; k++) {
+        for (y = dashes[k][1]; y <= dashes[k][2]; y++) {
+            for (x = dashes[k][0]; x <= 128; x++) {
+                if (PartyPortTall_IsStripe(sPartyPortPixels[y][x])) {
+                    sPartyPortPixels[y][x] = PartyPortTall_Band(y);
+                }
+            }
+        }
+    }
+
+    // each band's top-left corner on a clean diagonal (its first three rows
+    // from x 129, 128, 127), its tip a row of 3
+    for (k = 1; k < 3; k++) {
+        int topRow = right[k - 1][1] + 16 * k + 2;
+
+        for (int i = 0; i < 3; i++) {
+            y = topRow + i;
+
+            for (x = 127; x < 131; x++) {
+                u8 *c = &sPartyPortPixels[y][x];
+
+                if (x >= 129 - i && PartyPortTall_IsStripe(*c)) {
+                    *c = PartyPortTall_Band(y);
+                } else if (x < 129 - i && (*c == PARTY_PORT_TEAL || *c == PARTY_PORT_TEAL_DARK)) {
+                    *c = PartyPortTall_Stripe(y);
+                }
+            }
+        }
+    }
+
+    for (k = 0; k < (int)NELEMS(tips); k++) {
+        sPartyPortPixels[tips[k][1]][tips[k][0]] = PartyPortTall_Stripe(tips[k][1]);
+    }
+
+    // the stripes right up to the left panels, the Poké Balls and the empty
+    // slots' outlines (the DS leaves bits plain beside them)
+    for (y = 7; y < 218; y++) {
+        for (x = 7; x < 126; x++) {
+            if (sPartyPortPixels[y][x] == PARTY_PORT_PLAIN) {
+                sPartyPortPixels[y][x] = PartyPortTall_Stripe(y);
+            }
+        }
+    }
+
+    // the message's rows and CANCEL's, the bottom border with them
+    for (y = 162; y + 56 < PARTY_PORT_TALL_LINES; y++) {
+        for (x = 0; x < 256; x++) {
+            sPartyPortPixels[y + 56][x] = PartyPortTall_Pixel(dsMap, chars, x, y);
+        }
+    }
+
+    // its tiles
+    for (int ty = 0; ty < PARTY_PORT_TALL_LINES / 8; ty++) {
+        for (int tx = 0; tx < 32; tx++) {
+            for (int py = 0; py < 8; py++) {
+                for (int px = 0; px < 8; px += 2) {
+                    tile[py * 4 + px / 2] = (u8)(sPartyPortPixels[ty * 8 + py][tx * 8 + px] | (sPartyPortPixels[ty * 8 + py][tx * 8 + px + 1] << 4));
+                }
+            }
+
+            map[ty * 32 + tx] = (u16)((PARTY_PORT_BG3_PALETTE << 12) | PartyPortTall_AddTile(tile, &count, first));
+        }
+    }
+
+    // a back panel's top row and an empty one's without the edge from x 21
+    // (pixel row 4), for the second left panel (PartyPortTall_FixEdges)
+    for (k = 0; k < 2; k++) {
+        const u16 *panel = k == 0 ? application->backMemberPanel : application->noneMemberPanel;
+
+        for (x = 0; x < MEMBER_PANEL_WIDTH; x++) {
+            u16 entry = panel[x];
+            int t = entry & 0x3FF, sy = (entry & 0x800) ? 3 : 4;
+            BOOL changed = FALSE;
+
+            memcpy(tile, &chars[t * TILE_SIZE_4BPP], TILE_SIZE_4BPP);
+
+            for (int px = 0; px < 8; px++) {
+                int sx = (entry & 0x400) ? 7 - px : px;
+                u8 *pair = &tile[sy * 4 + sx / 2];
+                u8 c = (sx & 1) ? (*pair >> 4) : (*pair & 15);
+
+                if (x * 8 + px >= 21 && c == PARTY_PORT_EDGE) {
+                    *pair &= (sx & 1) ? 0x0F : 0xF0;
+                    changed = TRUE;
+                }
+            }
+
+            sPartyPortEdgeOrig[k][x] = (u16)t;
+            sPartyPortEdgeless[k][x] = changed ? (u16)PartyPortTall_AddTile(tile, &count, first) : (u16)t;
+        }
+    }
+
+    GF_ASSERT(first + count <= 1024);
+    Bg_LoadTiles(application->bgConfig, BG_LAYER_MAIN_3, sPartyPortNewTiles, (u32)count * TILE_SIZE_4BPP, (u32)first);
+    Bg_CopyTilemapBufferToVRAM(application->bgConfig, BG_LAYER_MAIN_3);
+    Heap_FreeExplicit(HEAP_ID_PARTY_MENU, ncgr);
+}
+
+// The panels' top edges as the tall layout has them: the second left
+// panel's (its top row, BG2's row 10: a Pokémon's or empty) without the
+// edge; every other's as the game drew it (an edgeless tile scrolled away
+// by a switch, the original again).
+void PartyPortTall_FixEdges(PartyMenuApplication *application)
+{
+    u16 *map;
+
+    if (!gPartyPortTall) {
+        return;
+    }
+
+    map = Bg_GetTilemapBuffer(application->bgConfig, BG_LAYER_MAIN_2);
+
+    for (int i = 0; i < 32 * (PARTY_PORT_TALL_LINES / 8); i++) {
+        int t = map[i] & 0x3FF;
+
+        for (int k = 0; k < 2 * MEMBER_PANEL_WIDTH; k++) {
+            int edgeless = sPartyPortEdgeless[k / MEMBER_PANEL_WIDTH][k % MEMBER_PANEL_WIDTH];
+            int orig = sPartyPortEdgeOrig[k / MEMBER_PANEL_WIDTH][k % MEMBER_PANEL_WIDTH];
+
+            if (t == edgeless && t != orig) {
+                map[i] = (u16)((map[i] & 0xFC00) | orig);
+                break;
+            }
+        }
+    }
+
+    for (int c = 0; c < MEMBER_PANEL_WIDTH; c++) {
+        u16 *entry = &map[(6 + 4) * 32 + c];
+
+        for (int k = 0; k < 2; k++) {
+            if ((*entry & 0x3FF) == sPartyPortEdgeOrig[k][c]) {
+                *entry = (u16)((*entry & 0xFC00) | sPartyPortEdgeless[k][c]);
+                break;
+            }
+        }
+    }
+}
+#endif
