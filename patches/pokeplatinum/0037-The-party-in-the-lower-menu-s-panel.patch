+    case PARTY_MENU_EXIT_CODE_OVERWRITE_MOVE_LEVEL_UP:
+    case PARTY_MENU_EXIT_CODE_GIVE_ITEM:
+    case PARTY_MENU_EXIT_CODE_RETURN_TO_BAG:
