+// A map's own edge drawn on past its border instead of what's beyond it
+// (a scenery map, or nothing past a matrix's edge), straight, as far as
+// the wider view sees: each polygon that reaches the border (a cliff's
+// face, the ground by it, a row of trees drawn as one long quad) again and
+// again, moved on by its own width each time; its trees in the last two
+// columns (or rows), whole, every 2 tiles (a tree is 4 quads of 1 3/8 to
+// 2 1/2 tiles over one place). Past the side (dirX: -1 left, 1 right),
+// past the top or bottom (dirZ: -1, 1), or past both into the corner (what
+// reaches both borders, on in both ways). Mirrored instead (as before),
+// the map's own houses, ponds and paths showed again backwards past it.
+//
+// One copy of the map's model for each: its lists with only those
+// polygons, each again at every place it's drawn on at (an MTX_TRANS
+// between), the copy drawn once. Made a few shapes a scene, ahead: for the
+// loaded maps by an edge while the player's still in their far half (by
+// the time the edge comes into the view, it's made); made at once if it's
+// needed before that (just come in).
+#define PORT_EXTRUDE_REACH_X       13   // (tiles past the border the copies reach: the wider view sees 12 and a half)
+#define PORT_EXTRUDE_REACH_Z       9    // (up the screen and down it: 7 and a half, the pixel field 9)
+#define PORT_EXTRUDE_TREE_PITCH    2
+#define PORT_EXTRUDE_COPIES        12   // (four maps by a corner: a side, the top or bottom, the corner, each)
+#define PORT_EXTRUDE_GROUPS        1024 // (a shape's polygons looked at, at most)
+#define PORT_EXTRUDE_SHAPES_AHEAD  2    // (shapes worked through a scene, ahead of need)
+#define PORT_EXTRUDE_FACES         32
+#define PORT_EXTRUDE_FLATS         64
+#define PORT_EXTRUDE_FILLS         8
+
+enum {
+    PORT_EXTRUDE_FREE,
+    PORT_EXTRUDE_MAKING,
+    PORT_EXTRUDE_MADE,
+    PORT_EXTRUDE_FAILED,
+};
+
+typedef struct PortExtrudeSpan {
+    s16 lo, hi; // (along the border, sixteenths of a tile from the map's middle)
+    s16 y;      // (a face's top; a flat's height)
+    u8 shape;
+    u16 group;
+} PortExtrudeSpan;
+
+// A shape's list being made, and where it's moved to by then (the model's
+// coordinates).
+typedef struct PortExtrudeList {
+    u8 *bytes;
+    u32 size, room;
+    s32 x, z;
+} PortExtrudeList;
+
+typedef struct PortExtrudeCopy {
+    int mapMatrixIndex, matrixID, landDataID;
+    s8 dirX, dirZ;
+    s8 band;            // (0 all; 1 only the polygons in its forest band, PortExtrudeForest; -1 not those north of it)
+    u8 state;
+    u32 wanted;         // (the last scene it was asked for, or looked ahead to)
+    s8 bandLo, bandHi;  // (the band's rows; drawn again bandCopies times north, every their depth)
+    u8 bandCopies;
+    int numShp, nextShape;
+    s32 tile;           // (a tile in the model's coordinates)
+    PortExtrudeList *lists;
+    PortExtrudeSpan *faces, *flats;
+    int numFaces, numFlats;
+    u8 *block;          // (the model file copied, the lists after it)
+    NNSG3dResMdl *model;
+} PortExtrudeCopy;
+
+static PortExtrudeCopy sPortExtrudeCopies[PORT_EXTRUDE_COPIES];
+static u32 sPortExtrudeScene = 1;
+
+static void Port_FreeExtrudeLists(PortExtrudeCopy *copy)
+{
+    if (copy->lists != NULL) {
+        for (int i = 0; i < copy->numShp; i++) {
+            free(copy->lists[i].bytes);
+        }
+    }
+
+    free(copy->lists);
+    free(copy->faces);
+    copy->lists = NULL;
+    copy->faces = copy->flats = NULL;
+}
+
+static void Port_FreeExtrudeCopy(PortExtrudeCopy *copy)
+{
+    Port_FreeExtrudeLists(copy);
+    free(copy->block);
+    memset(copy, 0, sizeof(*copy));
+}
+
+static void Port_FreeExtrudeCopies(void)
+{
+    for (int i = 0; i < PORT_EXTRUDE_COPIES; i++) {
+        Port_FreeExtrudeCopy(&sPortExtrudeCopies[i]);
+    }
+}
+
+// The pitch (tiles) a polygon is drawn on at past the border on side dir
+// of axis a (0 x, 2 z), 0 for none; bounds in sixteenths of a tile from
+// the map's middle. A tree's layers: the last 2 columns' trees, every 2
+// tiles. Else what starts in the map's last column, every tile (the
+// column's profile: a cliff's face, its foot, the ground); what's wider and
+// reaches the border (a row of trees, a long cliff), every its own width.
+// What ends before the border (a cliff's corner by it) isn't drawn on.
+static int Port_ExtrudePitch(const s32 *lo, const s32 *hi, int a, int dir, BOOL tree)
+{
+    s32 half = MAP_TILES_COUNT_X / 2 * 16, w = hi[a] - lo[a];
+
+    if (tree) {
+        s32 centre = (lo[a] + hi[a]) / 2;
+
+        return (dir > 0 ? centre > half - PORT_EXTRUDE_TREE_PITCH * 16 : centre < -half + PORT_EXTRUDE_TREE_PITCH * 16) ? PORT_EXTRUDE_TREE_PITCH : 0;
+    }
+
+    if (dir > 0 ? lo[a] >= half - 16 - 1 : hi[a] <= -half + 16 + 1) {
+        return 1;
+    }
+
+    if (dir > 0 ? hi[a] < half - 1 : lo[a] > -half + 1) {
+        return 0;
+    }
+
+    int pitch = (w + 8) / 16;
+    return pitch < 1 ? 1 : pitch;
+}
+
+// Whether a group is one of a tree's canopy layers: 1 3/8, 2 1/16 or 2 1/2
+// tiles across, standing (the field's trees, 4 quads over one place).
+static BOOL Port_IsCanopyLayer(const s32 *lo, const s32 *hi)
+{
+    s32 w = hi[0] - lo[0];
+
+    return hi[1] - lo[1] >= 8 && ((w >= 21 && w <= 23) || (w >= 32 && w <= 34) || (w >= 39 && w <= 41));
+}
+
+// Whether a group is a layer of a row of trees as drawn past the top or
+// bottom border: standing half a tile or more, leaning back 1 to 2 tiles
+// (the field's trees, a row of them drawn as one long quad a layer).
+static BOOL Port_IsLeaningLayer(const s32 *lo, const s32 *hi)
+{
+    s32 d = hi[2] - lo[2];
+
+    return hi[1] - lo[1] >= 8 && d >= 16 && d <= 32;
+}
+
+// The list's bytes added to the end of the shape's list being made.
+static BOOL Port_ExtrudeListPut(PortExtrudeList *list, const void *bytes, u32 size)
+{
+    if (list->size + size > list->room) {
+        u32 room = list->room * 2 > list->size + size + 256 ? list->room * 2 : list->size + size + 256;
+        u8 *grown = realloc(list->bytes, room);
+
+        if (grown == NULL) {
+            return FALSE;
+        }
+
+        list->bytes = grown;
+        list->room = room;
+    }
+
+    memcpy(list->bytes + list->size, bytes, size);
+    list->size += size;
+    return TRUE;
+}
+
+// What's sent after it moved to (x, z) (the model's coordinates).
+static BOOL Port_ExtrudeListMoveTo(PortExtrudeList *list, s32 x, s32 z)
+{
+    u32 command[4];
+
+    if (x == list->x && z == list->z) {
+        return TRUE;
+    }
+
+    NitroPort_Gx3dTranslateCommand(command, sizeof(command), x - list->x, 0, z - list->z);
+    list->x = x;
+    list->z = z;
+    return Port_ExtrudeListPut(list, command, sizeof(command));
+}
+
+// The cut list added again at each place a polygon pitchX, pitchZ tiles
+// apart is drawn on at (then for a fill, each of those again count times
+// along the border, step sixteenths of a tile apart; for the copy of a
+// forest band, all of those again north of it).
+static BOOL Port_ExtrudeListRepeat(const PortExtrudeCopy *copy, PortExtrudeList *list, const void *cut, u32 size,
+    int pitchX, int pitchZ, int fillDir, int fillCount, int fillStep)
+{
+    int stepsX = pitchX > 0 ? (PORT_EXTRUDE_REACH_X + pitchX - 1) / pitchX : 0;
+    int stepsZ = pitchZ > 0 ? (PORT_EXTRUDE_REACH_Z + pitchZ - 1) / pitchZ : 0;
+    BOOL ok = TRUE;
+
+    for (int b = copy->band > 0 ? 1 : 0; b <= (copy->band > 0 ? copy->bandCopies : 0) && ok; b++) {
+        for (int i = pitchX > 0 ? 1 : 0; i <= stepsX && ok; i++) {
+            for (int j = pitchZ > 0 ? 1 : 0; j <= stepsZ && ok; j++) {
+                for (int m = fillDir != 0 ? 1 : 0; m <= fillCount && ok; m++) {
+                    s32 x16 = copy->dirX * i * pitchX * 16, z16 = copy->dirZ * j * pitchZ * 16 - b * (copy->bandHi - copy->bandLo) * 16;
+
+                    if (copy->dirX != 0) {
+                        z16 += fillDir * m * fillStep;
+                    } else {
+                        x16 += fillDir * m * fillStep;
+                    }
+
+                    ok = Port_ExtrudeListMoveTo(list, (s32)((s64)x16 * copy->tile / 16), (s32)((s64)z16 * copy->tile / 16))
+                        && Port_ExtrudeListPut(list, cut, size);
+                }
+            }
+        }
+    }
+
+    return ok;
+}
+
+// A slope or wall along the border in its last column (its face toward
+// the border or away from it, not across it) isn't drawn on past it: side
+// by side every tile, the faces make teeth with nothing between (the
+// Cycling Road's mountains rising to the border). Past it instead, the
+// ground at its top: the flat polygon at that height in the last column
+// next to it along the border (where the slope ends), drawn on past the
+// border as the rest of the column is, and again along the border over the
+// slope's length, every its own length (a fill).
+typedef struct PortExtrudeFill {
+    u8 shape;
+    u16 group;
+    s8 dir;
+    u8 count;
+    s16 step;
+} PortExtrudeFill;
+
+// The fills for the faces (merged into runs along the border at one top),
+// up to max; their count.
+static int Port_MakeExtrudeFills(PortExtrudeSpan *faces, int numFaces, const PortExtrudeSpan *flats, int numFlats, PortExtrudeFill *fills, int max)
+{
+    int numFills = 0;
+
+    // (by where each starts)
+    for (int i = 1; i < numFaces; i++) {
+        for (int j = i; j > 0 && faces[j].lo < faces[j - 1].lo; j--) {
+            PortExtrudeSpan t = faces[j];
+
+            faces[j] = faces[j - 1];
+            faces[j - 1] = t;
+        }
+    }
+
+    for (int i = 0; i < numFaces && numFills < max;) {
+        PortExtrudeSpan run = faces[i++];
+
+        while (i < numFaces && faces[i].lo <= run.hi + 2 && faces[i].y >= run.y - 1 && faces[i].y <= run.y + 1) {
+            run.hi = faces[i].hi > run.hi ? faces[i].hi : run.hi;
+            i++;
+        }
+
+        const PortExtrudeSpan *best = NULL;
+        int dir = 0;
+
+        for (int k = 0; k < numFlats; k++) {
+            const PortExtrudeSpan *f = &flats[k];
+            int d = 0;
+
+            if (f->y < run.y - 1 || f->y > run.y + 1 || f->hi - f->lo < 16) {
+                continue;
+            }
+
+            if (f->lo >= run.hi - 16 && f->lo <= run.hi + 16) {
+                d = -1; // (after the run: drawn again back over it)
+            } else if (f->hi <= run.lo + 16 && f->hi >= run.lo - 16) {
+                d = 1;
+            }
+
+            if (d != 0 && (best == NULL || f->hi - f->lo > best->hi - best->lo)) {
+                best = f;
+                dir = d;
+            }
+        }
+
+        if (best != NULL) {
+            int step = best->hi - best->lo, reach = dir < 0 ? best->lo - run.lo : run.hi - best->hi;
+            int n = (reach + step - 1) / step;
+
+            fills[numFills].shape = best->shape;
+            fills[numFills].group = best->group;
+            fills[numFills].dir = (s8)dir;
+            fills[numFills].count = (u8)(n < 1 ? 1 : n > 8 ? 8 : n);
+            fills[numFills].step = (s16)step;
+            numFills++;
+        }
+    }
+
+    return numFills;
+}
+
+// (the work space for a shape: its groups' bounds and slopes, each one's
+// pitches, and which are cut out)
+static s32 sPortExtrudeBox[PORT_EXTRUDE_GROUPS][6];
+static u8 sPortExtrudeSlopes[PORT_EXTRUDE_GROUPS];
+static u8 sPortExtrudePitchX[PORT_EXTRUDE_GROUPS];
+static u8 sPortExtrudePitchZ[PORT_EXTRUDE_GROUPS];
+static u8 sPortExtrudeMark[PORT_EXTRUDE_GROUPS];
+
+// The cut list of shape i of the model with the marked groups (into a new
+// buffer), and whether it can be sent again right after itself.
+static void *Port_ExtrudeCut(NitroGx3dListSurvey *survey, NNSG3dResShpData *shp, u32 count, u32 *size, int *repeatable)
+{
+    u32 room = NNS_G3dGetShpDLSize(shp) + NNS_G3dGetShpDLSize(shp) / 2 + 64;
+    void *cut = malloc(room);
+
+    *size = cut == NULL ? 0 : NitroPort_Gx3dSurveyTrim(survey, cut, room, sPortExtrudeMark, count, repeatable);
+
+    if (*size == 0) {
+        free(cut);
+        return NULL;
+    }
+
+    return cut;
+}
+
+// (a cut list whose first vertices take the colour, normal or texture
+// coordinates from before it, set again later in it: sent again right after
+// itself, those vertices take what it set last instead. Not seen in the
+// maps drawn on; logged, in case)
+static void Port_NoteNotRepeatable(const PortExtrudeCopy *copy, int shape, BOOL notRepeatable)
+{
+    extern void NitroPort_Log(const char *fmt, ...);
+
+    if (notRepeatable) {
+        NitroPort_Log("[field] drawn on past the border (matrix %d, map %d, side %d,%d): shape %d's list not the same sent again",
+            copy->matrixID, copy->mapMatrixIndex, copy->dirX, copy->dirZ, shape);
+    }
+}
+
+// Shape i of the model worked through: each of its polygons' pitches, the
+// polygons at each pair of pitches cut out and added to its list at every
+// place they're drawn on at; the faces and flats in the last column noted
+// (Port_MakeExtrudeFills, once all are through).
+static BOOL Port_ExtrudeShape(PortExtrudeCopy *copy, NNSG3dResMdl *model, int i)
+{
+    NNSG3dResShpData *shp = NNS_G3dGetShpDataByIdx(NNS_G3dGetShp(model), i);
+    NitroGx3dListSurvey *survey = NitroPort_Gx3dSurveyList(NNS_G3dGetShpDLPtr(shp), NNS_G3dGetShpDLSize(shp));
+    PortExtrudeList *list = &copy->lists[i];
+    int a = copy->dirX != 0 ? 0 : 2, b = 2 - a, side = (copy->dirX != 0) != (copy->dirZ != 0);
+    u32 count, canopies = 0;
+    BOOL ok = survey != NULL;
+
+    count = ok ? NitroPort_Gx3dSurveyGroups(survey, sPortExtrudeBox, sPortExtrudeSlopes, PORT_EXTRUDE_GROUPS) : 0;
+    count = count > PORT_EXTRUDE_GROUPS ? PORT_EXTRUDE_GROUPS : count;
+
+    // (each polygon's pitches; the trees' shape: a quarter of it or more
+    // canopy layers, the rest their shadows)
+    for (int pass = 0; pass < 2 && ok; pass++) {
+        BOOL trees = count >= 8 && canopies * 4 >= count;
+
+        for (u32 g = 0; g < count; g++) {
+            s32 lo[3], hi[3];
+            u8 *px = &sPortExtrudePitchX[g], *pz = &sPortExtrudePitchZ[g];
+
+            for (int k = 0; k < 3; k++) {
+                lo[k] = (s32)(((s64)sPortExtrudeBox[g][k] * 16) / copy->tile);
+                hi[k] = (s32)(((s64)sPortExtrudeBox[g][3 + k] * 16) / copy->tile);
+            }
+
+            if (pass == 0) {
+                canopies += Port_IsCanopyLayer(lo, hi);
+                continue;
+            }
+
+            *px = copy->dirX != 0 ? (u8)Port_ExtrudePitch(lo, hi, 0, copy->dirX, trees) : 0;
+            *pz = copy->dirZ != 0 ? (u8)Port_ExtrudePitch(lo, hi, 2, copy->dirZ, trees || Port_IsLeaningLayer(lo, hi)) : 0;
+
+            // (into the corner only what goes on both ways)
+            if (copy->dirX != 0 && copy->dirZ != 0 && (*px == 0 || *pz == 0)) {
+                *px = *pz = 0;
+            }
+
+            // (its forest band alone, or what's south of the band's top)
+            if (copy->band != 0) {
+                s32 centre = (lo[2] + hi[2]) / 2;
+
+                if (copy->band > 0 ? centre < copy->bandLo * 16 || centre >= copy->bandHi * 16 : centre < copy->bandLo * 16) {
+                    *px = *pz = 0;
+                }
+            }
+
+            // (past a side: in the last column, a face along the border,
+            // and the flat ground)
+            u8 *p = a == 0 ? px : pz;
+
+            if (side && !trees && *p == 1) {
+                BOOL face = (lo[a] == hi[a] && hi[1] > lo[1]) || (sPortExtrudeSlopes[g] & (a == 0 ? 1 : 2)) != 0;
+                PortExtrudeSpan span = { (s16)lo[b], (s16)hi[b], (s16)hi[1], (u8)i, (u16)g };
+
+                if (face) {
+                    *p = 0;
+
+                    if (copy->numFaces < PORT_EXTRUDE_FACES) {
+                        copy->faces[copy->numFaces++] = span;
+                    }
+                } else if (lo[1] == hi[1] && copy->numFlats < PORT_EXTRUDE_FLATS) {
+                    copy->flats[copy->numFlats++] = span;
+                }
+            }
+        }
+    }
+
+    // (the polygons at each pair of pitches, at every place)
+    while (ok) {
+        int pitchX = -1, pitchZ = -1;
+
+        for (u32 g = 0; g < count && pitchX < 0; g++) {
+            if (sPortExtrudePitchX[g] != 0 || sPortExtrudePitchZ[g] != 0) {
+                pitchX = sPortExtrudePitchX[g];
+                pitchZ = sPortExtrudePitchZ[g];
+            }
+        }
+
+        if (pitchX < 0) {
+            break;
+        }
+
+        for (u32 g = 0; g < count; g++) {
+            sPortExtrudeMark[g] = (sPortExtrudePitchX[g] != 0 || sPortExtrudePitchZ[g] != 0)
+                && sPortExtrudePitchX[g] == pitchX && sPortExtrudePitchZ[g] == pitchZ;
+
+            if (sPortExtrudeMark[g]) {
+                sPortExtrudePitchX[g] = sPortExtrudePitchZ[g] = 0;
+            }
+        }
+
+        u32 size;
+        int repeatable;
+        void *cut = Port_ExtrudeCut(survey, shp, count, &size, &repeatable);
+
+        Port_NoteNotRepeatable(copy, i, cut != NULL && !repeatable);
+        ok = cut != NULL && Port_ExtrudeListRepeat(copy, list, cut, size, pitchX, pitchZ, 0, 0, 0);
+        free(cut);
+    }
+
+    NitroPort_Gx3dFreeSurvey(survey);
+    return ok;
+}
+
+// The fills (shapes surveyed again for them), each shape's list moved back
+// where it began, and the model copied with them: made.
+static BOOL Port_FinishExtrudeCopy(PortExtrudeCopy *copy, const NNSG3dResFileHeader *file, NNSG3dResMdl *model)
+{
+    PortExtrudeFill fills[PORT_EXTRUDE_FILLS];
+    int numFills = Port_MakeExtrudeFills(copy->faces, copy->numFaces, copy->flats, copy->numFlats, fills, PORT_EXTRUDE_FILLS);
+    BOOL ok = TRUE;
+
+    for (int f = 0; f < numFills && ok; f++) {
+        NNSG3dResShpData *shp = NNS_G3dGetShpDataByIdx(NNS_G3dGetShp(model), fills[f].shape);
+        NitroGx3dListSurvey *survey = NitroPort_Gx3dSurveyList(NNS_G3dGetShpDLPtr(shp), NNS_G3dGetShpDLSize(shp));
+        u32 count = survey != NULL ? NitroPort_Gx3dSurveyGroups(survey, sPortExtrudeBox, NULL, PORT_EXTRUDE_GROUPS) : 0, size;
+        int repeatable;
+
+        count = count > PORT_EXTRUDE_GROUPS ? PORT_EXTRUDE_GROUPS : count;
+
+        for (u32 g = 0; g < count; g++) {
+            sPortExtrudeMark[g] = g == fills[f].group;
+        }
+
+        void *cut = survey != NULL ? Port_ExtrudeCut(survey, shp, count, &size, &repeatable) : NULL;
+
+        Port_NoteNotRepeatable(copy, fills[f].shape, cut != NULL && !repeatable);
+        ok = cut != NULL
+            && Port_ExtrudeListRepeat(copy, &copy->lists[fills[f].shape], cut, size,
+                copy->dirX != 0 ? 1 : 0, copy->dirX != 0 ? 0 : 1, fills[f].dir, fills[f].count, fills[f].step);
+        free(cut);
+        NitroPort_Gx3dFreeSurvey(survey);
+    }
+
+    void **cuts = calloc(copy->numShp, sizeof(void *));
+    u32 *sizes = calloc(copy->numShp, sizeof(u32)), *ofs = calloc(copy->numShp, sizeof(u32));
+    static const u32 sNops = 0;
+
+    ok = ok && cuts != NULL && sizes != NULL && ofs != NULL;
+
+    for (int i = 0; i < copy->numShp && ok; i++) {
+        PortExtrudeList *list = &copy->lists[i];
+
+        ok = Port_ExtrudeListMoveTo(list, 0, 0);
+        cuts[i] = list->size > 0 ? (void *)list->bytes : (void *)&sNops;
+        sizes[i] = list->size > 0 ? list->size : sizeof(sNops);
+    }
+
+    if (ok) {
+        copy->block = Port_CopyWithCuts(file, cuts, sizes, ofs, copy->numShp);
+        ok = copy->block != NULL;
+    }
+
+    if (ok) {
+        copy->model = NNS_G3dGetMdlByIdx(NNS_G3dGetMdlSet((NNSG3dResFileHeader *)copy->block), 0);
+
+        NNSG3dResShp *shapes = NNS_G3dGetShp(copy->model);
+
+        for (int i = 0; i < copy->numShp; i++) {
+            NNSG3dResShpData *shp = NNS_G3dGetShpDataByIdx(shapes, i);
+
+            shp->ofsDL = (u32)(copy->block + ofs[i] - (u8 *)shp);
+            shp->sizeDL = sizes[i];
+        }
+    }
+
+    free(cuts);
+    free(sizes);
+    free(ofs);
+    Port_FreeExtrudeLists(copy);
+    return ok;
+}
+
+static BOOL Port_ReadWholeCopyOf(const LandDataManager *landDataMan, int mapMatrixIndex, const NNSG3dResFileHeader **file, NNSG3dResMdl **model);
+
+// The copy's map's model: the loaded one's (the game done reading it, still
+// the same map), else (readWhole) its model read whole for it, a map of the
+// matrix not loaded now.
+static BOOL Port_ExtrudeSource(const LandDataManager *landDataMan, const PortExtrudeCopy *copy, BOOL readWhole,
+    const NNSG3dResFileHeader **file, NNSG3dResMdl **model)
+{
+    if (MapMatrix_GetMatrixID(landDataMan->mapMatrix) != copy->matrixID
+        || MapMatrix_GetLandDataIDByIndex(copy->mapMatrixIndex, landDataMan->mapMatrix) != copy->landDataID) {
+        return FALSE;
+    }
+
+    for (u8 i = 0; i < QUADRANT_COUNT; i++) {
+        const LoadedMap *m = landDataMan->loadedMaps[i];
+
+        if (m->mapMatrixIndex == copy->mapMatrixIndex && m->valid == TRUE) {
+            *file = m->mapModelFile;
+            *model = m->mapRenderObj.resMdl;
+            return TRUE;
+        }
+    }
+
+    return readWhole && Port_ReadWholeCopyOf(landDataMan, copy->mapMatrixIndex, file, model);
+}
+
+// Up to shapes more of the copy's shapes worked through (all of them for
+// shapes < 0), then the copy finished: made, or failed.
+static void Port_ExtrudeWork(const LandDataManager *landDataMan, PortExtrudeCopy *copy, int shapes, BOOL readWhole)
+{
+    const NNSG3dResFileHeader *file;
+    NNSG3dResMdl *model;
+
+    if (copy->state != PORT_EXTRUDE_MAKING || !Port_ExtrudeSource(landDataMan, copy, readWhole, &file, &model)) {
+        return;
+    }
+
+    if (copy->lists == NULL) {
+        NNSG3dResMdlInfo *info = NNS_G3dGetMdlInfo(model);
+
+        copy->numShp = NNS_G3dGetShp(model)->dict.numEntry;
+        copy->tile = info->posScale > 0 ? (s32)(((s64)MAP_OBJECT_TILE_SIZE << FX32_SHIFT) / info->posScale) : 0;
+        copy->lists = calloc(copy->numShp > 0 ? copy->numShp : 1, sizeof(PortExtrudeList));
+        copy->faces = malloc(sizeof(PortExtrudeSpan) * (PORT_EXTRUDE_FACES + PORT_EXTRUDE_FLATS));
+        copy->flats = copy->faces != NULL ? copy->faces + PORT_EXTRUDE_FACES : NULL;
+        copy->nextShape = 0;
+
+        if (copy->lists == NULL || copy->faces == NULL || copy->tile <= 0 || file == NULL) {
+            Port_FreeExtrudeLists(copy);
+            copy->state = PORT_EXTRUDE_FAILED;
+            return;
+        }
+    }
+
+    for (int n = 0; copy->nextShape < copy->numShp && (shapes < 0 || n < shapes); n++) {
+        if (!Port_ExtrudeShape(copy, model, copy->nextShape++)) {
+            Port_FreeExtrudeLists(copy);
+            copy->state = PORT_EXTRUDE_FAILED;
+            return;
+        }
+    }
+
+    if (copy->nextShape >= copy->numShp) {
+        copy->state = Port_FinishExtrudeCopy(copy, file, model) ? PORT_EXTRUDE_MADE : PORT_EXTRUDE_FAILED;
+    }
+}
+
+// A side whose own strip by the border doesn't go on coherently, filled
+// instead with a forest band of the map below it: the band's polygons
+// (rows bandLo to bandHi, in tiles from the map's middle) drawn on past the
+// border as the rest of its strip is, and again every (bandHi - bandLo)
+// tiles further north, past the map above and the corner beyond; north of
+// the band, the lower map's own strip cut. Amity Square's top-right map
+// ends at the right in the plateau's last cliff, sloping down to the border
+// (drawn on, cliff faces side by side with nothing between, and the
+// plateau's south cliff on past the border, its top over nothing); past
+// it, the bottom-right map's upper terrace of trees, on north, the cliff
+// going down into it.
+typedef struct PortExtrudeForest {
+    u8 matrixID;
+    u8 mapMatrixIndex; // (the map whose band it is; the one above it, filled with it)
+    s8 dirX;
+    s8 bandLo, bandHi;
+} PortExtrudeForest;
+
+static const PortExtrudeForest sPortExtrudeForests[] = {
+    { 50, 3, 1, -14, -2 }, // (Amity Square)
+};
+
+static const PortExtrudeForest *Port_ExtrudeForestOf(const LandDataManager *landDataMan, int mapMatrixIndex, int dirX)
+{
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+
+    for (int k = 0; k < (int)NELEMS(sPortExtrudeForests); k++) {
+        const PortExtrudeForest *f = &sPortExtrudeForests[k];
+
+        if (f->matrixID == matrixID && f->mapMatrixIndex == mapMatrixIndex && f->dirX == dirX) {
+            return f;
+        }
+    }
+
+    return NULL;
+}
+
+// Which copy the loaded map at index is drawn on past its border with (its
+// own, or the forest band's of the map below it), FALSE for none: the
+// corner past a side filled with a band is (the band's copies reach it).
+static BOOL Port_ExtrudePartOf(const LandDataManager *landDataMan, u8 index, int dirX, int dirZ, int *from, int *band)
+{
+    int width = landDataMan->mapMatrixWidth;
+
+    *from = landDataMan->loadedMaps[index]->mapMatrixIndex;
+    *band = 0;
+
+    if (dirX != 0 && Port_ExtrudeForestOf(landDataMan, *from + width, dirX) != NULL) {
+        if (dirZ != 0) {
+            return FALSE;
+        }
+
+        *from += width;
+        *band = 1;
+    } else if (dirX != 0 && dirZ == 0 && Port_ExtrudeForestOf(landDataMan, *from, dirX) != NULL) {
+        *band = -1;
+    }
+
+    return TRUE;
+}
+
+// The copy for (from, dirX, dirZ, band), asked for this scene: found, or a
+// slot taken for it (one free, else the one wanted longest ago, not this
+// scene), then being made; NULL if there's no room.
+static PortExtrudeCopy *Port_ExtrudeCopyFor(const LandDataManager *landDataMan, int from, int dirX, int dirZ, int band)
+{
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+    int landDataID = MapMatrix_GetLandDataIDByIndex(from, landDataMan->mapMatrix);
+    PortExtrudeCopy *copy = NULL;
+
+    for (int k = 0; k < PORT_EXTRUDE_COPIES; k++) {
+        PortExtrudeCopy *c = &sPortExtrudeCopies[k];
+
+        if (c->state != PORT_EXTRUDE_FREE && c->mapMatrixIndex == from && c->matrixID == matrixID && c->landDataID == landDataID
+            && c->dirX == dirX && c->dirZ == dirZ && c->band == band) {
+            c->wanted = sPortExtrudeScene;
+            return c;
+        }
+    }
+
+    for (int k = 0; k < PORT_EXTRUDE_COPIES; k++) {
+        PortExtrudeCopy *c = &sPortExtrudeCopies[k];
+
+        if (c->state == PORT_EXTRUDE_FREE) {
+            copy = c;
+            break;
+        }
+
+        if (c->wanted != sPortExtrudeScene && (copy == NULL || (int)(c->wanted - copy->wanted) < 0)) {
+            copy = c;
+        }
+    }
+
+    if (copy == NULL) {
+        return NULL;
+    }
+
+    Port_FreeExtrudeCopy(copy);
+    copy->mapMatrixIndex = from;
+    copy->matrixID = matrixID;
+    copy->landDataID = landDataID;
+    copy->dirX = (s8)dirX;
+    copy->dirZ = (s8)dirZ;
+    copy->band = (s8)band;
+    copy->state = PORT_EXTRUDE_MAKING;
+    copy->wanted = sPortExtrudeScene;
+
+    const PortExtrudeForest *forest = band != 0 ? Port_ExtrudeForestOf(landDataMan, from, dirX) : NULL;
+
+    if (forest != NULL) {
+        copy->bandLo = forest->bandLo;
+        copy->bandHi = forest->bandHi;
+        copy->bandCopies = (u8)((forest->bandLo + MAP_TILES_COUNT_Z / 2 + MAP_TILES_COUNT_Z + PORT_EXTRUDE_REACH_Z + (forest->bandHi - forest->bandLo) - 1)
+            / (forest->bandHi - forest->bandLo));
+    }
+
+    return copy;
+}
+
+static void Port_RenderExtrudedPart(const LandDataManager *landDataMan, u8 index, int dirX, int dirZ)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+    int from, band;
+
+    if (loadedMap->valid != TRUE || !Port_ExtrudePartOf(landDataMan, index, dirX, dirZ, &from, &band)) {
+        return;
+    }
+
+    PortExtrudeCopy *copy = Port_ExtrudeCopyFor(landDataMan, from, dirX, dirZ, band);
+
+    if (copy == NULL) {
+        return;
+    }
+
+    // (needed now: made at once, if it isn't yet)
+    Port_ExtrudeWork(landDataMan, copy, -1, TRUE);
+
+    if (copy->state != PORT_EXTRUDE_MADE) {
+        return;
+    }
+
+    VecFx32 position = { 0, 0, 0 };
+    VecFx32 scale = { FX32_ONE, FX32_ONE, FX32_ONE };
+    MtxFx33 rotationMatrix = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+    NNSG3dResMdl *own = loadedMap->mapRenderObj.resMdl;
+
+    LandDataManager_CalculateRenderingPosition(from, landDataMan->mapMatrixWidth, landDataMan->mapMatrix, &position);
+    position.x += landDataMan->offset.x;
+    position.y += landDataMan->offset.y;
+    position.z += landDataMan->offset.z;
+
+    loadedMap->mapRenderObj.resMdl = copy->model;
+    Easy3D_DrawRenderObj(&loadedMap->mapRenderObj, &position, &rotationMatrix, &scale);
+    NNS_G3dGeFlushBuffer();
+    loadedMap->mapRenderObj.resMdl = own;
+}
+
+static void Port_RenderExtrudedEdge(const LandDataManager *landDataMan, u8 index, int dir)
+{
+    Port_RenderExtrudedPart(landDataMan, index, dir, 0);
+}
+
+static BOOL Port_MirroredBesideSceneryTo(u16 header, int dir);
+static BOOL Port_ExtrudedBesideScenery(u16 header);
+
+// The copies the loaded maps may be drawn on past their borders with, in
+// either half of them, asked for (each scene: kept), and a little more of
+// the first one not made yet made: by an extruded matrix's edges, and past
+// the scenery beside a map listed (Port_RenderMirroredBesideSceneryMaps).
+static void Port_ExtrudeAhead(const LandDataManager *landDataMan)
+{
+    PortExtrudeCopy *making = NULL;
+    int width = landDataMan->mapMatrixWidth, height = landDataMan->mapMatrixHeight;
+
