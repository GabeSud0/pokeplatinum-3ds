-}
-
 static void Port_RenderEdgeBelowScenery(const LandDataManager *landDataMan, ModelAttributes *const modelAttrs)
 {
     if (NitroPort_WideScreenExtra() == 0 || landDataMan->inDistortionWorld) {
@@ -3372,6 +3205,357 @@ static void Port_RenderBesideMaps(const LandDataManager *landDataMan, ModelAttri
         }
     }
 }
+
+// The forest south of a map in sPortForestOnSouth (Route 203): that map's
+// strip by its south edge, read for it (as the maps beside the loaded ones
+// are: its own copy, its own render object), whether that map is loaded or
+// not, so the scenery map south of it looks the same from wherever it's
+// seen (from Jubilife's south-east, with Route 203's map let go, the
+// scenery was drawn as it is, and with it loaded, the copies: the forest
+// changed as the player walked). 2 kept, let go with the loaded maps.
+#define PORT_FOREST_SLOTS 2
+
+typedef struct PortForestCopy {
+    int mapMatrixIndex; // (the map north of the scenery; INVALID_MAP_MATRIX_INDEX: none)
+    int matrixID;
+    int landDataID;
+    int from, to;       // (its columns, tiles from its west edge)
+    BOOL failed;        // (couldn't be read: not tried again)
+    u32 used;           // (the frame it was last drawn in)
+    u8 *block;          // its model file, its strip's cut lists
+    NNSG3dRenderObj renderObj;
+} PortForestCopy;
+
+static PortForestCopy sPortForestCopies[PORT_FOREST_SLOTS];
+
+static void Port_FreeForestCopy(PortForestCopy *copy)
+{
+    free(copy->block);
+    memset(copy, 0, sizeof(*copy));
+    copy->mapMatrixIndex = INVALID_MAP_MATRIX_INDEX;
+}
+
+static void Port_FreeForestCopies(void)
+{
+    for (int i = 0; i < PORT_FOREST_SLOTS; i++) {
+        Port_FreeForestCopy(&sPortForestCopies[i]);
+    }
+}
+
+// The strip of the map at mapMatrixIndex by its south edge (its last 2
+// tiles), only the polygons reaching into its columns from <= x < to: read
+// once, kept; NULL if it can't be.
+static PortForestCopy *Port_ForestCopyOf(const LandDataManager *landDataMan, int mapMatrixIndex, int from, int to)
+{
+    extern void NitroPort_Log(const char *fmt, ...);
+    int landDataID = MapMatrix_GetLandDataIDByIndex(mapMatrixIndex, landDataMan->mapMatrix);
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+    PortForestCopy *copy = NULL;
+
+    if (landDataID == INVALID_LAND_DATA_ID) {
+        return NULL;
+    }
+
+    for (int i = 0; i < PORT_FOREST_SLOTS; i++) {
+        PortForestCopy *c = &sPortForestCopies[i];
+
+        if ((c->block != NULL || c->failed) && c->mapMatrixIndex == mapMatrixIndex && c->matrixID == matrixID
+            && c->landDataID == landDataID && c->from == from && c->to == to) {
+            c->used = sPortBesideFrame;
+            return c->failed ? NULL : c;
+        }
+    }
+
+    // (a slot free, else the one drawn longest ago)
+    for (int i = 0; i < PORT_FOREST_SLOTS; i++) {
+        PortForestCopy *c = &sPortForestCopies[i];
+
+        if (c->block == NULL && !c->failed) {
+            copy = c;
+            break;
+        }
+
+        if (copy == NULL || (int)(c->used - copy->used) < 0) {
+            copy = c;
+        }
+    }
+
+    Port_FreeForestCopy(copy);
+    copy->mapMatrixIndex = mapMatrixIndex;
+    copy->matrixID = matrixID;
+    copy->landDataID = landDataID;
+    copy->from = from;
+    copy->to = to;
+    copy->used = sPortBesideFrame;
+    copy->failed = TRUE; // (till it's read)
+
+    if (sPortBesideNARC == NULL) {
+        sPortBesideNARC = NARC_ctor(NARC_INDEX_FIELDDATA__LAND_DATA__LAND_DATA, HEAP_ID_FIELD1);
+    }
+
+    int *header = malloc(sizeof(int) * 4);
+
+    if (header == NULL || sPortBesideNARC == NULL) {
+        free(header);
+        return NULL;
+    }
+
+    NARC_ReadFromMember(sPortBesideNARC, landDataID, 0, sizeof(int) * 4, header);
+
+    int attributesSize = header[0], propsSize = header[1], modelSize = header[2];
+
+    free(header);
+
+    if (modelSize <= 0 || propsSize < 0 || attributesSize < 0) {
+        return NULL;
+    }
+
+    u8 *file = malloc(modelSize);
+
+    if (file == NULL) {
+        return NULL;
+    }
+
+    NARC_ReadFromMember(sPortBesideNARC, landDataID, sizeof(int) * 4 + attributesSize + propsSize, modelSize, file);
+
+    NNSG3dResFileHeader *fileHeader = (NNSG3dResFileHeader *)file;
+    NNSG3dResMdlSet *mdlSet = NNS_G3dGetMdlSet(fileHeader);
+
+    if (mdlSet == NULL || mdlSet->dict.numEntry != 1) {
+        free(file);
+        return NULL;
+    }
+
+    // (the lists of its shapes cut to the strip, then to the columns; a
+    // list that can't be cut: none of it)
+    NNSG3dResMdl *model = NNS_G3dGetMdlByIdx(mdlSet, 0);
+    NNSG3dResShp *shapes = NNS_G3dGetShp(model);
+    NNSG3dResMdlInfo *info = NNS_G3dGetMdlInfo(model);
+    int numShp = shapes->dict.numEntry;
+    void **cuts = calloc(numShp > 0 ? numShp : 1, sizeof(void *));
+    u32 *cutSize = calloc(numShp > 0 ? numShp : 1, sizeof(u32)), *cutOfs = calloc(numShp > 0 ? numShp : 1, sizeof(u32));
+    BOOL failed = cuts == NULL || cutSize == NULL || cutOfs == NULL || info->posScale <= 0;
+
+    s32 tile = failed ? 0 : (s32)(((s64)MAP_OBJECT_TILE_SIZE << FX32_SHIFT) / info->posScale);
+    s32 half = tile * MAP_TILES_COUNT_Z / 2, west = -tile * MAP_TILES_COUNT_X / 2;
+
+    for (int i = 0; i < numShp && !failed; i++) {
+        NNSG3dResShpData *shp = NNS_G3dGetShpDataByIdx(shapes, i);
+        const void *list = NNS_G3dGetShpDLPtr(shp);
+        u32 size = NNS_G3dGetShpDLSize(shp), room = size + size / 2 + 64;
+        void *strip = malloc(room), *cut = malloc(room);
+        u32 bytes = strip != NULL ? NitroPort_Gx3dTrimList(list, size, strip, room, 2, half - 2 * tile, half + tile) : 0;
+
+        bytes = bytes != 0 && cut != NULL ? NitroPort_Gx3dTrimList(strip, bytes, cut, room, 0, west + (from > 0 ? from : -1) * tile, west + to * tile) : 0;
+        free(strip);
+
+        if (bytes == 0) {
+            free(cut);
+            failed = TRUE;
+            break;
+        }
+
+        cuts[i] = cut;
+        cutSize[i] = bytes;
+    }
+
+    u8 *block = failed ? NULL : Port_CopyWithCuts(fileHeader, cuts, cutSize, cutOfs, numShp);
+
+    for (int i = 0; cuts != NULL && i < numShp; i++) {
+        free(cuts[i]);
+    }
+
+    free(cuts);
+    free(file);
+
+    if (block == NULL) {
+        free(cutSize);
+        free(cutOfs);
+        return NULL;
+    }
+
+    model = NNS_G3dGetMdlByIdx(NNS_G3dGetMdlSet((NNSG3dResFileHeader *)block), 0);
+    shapes = NNS_G3dGetShp(model);
+
+    for (int i = 0; i < numShp; i++) {
+        NNSG3dResShpData *shp = NNS_G3dGetShpDataByIdx(shapes, i);
+
+        shp->ofsDL = (u32)(block + cutOfs[i] - (u8 *)shp);
+        shp->sizeDL = cutSize[i];
+    }
+
+    free(cutSize);
+    free(cutOfs);
+
+    // (its textures: the area's, as the loaded maps' are)
+    NNSG3dResTex *mapTexture = AreaDataManager_GetMapTexture(landDataMan->areaDataMan);
+
+    if (mapTexture == NULL || Easy3D_IsTextureUploadedToVRAM(mapTexture) != TRUE) {
+        free(block);
+        Port_FreeForestCopy(copy); // (not there yet: read again next time)
+        return NULL;
+    }
+
+    if (!Easy3D_BindTextureToResource((NNSG3dResFileHeader *)block, mapTexture)) {
+        free(block);
+        return NULL;
+    }
+
+    NNS_G3dRenderObjInit(&copy->renderObj, model);
+
+    if (AreaDataManager_IsOutdoorsLighting(landDataMan->areaDataMan) == TRUE) {
+        AreaLight_UseGlobalModelAttributes(model);
+    }
+
+    copy->block = block;
+    copy->failed = FALSE;
+    NitroPort_Log("[field] the forest south of matrix %d (land data %d) read: columns %d-%d of its strip by the south edge", mapMatrixIndex, landDataID, from, to - 1);
+    return copy;
+}
+
+// Whether the loaded scenery map index (header "everywhere") has the forest
+// of the map north of it drawn on over it (sPortForestOnSouth, the scenery
+// higher than that map): that map's strip, read (NULL: no), the columns
+// (from <= x < to, tiles from the west edge) and that map's index.
+static PortForestCopy *Port_ForestOverOf(const LandDataManager *landDataMan, u8 index, int *from, int *to, int *north)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+    int width = landDataMan->mapMatrixWidth, matrixWidth = MapMatrix_GetWidth(landDataMan->mapMatrix);
+    int mapMatrixIndex = loadedMap->mapMatrixIndex;
+    u16 matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+
+    *from = *to = 0;
+    *north = mapMatrixIndex - width;
+
+    if (NitroPort_WideScreenExtra() == 0 || landDataMan->inDistortionWorld || mapMatrixIndex == INVALID_MAP_MATRIX_INDEX
+        || loadedMap->valid != TRUE || *north < 0
+        || MapMatrix_GetMapHeaderIDAtIndex(landDataMan->mapMatrix, mapMatrixIndex) != MAP_HEADER_EVERYWHERE) {
+        return NULL;
+    }
+
+    for (int k = 0; k < (int)NELEMS(sPortForestOnSouth); k++) {
+        int west = (*north % width) * MAP_TILES_COUNT_X;
+
+        if (sPortForestOnSouth[k].header == MapMatrix_GetMapHeaderIDAtIndex(landDataMan->mapMatrix, *north)) {
+            *from = sPortForestOnSouth[k].xFrom - west;
+            *to = sPortForestOnSouth[k].xTo - west;
+            *from = *from < 0 ? 0 : *from;
+            *to = *to > MAP_TILES_COUNT_X ? MAP_TILES_COUNT_X : *to;
+        }
+    }
+
+    if (*from >= *to
+        || MapMatrix_GetAltitudeAtCoords(landDataMan->mapMatrix, matrixID, mapMatrixIndex % width, mapMatrixIndex / width, matrixWidth)
+            <= MapMatrix_GetAltitudeAtCoords(landDataMan->mapMatrix, matrixID, *north % width, *north / width, matrixWidth)) {
+        return NULL;
+    }
+
+    return Port_ForestCopyOf(landDataMan, *north, *from, *to);
+}
+
+// Whether the loaded map is a scenery map with the forest of the map north
+// of it drawn on over it: then it's drawn only past those columns, from
+// *keepFrom (tiles from its west edge) on.
+static BOOL Port_SceneryForestOver(const LandDataManager *landDataMan, u8 index, int *keepFrom)
+{
+    int from, to, north;
+
+    if (Port_ForestOverOf(landDataMan, index, &from, &to, &north) == NULL) {
+        return FALSE;
+    }
+
+    *keepFrom = to;
+    return TRUE;
+}
+
+// The scenery map index drawn only over its columns from keepFrom on (the
+// polygons reaching into them).
+static void Port_RenderSceneryPart(const LandDataManager *landDataMan, u8 index, int keepFrom)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+
+    if (keepFrom >= MAP_TILES_COUNT_X || loadedMap->valid != TRUE) {
+        return;
+    }
+
+    PortEdgeCopy *copy = Port_EdgeCopyOf(landDataMan, index, PORT_MAP_COLUMNS, keepFrom, MAP_TILES_COUNT_X);
+
+    if (copy == NULL) {
+        return;
+    }
+
+    VecFx32 position = { 0, 0, 0 };
+    VecFx32 scale = { FX32_ONE, FX32_ONE, FX32_ONE };
+    MtxFx33 rotationMatrix = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+    NNSG3dResMdl *own = loadedMap->mapRenderObj.resMdl;
+
+    LandDataManager_CalculateRenderingPosition(loadedMap->mapMatrixIndex, landDataMan->mapMatrixWidth, landDataMan->mapMatrix, &position);
+    position.x += landDataMan->offset.x;
+    position.y += landDataMan->offset.y;
+    position.z += landDataMan->offset.z;
+
+    if (GFXBoxTest_IsModelInView(own, &position, &rotationMatrix, &scale)) {
+        loadedMap->mapRenderObj.resMdl = copy->model;
+        Easy3D_DrawRenderObj(&loadedMap->mapRenderObj, &position, &rotationMatrix, &scale);
+        NNS_G3dGeFlushBuffer();
+        loadedMap->mapRenderObj.resMdl = own;
+    }
+}
+
+// Over each such scenery map, the strip of the map north of it drawn
+// again 2, 4, ... tiles further south, the whole of the scenery map's
+// depth, each an eighth of a tile lower than the one before; each only while
+// its box is in the view.
+static void Port_RenderForestOnSouth(const LandDataManager *landDataMan)
+{
+    int width = landDataMan->mapMatrixWidth;
+
+    for (u8 i = 0; i < QUADRANT_COUNT; i++) {
+        int from, to, north;
+        PortForestCopy *copy = Port_ForestOverOf(landDataMan, i, &from, &to, &north);
+
+        if (copy == NULL) {
+            continue;
+        }
+
+        VecFx32 position = { 0, 0, 0 };
+        VecFx32 scale = { FX32_ONE, FX32_ONE, FX32_ONE };
+        MtxFx33 rotationMatrix = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+        const NNSG3dResMdlInfo *info = NNS_G3dGetMdlInfo(copy->renderObj.resMdl);
+
+        LandDataManager_CalculateRenderingPosition(north, width, landDataMan->mapMatrix, &position);
+        position.x += landDataMan->offset.x;
+        position.y += landDataMan->offset.y;
+        position.z += landDataMan->offset.z;
+
+        for (int k = 1; k <= PORT_FOREST_ON_COPIES; k++) {
+            VecFx32 moved = position;
+            GFXTestBox box;
+
+            moved.y -= k * (MAP_OBJECT_TILE_SIZE / 8);
+            moved.z += k * 2 * MAP_OBJECT_TILE_SIZE;
+
+            // (the strip's box alone, moved: its columns, its trees' height)
+            VecFx32 corner = {
+                moved.x + (from - MAP_TILES_COUNT_X / 2) * MAP_OBJECT_TILE_SIZE,
+                moved.y + FX_Mul((fx32)info->boxY, info->boxPosScale),
+                moved.z + (MAP_TILES_COUNT_Z / 2 - 3) * MAP_OBJECT_TILE_SIZE,
+            };
+
+            NNS_G3dGlbSetBaseRot(&rotationMatrix);
+            NNS_G3dGlbSetBaseScale(&scale);
+            GFXBoxTest_MakeBox((to - from) * MAP_OBJECT_TILE_SIZE, FX_Mul((fx32)info->boxH, info->boxPosScale) + 4 * MAP_OBJECT_TILE_SIZE,
+                               4 * MAP_OBJECT_TILE_SIZE, &box);
+
+            if (!GFXBoxTest_IsBoxAtPositionInView(&corner, &box)) {
+                continue;
+            }
+
+            Easy3D_DrawRenderObj(&copy->renderObj, &moved, &rotationMatrix, &scale);
+            NNS_G3dGeFlushBuffer();
+        }
+    }
+}
