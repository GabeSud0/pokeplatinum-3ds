diff --git a/src/port_follower.c b/src/port_follower.c
index 7384055c..b0623c16 100644
--- a/src/port_follower.c
+++ b/src/port_follower.c
@@ -1233,6 +1233,81 @@ static void PortFollower_TakeBallKind(FieldSystem *fieldSystem)
 // step goes on: at most a running or walking step's.
 #define PORT_OWN_STEP_FRAMES 16
 
+// ----- A little further behind: a tile behind the player its picture (a
+// tile and more wide) sat right on the player's back. It's drawn
+// PORT_FOLLOWER_BACK further from the player than its tile, along the line
+// from the player to it (round a corner with it), its round shadow with it
+// (PortFollower_AddBack: ov5_021ECC20.c, ov5_021F134C.c); less when it's
+// nearer than a tile (coming out of its ball, on the player's tile: none
+// within half a tile). Only where it's drawn: its tile is as ever.
+#define PORT_FOLLOWER_BACK 3 // (sixteenths of a tile)
+static VecFx32 sBack;
+static const MapObject *sBackOf;
+
+static s32 PortFollower_Root(s32 v)
+{
+    s32 r, next;
+
+    if (v <= 0) {
+        return 0;
+    }
+
+    r = v;
+    next = (r + 1) / 2;
+
+    while (next < r) {
+        r = next;
+        next = (r + v / r) / 2;
+    }
+
+    return r;
+}
+
+static void PortFollower_NoteBack(MapObject *mapObj, MapObject *player)
+{
+    VecFx32 at, by;
+    s32 dx, dz, len, k;
+
+    sBack.x = sBack.y = sBack.z = 0;
+    sBackOf = mapObj;
+
+    if (mapObj == NULL || player == NULL) {
+        return;
+    }
+
+    MapObject_GetPosPtr(mapObj, &at);
+    MapObject_GetPosPtr(player, &by);
+    dx = (at.x - by.x) >> 4; // (1/256 of a unit: a tile is 16 units)
+    dz = (at.z - by.z) >> 4;
+
+    if (dx > 64 * 256 || dx < -64 * 256 || dz > 64 * 256 || dz < -64 * 256) {
+        return; // (not by the player at all)
+    }
+
+    len = PortFollower_Root(dx * dx + dz * dz);
+    k = len - 8 * 256;
+
+    if (k <= 0) {
+        return;
+    }
+
+    if (k > 8 * 256) {
+        k = 8 * 256;
+    }
+
+    // (dx / len) * BACK units * k / (8 * 256), in 20.12
+    sBack.x = (fx32)((s64)dx * (PORT_FOLLOWER_BACK * 2) * k / len);
+    sBack.z = (fx32)((s64)dz * (PORT_FOLLOWER_BACK * 2) * k / len);
+}
+
+void PortFollower_AddBack(const MapObject *mapObj, VecFx32 *pos)
+{
+    if (mapObj != NULL && mapObj == sBackOf) {
+        pos->x += sBack.x;
+        pos->z += sBack.z;
+    }
+}
+
 void PortFollower_Update(FieldSystem *fieldSystem)
 {
     static int sWait, sPlayerX, sPlayerZ, sNoRoom, sOwnStep;
@@ -1255,6 +1330,8 @@ void PortFollower_Update(FieldSystem *fieldSystem)
         return;
     }
 
+    PortFollower_NoteBack(mapObj, player);
+
     PortFollower_NoteTrail(fieldSystem);
     PortFollower_UpdateBall(fieldSystem, sDropIn);
     PortFollower_UpdateBurst();
