     Bg_FillTilemapRect(param0->unk_58F4, 3, 0x18, 0, 0, 64, 32, 9);
+#ifdef SDK_PORT_3DS
+    sBoxWidePanel = BOX_WIDE_PANEL_NONE;
+    BoxWide_SetLayout(param0);
+#endif
 }
 
