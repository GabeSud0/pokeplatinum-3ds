+// Another area's maps. Each map's textures and props are its area's (the
+// area data of its map header): the game loads the player's area's, and a
+// map of another one, behind a gate on the DS's screen, isn't seen from
+// here. The wider field sees past the gates: Hearthome City from Route 209
+// by its gate was white, its ground's textures not in Route 209's set, its
+// houses not drawn, their models not Route 209's (a photo of 2026-11-06).
+// A map (loaded or beside) with textures not in the field's set is drawn
+// from a copy bound to its own area's: that area's map and prop textures
+// read, put in texture slots 2 and 3 of the port's own (the field's VRAM
+// is slots 0 and 1, NitroPort_SetExtraTexSlots: 128 KB each, an area each;
+// in play the field's VRAM has about 45 KB left, an area needs 80-90),
+// their palettes in the field's palette VRAM, and the models of its props
+// read as they're needed. Two kept (the least recently used let go, with
+// the copies bound to it; not one used this scene), let go with the loaded
+// maps. Not if the field's textures are in more than slots 0 and 1. The
+// log says each: `[field] another area's textures ...`.
+#define PORT_OTHER_AREAS 2
+
+typedef struct PortOtherArea {
+    int areaID;         // (-1: none)
+    BOOL failed;        // (couldn't be read: not tried again)
+    u32 used;           // (the scene it was last used in)
+    AreaDataManager *area;
+    NNSG3dPlttKey plttKeys[2];
+} PortOtherArea;
+
+static PortOtherArea sPortOtherAreas[PORT_OTHER_AREAS] = { { -1 }, { -1 } };
+
+extern unsigned char NitroPort_ExtraTexVram[];
+extern void NitroPort_SetExtraTexSlots(int on);
+
+static void Port_FreeOtherArea(PortOtherArea *other)
+{
+    if (other->area != NULL) {
+        // (its copies first: bound to its textures)
+        for (int i = 0; i < PORT_BESIDE_SLOTS; i++) {
+            if (sPortBesideMaps[i].area == other->area) {
+                Port_FreeBesideMap(&sPortBesideMaps[i]);
+            }
+        }
+
+        for (int i = 1; i < MAX_MAP_PROP_MODEL_FILES; i++) {
+            free(other->area->mapPropModelFiles[i]); // ([0], the dummy box, is the field's)
+        }
+
+        free(other->area->mapPropModelIDs);
+        free(other->area->mapTextureFile);
+        free(other->area->mapPropTextureFile);
+        free(other->area);
+    }
+
+    for (int i = 0; i < 2; i++) {
+        if (other->plttKeys[i] != 0) {
+            NNS_GfdFreePlttVram(other->plttKeys[i]);
+        }
+    }
+
+    memset(other, 0, sizeof(*other));
+    other->areaID = -1;
+
+    BOOL any = FALSE;
+
+    for (int i = 0; i < PORT_OTHER_AREAS; i++) {
+        any |= sPortOtherAreas[i].area != NULL;
+    }
+
+    NitroPort_SetExtraTexSlots(any);
+}
+
+static void Port_FreeOtherAreas(void)
+{
+    for (int i = 0; i < PORT_OTHER_AREAS; i++) {
+        Port_FreeOtherArea(&sPortOtherAreas[i]);
+    }
+}
+
+// Whether a copy bound to the area can be drawn now (its textures shown:
+// the field's are in slots 0 and 1 only, as when it was read), the area
+// marked as used this scene.
+static BOOL Port_AreaShown(const LandDataManager *landDataMan, const AreaDataManager *area)
+{
+    if (area == landDataMan->areaDataMan) {
+        return TRUE;
+    }
+
+    for (int i = 0; i < PORT_OTHER_AREAS; i++) {
+        if (sPortOtherAreas[i].area == area) {
+            sPortOtherAreas[i].used = sPortBesideFrame;
+        }
+    }
+
+    return (GX_GetBankForTex() & ~(GX_VRAM_A | GX_VRAM_B)) == 0;
+}
+
+// Whether any of the textures the model file's model uses isn't in tex.
+static BOOL Port_TexturesMissing(const NNSG3dResFileHeader *file, const NNSG3dResTex *tex)
+{
+    NNSG3dResMdlSet *mdlSet = NNS_G3dGetMdlSet((NNSG3dResFileHeader *)file);
+
+    if (tex == NULL || mdlSet == NULL || mdlSet->dict.numEntry == 0) {
+        return FALSE;
+    }
+
+    NNSG3dResMat *mat = NNS_G3dGetMat(NNS_G3dGetMdlByIdx(mdlSet, 0));
+    NNSG3dResDict *dictTex = (NNSG3dResDict *)((u8 *)mat + mat->ofsDictTexToMatList);
+
+    for (u32 i = 0; i < dictTex->numEntry; i++) {
+        if (NNS_G3dGetTexDataByName(tex, NNS_G3dGetResNameByIdx(dictTex, i)) == NULL) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+// A texture set's texels into the port's texture slot (base: its offset in
+// NitroPort_ExtraTexVram; *at: the bytes used of the slot), its palettes into
+// the field's palette VRAM (*plttKey); bound models then draw from there.
+static BOOL Port_LoadExtraTextures(NNSG3dResTex *tex, u32 base, u32 *at, NNSG3dPlttKey *plttKey)
+{
+    u32 size = NNS_G3dTexGetRequiredSize(tex), plttSize = NNS_G3dPlttGetRequiredSize(tex);
+    u32 rounded = (size + 15) & ~15u;
+
+    *plttKey = 0;
+
+    if (NNS_G3dTex4x4GetRequiredSize(tex) != 0 || *at + rounded > 0x20000) {
+        return FALSE; // (a 4x4-compressed one's texels and indexes go in two slots: none here)
+    }
+
+    if (plttSize > 0) {
+        *plttKey = NNS_GfdAllocPlttVram(plttSize, tex->tex4x4Info.flag & NNS_G3D_RESPLTT_USEPLTT4, 0);
+
+        if (*plttKey == NNS_GFD_ALLOC_ERROR_PLTTKEY) {
+            *plttKey = 0;
+            return FALSE;
+        }
+    }
+
+    if (size > 0) {
+        memcpy(NitroPort_ExtraTexVram + base + *at, (const u8 *)tex + tex->texInfo.ofsTex, size);
+        NNS_G3dTexSetTexKey(tex, NNS_GfdMakeTexKey(0x40000 + base + *at, rounded, FALSE), 0);
+        tex->texInfo.flag |= NNS_G3D_RESTEX_LOADED;
+        *at += rounded;
+    }
+
+    if (plttSize > 0) {
+        NNS_G3dPlttSetPlttKey(tex, *plttKey);
+        DC_FlushRange(tex, tex->header.size);
+        NNS_G3dPlttLoad(tex, TRUE);
+    }
+
+    return TRUE;
+}
+
+// A NARC member read whole into memory of its own (NULL if it can't be).
+static void *Port_ReadMember(NARC *narc, int memberIndex)
+{
+    u32 size = narc != NULL ? NARC_GetMemberSize(narc, memberIndex) : 0;
+    void *data = size > 0 ? malloc(size) : NULL;
+
+    if (data != NULL) {
+        NARC_ReadWholeMember(narc, memberIndex, data);
+    }
+
+    return data;
+}
+
+// The area of the map at mapMatrixIndex when it isn't the field's (its
+// textures and its props' models as they're needed): NULL if it's the
+// field's, or can't be read.
+static AreaDataManager *Port_OtherAreaOf(const LandDataManager *landDataMan, int mapMatrixIndex)
+{
+    extern void NitroPort_Log(const char *fmt, ...);
+    enum MapHeaderID header = MapMatrix_GetMapHeaderIDAtIndex(landDataMan->mapMatrix, mapMatrixIndex);
+    const AreaDataManager *own = landDataMan->areaDataMan;
+    PortOtherArea *other = NULL;
+    int areaID;
+
+    if (own == NULL || header == MAP_HEADER_EVERYWHERE || header == 0 || GX_GetBankForTex() & ~(GX_VRAM_A | GX_VRAM_B)) {
+        return NULL;
+    }
+
+    areaID = MapHeader_GetAreaDataArchiveID(header);
+
+    for (int i = 0; i < PORT_OTHER_AREAS; i++) {
+        if (sPortOtherAreas[i].areaID == areaID) {
+            sPortOtherAreas[i].used = sPortBesideFrame;
+            return sPortOtherAreas[i].failed ? NULL : sPortOtherAreas[i].area;
+        }
+    }
+
+    // (a slot free, else the one used longest ago, not this scene)
+    for (int i = 0; i < PORT_OTHER_AREAS; i++) {
+        PortOtherArea *o = &sPortOtherAreas[i];
+
+        if (o->areaID < 0) {
+            other = o;
+            break;
+        }
+
+        if (o->used != sPortBesideFrame && (other == NULL || (int)(o->used - other->used) < 0)) {
+            other = o;
+        }
+    }
+
+    if (other == NULL) {
+        return NULL;
+    }
+
+    Port_FreeOtherArea(other);
+    other->areaID = areaID;
+    other->used = sPortBesideFrame;
+    other->failed = TRUE; // (till it's read)
+
+    AreaDataFile file;
+
+    NARC_ReadWholeMemberByIndexPair(&file, NARC_INDEX_FIELDDATA__AREADATA__AREA_DATA, areaID);
+
+    if (file.mapTextureArchiveID == own->areaData.mapTextureArchiveID && file.mapPropArchivesID == own->areaData.mapPropArchivesID) {
+        return NULL; // (the field's own)
+    }
+
+    AreaDataManager *area = calloc(1, sizeof(AreaDataManager));
+    NARC *narc = NARC_ctor(NARC_INDEX_FIELDDATA__AREADATA__AREA_MAP_TEX__MAP_TEX_SET, HEAP_ID_FIELD1);
+
+    if (area == NULL) {
+        if (narc != NULL) {
+            NARC_dtor(narc);
+        }
+
+        return NULL;
+    }
+
+    other->area = area;
+    area->areaData = file;
+    area->mapTextureFile = Port_ReadMember(narc, file.mapTextureArchiveID);
+
+    if (narc != NULL) {
+        NARC_dtor(narc);
+    }
+
+    narc = NARC_ctor(NARC_INDEX_FIELDDATA__AREADATA__AREA_BUILD_MODEL__AREABM_TEXSET, HEAP_ID_FIELD1);
+    area->mapPropTextureFile = Port_ReadMember(narc, file.mapPropArchivesID);
+
+    if (narc != NULL) {
+        NARC_dtor(narc);
+    }
+
+    narc = NARC_ctor(NARC_INDEX_FIELDDATA__AREADATA__AREA_BUILD_MODEL__AREA_BUILD, HEAP_ID_FIELD1);
+    area->mapPropModelIDs = Port_ReadMember(narc, file.mapPropArchivesID);
+
+    if (narc != NULL) {
+        NARC_dtor(narc);
+    }
+
+    area->mapTexture = area->mapTextureFile != NULL ? NNS_G3dGetTex((NNSG3dResFileHeader *)area->mapTextureFile) : NULL;
+    area->mapPropTexture = area->mapPropTextureFile != NULL ? NNS_G3dGetTex((NNSG3dResFileHeader *)area->mapPropTextureFile) : NULL;
+    area->mapPropMatShp = own->mapPropMatShp;   // (one file for all)
+    area->mapPropModelFiles[0] = own->mapPropModelFiles[0]; // (the dummy box)
+
+    u32 base = (u32)(other - sPortOtherAreas) * 0x20000, at = 0;
+
+    if (area->mapTexture == NULL || area->mapPropModelIDs == NULL
+        || !Port_LoadExtraTextures(area->mapTexture, base, &at, &other->plttKeys[0])
+        || (area->mapPropTexture != NULL && !Port_LoadExtraTextures(area->mapPropTexture, base, &at, &other->plttKeys[1]))) {
+        NitroPort_Log("[field] another area's textures (area %d) not read for the wider view: no room", areaID);
+        Port_FreeOtherArea(other);
+        other->areaID = areaID;
+        other->used = sPortBesideFrame;
+        other->failed = TRUE;
+        return NULL;
+    }
+
+    other->failed = FALSE;
+    NitroPort_SetExtraTexSlots(TRUE);
+    NitroPort_Log("[field] another area's textures (area %d, for map header %d) read for the wider view: %u KB in the port's texture slot %d",
+                  areaID, header, (at + 1023) / 1024, 2 + (int)(other - sPortOtherAreas));
+    return area;
+}
+
+// The models of a map's props (its land data's props part) that are the
+// other area's, read and bound to its prop textures, as they're needed.
+static void Port_LoadOtherAreaModels(AreaDataManager *area, const void *propFiles, int propsSize)
+{
+    int modelIDs[MAX_LOADED_MAP_PROPS], n = MapPropManager_PortModelIDs(propFiles, propsSize, modelIDs, MAX_LOADED_MAP_PROPS);
+    NARC *narc = NULL;
+
+    for (int i = 0; i < n; i++) {
+        int modelID = modelIDs[i];
+        BOOL listed = FALSE;
+
+        if (modelID <= 0 || modelID >= MAX_MAP_PROP_MODEL_FILES || area->mapPropModelFiles[modelID] != NULL) {
+            continue;
+        }
+
+        for (int k = 0; k < area->mapPropModelIDs[0] && !listed; k++) {
+            listed = area->mapPropModelIDs[k + 1] == modelID;
+        }
+
+        if (!listed) {
+            continue;
+        }
+
+        if (narc == NULL && (narc = NARC_ctor(NARC_INDEX_FIELDDATA__BUILD_MODEL__BUILD_MODEL, HEAP_ID_FIELD1)) == NULL) {
+            return;
+        }
+
+        NNSG3dResFileHeader *file = Port_ReadMember(narc, modelID);
+
+        if (file != NULL && area->mapPropTexture != NULL) {
+            Easy3D_BindTextureToResource(file, area->mapPropTexture);
+        }
+
+        area->mapPropModelFiles[modelID] = file;
+    }
+
+    if (narc != NULL) {
+        NARC_dtor(narc);
+    }
+}
+
