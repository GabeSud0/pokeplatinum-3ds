+// A loaded map with textures the field hasn't (another area's: Hearthome
+// City's beside Route 209's gate): drawn from a whole copy bound to its
+// own area's textures (Port_BesideMapOf, Port_OtherAreaOf), its props with
+// it. FALSE: drawn as the game has it (the field's own, or its area not had).
+static BOOL Port_RenderOtherAreaMap(const LandDataManager *landDataMan, u8 index, ModelAttributes *const modelAttrs)
+{
+    static struct {
+        const void *file;
+        int mapMatrixIndex;
+        BOOL other;
+    } sSeen[QUADRANT_COUNT];
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+
+    if (NitroPort_WideScreenExtra() == 0 || landDataMan->inDistortionWorld || loadedMap->valid != TRUE
+        || loadedMap->mapMatrixIndex == INVALID_MAP_MATRIX_INDEX) {
+        return FALSE;
+    }
+
+    // (looked at once for each map the quadrant has)
+    if (sSeen[index].file != loadedMap->mapModelFile || sSeen[index].mapMatrixIndex != loadedMap->mapMatrixIndex) {
+        sSeen[index].file = loadedMap->mapModelFile;
+        sSeen[index].mapMatrixIndex = loadedMap->mapMatrixIndex;
+        sSeen[index].other = Port_TexturesMissing(loadedMap->mapModelFile, AreaDataManager_GetMapTexture(landDataMan->areaDataMan));
+    }
+
+    if (!sSeen[index].other) {
+        return FALSE;
+    }
+
+    VecFx32 position = { 0, 0, 0 };
+    VecFx32 one = { FX32_ONE, FX32_ONE, FX32_ONE };
+    MtxFx33 identity = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+
+    LandDataManager_CalculateRenderingPosition(loadedMap->mapMatrixIndex, landDataMan->mapMatrixWidth, landDataMan->mapMatrix, &position);
+    position.x += landDataMan->offset.x;
+    position.y += landDataMan->offset.y;
+    position.z += landDataMan->offset.z;
+
+    // (read only once it's in the view)
+    NNS_G3dGlbSetBaseRot(&identity);
+    NNS_G3dGlbSetBaseScale(&one);
+
+    if (!GFXBoxTest_IsModelInView(loadedMap->mapRenderObj.resMdl, &position, &identity, &one)
+        && Port_BesideMapOf(landDataMan, loadedMap->mapMatrixIndex, 0, TRUE) == NULL) {
+        return FALSE; // (as the game has it: nothing of it in the view, its props box-tested)
+    }
+
+    PortBesideMap *map = Port_BesideMapOf(landDataMan, loadedMap->mapMatrixIndex, 0, FALSE);
+
+    if (map == NULL || map->area == landDataMan->areaDataMan || !Port_AreaShown(landDataMan, map->area)) {
+        return FALSE;
+    }
+
+    map->used = sPortBesideFrame;
