+        }
+    }
+
     // Its strip by the loaded maps: the lists of its shapes cut to it (x in
     // the lists' own coordinates; a list that can't be cut, whole).
     NNSG3dResMdl *model = NNS_G3dGetMdlByIdx(mdlSet, 0);
@@ -3071,7 +3408,7 @@ static PortBesideMap *Port_BesideMapOf(const LandDataManager *landDataMan, int m
     free(cutOfs);
 
     // (its textures: the area's, as the loaded maps' are)
-    NNSG3dResTex *mapTexture = AreaDataManager_GetMapTexture(landDataMan->areaDataMan);
+    NNSG3dResTex *mapTexture = AreaDataManager_GetMapTexture(area);
 
     if (mapTexture != NULL && Easy3D_IsTextureUploadedToVRAM(mapTexture) == TRUE) {
         if (!Easy3D_BindTextureToResource((NNSG3dResFileHeader *)block, mapTexture)) {
@@ -3087,6 +3424,7 @@ static PortBesideMap *Port_BesideMapOf(const LandDataManager *landDataMan, int m
     }
 
     map->block = block;
+    map->area = area;
 
     // Its props.
     if (!landDataMan->skipMapProps && propsSize > 0 && (propFiles = malloc(propsSize)) != NULL) {
@@ -3094,7 +3432,12 @@ static PortBesideMap *Port_BesideMapOf(const LandDataManager *landDataMan, int m
 
         if (map->props != NULL) {
             NARC_ReadFromMember(sPortBesideNARC, landDataID, sizeof(int) * 4 + attributesSize, propsSize, propFiles);
-            MapPropManager_PortLoadStill(propFiles, propsSize, landDataMan->areaDataMan, map->props);
+
+            if (area != landDataMan->areaDataMan) {
+                Port_LoadOtherAreaModels(area, propFiles, propsSize);
+            }
+
+            MapPropManager_PortLoadStill(propFiles, propsSize, area, map->props);
         }
 
         free(propFiles);
@@ -3102,6 +3445,10 @@ static PortBesideMap *Port_BesideMapOf(const LandDataManager *landDataMan, int m
 
     map->failed = FALSE;
 
+    if (area != landDataMan->areaDataMan) {
+        NitroPort_Log("[field] the map at matrix %d (land data %d) drawn with its own area's textures and props", mapMatrixIndex, landDataID);
+    }
+
     if (dir == 0) {
         NitroPort_Log("[field] a map the game is still reading (matrix %d, land data %d) read whole for the wider view: %d KB",
                       mapMatrixIndex, landDataID, (modelSize + propsSize + 1023) / 1024);
@@ -3263,17 +3610,87 @@ static void Port_RenderBesideMaps(const LandDataManager *landDataMan, ModelAttri
 
             map->used = sPortBesideFrame;
 
