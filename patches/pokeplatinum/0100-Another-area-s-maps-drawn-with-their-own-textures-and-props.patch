 // strip on the other side from dir), or NULL (or, kept only, NULL if it
 // isn't read already).
@@ -2997,6 +3322,18 @@ static PortBesideMap *Port_BesideMapOf(const LandDataManager *landDataMan, int m
         return NULL;
     }
 
+    // (its textures and props: the field's, or, with textures the field
+    // hasn't, its own area's if those are all there)
+    AreaDataManager *area = landDataMan->areaDataMan;
+
+    if (Port_TexturesMissing(fileHeader, AreaDataManager_GetMapTexture(area))) {
