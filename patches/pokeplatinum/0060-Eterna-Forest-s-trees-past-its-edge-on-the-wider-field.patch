+#ifdef SDK_PORT_3DS
+#include <nnsys/g3d/model.h>
+
+void Port_SwapModelCulling(NNSG3dResMdl *model)
+{
+    for (u32 i = 0; i < model->info.numMat; i++) {
+        GXCull cull = NNS_G3dMdlGetMdlCullMode(model, i);
+
+        if (cull == GX_CULL_BACK) {
+            NNS_G3dMdlSetMdlCullMode(model, i, GX_CULL_FRONT);
+        } else if (cull == GX_CULL_FRONT) {
+            NNS_G3dMdlSetMdlCullMode(model, i, GX_CULL_BACK);
+        }
+    }
+}
+
+void MapPropManager_RenderMirrored(const VecFx32 *mirrorCentre, const AreaDataManager *areaDataManager, const BOOL applyAttrsToModel, ModelAttributes *const modelAttrs, MapPropManager *mapPropManager)
+{
+    MtxFx33 rotationMatrix = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+
+    for (int i = 0; i < MAX_LOADED_MAP_PROPS; i++) {
+        MapProp *loadedProp = &mapPropManager->loadedProps[i];
+
+        if (loadedProp->loaded == FALSE || loadedProp->hidden) {
+            continue;
+        }
+
+        VecFx32 position = loadedProp->position;
+        VecFx32 scale = loadedProp->scale;
+
+        position.x = mirrorCentre->x - position.x;
+        position.z += mirrorCentre->z;
+        scale.x = -scale.x;
+
+        if (!GFXBoxTest_IsModelInView(loadedProp->model, &position, &rotationMatrix, &scale)) {
+            continue;
+        }
+
+        const MapPropMaterialShape *propMatShp = AreaDataManager_GetMapPropMaterialShape(areaDataManager);
+        u16 propMatShpIDsCount;
+
+        if (applyAttrsToModel == TRUE) {
+            ModelAttributes_ApplyToModel(
+                modelAttrs,
+                loadedProp->model,
+                MODEL_LIGHT_VECTOR_1 | MODEL_LIGHT_VECTOR_2 | MODEL_LIGHT_COLOR_1 | MODEL_LIGHT_COLOR_2 | MODEL_DIFFUSE_REFLECT_COLOR | MODEL_AMBIENT_REFLECT_COLOR | MODEL_SPECULAR_REFLECT_COLOR | MODEL_EMISSION_COLOR);
+        }
+
+        MapProp_GetMaterialShapeIDsCount(loadedProp->modelID, propMatShp, &propMatShpIDsCount);
+        Port_SwapModelCulling(loadedProp->model);
+
+        if (propMatShpIDsCount == 0) {
+            Easy3D_DrawRenderObj(&loadedProp->renderObj, &position, &rotationMatrix, &scale);
+        } else {
+            MapPropManager_RenderUsing1Mat1Shp(loadedProp->model, &position, &rotationMatrix, &scale, propMatShp, loadedProp->modelID);
+        }
+
+        NNS_G3dGeFlushBuffer();
+        Port_SwapModelCulling(loadedProp->model);
+    }
+}
+#endif
+
 VecFx32 *MapProp_GetRotation(MapProp *mapProp)
 {
     return &mapProp->rotation;
