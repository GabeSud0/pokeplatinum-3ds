+#ifdef SDK_PORT_3DS
+// The wider field (400 pixels across, 3ds_port) sees about 12 tiles each
+// side of the player, the DS's 8: by a map matrix's left or right edge the
+// view goes past the last map, where there is no map to draw, and shows
+// black. In these places the map by the edge is drawn again past it,
+// mirrored left to right about the edge: what's beside the edge on the
+// map (a forest's trees) goes on past it. Only for the matrices listed:
+// past a town's edge, mirrored houses would look wrong.
+static const u8 sPortMirroredEdgeMatrices[] = {
+    7, // Eterna Forest (m_dun0301)
+};
+
+static BOOL Port_MirrorsEdges(const LandDataManager *landDataMan)
+{
+    if (landDataMan->inDistortionWorld) {
+        return FALSE;
+    }
+
+    u8 matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+
+    for (int i = 0; i < (int)NELEMS(sPortMirroredEdgeMatrices); i++) {
+        if (sPortMirroredEdgeMatrices[i] == matrixID) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+// The loaded map i drawn again a map's width to the side (dir: 1 right,
+// -1 left), mirrored about its edge on that side.
+static void Port_RenderLoadedMapMirrored(const u8 index, const int dir, const LandDataManager *landDataMan, ModelAttributes *const modelAttrs)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+
+    if (loadedMap->valid != TRUE) {
+        return;
+    }
+
+    VecFx32 position = { 0, 0, 0 };
+
+    LandDataManager_CalculateRenderingPosition(loadedMap->mapMatrixIndex, landDataMan->mapMatrixWidth, landDataMan->mapMatrix, &position);
+
+    position.x += landDataMan->offset.x + dir * MAP_TILES_COUNT_X * MAP_OBJECT_TILE_SIZE;
+    position.y += landDataMan->offset.y;
+    position.z += landDataMan->offset.z;
+
+    VecFx32 scale = { -FX32_ONE, FX32_ONE, FX32_ONE };
+    MtxFx33 rotationMatrix = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+    NNSG3dResMdl *model = loadedMap->mapRenderObj.resMdl;
+
+    Port_SwapModelCulling(model);
+    Easy3D_DrawRenderObj(&loadedMap->mapRenderObj, &position, &rotationMatrix, &scale);
+    NNS_G3dGeFlushBuffer();
+    Port_SwapModelCulling(model);
+
+    if (loadedMap->mapPropManager != NULL) {
+        MapPropManager_RenderMirrored(&position, landDataMan->areaDataMan, AreaDataManager_IsOutdoorsLighting(landDataMan->areaDataMan), modelAttrs, loadedMap->mapPropManager);
+    }
+}
+
+// With the player in the half of a map by the matrix's left or right
+// edge that's nearer it, the loaded maps in that column drawn past it.
+static void Port_RenderMirroredEdges(const LandDataManager *landDataMan, ModelAttributes *const modelAttrs)
+{
+    if (NitroPort_WideScreenExtra() == 0 || !Port_MirrorsEdges(landDataMan)
+        || landDataMan->trackedTargetMapMatrixIndex == INVALID_MAP_MATRIX_INDEX) {
+        return;
+    }
+
+    int width = landDataMan->mapMatrixWidth;
+    int column = (int)landDataMan->trackedTargetMapMatrixIndex % width;
+    u8 quadrant = landDataMan->trackedTargetMapQuadrant;
+    BOOL rightHalf = quadrant == QUADRANT_TOP_RIGHT || quadrant == QUADRANT_BOTTOM_RIGHT;
+    int dir;
+
+    if (column == width - 1 && rightHalf) {
+        dir = 1;
+    } else if (column == 0 && !rightHalf) {
+        dir = -1;
+    } else {
+        return;
+    }
+
+    for (u8 i = 0; i < QUADRANT_COUNT; i++) {
+        int index = landDataMan->loadedMaps[i]->mapMatrixIndex;
+
+        if (index != INVALID_MAP_MATRIX_INDEX && index % width == column) {
+            Port_RenderLoadedMapMirrored(i, dir, landDataMan, modelAttrs);
+        }
+    }
+}
+#endif
+
