 {
     VarsFlags *varsFlags = SaveData_GetVarsFlags(fieldSystem->saveData);
 
+#ifdef SDK_PORT_3DS
+    // The flags read once, in one read, and kept (they're the cartridge's):
+    // the 3DS remaster's lower menu works the checks out as the player walks
+    // (start_menu.c), and each read of the cartridge costs the port the DS's
+    // time for it.
+    static TownMapDescriptionFlags allFlags[NELEMS(ctx->descCheckResults)];
+    static int numFlags = -1;
+    TownMapDescriptionFlags *descFlags;
+
+    if (numFlags < 0) {
+        FSFile flagsFile;
+        int count = 0;
+
+        FS_InitFile(&flagsFile);
+
+        if (!FS_OpenFile(&flagsFile, flagsFilePath)) {
+            GF_ASSERT(FALSE);
+            return;
+        }
+
+        if (FS_ReadFile(&flagsFile, &count, sizeof(int)) != sizeof(int) || count < 0) {
+            count = 0;
+        }
+
+        count = count < (int)NELEMS(allFlags) ? count : (int)NELEMS(allFlags);
+        MI_CpuClear8(allFlags, sizeof(allFlags));
+        FS_ReadFile(&flagsFile, allFlags, sizeof(TownMapDescriptionFlags) * count);
+        FS_CloseFile(&flagsFile);
+        numFlags = count;
+    }
+
+    ctx->numDescChecks = numFlags;
+
+    for (int i = 0; i < numFlags; i++) {
+        TownMapLocationDescCheckResults *checksResult = &(ctx->descCheckResults[i]);
+        descFlags = &allFlags[i];
+#else
     FSFile flagsFile;
     FS_InitFile(&flagsFile);
 
@@ -167,22 +204,6 @@ static void PerformTownMapDescriptionsChecks(FieldSystem *fieldSystem, TownMapCo
     int readLength = FS_ReadFile(&flagsFile, &numFlags, sizeof(int));
     GF_ASSERT(readLength >= 0);
 
-#ifdef SDK_PORT_3DS
-    // The flags in one read, not one each: each read of the cartridge costs
-    // the port the DS's time for it (the 3DS remaster's lower menu works
-    // them out as the player walks: start_menu.c).
-    TownMapDescriptionFlags *allFlags = Heap_AllocAtEnd(HEAP_ID_FIELD2, sizeof(TownMapDescriptionFlags) * (numFlags > 0 ? numFlags : 1));
-    TownMapDescriptionFlags *descFlags;
-
-    MI_CpuClear8(allFlags, sizeof(TownMapDescriptionFlags) * (numFlags > 0 ? numFlags : 1));
-    readLength = FS_ReadFile(&flagsFile, allFlags, sizeof(TownMapDescriptionFlags) * numFlags);
-
-    ctx->numDescChecks = numFlags;
-
-    for (int i = 0; i < numFlags; i++) {
-        TownMapLocationDescCheckResults *checksResult = &(ctx->descCheckResults[i]);
-        descFlags = &allFlags[i];
-#else
     TownMapDescriptionFlags *descFlags = Heap_AllocAtEnd(HEAP_ID_FIELD2, sizeof(TownMapDescriptionFlags));
     MI_CpuClear8(descFlags, sizeof(TownMapDescriptionFlags));
 
@@ -216,10 +237,8 @@ static void PerformTownMapDescriptionsChecks(FieldSystem *fieldSystem, TownMapCo
         }
     }
 
+#ifndef SDK_PORT_3DS
     FS_CloseFile(&flagsFile);
-#ifdef SDK_PORT_3DS
-    Heap_Free(allFlags);
-#else
     Heap_Free(descFlags);
 #endif
 }
