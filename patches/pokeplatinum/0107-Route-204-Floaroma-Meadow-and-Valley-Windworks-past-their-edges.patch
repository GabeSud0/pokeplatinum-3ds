@@ -1947,6 +2001,12 @@ static BOOL Port_SceneryMirroredOver(const LandDataManager *landDataMan, u8 inde
         if (dir != 0 && landDataMan->loadedMaps[i]->mapMatrixIndex + dir == mapMatrixIndex) {
             return TRUE;
         }
+
+        dir = i == index ? 0 : Port_MirrorSideBelowMirrored(landDataMan, i);
