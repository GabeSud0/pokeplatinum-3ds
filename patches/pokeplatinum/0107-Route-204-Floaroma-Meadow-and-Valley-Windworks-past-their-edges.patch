+        if (dir != 0 && landDataMan->loadedMaps[i]->mapMatrixIndex + dir == mapMatrixIndex) {
+            return TRUE;
+        }
     }
 
     return FALSE;
@@ -2495,7 +2555,7 @@ static void Port_MirroredWaterShape(NNSG3dRS *rs)
