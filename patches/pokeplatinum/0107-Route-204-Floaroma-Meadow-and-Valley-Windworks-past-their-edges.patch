 {
     LoadedMap *loadedMap = landDataMan->loadedMaps[index];
-    int width = landDataMan->mapMatrixWidth, mapMatrixIndex = loadedMap->mapMatrixIndex, dir, i;
+    int width = landDataMan->mapMatrixWidth, mapMatrixIndex = loadedMap->mapMatrixIndex, dir;
 
     if (NitroPort_WideScreenExtra() == 0 || landDataMan->inDistortionWorld || mapMatrixIndex == INVALID_MAP_MATRIX_INDEX
         || loadedMap->valid == TRUE || landDataMan->trackedTargetMapMatrixIndex == INVALID_MAP_MATRIX_INDEX
@@ -2504,16 +2564,13 @@ static int Port_MirrorSideWhileRead(const LandDataManager *landDataMan, u8 index
     }
 
     u16 header = MapMatrix_GetMapHeaderIDAtIndex(landDataMan->mapMatrix, mapMatrixIndex);
+    u8 quadrant = landDataMan->trackedTargetMapQuadrant;
+    dir = quadrant == QUADRANT_TOP_RIGHT || quadrant == QUADRANT_BOTTOM_RIGHT ? 1 : -1;
 
-    for (i = 0; i < (int)NELEMS(sPortMirroredBesideScenery) && sPortMirroredBesideScenery[i] != header; i++) { }
-
-    if (i == (int)NELEMS(sPortMirroredBesideScenery)) {
