+// Room for a berry patch beside the player's map (map_object.h,
+// MAP_OBJ_STATUS_PORT_NEIGHBOUR) by the picture its berry shows now
+// (BerryPatchGraphics_PortPictureOf; 0xffff: none, nothing planted or only
+// just): that picture in already, or a place for it with places left for
+// the pictures the player's map's own people may still need (its events'
+// not in now: the ones its scripts bring on) and two more. Nothing
+// loading. With five places kept for any berry's picture instead
+// (MapObjectGfx_PortHasRoom), the four in Solaceon Town by its south
+// entrance were never brought from Route 209 (five places free, three
+// pictures new): they popped in at the zone change, in sight (2026-11-05).
+BOOL MapObjectGfx_PortHasRoomForBerry(const MapObjectManager *mapObjMan, int pictureID, int ownCount, const ObjectEvent *own)
+{
+    UnkStruct_ov5_021ED0A4 *gfx = sub_0206285C(mapObjMan);
+    u16 seen[64];
+    int i, j, need = 0, nSeen = 0;
+
+    if (ov5_PortLoading(gfx)) {
         return FALSE;
     }
 
-    {
-        int model = ov5_021EDD2C(graphicsID), frames = ov5_021EDD38(graphicsID);
+    if (pictureID == 0xffff) {
+        return TRUE;
+    }
 
-        if (ov5_021ED598(gfx, model) == 0 && ov5_021ED5E8(gfx, model) == 0
-            && ov5_PortFreeOf(&ov5_021EDCBC(gfx)[ov5_021EDCC8(gfx)], ov5_021EDCD0(gfx)) < 2) {
-            return FALSE;
+    for (i = 0; i < ownCount && own != NULL; i++) {
+        int graphicsID = ObjectEvent_GetGraphicsID(&own[i]);
+        const ObjectEventGfxRenderDetailsEntry *details = gObjectEventGfxRenderDetailsTable;
+
+        while (details->graphicsID != 0xffff && details->graphicsID != graphicsID) {
+            details++;
         }
 
-        if (ov5_021ED6D4(gfx, frames) == 0 && ov5_021ED724(gfx, frames) == 0
-            && ov5_PortFreeOf(&ov5_021EDCC0(gfx)[ov5_021EDCD8(gfx)], ov5_021EDCE0(gfx)) < 2) {
-            return FALSE;
+        // (berry patches aside: theirs are made with their map, and a new
+        // one as a berry grows takes the old one's place)
+        if (details->graphicsID == 0xffff || details->modelType != MODEL_TYPE_BILLBOARD
+            || BerryPatchGraphics_IsBerryPatch(graphicsID) == TRUE
+            || ov5_021ED810(gfx, graphicsID) != 0 || ov5_021ED924(gfx, graphicsID) != 0) {
+            continue;
+        }
+
+        for (j = 0; j < nSeen && seen[j] != graphicsID; j++) { }
+
+        if (j == nSeen) {
+            if (nSeen < (int)NELEMS(seen)) {
+                seen[nSeen++] = (u16)graphicsID;
+            }
+
+            need++;
         }
     }
 
-    return TRUE;
+    return ov5_PortRoomForPicture(gfx, pictureID, 1 + need + 2);
 }
 
