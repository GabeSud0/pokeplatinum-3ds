 // or room for them with places left for the game's own (this field's places
@@ -2110,13 +2152,9 @@ BOOL MapObjectGfx_PortHasRoom(const MapObjectManager *mapObjMan, int graphicsID)
 {
     UnkStruct_ov5_021ED0A4 *gfx = sub_0206285C(mapObjMan);
     const ObjectEventGfxRenderDetailsEntry *details = gObjectEventGfxRenderDetailsTable;
-    UnkStruct_ov5_021EDF3C *loading = gfx->unk_100;
