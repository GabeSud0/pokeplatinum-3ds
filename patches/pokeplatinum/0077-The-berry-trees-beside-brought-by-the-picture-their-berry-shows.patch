 #define PORT_NEIGHBOUR_MAPS   4
@@ -1160,6 +1163,25 @@ static void FieldMap_PortKeepHiddenInSight(FieldSystem *fieldSystem, enum MapHea
     }
 }
 
+// Room for the picture of someone beside: a berry patch's is the one its
+// berry shows now (its patch's in the save, by its event's data), with
+// room kept for what the player's map's own may still need.
+static BOOL FieldMap_PortHasRoom(FieldSystem *fieldSystem, const ObjectEvent *e)
+{
+    int graphicsID = ObjectEvent_GetGraphicsID(e);
+
+    if (BerryPatchGraphics_IsBerryPatch(graphicsID) == TRUE) {
+        const BerryPatch *patches = MiscSaveBlock_GetBerryPatches(fieldSystem->saveData);
+        int patchID = ObjectEvent_GetDataAt(e, 0);
+
+        return MapObjectGfx_PortHasRoomForBerry(fieldSystem->mapObjMan,
+            BerryPatchGraphics_PortPictureOf(BerryPatches_GetPatchBerryID(patches, patchID), BerryPatches_GetPatchGrowthStage(patches, patchID)),
+            MapHeaderData_GetNumObjectEvents(fieldSystem), MapHeaderData_GetObjectEvents(fieldSystem));
+    }
+
+    return MapObjectGfx_PortHasRoom(fieldSystem->mapObjMan, graphicsID);
+}
+
 // The people of the maps beside the player's, on the 3DS's wider field
 // (map_object.h, MAP_OBJ_STATUS_PORT_NEIGHBOUR): every frame, the ones out
 // of reach dropped, and one more of those in reach brought from their map's
@@ -1335,7 +1357,7 @@ static void FieldMap_PortNeighbours(FieldSystem *fieldSystem)
                 continue;
             }
 
-            if (!MapObjectGfx_PortHasRoom(mapObjMan, ObjectEvent_GetGraphicsID(e))) {
+            if (!FieldMap_PortHasRoom(fieldSystem, e)) {
                 sWait = 4; // (pictures loading, or no room: soon again)
                 continue;
             }
diff --git a/src/overlay005/ov5_021ECE40.c b/src/overlay005/ov5_021ECE40.c
index 04528579..594ef00a 100644
--- a/src/overlay005/ov5_021ECE40.c
+++ b/src/overlay005/ov5_021ECE40.c
@@ -2101,6 +2101,48 @@ static int ov5_PortFreeOf(const int *list, int count)
     return n;
 }
 
+// Pictures loading now.
+static BOOL ov5_PortLoading(UnkStruct_ov5_021ED0A4 *gfx)
+{
+    UnkStruct_ov5_021EDF3C *loading = gfx->unk_100;
+    int i;
+
+    for (i = 0; i < loading->unk_00; i++) {
+        if (loading->unk_08[i].unk_04 != NULL || loading->unk_0C[i].unk_0C != NULL) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+// Room for a billboard picture (graphicsID's: its texture, model and
+// frames): each in already, or a place for it with places left for the
+// game's own (a new texture: texFree of them free at least).
+static BOOL ov5_PortRoomForPicture(UnkStruct_ov5_021ED0A4 *gfx, int graphicsID, int texFree)
+{
+    if (ov5_021ED810(gfx, graphicsID) == 0 && ov5_021ED924(gfx, graphicsID) == 0
+        && ov5_PortFreeOf(&ov5_021EDCB8(gfx)[ov5_021EDCE8(gfx)], ov5_021EDCF0(gfx)) < texFree) {
+        return FALSE;
+    }
+
+    {
+        int model = ov5_021EDD2C(graphicsID), frames = ov5_021EDD38(graphicsID);
+
+        if (ov5_021ED598(gfx, model) == 0 && ov5_021ED5E8(gfx, model) == 0
+            && ov5_PortFreeOf(&ov5_021EDCBC(gfx)[ov5_021EDCC8(gfx)], ov5_021EDCD0(gfx)) < 2) {
+            return FALSE;
+        }
+
+        if (ov5_021ED6D4(gfx, frames) == 0 && ov5_021ED724(gfx, frames) == 0
+            && ov5_PortFreeOf(&ov5_021EDCC0(gfx)[ov5_021EDCD8(gfx)], ov5_021EDCE0(gfx)) < 2) {
+            return FALSE;
+        }
+    }
+
+    return TRUE;
+}
+
 // Room for someone of a map beside the player's, on the 3DS's wider field
