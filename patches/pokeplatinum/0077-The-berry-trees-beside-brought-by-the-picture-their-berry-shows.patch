diff --git a/src/berry_patch_graphics.c b/src/berry_patch_graphics.c
index abbbd864..c957022a 100644
--- a/src/berry_patch_graphics.c
+++ b/src/berry_patch_graphics.c
@@ -230,6 +230,23 @@ static int BerryPatchGraphics_GetGraphicsResourceID(int berryID, enum BerryGrowt
     return 0xffff;
 }
 
+#ifdef SDK_PORT_3DS
+#include "constants/items.h"
+
+// (the 3DS port) The picture a berry patch shows with this berry at this
+// stage (0xffff: none), for one of a map beside the player's before it's
+// made (MapObjectGfx_PortHasRoomForBerry).
+int BerryPatchGraphics_PortPictureOf(int berryID, enum BerryGrowthStage growthStage)
+{
+    if (growthStage != BERRY_GROWTH_STAGE_NONE && growthStage != BERRY_GROWTH_STAGE_PLANTED
+        && (berryID < 1 || berryID > NUM_BERRIES)) {
+        return 0xffff;
+    }
+
+    return BerryPatchGraphics_GetGraphicsResourceID(berryID, growthStage);
+}
+#endif
+
 Billboard *BerryPatchGraphics_GetGraphicsObject(MapObject *mapObject)
 {
     Billboard *graphicsObject = NULL;
diff --git a/src/overlay005/fieldmap.c b/src/overlay005/fieldmap.c
index 6edac13f..9c96f2de 100644
--- a/src/overlay005/fieldmap.c
+++ b/src/overlay005/fieldmap.c
@@ -995,6 +995,9 @@ static BOOL FieldMap_InDistortionWorld(FieldSystem *fieldSystem)
 }
 
 #ifdef SDK_PORT_3DS
