+        return FALSE;
     }
 
     while (details->graphicsID != 0xffff && details->graphicsID != PortFollower_DetailsGfx(graphicsID)) {
@@ -2138,26 +2176,61 @@ BOOL MapObjectGfx_PortHasRoom(const MapObjectManager *mapObjMan, int graphicsID)
             && ov5_PortFreeOf(&ov5_021EDCC0(gfx)[ov5_021EDCD8(gfx)], ov5_021EDCE0(gfx)) >= 2;
     }
 
-    if (ov5_021ED810(gfx, graphicsID) == 0 && ov5_021ED924(gfx, graphicsID) == 0
-        && ov5_PortFreeOf(&ov5_021EDCB8(gfx)[ov5_021EDCE8(gfx)], ov5_021EDCF0(gfx)) < 6) {
+    return ov5_PortRoomForPicture(gfx, graphicsID, 6);
+}
