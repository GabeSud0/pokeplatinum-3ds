+// The second square's item, if the bag has it (the port keeps it, not the
+// save: another adventure's, or one not had yet, isn't shown). Looked up
+// again when it changes or the field starts (Bag_CanRemoveItem reads the
+// item's data).
+static BOOL StartMenu_PortItem2Owned(FieldSystem *fieldSystem, u16 item)
+{
+    if (item != sPortItem2Key) {
+        sPortItem2Key = item;
+        sPortItem2Owned = item != ITEM_NONE && item < NUM_ITEMS &&
+            Bag_CanRemoveItem(SaveData_GetBag(fieldSystem->saveData), item, 1, HEAP_ID_FIELD2);
+    }
+
+    return sPortItem2Owned;
+}
+
+u16 StartMenu_PortSquareItem(FieldSystem *fieldSystem, int square)
+{
+    u16 registered = (u16)Bag_GetRegisteredItem(SaveData_GetBag(fieldSystem->saveData));
+    u16 item = (u16)NitroPort_Option(PORT_OPT_ITEM2);
+
+    if (square == 1) {
+        return registered;
+    }
+
+    return item != registered && StartMenu_PortItem2Owned(fieldSystem, item) ? item : ITEM_NONE;
+}
+
+// The squares' items to the port (their icons), and the squares that can be
+// used now: an item there, and not where Y does nothing (the Battle Tower's
+// salon, the Pal Park).
+static u32 StartMenu_PortSquareButtons(FieldSystem *fieldSystem)
+{
+    BOOL usable = !FieldSystem_IsInBattleTowerSalon(fieldSystem) &&
+        !SystemFlag_CheckInPalPark(SaveData_GetVarsFlags(fieldSystem->saveData));
+    u32 buttons = 0;
+
+    for (int square = 1; square <= 2; square++) {
+        u16 item = StartMenu_PortSquareItem(fieldSystem, square);
+
+        NitroPort_LowerMenuSetItem(square - 1, item, Item_FileID(item, ITEM_FILE_TYPE_ICON), Item_FileID(item, ITEM_FILE_TYPE_PALETTE));
+
+        if (item != ITEM_NONE && usable) {
+            buttons |= 1u << (PORT_BUTTON_ITEM1 + square - 1);
+        }
+    }
+
+    return buttons;
+}
+
+int StartMenu_PortTakeSquarePress(void)
+{
+    int square = sPortSquarePress;
+
+    sPortSquarePress = 0;
+    return square;
+}
+
+void StartMenu_PortRegisterItem(void *bagData, u16 item, BOOL on)
+{
+    Bag *bag = bagData;
+    u16 registered = (u16)Bag_GetRegisteredItem(bag);
+    u16 second = (u16)NitroPort_Option(PORT_OPT_ITEM2);
+
+    // (without the lower menu, as the DS's: no second square)
+    if (!NitroPort_LowerMenuAvailable()) {
+        Bag_RegisterItem(bag, on ? item : ITEM_NONE);
+        return;
+    }
+
+    if (on) {
+        // On Y; the one that was there to the second square (or, the item
+        // the second's, the second's empty now).
+        Bag_RegisterItem(bag, item);
+
+        if (registered != ITEM_NONE && registered != item) {
+            second = registered;
+        } else if (second == item) {
+            second = ITEM_NONE;
+        }
+    } else if (registered == item) {
+        Bag_RegisterItem(bag, ITEM_NONE);
+    } else if (second == item) {
+        second = ITEM_NONE;
+    }
+
+    if (second != NitroPort_Option(PORT_OPT_ITEM2)) {
+        NitroPort_OptionSet(PORT_OPT_ITEM2, second);
+        NitroPort_OptionsSave();
+    }
+}
