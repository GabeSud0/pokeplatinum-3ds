From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Sun, 8 Nov 2026 23:55:00 -0700
Subject: [PATCH] Route 210 North's terraces go on south (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Route 210 North's south-west map ends in terraces 4 to 8 tiles high over
the low mountain filler west of Route 210 South (3 high), with no sides
under them: black at the top of Route 210 South. Its terraces by the
south-east corner are drawn on south 5 tiles (a column extrusion can now
reach less than PORT_EXTRUDE_REACH_Z: reachZ; past 5 tiles they'd be seen
from where the map isn't loaded), and the filler's ground is drawn on
north under the map's last rows (a piece of it moved north), seen under
their ends instead of nothing.
---
diff --git a/src/overlay005/land_data.c b/src/overlay005/land_data.c
index c5dfdafe..3945d486 100644
--- a/src/overlay005/land_data.c
+++ b/src/overlay005/land_data.c
@@ -3547,6 +3547,7 @@ typedef struct PortExtrudeCopy {
     s8 bandLo, bandHi;  // (the band's rows; drawn again bandCopies times north, every their depth)
     u8 bandCopies;
     s8 colLo, colHi;    // (drawn on north or south: only the polygons centred in these columns, tiles from the map's middle; -16 to 16 all)
+    u8 reachZ;          // (tiles drawn on north or south: PORT_EXTRUDE_REACH_Z, or less)
     BOOL outdoors;      // (lit by the time of day, as the area's maps are)
     int numShp, nextShape;
     s32 tile;           // (a tile in the model's coordinates)
@@ -3679,7 +3680,7 @@ static BOOL Port_ExtrudeListRepeat(const PortExtrudeCopy *copy, PortExtrudeList
     int pitchX, int pitchZ, int fillDir, int fillCount, int fillStep, int firstX, int shiftZ16)
 {
     int stepsX = pitchX > 0 ? (PORT_EXTRUDE_REACH_X + pitchX - 1) / pitchX : 0;
-    int stepsZ = pitchZ > 0 ? (PORT_EXTRUDE_REACH_Z + pitchZ - 1) / pitchZ : 0;
+    int stepsZ = pitchZ > 0 ? (copy->reachZ + pitchZ - 1) / pitchZ : 0;
     BOOL ok = TRUE;
 
     for (int b = copy->band > 0 ? 1 : 0; b <= (copy->band > 0 ? copy->bandCopies : 0) && ok; b++) {
@@ -4176,6 +4177,7 @@ typedef struct PortExtrudeColumns {
     u16 mapMatrixIndex;
     s8 dirZ;
     s8 colLo, colHi;
+    u8 reachZ; // (0: PORT_EXTRUDE_REACH_Z)
 } PortExtrudeColumns;
 
 static const PortExtrudeColumns sPortExtrudeColumns[] = {
@@ -4184,6 +4186,7 @@ static const PortExtrudeColumns sPortExtrudeColumns[] = {
     { 0, 670, 1, -3, 16 },  // (and its cliffs and plateau, south over the mountain's filler)
     { 0, 369, 1, 4, 16 },   // (Route 216's west map: its terraces by the south edge, south over the snowy forest's filler (its trees there left out: sPortMapCuts))
     { 0, 370, 1, -16, 16 }, // (and its middle map's, south over the high snow's filler (left out there: sPortMapCuts))
+    { 0, 496, 1, 8, 16, 5 }, // (Route 210 North's south-west map: its terraces by the south-east corner, 5 tiles south over the low filler: past that seen only from where the map isn't loaded)
     { 0, 697, 1, 8, 16 },   // (Route 203's east map: its dirt and the plateau's cliff by the south-east corner, south over the forest's filler)
 };
 
@@ -4293,6 +4296,7 @@ static PortExtrudeCopy *Port_ExtrudeCopyFor(const LandDataManager *landDataMan,
 
     copy->colLo = columns != NULL ? columns->colLo : -MAP_TILES_COUNT_X / 2;
     copy->colHi = columns != NULL ? columns->colHi : MAP_TILES_COUNT_X / 2;
+    copy->reachZ = columns != NULL && columns->reachZ != 0 ? columns->reachZ : PORT_EXTRUDE_REACH_Z;
 
     if (forest != NULL) {
         copy->bandLo = forest->bandLo;
@@ -6739,6 +6743,7 @@ static const PortMapPiece sPortMapPieces[] = {
     { 0, 672, 8, { 116, 140, 254, 258 }, 2, 116, 2, 3, 0, 144, 0, 0, 1, 0 }, // (and on east along the forest, to x 418)
     { 0, 676, 4, { 174, 204, 62, 68 }, 6, 0, 1, 1, 0, 32, 0, -64, 1, 0 },    // (Route 209: its river's top, x 538-541: the north-west corner and the top)
     { 0, 677, 3, { 76, 82, 62, 68 }, 4, 0, 1, 1, 0, -96, 0, -64, 1, 0 },     // (the north-east corner, from the map east of it)
+    { 0, 526, 0, { 0, 256, 64, 128 }, 4, 0, 1, 1, 0, 0, 0, -128, 1, 0 },  // (Route 210 North's south-west map: the low filler's ground under its last rows, seen under its terraces' ends)
     { 0, 669, 2, { 32, 64, 0, 8 }, 1, 0, 1, 1, 0, -288, 0, 224, 8, 0, 32 },   // (Route 207's west map: the rim facing south, x 256-287, z 732)
     { 0, 669, 4, { 24, 56, 192, 224 }, 1, 0, 1, 1, 0, -280, 8, 0, 8, 0, 32 }, // (the ground north of it, a tile higher, z 728-731)
     { 0, 669, 4, { 24, 56, 224, 256 }, 1, 0, 1, 1, 0, -280, 0, 0, 8, 0, 32 }, // (and south of it, z 732-735: under the rim)
