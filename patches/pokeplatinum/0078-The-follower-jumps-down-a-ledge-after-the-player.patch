 #include "res/sound/pl_sound_data.naix"
 
 typedef struct MoveAnimData {
@@ -950,20 +954,54 @@ static BOOL MovementAction_JumpNearFastEast_Step0(MapObject *mapObj)
     return TRUE;
 }
 
+#ifdef SDK_PORT_3DS
+// The follower Pokémon down a ledge after the player (port_follower.c): the
+// 2 tiles in the player's step's time.
+static BOOL MovementAction_PortFollowerJump(MapObject *mapObj, int dir)
+{
+    int frames = PortFollower_JumpFrames(mapObj);
+
+    if (frames <= 0) {
+        return FALSE;
+    }
+
+    MovementAction_InitJump(mapObj, dir, FX32_CONST(32) / frames, frames, MAP_OBJ_UNK_A0_03, JUMP_HEIGHT_HIGH, 0x1000 / frames);
+    return TRUE;
+}
+#endif
+
 static BOOL MovementAction_JumpFarNorth_Step0(MapObject *mapObj)
 {
+#ifdef SDK_PORT_3DS
+    if (MovementAction_PortFollowerJump(mapObj, DIR_NORTH)) {
+        return TRUE;
+    }
+#endif
+
     MovementAction_InitJump(mapObj, DIR_NORTH, FX32_CONST(2), 8 * 2, MAP_OBJ_UNK_A0_03, JUMP_HEIGHT_HIGH, 0x100);
     return TRUE;
 }
 
 static BOOL MovementAction_JumpFarSouth_Step0(MapObject *mapObj)
 {
+#ifdef SDK_PORT_3DS
+    if (MovementAction_PortFollowerJump(mapObj, DIR_SOUTH)) {
+        return TRUE;
+    }
+#endif
+
     MovementAction_InitJump(mapObj, DIR_SOUTH, FX32_CONST(2), 16, MAP_OBJ_UNK_A0_03, JUMP_HEIGHT_HIGH, 0x100);
     return TRUE;
 }
 
 static BOOL MovementAction_JumpFarWest_Step0(MapObject *mapObj)
 {
+#ifdef SDK_PORT_3DS
+    if (MovementAction_PortFollowerJump(mapObj, DIR_WEST)) {
+        return TRUE;
+    }
+#endif
+
     MovementAction_InitJump(mapObj, DIR_WEST, FX32_CONST(2), 16, MAP_OBJ_UNK_A0_03, JUMP_HEIGHT_HIGH, 0x100);
 
     return TRUE;
@@ -971,6 +1009,12 @@ static BOOL MovementAction_JumpFarWest_Step0(MapObject *mapObj)
 
 static BOOL MovementAction_JumpFarEast_Step0(MapObject *mapObj)
 {
+#ifdef SDK_PORT_3DS
+    if (MovementAction_PortFollowerJump(mapObj, DIR_EAST)) {
+        return TRUE;
+    }
+#endif
+
     MovementAction_InitJump(mapObj, DIR_EAST, FX32_CONST(2), 16, MAP_OBJ_UNK_A0_03, JUMP_HEIGHT_HIGH, 0x100);
     return TRUE;
 }
