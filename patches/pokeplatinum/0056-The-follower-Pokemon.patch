+#ifndef POKEPLATINUM_PORT_FOLLOWER_H
+#define POKEPLATINUM_PORT_FOLLOWER_H
+
+#ifdef SDK_PORT_3DS
+#include "field/field_system_decl.h"
+#include "struct_decls/map_object.h"
+
+// The 3DS remaster's follower Pokémon (OPTIONS: ENHANCEMENTS: FOLLOWER):
+// the party's first Pokémon walks behind the player (port_follower.c).
+//
+// Its sprite is HeartGold and SoulSilver's when the player's data pack has
+// them (builder/followers.py; a port file at PORT_FOLLOWER_PAK_ID, each laid
+// out as Platinum's walking sprites), else Platinum's own for the few it has.
+// HeartGold's are graphics IDs of their own (PORT_FOLLOWER_GFX_FIRST + 2 *
+// sprite + shiny), their files members of the overworld sprites' archive
+// past its own (narc.c: PortFollower_NarcMember), drawn as Pikachu is (or
+// Regigigas: 64 x 64) with Platinum's walk.
+//
+// It's a map object of its own (MAP_OBJ_STATUS_PORT_FOLLOWER, local ID
+// PORT_FOLLOWER_LOCAL_ID) moving as the partner trainers do (Platinum's
+// MOVEMENT_TYPE_FOLLOW_PLAYER's code, its own movement type so scripts never
+// take it for the partner): walked through, never saved, not talked to.
+#define PORT_FOLLOWER_PAK_ID          0x10000000
+#define PORT_FOLLOWER_GFX_FIRST       0x4000 // (past the berry trees' 0x1000 and OBJ_EVENT_GFX_INVISIBLE's 0x2000)
+#define PORT_FOLLOWER_GFX_COUNT       0x800
+#define PORT_FOLLOWER_NARC_FIRST      0x7000 // (no archive has this many members)
+#define PORT_FOLLOWER_LOCAL_ID        0xF3
+#define PORT_FOLLOWER_BALL_LOCAL_ID   0xF4   // (its Poké Ball, seen as it goes in and comes out)
+#define PORT_FOLLOWER_EMOTE_LOCAL_ID  0xF5   // (its bubble, talked to)
+// Its Poké Ball: each kind as the battles draw it, made from the player's
+// ROM (builder/ball_sprites.py: a port file at PORT_FOLLOWER_BALLS_PAK_ID),
+// open facing north and closed the other ways; graphics IDs after the
+// follower sprites' (PORT_FOLLOWER_BALL_GFX_FIRST + ball - 1, then the
+// talk bubbles), their textures archive members after theirs; drawn as
+// the follower sprites are.
+#define PORT_FOLLOWER_BALLS_PAK_ID    0x10000001
+#define PORT_FOLLOWER_BALL_GFX_FIRST  (PORT_FOLLOWER_GFX_FIRST + PORT_FOLLOWER_GFX_COUNT)
+#define PORT_FOLLOWER_BALL_GFX_COUNT  0x40
+#define PORT_MOVEMENT_TYPE_FOLLOW_MON 0x44   // (Platinum's go to 0x43)
+
+BOOL PortFollower_IsGfx(int graphicsID);
+// The Platinum graphics ID whose renderer and details it borrows (Pikachu),
+// and whose model and walk (Pikachu's, or Regigigas's for 64 x 64 ones).
+int PortFollower_DetailsGfx(int graphicsID);
+int PortFollower_ModelGfx(int graphicsID);
+// Its texture's member of the overworld sprites' archive.
+u32 PortFollower_TextureMember(int graphicsID);
+// A member past an archive's own: its bytes (kept till the next call), or NULL.
+const void *PortFollower_NarcMember(u32 memberIndex, u32 *size);
+
+BOOL MapObject_PortIsFollower(const MapObject *mapObj);
+// Its picture made before it has come out of its ball: from nothing (ov5_021ECE40.c).
+BOOL PortFollower_StartsSmall(const MapObject *mapObj);
+// A pressed facing it, out (field_control.c): its cry and a word; TRUE if so.
+BOOL PortFollower_TryTalk(FieldSystem *fieldSystem);
+// The ball's burst drawn (fieldmap.c, after the billboards), and freed as the
+// field ends (FieldMap_Exit).
+void PortFollower_Draw(void);
+void PortFollower_FieldEnds(void);
+// Every frame of the field (fieldmap.c): out, in its ball or swapped as the
+// party, the option and the field are.
+void PortFollower_Update(FieldSystem *fieldSystem);
+#endif
+
+#endif // POKEPLATINUM_PORT_FOLLOWER_H
