+// The port's own files in the data pack (port_fs.c).
+extern u32 NitroPort_PakOwnFileSize(u32 id);
+extern BOOL NitroPort_PakOwnFileRead(u32 id, u32 offset, void *dest, u32 size);
+extern void NitroPort_Log(const char *fmt, ...);
+
+// The data pack's follower file (builder/followers.py, make_bundle):
+// 'PFOL', u16 version, u16 species, u32 sprites, u32 0; species x {u16
+// first sprite, u8 forms after it, u8 females' own}; sprites x {u32 offset,
+// u32 size, u8 width, u8 height, u16 0}; the sprites (NSBTX, Platinum's
+// walking sprites' layout: 16 textures; palettes normal, shiny).
+#define BUNDLE_VERSION   1
+#define BUNDLE_SPECIES   493
+#define BUNDLE_SPRITES   (PORT_FOLLOWER_GFX_COUNT / 2)
+#define SPRITE_BYTES_MAX (16 + 4 + 0x3C + 0x400 + 0x80 + 64 * 64 / 2 * 8 + 64)
+
+typedef struct BundleSpecies {
+    u16 first;
+    u8 forms;
+    u8 female;
+} BundleSpecies;
+
+typedef struct BundleSprite {
+    u32 offset;
+    u32 size;
+    u8 width;
+    u8 height;
+    u16 pad;
+} BundleSprite;
+
+static int sBundleState; // 0 not looked for, 1 there, -1 none
+static u32 sBundleSprites;
+static BundleSpecies sSpecies[BUNDLE_SPECIES];
+static BundleSprite sSprites[BUNDLE_SPRITES];
+static u32 sMemberCached = 0xffffffff; // (PortFollower_NarcMember's)
+static u32 sMemberSize;
+static u32 sMember[SPRITE_BYTES_MAX / 4];
+
+static BOOL Bundle_Ready(void)
+{
+    u32 head[4];
+
+    if (sBundleState != 0) {
+        return sBundleState > 0;
+    }
+
+    sBundleState = -1;
+
+    if (NitroPort_PakOwnFileSize(PORT_FOLLOWER_PAK_ID) < sizeof(head)
+        || !NitroPort_PakOwnFileRead(PORT_FOLLOWER_PAK_ID, 0, head, sizeof(head))) {
+        NitroPort_Log("[follower] no HeartGold/SoulSilver sprites in the data pack: Platinum's own only");
+        return FALSE;
+    }
+
+    if (memcmp(head, "PFOL", 4) != 0 || (head[1] & 0xffff) != BUNDLE_VERSION || (head[1] >> 16) != BUNDLE_SPECIES
+        || head[2] == 0 || head[2] > BUNDLE_SPRITES) {
+        NitroPort_Log("[follower] the data pack's follower sprites aren't this version's: rebuild the data pack");
+        return FALSE;
+    }
+
+    sBundleSprites = head[2];
+
+    if (!NitroPort_PakOwnFileRead(PORT_FOLLOWER_PAK_ID, 16, sSpecies, sizeof(sSpecies))
+        || !NitroPort_PakOwnFileRead(PORT_FOLLOWER_PAK_ID, 16 + sizeof(sSpecies), sSprites, sizeof(BundleSprite) * sBundleSprites)) {
+        return FALSE;
+    }
+
+    sBundleState = 1;
+    NitroPort_Log("[follower] %u HeartGold/SoulSilver sprites", (unsigned)sBundleSprites);
+    return TRUE;
+}
+
+BOOL PortFollower_IsGfx(int graphicsID)
+{
+    return graphicsID >= PORT_FOLLOWER_GFX_FIRST && graphicsID < PORT_FOLLOWER_BALL_GFX_FIRST + PORT_FOLLOWER_BALL_GFX_COUNT;
+}
+
+// The data pack's ball file (builder/ball_sprites.py, make_file): 'PFBL',
+// u16 version, u16 0, u32 sprites, u32 0; sprites x {u32 offset, u32 size};
+// the sprites (NSBTX, as the follower sprites).
+#define BALLS_VERSION 2 // (2: one sprite a ball, open facing north)
+
+static int sBallsState; // 0 not looked for, 1 there, -1 none
+static u32 sBallsCount;
+static u32 sBallsDir[PORT_FOLLOWER_BALL_GFX_COUNT][2];
+
+static BOOL Balls_Ready(void)
+{
+    u32 head[4];
+
+    if (sBallsState != 0) {
+        return sBallsState > 0;
+    }
+
+    sBallsState = -1;
+
+    if (NitroPort_PakOwnFileSize(PORT_FOLLOWER_BALLS_PAK_ID) < sizeof(head)
+        || !NitroPort_PakOwnFileRead(PORT_FOLLOWER_BALLS_PAK_ID, 0, head, sizeof(head))
+        || memcmp(head, "PFBL", 4) != 0 || (head[1] & 0xffff) != BALLS_VERSION || head[2] == 0 || head[2] > PORT_FOLLOWER_BALL_GFX_COUNT
+        || !NitroPort_PakOwnFileRead(PORT_FOLLOWER_BALLS_PAK_ID, 16, sBallsDir, 8 * head[2])) {
+        NitroPort_Log("[follower] no Poke Ball sprites in the data pack: the item ball");
+        return FALSE;
+    }
+
+    sBallsCount = head[2];
+    sBallsState = 1;
+    return TRUE;
+}
+
+static u32 PortFollower_Sprite(int graphicsID)
+{
+    return (u32)(graphicsID - PORT_FOLLOWER_GFX_FIRST) / 2;
+}
+
+static BOOL PortFollower_IsBig(int graphicsID)
+{
+    u32 sprite = PortFollower_Sprite(graphicsID);
+    return Bundle_Ready() && sprite < sBundleSprites && sSprites[sprite].width > 32;
+}
+
+int PortFollower_DetailsGfx(int graphicsID)
+{
+    return PortFollower_IsGfx(graphicsID) ? OBJ_EVENT_GFX_PIKACHU : graphicsID;
+}
+
+int PortFollower_ModelGfx(int graphicsID)
+{
+    if (!PortFollower_IsGfx(graphicsID)) {
+        return graphicsID;
+    }
+
+    return PortFollower_IsBig(graphicsID) ? OBJ_EVENT_GFX_REGIGIGAS : OBJ_EVENT_GFX_PIKACHU;
+}
+
+u32 PortFollower_TextureMember(int graphicsID)
+{
+    return PORT_FOLLOWER_NARC_FIRST + (u32)(graphicsID - PORT_FOLLOWER_GFX_FIRST);
+}
+
+const void *PortFollower_NarcMember(u32 memberIndex, u32 *size)
+{
+    u32 n = memberIndex - PORT_FOLLOWER_NARC_FIRST, sprite = n / 2;
+    const BundleSprite *s;
+
+    if (memberIndex >= PORT_FOLLOWER_NARC_FIRST && n >= PORT_FOLLOWER_GFX_COUNT && n < PORT_FOLLOWER_GFX_COUNT + PORT_FOLLOWER_BALL_GFX_COUNT) {
+        // A ball's (open facing north) or a bubble's
+        u32 k = n - PORT_FOLLOWER_GFX_COUNT;
+
+        if (!Balls_Ready() || k >= sBallsCount) {
+            return NULL;
+        }
+
+        if (sMemberCached != memberIndex) {
+            sMemberCached = 0xffffffff;
+
+            if (sBallsDir[k][1] < 0x40 || sBallsDir[k][1] > sizeof(sMember)
+                || !NitroPort_PakOwnFileRead(PORT_FOLLOWER_BALLS_PAK_ID, sBallsDir[k][0], sMember, sBallsDir[k][1])) {
+                return NULL;
+            }
+
+            sMemberSize = sBallsDir[k][1];
+            sMemberCached = memberIndex;
+        }
+
+        *size = sMemberSize;
+        return sMember;
+    }
+
+    if (memberIndex < PORT_FOLLOWER_NARC_FIRST || n >= PORT_FOLLOWER_GFX_COUNT || !Bundle_Ready() || sprite >= sBundleSprites) {
+        return NULL;
+    }
+
+    if (sMemberCached != memberIndex) {
+        s = &sSprites[sprite];
+        sMemberCached = 0xffffffff; // (the buffer's other member gone, whatever comes of the read)
+
+        if (s->size < 0x40 || s->size > sizeof(sMember) || !NitroPort_PakOwnFileRead(PORT_FOLLOWER_PAK_ID, s->offset, sMember, s->size)) {
+            return NULL;
+        }
+
+        sMemberSize = s->size;
+        sMemberCached = memberIndex;
+
+        if (n & 1) {
+            // Shiny: its two palettes' dictionary entries swapped, so the
+            // walk (which shows palette 0) shows the shiny one.
+            u8 *data = (u8 *)sMember;
+            u32 tex = *(u32 *)(data + 16), dict = 0, entries = 0;
+
+            if (tex + 0x3C <= s->size) {
+                dict = tex + *(u32 *)(data + tex + 0x34);
+            }
+
+            if (dict != 0 && dict + 8 <= s->size) {
+                entries = dict + *(u16 *)(data + dict + 6); // (the entries' block: where the tree's header says)
+            }
+
+            if (entries != 0 && data[dict + 1] == 2 && entries + 4 + 8 <= s->size) {
+                u8 *entry = data + entries + 4;
+                u32 first;
+
+                memcpy(&first, entry, 4);
+                memcpy(entry, entry + 4, 4);
+                memcpy(entry + 4, &first, 4);
+            }
+        }
+    }
+
+    *size = sMemberSize;
+    return sMember;
+}
+
+// Platinum's own walking sprites of Pokémon, for a data pack without
+// HeartGold's (the rest stay in their balls).
+static const struct {
+    u16 species;
+    u16 graphicsID;
+} sPlatinumSprites[] = {
+    { SPECIES_PIKACHU, OBJ_EVENT_GFX_PIKACHU },
+    { SPECIES_CLEFAIRY, OBJ_EVENT_GFX_CLEFAIRY },
+    { SPECIES_JIGGLYPUFF, OBJ_EVENT_GFX_JIGGLYPUFF },
+    { SPECIES_PSYDUCK, OBJ_EVENT_GFX_PSYDUCK },
+    { SPECIES_MACHOP, OBJ_EVENT_GFX_MACHOP },
+    { SPECIES_TORCHIC, OBJ_EVENT_GFX_TORCHIC },
+    { SPECIES_SHROOMISH, OBJ_EVENT_GFX_SHROOMISH },
+    { SPECIES_SKITTY, OBJ_EVENT_GFX_SKITTY },
+    { SPECIES_TURTWIG, OBJ_EVENT_GFX_TURTWIG },
+    { SPECIES_GROTLE, OBJ_EVENT_GFX_GROTLE },
+    { SPECIES_TORTERRA, OBJ_EVENT_GFX_TORTERRA },
+    { SPECIES_CHIMCHAR, OBJ_EVENT_GFX_CHIMCHAR },
+    { SPECIES_MONFERNO, OBJ_EVENT_GFX_MONFERNO },
+    { SPECIES_INFERNAPE, OBJ_EVENT_GFX_INFERNAPE },
+    { SPECIES_PIPLUP, OBJ_EVENT_GFX_PIPLUP },
+    { SPECIES_PRINPLUP, OBJ_EVENT_GFX_PRINPLUP },
+    { SPECIES_EMPOLEON, OBJ_EVENT_GFX_EMPOLEON },
+    { SPECIES_PACHIRISU, OBJ_EVENT_GFX_PACHIRISU },
+    { SPECIES_DRIFLOON, OBJ_EVENT_GFX_DRIFLOON },
+    { SPECIES_BUNEARY, OBJ_EVENT_GFX_BUNEARY },
+    { SPECIES_HAPPINY, OBJ_EVENT_GFX_HAPPINY },
+    { SPECIES_CROAGUNK, OBJ_EVENT_GFX_CROAGUNK },
+    { SPECIES_REGIGIGAS, OBJ_EVENT_GFX_REGIGIGAS },
+    { SPECIES_SHAYMIN, OBJ_EVENT_GFX_SHAYMIN },
+};
+
+// The party's first Pokémon's graphics ID, or 0: none (an egg, fainted,
+// or no sprite for it). HeartGold's way (FollowMon_GetSpriteID): a female
+// has her own sprite where the species does, else the form's.
+static int PortFollower_PartyGfx(FieldSystem *fieldSystem, BOOL *big)
+{
+    Party *party = SaveData_GetParty(fieldSystem->saveData);
+    Pokemon *mon;
+    int species, form, i;
+
+    *big = FALSE;
+
+    if (party == NULL || Party_GetCurrentCount(party) == 0) {
+        return 0;
+    }
+
+    mon = Party_GetPokemonBySlotIndex(party, 0);
+
+    if (Pokemon_GetValue(mon, MON_DATA_IS_EGG, NULL) || Pokemon_GetValue(mon, MON_DATA_HP, NULL) == 0) {
+        return 0;
+    }
+
+    species = Pokemon_GetValue(mon, MON_DATA_SPECIES, NULL);
+    form = Pokemon_GetValue(mon, MON_DATA_FORM, NULL);
+
+    if (species < 1 || species > BUNDLE_SPECIES) {
+        return 0;
+    }
+
+    if (Bundle_Ready()) {
+        const BundleSpecies *s = &sSpecies[species - 1];
+        u32 sprite = s->first;
+
+        if (s->female) {
+            sprite += Pokemon_GetGender(mon) == GENDER_FEMALE;
+        } else if (form <= s->forms) {
+            sprite += form;
+        }
+
+        if (sprite >= sBundleSprites) {
+            return 0;
+        }
+
+        *big = sSprites[sprite].width > 32;
+        return PORT_FOLLOWER_GFX_FIRST + 2 * sprite + (Pokemon_IsShiny(mon) ? 1 : 0);
+    }
+
+    for (i = 0; i < (int)NELEMS(sPlatinumSprites); i++) {
+        if (sPlatinumSprites[i].species == species) {
+            *big = species == SPECIES_REGIGIGAS;
+            return sPlatinumSprites[i].graphicsID;
+        }
+    }
+
+    {
+        static int sSaid; // (each species once)
+
+        if (sSaid != species) {
+            sSaid = species;
+            NitroPort_Log("[follower] no sprite for species %d: Platinum has its own for 24 only, the rest come with the data pack (rebuild it with the follower sprites)", species);
+        }
+    }
+
+    return 0;
+}
+
+BOOL MapObject_PortIsFollower(const MapObject *mapObj)
+{
+    return MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_PORT_FOLLOWER) != 0;
+}
+
+// The player jumping down a ledge (2 tiles, or 3): the follower can't keep
+// up with the jump (the follow code goes a tile a step behind), so it waits
+// in its ball and comes out behind them where they stop.
+// (the player's steps aren't map object movements: MapObject_IsMoving is 0)
+static BOOL PortFollower_PlayerStepping(FieldSystem *fieldSystem)
+{
+    int state = PlayerAvatar_GetMoveState(fieldSystem->playerAvatar);
+    return state == PLAYER_MOVE_STATE_START || state == PLAYER_MOVE_STATE_MOVING;
+}
+
+static BOOL PortFollower_PlayerJumping(FieldSystem *fieldSystem, MapObject *player)
+{
+    u32 action = MapObject_GetMovementAction(player); // (the player's map object's own: the jump)
+
+    return PortFollower_PlayerStepping(fieldSystem)
+        && ((action >= MOVEMENT_ACTION_JUMP_FAR_NORTH && action <= MOVEMENT_ACTION_JUMP_FAR_EAST)
+            || action == MOVEMENT_ACTION_JUMP_FARTHER_WEST || action == MOVEMENT_ACTION_JUMP_FARTHER_EAST);
+}
+
+// (the Pokémon: PORT_FOLLOWER_LOCAL_ID; its ball: PORT_FOLLOWER_BALL_LOCAL_ID)
+static MapObject *PortFollower_FindID(const MapObjectManager *mapObjMan, u32 localID)
+{
+    int i = 0;
+    MapObject *mapObj;
+
+    while (MapObjectMan_FindObjectWithStatus(mapObjMan, &mapObj, &i, MAP_OBJ_STATUS_0) == TRUE) {
+        if (MapObject_PortIsFollower(mapObj) && MapObject_GetLocalID(mapObj) == localID) {
+            return mapObj;
+        }
+    }
+
+    return NULL;
+}
+
+// Where it may be out: walking (not on the bike, surfing or using a field
+// move), with no partner trainer or Amity Square's Pokémon following, not
+// in the Underground, the Union Room or a map with features of its own (the
+// Distortion World, the gyms' puzzles); one 64 x 64 only outdoors.
+static BOOL PortFollower_MayBeOut(FieldSystem *fieldSystem, BOOL big)
+{
+    enum MapHeaderID here = fieldSystem->location->mapHeaderID;
+
+    if (PlayerAvatar_GetPlayerState(fieldSystem->playerAvatar) != PLAYER_AVATAR_WALKING
+        || SystemFlag_CheckHasPartner(SaveData_GetVarsFlags(fieldSystem->saveData))
+        || MapObjMan_GetLocalMapObjByMovementType(fieldSystem->mapObjMan, MOVEMENT_TYPE_FOLLOW_PLAYER) != NULL
+        || here == MAP_HEADER_UNDERGROUND || MapHeader_IsUnionRoom(here)
+        || PersistedMapFeatures_GetID(MiscSaveBlock_GetPersistedMapFeatures(fieldSystem->saveData)) != DYNAMIC_MAP_FEATURES_NONE) {
+        return FALSE;
+    }
+
+    return !big || MapHeader_IsOutdoors(here);
+}
+
+// Its shadow: made yet (PortFollower_Add), and hidden by this file while
+// it's smaller than itself (sShadowWas: as the field had it before).
+static BOOL sShadowMade, sShadowForced, sShadowWas;
+
+static void PortFollower_Remove(FieldSystem *fieldSystem, MapObject *mapObj)
+{
+    MapObject_Delete(mapObj);
+    ov5_021EDA38(fieldSystem->mapObjMan, sub_0206285C(fieldSystem->mapObjMan));
+}
+
+// Out behind the player when the tile behind is free, else on the player's
+// tile, hidden till the player steps off it (walking out of a door: it
+// comes out after them).
+static MapObject *PortFollower_Add(FieldSystem *fieldSystem, int graphicsID)
+{
+    MapObject *player = PlayerAvatar_GetMapObject(fieldSystem->playerAvatar);
+    int x = PlayerAvatar_GetXPos(fieldSystem->playerAvatar);
+    int z = PlayerAvatar_GetZPos(fieldSystem->playerAvatar);
+    int dir = PlayerAvatar_GetFacingDir(fieldSystem->playerAvatar);
+    int back = dir == DIR_NORTH ? DIR_SOUTH : dir == DIR_SOUTH ? DIR_NORTH : dir == DIR_WEST ? DIR_EAST : DIR_WEST;
+    int bx = x + MapObject_GetDxFromDir(back), bz = z + MapObject_GetDzFromDir(back);
+    // (a tile the player could walk to: not a wall, water, a ledge, a ramp, a
+    // warp or someone's)
+    BOOL behind = PlayerAvatar_CheckCollision(fieldSystem->playerAvatar, player, back) == PLAYER_COLLISION_NONE;
+    MapObject *mapObj;
+
+    mapObj = MapObjectMan_AddMapObject(fieldSystem->mapObjMan, behind ? bx : x, behind ? bz : z, dir, graphicsID,
+        PORT_MOVEMENT_TYPE_FOLLOW_MON, fieldSystem->location->mapHeaderID);
+
+    if (mapObj == NULL) {
+        return NULL;
+    }
+
+    MapObject_SetLocalID(mapObj, PORT_FOLLOWER_LOCAL_ID);
+    MapObject_SetStatusFlagOn(mapObj, MAP_OBJ_STATUS_PORT_FOLLOWER | MAP_OBJ_STATUS_PERSISTENT);
+
+    // Its shadow made once it's out (PortFollower_Update), not by the
+    // movement code on its first frame: a new shadow is drawn once before
+    // it first looks at its object's flags, so it showed alone, hidden or
+    // not, before the ball came.
+    sShadowMade = MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_SHOW_SHADOW) != 0;
+    MapObject_SetStatusFlagOn(mapObj, MAP_OBJ_STATUS_SHOW_SHADOW);
+
+    if (MapObject_CheckStatus(player, MAP_OBJ_STATUS_ON_ELEVATED_BRIDGE)) {
+        MapObject_SetStatusFlagOn(mapObj, MAP_OBJ_STATUS_ON_ELEVATED_BRIDGE);
+    }
+
+    if (!behind) {
+        MapObject_SetHidden(mapObj, TRUE);
+    }
+
+    return mapObj;
+}
+
+// Its Poké Ball: coming out it grows from nothing to its size, going in it
+// shrinks away where it is, POP_FRAMES each, with the battle's send-out and
+// recall sounds.
+#define POP_FRAMES 6
+
+static void PortFollower_Sound(u16 seqID)
+{
+    static int sFailed;
+
+    if (!Sound_PlayEffect(seqID) && sFailed++ < 4) {
+        NitroPort_Log("[follower] sound %d not played", seqID);
+    }
+}
+
+static BOOL PortFollower_ScaleOf(MapObject *mapObj, int step, int steps)
+{
+    Billboard *billboard = ov5_021EB1A0(mapObj);
+    VecFx32 scale;
+
+    if (billboard == NULL) {
+        return FALSE; // (its picture not made yet)
+    }
+
+    scale.x = scale.y = scale.z = FX32_ONE * step / steps;
+    Billboard_SetScale(billboard, &scale);
+    return TRUE;
+}
+
+static BOOL PortFollower_SetScale(MapObject *mapObj, int step)
+{
+    return PortFollower_ScaleOf(mapObj, step, POP_FRAMES);
+}
+
+// The ball itself, seen: the item ball's picture where the Pokémon stands, a
+// little in front of it, growing in and shrinking away BALL_POP steps each.
+// Coming out it drops in, BALL_LEAD steps before it opens and the Pokémon
+// grows out of it; going in it's there as the Pokémon shrinks into it and
+// BALL_AFTER steps after. (No room for it, no free map object: the
+// Pokémon alone, as before.)
+#define BALL_POP   3
+#define BALL_LEAD  8
+#define BALL_AFTER 6
+
+static int sBallLeft, sBallTotal;
+static int sBallKind = 4; // (the ball it was caught in: the game's numbers, 1 the Master Ball... 4 the Poké Ball)
+
+// (the ball's picture: its kind's from the ball file, facing north it's
+// open, any other way closed; else the item ball, the same either way)
+#define BALL_KINDS 17
+
+static int PortFollower_BallGfx(void)
+{
+    int kind = sBallKind >= 1 && sBallKind <= BALL_KINDS ? sBallKind : 4;
+    u32 k = kind - 1;
+
+    if (!Balls_Ready() || k >= sBallsCount) {
+        return OBJ_EVENT_GFX_POKEBALL;
+    }
+
+    return PORT_FOLLOWER_BALL_GFX_FIRST + (int)k;
+}
+
+static BOOL PortFollower_ShowBall(FieldSystem *fieldSystem, MapObject *at, int steps, BOOL open)
+{
+    MapObjectManager *mapObjMan = fieldSystem->mapObjMan;
+    MapObject *ball = PortFollower_FindID(mapObjMan, PORT_FOLLOWER_BALL_LOCAL_ID);
+    VecFx32 front = { 0, 0, FX32_ONE * 4 }; // (drawn over the Pokémon's feet)
+    int x = MapObject_GetX(at), z = MapObject_GetZ(at), graphicsID = PortFollower_BallGfx();
+    BOOL bridge = MapObject_CheckStatus(at, MAP_OBJ_STATUS_ON_ELEVATED_BRIDGE) != 0;
+
+    if (ball != NULL && MapObject_GetGraphicsID(ball) == graphicsID && MapObject_GetX(ball) == x && MapObject_GetZ(ball) == z) {
+        // (still there, where it's wanted: kept, its time begun again; not
+        // made again, so nothing reloads and 60 FPS's in-between scenes
+        // keep it where it is)
+        MapObject_Face(ball, open ? DIR_NORTH : DIR_SOUTH);
+        sBallLeft = sBallTotal = steps;
+        return TRUE;
+    }
+
+    if (ball != NULL) {
+        PortFollower_Remove(fieldSystem, ball);
+    }
+
+    sBallLeft = 0;
+
+    if (MapObjectMan_PortFreeSlots(mapObjMan) <= 1 || !MapObjectGfx_PortHasRoom(mapObjMan, graphicsID)) {
+        return FALSE;
+    }
+
+    ball = MapObjectMan_AddMapObject(mapObjMan, x, z, open ? DIR_NORTH : DIR_SOUTH, graphicsID, MOVEMENT_TYPE_NONE,
+        fieldSystem->location->mapHeaderID);
+
+    if (ball == NULL) {
+        return FALSE;
+    }
+
+    // (not saved, not found by scripts, not talked to, walked through)
+    MapObject_SetLocalID(ball, PORT_FOLLOWER_BALL_LOCAL_ID);
+    MapObject_SetStatusFlagOn(ball, MAP_OBJ_STATUS_PORT_FOLLOWER | MAP_OBJ_STATUS_PERSISTENT);
+    sub_02062D80(ball, FALSE);
+
+    if (bridge) {
+        MapObject_SetStatusFlagOn(ball, MAP_OBJ_STATUS_ON_ELEVATED_BRIDGE);
+    }
+
+    // (no shadow: not made at all, as the movement code would on its first
+    // frame, nor shown)
+    MapObject_SetStatusFlagOn(ball, MAP_OBJ_STATUS_SHOW_SHADOW | MAP_OBJ_STATUS_HIDE_SHADOW);
+    MapObject_SetSpritePosOffset(ball, &front);
+    PortFollower_ScaleOf(ball, 0, BALL_POP);
+    sBallLeft = sBallTotal = steps;
+    return TRUE;
+}
+
+// (shortened to go away now: the Pokémon put away before it was seen)
+static void PortFollower_BallAway(void)
+{
+    if (sBallLeft > BALL_POP) {
+        sBallLeft = BALL_POP;
+        sBallTotal = BALL_POP * 2;
+    }
+}
+
+// (its scale this step of its time: in BALL_POP steps, away in the last)
+static int PortFollower_BallStep(void)
+{
+    int done = sBallTotal - sBallLeft, step = done < sBallLeft ? done : sBallLeft;
+    return step < BALL_POP ? step : BALL_POP;
+}
+
+// The ball opened (the Pokémon coming out) or closed (it gone in): turned
+// to its other picture (north: open), its time going on. (The item ball
+// has one picture only.)
+static void PortFollower_SwapBall(FieldSystem *fieldSystem, BOOL open)
+{
+    MapObject *ball = PortFollower_FindID(fieldSystem->mapObjMan, PORT_FOLLOWER_BALL_LOCAL_ID);
+
+    // (turned: the same object, its texture already there, where it is)
+    if (ball != NULL && sBallLeft > 0) {
+        MapObject_Face(ball, open ? DIR_NORTH : DIR_SOUTH);
+    }
+}
+
+static void PortFollower_UpdateBall(FieldSystem *fieldSystem, BOOL dropIn)
+{
+    MapObject *ball = PortFollower_FindID(fieldSystem->mapObjMan, PORT_FOLLOWER_BALL_LOCAL_ID);
+    int done, step;
+
+    if (ball == NULL) {
+        sBallLeft = 0;
+        return;
+    }
+
+    if (sBallLeft <= 0) {
+        PortFollower_Remove(fieldSystem, ball);
+        return;
+    }
+
+    MapObject_SetStatusFlagOn(ball, MAP_OBJ_STATUS_HIDE_SHADOW); // (the Pokémon's own only)
+    done = sBallTotal - sBallLeft;
+    step = PortFollower_BallStep();
+    PortFollower_ScaleOf(ball, step, BALL_POP);
+
+    {
+        // (coming out: dropped in from above as it grows)
+        VecFx32 hop = { 0, dropIn && done < BALL_POP ? FX32_ONE * 6 * (BALL_POP - done) : 0, 0 };
+        MapObject_SetSpriteJumpOffset(ball, &hop);
+    }
+
+    sBallLeft--;
+}
+
+// (coming out: frames of it so far, -1 not yet begun: its picture or, -2,
+// the player's step off its tile awaited; going in: frames left)
+static int sOut, sIn;
+
+static int sOpenIn; // (coming out, sOut -3: the ball's steps before it opens)
+
+static void PortFollower_HideShadow(MapObject *mapObj)
+{
+    if (!sShadowForced) {
+        sShadowForced = TRUE;
+        sShadowWas = MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_HIDE_SHADOW) != 0; // (in grass, on water...)
+    }
+
+    MapObject_SetStatusFlagOn(mapObj, MAP_OBJ_STATUS_HIDE_SHADOW);
+}
+
+static void PortFollower_ShowShadow(MapObject *mapObj)
+{
+    if (!sShadowMade) {
+        sShadowMade = TRUE;
+        ov5_021F1570(mapObj);
+    }
+
+    if (sShadowForced) {
+        sShadowForced = FALSE;
+
+        if (!sShadowWas) {
+            MapObject_SetStatusFlagOff(mapObj, MAP_OBJ_STATUS_HIDE_SHADOW);
+        }
+    }
+}
+static BOOL sDropIn;
+
+BOOL PortFollower_StartsSmall(const MapObject *mapObj)
+{
+    return MapObject_PortIsFollower(mapObj) && (MapObject_GetLocalID(mapObj) != PORT_FOLLOWER_LOCAL_ID || sOut < 0);
+}
+
+// ----- The ball's burst as it opens: the battles' send-out particles for
+// its kind (wazaeffect/effectdata/ball_particle.narc, as
+// battle_anim/ov12_02235E94.c picks them: Unk_ov12_0223AD70), a particle
+// system of its own drawn with the field's camera after the billboards
+// (fieldmap.c: PortFollower_Draw), freed when its emitters are done or the
+// field ends. Only with room for it: the field heap's and the 3D VRAM's,
+// else the ball opens without it.
+#define BURST_HEAP      0x4800
+#define BURST_MAX_STEPS 90
+#ifndef BURST_SCALE
+#define BURST_SCALE (FX32_ONE * 4)
+#endif
+
+static const u8 sBurstMember[17][2] = {
+    // (member, emitters) for each ball, the game's ball numbers less one
+    { 0x1, 0x5 }, { 0x2, 0x4 }, { 0x3, 0x3 }, { 0x4, 0x3 }, { 0x5, 0x3 }, { 0x6, 0x4 }, { 0x7, 0x3 }, { 0x8, 0x4 }, { 0x9, 0x3 },
+    { 0xA, 0x5 }, { 0xB, 0x4 }, { 0xC, 0x3 }, { 0xD, 0x3 }, { 0xE, 0x3 }, { 0xF, 0x4 }, { 0x10, 0x4 }, { 0x11, 0x3 }
+};
+
+static ParticleSystem *sBurst;
+static void *sBurstHeap;
+static int sBurstSteps;
+
+static u32 PortFollower_BurstTexAlloc(u32 size, BOOL is4x4comp)
+{
+    NNSGfdTexKey key = NNS_GfdAllocTexVram(size, is4x4comp, 0);
+
+    ParticleSystem_RegisterTextureKey(key);
+    return NNS_GfdGetTexKeyAddr(key);
+}
+
+static u32 PortFollower_BurstPlttAlloc(u32 size, BOOL is4pltt)
+{
+    NNSGfdPlttKey key = NNS_GfdAllocPlttVram(size, is4pltt, 0);
+
+    ParticleSystem_RegisterPaletteKey(key);
+    return NNS_GfdGetPlttKeyAddr(key);
+}
+
+static void PortFollower_EndBurst(void)
+{
+    if (sBurst != NULL) {
+        ParticleSystem_Free(sBurst); // (its textures' and palettes' VRAM with it)
+        sBurst = NULL;
+    }
+
+    if (sBurstHeap != NULL) {
+        Heap_Free(sBurstHeap);
+        sBurstHeap = NULL;
+    }
+}
+
+// (whether `size` bytes of the textures' VRAM and `pltt` of the palettes'
+// are free: taken and given back)
+static BOOL PortFollower_VramFree(u32 size, u32 pltt)
+{
+    NNSGfdTexKey tex = NNS_GfdAllocTexVram(size, FALSE, 0);
+    NNSGfdPlttKey pal;
+
+    if (tex == NNS_GFD_ALLOC_ERROR_TEXKEY) {
+        return FALSE;
+    }
+
+    pal = NNS_GfdAllocPlttVram(pltt, FALSE, 0);
+    NNS_GfdFreeTexVram(tex);
+
+    if (pal == NNS_GFD_ALLOC_ERROR_PLTTKEY) {
+        return FALSE;
+    }
+
+    NNS_GfdFreePlttVram(pal);
+    return TRUE;
+}
+
+static VecFx32 sBurstPos;
+
+// (each emitter as it's made: at the ball, its offset, sizes and speeds made
+// for the battle's camera, a few units away, BURST_SCALE times: the field's
+// units are about a pixel; its emitters keep themselves, so they're only
+// seen here)
+static void PortFollower_BurstEmitter(SPLEmitter *emitter)
+{
+    VecFx32 at = emitter->position; // (the resource's offset from the ball)
+
+    emitter->position.x = sBurstPos.x + FX_Mul(at.x, BURST_SCALE);
+    emitter->position.y = sBurstPos.y + FX_Mul(at.y, BURST_SCALE);
+    emitter->position.z = sBurstPos.z + FX_Mul(at.z, BURST_SCALE);
+    emitter->radius = FX_Mul(emitter->radius, BURST_SCALE);
+    emitter->length = FX_Mul(emitter->length, BURST_SCALE);
+    emitter->initVelPositionAmplifier = FX_Mul(emitter->initVelPositionAmplifier, BURST_SCALE);
+    emitter->initVelAxisAmplifier = FX_Mul(emitter->initVelAxisAmplifier, BURST_SCALE);
+    emitter->baseScale = FX_Mul(emitter->baseScale, BURST_SCALE);
+}
+
+static void PortFollower_StartBurst(FieldSystem *fieldSystem, MapObject *ball)
+{
+    int kind = (sBallKind >= 1 && sBallKind <= 17 ? sBallKind : 4) - 1;
+    VecFx32 pos;
+    MtxFx44 projection;
+    void *resource;
+    int i;
+    static BOOL sSaid;
+
+    PortFollower_EndBurst();
+
+    if (ball == NULL || HeapExp_FndGetTotalFreeSize(HEAP_ID_FIELD1) < BURST_HEAP + 0x6000) {
+        if (!sSaid) {
+            sSaid = TRUE;
+            NitroPort_Log("[follower] no room for the ball's burst (heap)");
+        }
+        return;
+    }
+
+    resource = ParticleSystem_LoadResourceFromNARC(NARC_INDEX_WAZAEFFECT__EFFECTDATA__BALL_PARTICLE, sBurstMember[kind][0], HEAP_ID_FIELD1);
+
+    if (resource == NULL) {
+        return;
+    }
+
+    // (its textures' size: the SPA header's, at 0x14)
+    if (!PortFollower_VramFree(((const u32 *)resource)[5], 0x200)) {
+        Heap_Free(resource);
+
+        if (!sSaid) {
+            sSaid = TRUE;
+            NitroPort_Log("[follower] no room for the ball's burst (VRAM)");
+        }
+        return;
+    }
+
+    sBurstHeap = Heap_Alloc(HEAP_ID_FIELD1, BURST_HEAP);
+    // (made with a camera of its own, as ParticleSystem_New needs one, then
+    // without it: drawn with the field's, which is the active one again, its
+    // projection as it was: the new camera set its own)
+    projection = *NNS_G3dGlbGetProjectionMtx();
+    sBurst = ParticleSystem_New(PortFollower_BurstTexAlloc, PortFollower_BurstPlttAlloc, sBurstHeap, BURST_HEAP, TRUE, HEAP_ID_FIELD1);
+
+    if (sBurst == NULL) {
+        Heap_Free(resource);
+        PortFollower_EndBurst();
+        Camera_SetAsActive(fieldSystem->camera);
+        NNS_G3dGlbSetProjectionMtx(&projection);
+        return;
+    }
+
+    if (sBurst->camera != NULL) {
+        Camera_Delete(sBurst->camera);
+        sBurst->camera = NULL;
+    }
+
+    Camera_SetAsActive(fieldSystem->camera);
+    NNS_G3dGlbSetProjectionMtx(&projection);
+
+    ParticleSystem_SetResource(sBurst, resource, VRAM_AUTO_RELEASE_TEXTURE_LNK | VRAM_AUTO_RELEASE_PALETTE_LNK, TRUE);
+
+    // (from the ball's middle, in front of the Pokémon coming out)
+    MapObject_GetPosPtr(ball, &pos);
+    pos.y += FX32_ONE * 30;
+    pos.z += FX32_ONE * 16;
+
+    sBurstPos = pos;
+
+    for (i = 0; i < sBurstMember[kind][1]; i++) {
+        ParticleSystem_CreateEmitterWithCallback(sBurst, i, PortFollower_BurstEmitter, NULL);
+    }
+
+    sBurstSteps = 0;
+}
+
+static void PortFollower_UpdateBurst(void)
+{
+    if (sBurst == NULL) {
+        return;
+    }
+
+    ParticleSystem_Update(sBurst);
+
+    if (ParticleSystem_GetActiveEmitterCount(sBurst) == 0 || ++sBurstSteps > BURST_MAX_STEPS) {
+        PortFollower_EndBurst();
+    }
+}
+
+void PortFollower_Draw(void)
+{
+    if (sBurst != NULL) {
+        ParticleSystem_Draw(sBurst);
+    }
+}
+
+void PortFollower_FieldEnds(void)
+{
+    PortFollower_EndBurst();
+}
+
+static void PortFollower_UpdateEmote(FieldSystem *fieldSystem);
+
+// (the ball the party's first Pokémon was caught in: its ball's, as it
+// comes out and goes back in)
+static void PortFollower_TakeBallKind(FieldSystem *fieldSystem)
+{
+    Party *party = SaveData_GetParty(fieldSystem->saveData);
+
+    if (Party_GetCurrentCount(party) > 0) {
+        sBallKind = Pokemon_GetValue(Party_GetPokemonBySlotIndex(party, 0), MON_DATA_POKEBALL, NULL);
+    }
+}
+
+void PortFollower_Update(FieldSystem *fieldSystem)
+{
+    static int sWait, sPlayerX, sPlayerZ, sNoRoom;
+    static MapObject *sLast;
+    MapObject *mapObj, *player;
+    int graphicsID = 0, x, z, dx, dz;
+    BOOL big = FALSE, scripted;
+
+    if (fieldSystem == NULL || fieldSystem->mapObjMan == NULL || fieldSystem->playerAvatar == NULL
+        || fieldSystem->location == NULL || fieldSystem->saveData == NULL) {
+        return;
+    }
+
+    player = PlayerAvatar_GetMapObject(fieldSystem->playerAvatar);
+    mapObj = PortFollower_FindID(fieldSystem->mapObjMan, PORT_FOLLOWER_LOCAL_ID);
+
+    if (player == NULL) {
+        return;
+    }
+
+    PortFollower_UpdateBall(fieldSystem, sDropIn);
+    PortFollower_UpdateBurst();
+    PortFollower_UpdateEmote(fieldSystem);
+
+    if (mapObj != sLast) {
+        // (another one, or none: made anew, or the field's objects made again)
+        sIn = 0;
+        sOut = mapObj != NULL ? -1 : 0;
+        sLast = mapObj;
+        sShadowForced = FALSE;
+
+        if (mapObj != NULL) {
+            sShadowMade = TRUE; // (made again with the field's objects: the movement code's)
+            PortFollower_TakeBallKind(fieldSystem);
+        }
+    }
+
+    // (the options' page in the lower menu's panel: a task, but the field
+    // going on behind it, the player still: it comes and goes as there set)
+    scripted = FieldSystem_IsRunningTask(fieldSystem) && !OptionsPanel_IsOpen();
+
+    if (PortOption_On(PORT_OPT_FOLLOWER)) {
+        graphicsID = PortFollower_PartyGfx(fieldSystem, &big);
+
+        if (graphicsID != 0 && !PortFollower_MayBeOut(fieldSystem, big)) {
+            graphicsID = 0;
+        }
+    }
+
+    x = PlayerAvatar_GetXPos(fieldSystem->playerAvatar);
+    z = PlayerAvatar_GetZPos(fieldSystem->playerAvatar);
+
+    if (mapObj != NULL && sIn > 0) {
+        // Going in: smaller each frame, then gone.
+        sIn--;
+        PortFollower_SetScale(mapObj, sIn);
+
+        if (sIn == 0) {
+            PortFollower_Remove(fieldSystem, mapObj);
+            PortFollower_SwapBall(fieldSystem, FALSE); // (in: closed)
+            mapObj = sLast = NULL;
+            sWait = 8;
+        }
+    } else if (mapObj != NULL) {
+        const char *why = NULL;
+
+        dx = MapObject_GetX(mapObj) - x;
+        dz = MapObject_GetZ(mapObj) - z;
+
+        // Back in its ball: not to be out, another Pokémon first, the game
+        // moving the player (a script's walk: it waits in its ball till the
+        // player is theirs again), a ledge, or left behind (a warp within
+        // the map).
+        if (graphicsID != MapObject_GetGraphicsID(mapObj)) {
+            why = graphicsID ? "another Pokémon" : "not to be out";
+        } else if (scripted && (x != sPlayerX || z != sPlayerZ)) {
+            why = "the game moves the player";
+        } else if (PortFollower_PlayerJumping(fieldSystem, player)) {
+            why = "a ledge";
+        } else if (!scripted && !MapObject_IsMoving(mapObj) && !PortFollower_PlayerStepping(fieldSystem) && dx * dx + dz * dz > 1) {
+            why = "left behind";
+        }
+
+        if (why != NULL) {
+            NitroPort_Log("[follower] in its ball (%s)", why);
+
+            if (sOut < 0 || MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_HIDE)) {
+                PortFollower_Remove(fieldSystem, mapObj); // (never seen: its ball, if it was there, goes)
+                PortFollower_BallAway();
+                mapObj = sLast = NULL;
+                sWait = 8;
+            } else {
+                MapObject_SetPauseMovementOn(mapObj); // (it stays where it is)
+                sIn = sOut > 0 && sOut < POP_FRAMES ? sOut : POP_FRAMES;
+                sOut = POP_FRAMES;
+                sDropIn = FALSE;
+                PortFollower_ShowBall(fieldSystem, mapObj, sIn + BALL_AFTER + BALL_POP, TRUE); // (open as it goes in)
+                PortFollower_Sound(SEQ_SE_DP_SLOT02_sseq_1); // (SEQ_SE_DP_SUIKOMU: the battle's recall)
+            }
+        } else if (sOut == -3) {
+            // Coming out: its ball there, then open.
+            if (sOpenIn > 0) {
+                sOpenIn--;
+            } else {
+                MapObject_SetHidden(mapObj, FALSE);
+                sOut = 0;
+                PortFollower_SwapBall(fieldSystem, TRUE); // (it opens)
+                PortFollower_StartBurst(fieldSystem, PortFollower_FindID(fieldSystem->mapObjMan, PORT_FOLLOWER_BALL_LOCAL_ID));
+                PortFollower_Sound(SEQ_SE_DP_SLOT01_sseq_1); // (SEQ_SE_DP_BOWA2: the battle's send-out)
+            }
+        } else if (sOut < 0) {
+            // Coming out: once its picture is made (and, on the player's
+            // tile, once the player has stepped off it), its ball first,
+            // then it from nothing.
+            BOOL waits = MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_HIDE) && dx == 0 && dz == 0 && sOut == -2;
+
+            if (!waits && PortFollower_SetScale(mapObj, 0)) {
+                sDropIn = TRUE;
+                sOut = -3;
+                sOpenIn = PortFollower_ShowBall(fieldSystem, mapObj, BALL_LEAD + 2 * BALL_POP, FALSE) ? BALL_LEAD : 0;
+            }
+        } else if (sOut < POP_FRAMES) {
+            sOut++;
+            PortFollower_SetScale(mapObj, sOut);
+
+            if (sOut == POP_FRAMES) {
+                PortFollower_ShowShadow(mapObj); // (its shadow once it's its size)
+            }
+        } else if (sub_02062A14(mapObj) == 0 && !MapObject_IsMoving(mapObj)) {
+            // Out, standing: stepping in place, as HeartGold's do (the walk
+            // at a slow walk's pace; walking, the follow code's own).
+            sub_02062A0C(mapObj, 1);
+        }
+
+        // (no shadow under it while it's smaller than itself)
+        if (mapObj != NULL && (sIn > 0 || sOut < POP_FRAMES)) {
+            PortFollower_HideShadow(mapObj);
+        }
+    }
+
+    sPlayerX = x;
+    sPlayerZ = z;
+
+    // Out (not during a script's or a menu's task: when it ends).
+    if (mapObj == NULL && graphicsID != 0 && !scripted && !PortFollower_PlayerStepping(fieldSystem)) {
+        if (sWait > 0) {
+            sWait--;
+        } else if (MapObjectMan_PortFreeSlots(fieldSystem->mapObjMan) > 1
+            && (!PortFollower_IsGfx(graphicsID) || Bundle_Ready()) && MapObjectGfx_PortHasRoom(fieldSystem->mapObjMan, graphicsID)) {
+            BOOL onPlayer;
+
+            sOut = -1; // (its picture, made as it's added, starts from nothing)
+            PortFollower_TakeBallKind(fieldSystem);
+            mapObj = sLast = PortFollower_Add(fieldSystem, graphicsID);
+            onPlayer = mapObj != NULL && MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_HIDE);
+            NitroPort_Log("[follower] out: graphics %d at %d,%d%s", graphicsID, mapObj ? MapObject_GetX(mapObj) : -1,
+                mapObj ? MapObject_GetZ(mapObj) : -1, onPlayer ? " (on the player's tile till they step off it)" : "");
+
+            if (mapObj != NULL) {
+                MapObject_SetHidden(mapObj, TRUE); // (shown as it comes out of its ball)
+                PortFollower_SetScale(mapObj, 0);  // (its picture made with it, before it was the follower)
+                sOut = onPlayer ? -2 : -1;
+                sIn = 0;
+            }
+
+            sNoRoom = 0;
+        } else {
+            sWait = 4;
+
+            if (++sNoRoom == 15) { // (about 2 seconds: said once)
+                NitroPort_Log("[follower] waiting: %s", MapObjectMan_PortFreeSlots(fieldSystem->mapObjMan) <= 1 ? "no map object free"
+                    : PortFollower_IsGfx(graphicsID) && !Bundle_Ready() ? "no sprites" : "no room for its picture yet");
+            }
+        }
+    }
+}
+
+// ----- Talking to it (A facing it), as HeartGold and SoulSilver's: it
+// turns to the player, its cry, a bubble over it (a heart, a note, "...",
+// "!", "?": builder/ball_sprites.py's drawings, in the ball file) and, when
+// it's happy, a hop; then a word on how it feels: unwell, the weather, the
+// place, the time of day, or its friendship. Now and then (its friendship
+// 100 or more, 1 in 5, 3 a day) it has found an item for the player. The
+// port's text (the game has none): English, as the options page.
+
+enum {
+    EMOTE_HEART,
+    EMOTE_NOTE,
+    EMOTE_DOTS,
+    EMOTE_EXCLAIM,
+    EMOTE_QUESTION,
+    EMOTE_COUNT
+};
+
+#define BALL_SPRITES        BALL_KINDS // (the ball file's balls, before its bubbles)
+#define EMOTE_POP           2
+#define FOUND_A_DAY         3
+
+static int sEmoteLeft, sEmoteTotal;
+
+static void PortFollower_ShowEmote(FieldSystem *fieldSystem, MapObject *at, int emote, int steps, BOOL big)
+{
+    MapObjectManager *mapObjMan = fieldSystem->mapObjMan;
+    MapObject *bubble = PortFollower_FindID(mapObjMan, PORT_FOLLOWER_EMOTE_LOCAL_ID);
+    VecFx32 front = { 0, 0, FX32_ONE * 6 };
+    VecFx32 above = { 0, FX32_ONE * (big ? 60 : 30), 0 };
+    int graphicsID = PORT_FOLLOWER_BALL_GFX_FIRST + BALL_SPRITES + emote;
+
+    if (bubble != NULL) {
+        PortFollower_Remove(fieldSystem, bubble);
+    }
+
+    sEmoteLeft = 0;
+
+    if (!Balls_Ready() || BALL_SPRITES + emote >= (int)sBallsCount || MapObjectMan_PortFreeSlots(mapObjMan) <= 1
+        || !MapObjectGfx_PortHasRoom(mapObjMan, graphicsID)) {
+        return;
+    }
+
+    bubble = MapObjectMan_AddMapObject(mapObjMan, MapObject_GetX(at), MapObject_GetZ(at), DIR_SOUTH, graphicsID,
+        MOVEMENT_TYPE_NONE, fieldSystem->location->mapHeaderID);
+
+    if (bubble == NULL) {
+        return;
+    }
+
+    MapObject_SetLocalID(bubble, PORT_FOLLOWER_EMOTE_LOCAL_ID);
+    MapObject_SetStatusFlagOn(bubble, MAP_OBJ_STATUS_PORT_FOLLOWER | MAP_OBJ_STATUS_PERSISTENT
+            | MAP_OBJ_STATUS_SHOW_SHADOW | MAP_OBJ_STATUS_HIDE_SHADOW);
+    sub_02062D80(bubble, FALSE);
+
+    if (MapObject_CheckStatus(at, MAP_OBJ_STATUS_ON_ELEVATED_BRIDGE)) {
+        MapObject_SetStatusFlagOn(bubble, MAP_OBJ_STATUS_ON_ELEVATED_BRIDGE);
+    }
+
+    MapObject_SetSpritePosOffset(bubble, &front);
+    MapObject_SetSpriteJumpOffset(bubble, &above);
+    PortFollower_ScaleOf(bubble, 0, EMOTE_POP);
+    sEmoteLeft = sEmoteTotal = steps;
+}
+
+// (shortened to go away now)
+static void PortFollower_EmoteAway(void)
+{
+    if (sEmoteLeft > EMOTE_POP) {
+        sEmoteLeft = EMOTE_POP;
+        sEmoteTotal = EMOTE_POP * 2;
+    }
+}
+
+static void PortFollower_UpdateEmote(FieldSystem *fieldSystem)
+{
+    MapObject *bubble = PortFollower_FindID(fieldSystem->mapObjMan, PORT_FOLLOWER_EMOTE_LOCAL_ID);
+    int done, step;
+
+    if (bubble == NULL) {
+        sEmoteLeft = 0;
+        return;
+    }
+
+    if (sEmoteLeft <= 0) {
+        PortFollower_Remove(fieldSystem, bubble);
+        return;
+    }
+
+    MapObject_SetStatusFlagOn(bubble, MAP_OBJ_STATUS_HIDE_SHADOW);
+    done = sEmoteTotal - sEmoteLeft;
+    step = done < sEmoteLeft ? done : sEmoteLeft;
+    PortFollower_ScaleOf(bubble, step < EMOTE_POP ? step : EMOTE_POP, EMOTE_POP);
+    sEmoteLeft--;
+}
+
+static void PortFollower_AppendLetters(String *string, const char *letters)
+{
+    for (; *letters; letters++) {
+        int c = (unsigned char)*letters;
+
+        if (c >= 'A' && c <= 'Z') {
+            String_AppendChar(string, 0x12B + (c - 'A'));
+        } else if (c >= 'a' && c <= 'z') {
+            String_AppendChar(string, 0x145 + (c - 'a'));
+        } else if (c == ' ') {
+            String_AppendChar(string, 0x1DE);
+        } else if (c == '.') {
+            String_AppendChar(string, 0x1AE);
+        } else if (c == '!') {
+            String_AppendChar(string, 0x1AB);
+        } else if (c == '?') {
+            String_AppendChar(string, 0x1AC);
+        } else if (c == '\'') {
+            String_AppendChar(string, 0x1B3); // (’, as the game's English texts)
+        } else if (c == '\n') {
+            String_AppendChar(string, 0xE000);
+        }
+    }
+}
+
+// What it says: its emote, whether it hops, the words after its name.
+typedef struct PortFollowerLine {
+    u8 emote;
+    u8 hop;
+    const char *words;
+} PortFollowerLine;
+
+static const PortFollowerLine sUnwell = { EMOTE_DOTS, FALSE, " doesn't seem\nto be feeling well." };
+static const PortFollowerLine sFound = { EMOTE_EXCLAIM, TRUE, " seems to have\nfound something!" };
+static const PortFollowerLine sFriendship[] = {
+    { EMOTE_HEART, TRUE, " is overjoyed\nto be walking with you!" },
+    { EMOTE_NOTE, TRUE, " looks very happy." },
+    { EMOTE_EXCLAIM, FALSE, " is happy\nto see you." },
+    { EMOTE_DOTS, FALSE, " is keeping\nan eye on you." },
+};
+static const PortFollowerLine sRainLover = { EMOTE_NOTE, TRUE, " is splashing\nhappily in the rain!" };
+static const PortFollowerLine sRain = { EMOTE_DOTS, FALSE, " is shaking off\nthe rain." };
+static const PortFollowerLine sSnowLover = { EMOTE_NOTE, TRUE, " is happily\nplaying in the snow!" };
+static const PortFollowerLine sSnow = { EMOTE_DOTS, FALSE, " looks a little cold." };
+static const PortFollowerLine sDust = { EMOTE_DOTS, FALSE, " is squinting\nthrough the dust." };
+static const PortFollowerLine sFog = { EMOTE_QUESTION, FALSE, " is peering\nthrough the fog." };
+static const PortFollowerLine sCave = { EMOTE_QUESTION, FALSE, " is listening\nto the echoes." };
+static const PortFollowerLine sCenter = { EMOTE_NOTE, FALSE, " looks relaxed\nin here." };
+static const PortFollowerLine sNightOwl = { EMOTE_EXCLAIM, TRUE, " seems livelier\nat night!" };
+static const PortFollowerLine sSleepy = { EMOTE_DOTS, FALSE, " looks sleepy." };
+static const PortFollowerLine sMorning = { EMOTE_EXCLAIM, TRUE, " seems full of\nenergy this morning!" };
+static const PortFollowerLine sOutdoors = { EMOTE_NOTE, FALSE, " is enjoying\nthe fresh air." };
+
+static BOOL PortFollower_HasType(Pokemon *mon, int type)
+{
+    return Pokemon_GetValue(mon, MON_DATA_TYPE_1, NULL) == type || Pokemon_GetValue(mon, MON_DATA_TYPE_2, NULL) == type;
+}
+
+// (where it is and when: one line of those that fit, picked at random, or NULL)
+static const PortFollowerLine *PortFollower_ContextLine(FieldSystem *fieldSystem, Pokemon *mon)
+{
+    const PortFollowerLine *fit[4];
+    int n = 0, here = fieldSystem->location->mapHeaderID;
+    int weather = FieldSystem_GetWeather(fieldSystem, here);
+    enum TimeOfDay time = GetTimeOfDay();
+
+    switch (weather) {
+    case OVERWORLD_WEATHER_RAINING:
+    case OVERWORLD_WEATHER_HEAVY_RAIN:
+    case OVERWORLD_WEATHER_THUNDERSTORM:
+        fit[n++] = PortFollower_HasType(mon, TYPE_WATER) ? &sRainLover : &sRain;
+        break;
+    case OVERWORLD_WEATHER_SNOWING:
+    case OVERWORLD_WEATHER_HEAVY_SNOW:
+    case OVERWORLD_WEATHER_BLIZZARD:
+    case OVERWORLD_WEATHER_HAILING:
+        fit[n++] = PortFollower_HasType(mon, TYPE_ICE) ? &sSnowLover : &sSnow;
+        break;
+    case OVERWORLD_WEATHER_SANDSTORM:
+    case OVERWORLD_WEATHER_SLOW_ASHFALL:
+        fit[n++] = &sDust;
+        break;
+    case OVERWORLD_WEATHER_FOG:
+    case OVERWORLD_WEATHER_DEEP_FOG:
+        fit[n++] = &sFog;
+        break;
+    }
+
+    if (MapHeader_IsCave(here)) {
+        fit[n++] = &sCave;
+    } else if (MapHeader_IsPokemonCenter(here)) {
+        fit[n++] = &sCenter;
+    } else if (MapHeader_IsOutdoors(here) && weather == OVERWORLD_WEATHER_CLEAR) {
+        fit[n++] = &sOutdoors;
+    }
+
+    if (time == TIMEOFDAY_NIGHT || time == TIMEOFDAY_LATE_NIGHT) {
+        fit[n++] = PortFollower_HasType(mon, TYPE_GHOST) || PortFollower_HasType(mon, TYPE_DARK) ? &sNightOwl : &sSleepy;
+    } else if (time == TIMEOFDAY_MORNING) {
+        fit[n++] = &sMorning;
+    }
+
+    return n > 0 ? fit[LCRNG_Next() % n] : NULL;
+}
+
+// What it may find: most often the first row, now and then the second, rarely the third.
+static const u16 sFoundItems[3][6] = {
+    { ITEM_POTION, ITEM_ANTIDOTE, ITEM_PARLYZ_HEAL, ITEM_POKE_BALL, ITEM_ORAN_BERRY, ITEM_PECHA_BERRY },
+    { ITEM_SUPER_POTION, ITEM_GREAT_BALL, ITEM_ETHER, ITEM_LEPPA_BERRY, ITEM_TINYMUSHROOM, ITEM_HONEY },
+    { ITEM_ULTRA_BALL, ITEM_REVIVE, ITEM_RARE_CANDY, ITEM_NUGGET, ITEM_STARDUST, ITEM_SUPER_POTION },
+};
+
+// (an item for the player, or ITEM_NONE: its friendship 100 or more, 1 in
+// 5 talks, FOUND_A_DAY a day, room in the bag)
+static u16 PortFollower_FoundItem(FieldSystem *fieldSystem, Pokemon *mon)
+{
+    static int sDay = -1, sToday;
+    RTCDate date;
+    int day, roll;
+    u16 item;
+
+    GetCurrentDate(&date);
+    day = DayNumberForDate(&date) + date.year * 400;
+
+    if (day != sDay) {
+        sDay = day;
+        sToday = 0;
+    }
+
+    if (sToday >= FOUND_A_DAY || Pokemon_GetValue(mon, MON_DATA_FRIENDSHIP, NULL) < 100 || LCRNG_Next() % 5 != 0) {
+        return ITEM_NONE;
+    }
+
+    roll = LCRNG_Next() % 100;
+    item = sFoundItems[roll < 70 ? 0 : roll < 95 ? 1 : 2][LCRNG_Next() % 6];
+
+    if (!Bag_CanFitItem(SaveData_GetBag(fieldSystem->saveData), item, 1, HEAP_ID_FIELD2)) {
+        return ITEM_NONE;
+    }
+
+    sToday++;
+    return item;
+}
+
+typedef struct PortFollowerTalk {
+    int state;
+    int wait;
+    u8 printerID;
+    u16 item;
+    Window window;
+    String *string;
+    MapObject *mapObj;
+} PortFollowerTalk;
+
+static void PortFollower_TalkPrint(FieldSystem *fieldSystem, PortFollowerTalk *talk)
+{
+    talk->printerID = FieldMessage_Print(&talk->window, talk->string, SaveData_GetOptions(fieldSystem->saveData), TRUE);
+}
+
+static BOOL PortFollower_TalkTask(FieldTask *task)
+{
+    FieldSystem *fieldSystem = FieldTask_GetFieldSystem(task);
+    PortFollowerTalk *talk = FieldTask_GetEnv(task);
+    BOOL out = PortFollower_FindID(fieldSystem->mapObjMan, PORT_FOLLOWER_LOCAL_ID) == talk->mapObj;
+
+    switch (talk->state) {
+    case 0:
+        // (its hop and its bubble first)
+        talk->wait++;
+
+        if (talk->wait >= 20 && (!out || sub_020656AC(talk->mapObj))) {
+            if (out) {
+                MapObject_SetPauseMovementOn(talk->mapObj);
+            }
+
+            FieldMessage_AddWindow(fieldSystem->bgConfig, &talk->window, BG_LAYER_MAIN_3);
+            FieldMessage_DrawWindow(&talk->window, SaveData_GetOptions(fieldSystem->saveData));
+            PortFollower_TalkPrint(fieldSystem, talk);
+            talk->state = 1;
+        }
+        break;
+    case 1:
+        if (FieldMessage_FinishedPrinting(talk->printerID) == TRUE) {
+            talk->state = 2;
+        }
+        break;
+    case 2:
+        if (gSystem.pressedKeys & (PAD_BUTTON_A | PAD_BUTTON_B)) {
+            if (talk->item != ITEM_NONE) {
+                // "You found <item>!", with the game's item fanfare
+                String *name = String_Init(32, HEAP_ID_FIELD2);
+
+                Bag_TryAddItem(SaveData_GetBag(fieldSystem->saveData), talk->item, 1, HEAP_ID_FIELD2);
+                String_Clear(talk->string);
+                PortFollower_AppendLetters(talk->string, "You found\n");
+                Item_LoadName(name, talk->item, HEAP_ID_FIELD2);
+                String_Concat(talk->string, name);
+                PortFollower_AppendLetters(talk->string, "!");
+                String_Free(name);
+                talk->item = ITEM_NONE;
+                FieldMessage_ClearWindow(&talk->window);
+                PortFollower_TalkPrint(fieldSystem, talk);
+                Sound_PlayFanfare(SEQ_FANFA4_sseq);
+                talk->state = 3;
+                break;
+            }
+
+            talk->state = 4;
+        }
+        break;
+    case 3:
+        if (FieldMessage_FinishedPrinting(talk->printerID) == TRUE && Sound_IsBGMPausedByFanfare() == FALSE) {
+            talk->state = 2;
+        }
+        break;
+    case 4:
+        Window_EraseMessageBox(&talk->window, FALSE);
+        Window_Remove(&talk->window);
+        String_Free(talk->string);
+        PortFollower_EmoteAway();
+
+        if (out) {
+            MapObject_SetPauseMovementOff(talk->mapObj);
+        }
+
+        Heap_Free(talk);
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+BOOL PortFollower_TryTalk(FieldSystem *fieldSystem)
+{
+    MapObject *mapObj = PortFollower_FindID(fieldSystem->mapObjMan, PORT_FOLLOWER_LOCAL_ID);
+    int dir = PlayerAvatar_GetFacingDir(fieldSystem->playerAvatar);
+    int x = PlayerAvatar_GetXPos(fieldSystem->playerAvatar) + MapObject_GetDxFromDir(dir);
+    int z = PlayerAvatar_GetZPos(fieldSystem->playerAvatar) + MapObject_GetDzFromDir(dir);
+    int back = dir == DIR_NORTH ? DIR_SOUTH : dir == DIR_SOUTH ? DIR_NORTH : dir == DIR_WEST ? DIR_EAST : DIR_WEST;
+    Party *party = SaveData_GetParty(fieldSystem->saveData);
+    const PortFollowerLine *line;
+    PortFollowerTalk *talk;
+    Pokemon *mon;
+    String *name;
+    int friendship;
+
+    // (out and its size, where the player faces)
+    if (mapObj == NULL || sOut < POP_FRAMES || sIn > 0 || MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_HIDE)
+        || MapObject_GetX(mapObj) != x || MapObject_GetZ(mapObj) != z || Party_GetCurrentCount(party) == 0) {
+        return FALSE;
+    }
+
+    mon = Party_GetPokemonBySlotIndex(party, 0);
+    friendship = Pokemon_GetValue(mon, MON_DATA_FRIENDSHIP, NULL);
+
+    talk = Heap_Alloc(HEAP_ID_FIELD2, sizeof(PortFollowerTalk));
+    memset(talk, 0, sizeof(PortFollowerTalk));
+    talk->mapObj = mapObj;
+    talk->item = ITEM_NONE;
+
+    if (Pokemon_GetValue(mon, MON_DATA_STATUS, NULL) != 0) {
+        line = &sUnwell;
+    } else if ((talk->item = PortFollower_FoundItem(fieldSystem, mon)) != ITEM_NONE) {
+        line = &sFound;
+    } else {
+        line = LCRNG_Next() % 2 ? PortFollower_ContextLine(fieldSystem, mon) : NULL;
+
+        if (line == NULL) {
+            line = &sFriendship[friendship >= 220 ? 0 : friendship >= 150 ? 1 : friendship >= 70 ? 2 : 3];
+        }
+    }
+
+    talk->string = String_Init(160, HEAP_ID_FIELD2);
+    name = String_Init(32, HEAP_ID_FIELD2);
+    Pokemon_GetValue(mon, MON_DATA_NICKNAME_STRING, name);
+    String_Concat(talk->string, name);
+    String_Free(name);
+    PortFollower_AppendLetters(talk->string, line->words);
+
+    // (it turns to the player, its cry, its bubble, a hop when it's happy)
+    MapObject_Face(mapObj, back);
+    Pokemon_PlayCry(mon);
+    PortFollower_ShowEmote(fieldSystem, mapObj, line->emote, 400, PortFollower_IsBig(MapObject_GetGraphicsID(mapObj)));
+
+    if (line->hop) {
+        MapObject_SetPauseMovementOff(mapObj);
+        LocalMapObj_SetAnimationCode(mapObj, MOVEMENT_ACTION_JUMP_ON_SPOT_FAST_NORTH + back);
+    } else {
+        MapObject_SetPauseMovementOn(mapObj);
+    }
+
+    FieldSystem_CreateTask(fieldSystem, PortFollower_TalkTask, talk);
+    return TRUE;
+}
