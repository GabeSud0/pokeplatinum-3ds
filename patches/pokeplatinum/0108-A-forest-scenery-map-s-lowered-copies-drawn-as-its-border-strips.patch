+                break;
+            }
+
+            loadedMap->mapRenderObj.resMdl = strip;
+            Easy3D_DrawRenderObj(&loadedMap->mapRenderObj, &position, &rotationMatrix, &scale);
+            NNS_G3dGeFlushBuffer();
+            loadedMap->mapRenderObj.resMdl = own;
+        }
+
+        if (whole) {
             Easy3D_DrawRenderObj(&loadedMap->mapRenderObj, &position, &rotationMatrix, &scale);
         }
     }
@@ -1839,6 +1966,7 @@ static void Port_RenderSceneryMapsLowered(const LandDataManager *landDataMan)
         return;
     }
 
+    sPortLoweredScene++;
 
     for (u8 i = 0; i < QUADRANT_COUNT; i++) {
         if (landDataMan->loadedMaps[i]->mapMatrixIndex != INVALID_MAP_MATRIX_INDEX && landDataMan->loadedMaps[i]->valid == TRUE) {
@@ -2197,6 +2325,227 @@ static u8 *Port_CopyWithCuts(const NNSG3dResFileHeader *file, void **cuts, const
     return block;
 }
 
+// A big scenery map's strips by its four sides (Port_RenderSceneryMapLowered),
+// cut from the loaded map's model (the game done reading it) a side a
+// scene, the copies drawn whole meanwhile: cut at once, a forest's lists
+// four times over would be a stutter, as the mirrored copies made at once
+// were on the Cycling Road (4 to 6 ms). Kept for up to
+// PORT_LOWERED_COPIES maps, the one asked for longest
+// ago let go first: the game moves the maps it keeps to other quadrants
+// as the player crosses a map's middle.
+#define PORT_LOWERED_COPIES 6
+
+typedef struct PortLoweredCopy {
+    int mapMatrixIndex, matrixID, landDataID; // (whose)
+    BOOL failed;                              // (couldn't be cut: not tried again)
+    u32 used;                                 // (sPortLoweredCalls when last asked for)
+    int numShp, sidesCut;
+    void **cuts;                              // [side * numShp + shape] while being cut
+    u8 *block;                                // the model file copied, then the cut lists
+    NNSG3dResMdl *model;
+    u32 *cutOfs, *cutSize;                    // [side * numShp + shape]
+    u32 sideBytes[PORT_SIDES], wholeBytes;    // (each side's lists, and the model's own)
+} PortLoweredCopy;
+
+static PortLoweredCopy sPortLoweredCopies[PORT_LOWERED_COPIES];
+static u32 sPortLoweredCalls;
+
+static void Port_FreeLoweredCopy(PortLoweredCopy *copy)
+{
+    for (int i = 0; copy->cuts != NULL && i < PORT_SIDES * copy->numShp; i++) {
+        free(copy->cuts[i]);
+    }
+
+    free(copy->cuts);
+    free(copy->block);
+    free(copy->cutOfs);
+    free(copy->cutSize);
+    memset(copy, 0, sizeof(*copy));
+}
+
+static void Port_FreeLoweredCopies(void)
+{
+    for (int i = 0; i < PORT_LOWERED_COPIES; i++) {
+        Port_FreeLoweredCopy(&sPortLoweredCopies[i]);
+    }
+}
+
+static BOOL Port_LoweredCopyIs(const PortLoweredCopy *copy, int mapMatrixIndex, int matrixID, int landDataID)
+{
+    return (copy->block != NULL || copy->cuts != NULL || copy->failed) && copy->mapMatrixIndex == mapMatrixIndex
+        && copy->matrixID == matrixID && copy->landDataID == landDataID;
+}
+
+// The loaded map's model with its shapes' lists those of its strip by that
+// side: NULL while it isn't cut yet (a side a scene) or if it can't be.
+static NNSG3dResMdl *Port_LoweredStripOf(const LandDataManager *landDataMan, u8 index, int side)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+    int landDataID = MapMatrix_GetLandDataIDByIndex(loadedMap->mapMatrixIndex, landDataMan->mapMatrix);
+    PortLoweredCopy *copy = NULL;
+
+    if (loadedMap->valid != TRUE || loadedMap->mapModelFile == NULL) {
+        return NULL;
+    }
+
+    sPortLoweredCalls++;
+
+    for (int k = 0; k < PORT_LOWERED_COPIES && copy == NULL; k++) {
+        if (Port_LoweredCopyIs(&sPortLoweredCopies[k], loadedMap->mapMatrixIndex, matrixID, landDataID)) {
+            copy = &sPortLoweredCopies[k];
+        }
+    }
+
+    NNSG3dResMdl *model = loadedMap->mapRenderObj.resMdl;
+    NNSG3dResShp *shapes = NNS_G3dGetShp(model);
+    NNSG3dResMdlInfo *info = NNS_G3dGetMdlInfo(model);
+
+    if (copy == NULL) {
+        // (a free place, or the one asked for longest ago)
+        for (int k = 0; k < PORT_LOWERED_COPIES; k++) {
+            PortLoweredCopy *c = &sPortLoweredCopies[k];
+
+            if (c->block == NULL && c->cuts == NULL && !c->failed) {
+                copy = c;
+                break;
+            }
+
+            if (copy == NULL || (int)(c->used - copy->used) < 0) {
+                copy = c;
+            }
+        }
+
+        Port_FreeLoweredCopy(copy);
+        copy->mapMatrixIndex = loadedMap->mapMatrixIndex;
+        copy->matrixID = matrixID;
+        copy->landDataID = landDataID;
+        copy->numShp = shapes->dict.numEntry;
+        copy->cuts = copy->numShp > 0 ? calloc(PORT_SIDES * copy->numShp, sizeof(void *)) : NULL;
+        copy->cutSize = copy->numShp > 0 ? calloc(PORT_SIDES * copy->numShp, sizeof(u32)) : NULL;
+        copy->cutOfs = copy->numShp > 0 ? calloc(PORT_SIDES * copy->numShp, sizeof(u32)) : NULL;
+
+        if (copy->cuts == NULL || copy->cutSize == NULL || copy->cutOfs == NULL || info->posScale <= 0) {
+            Port_FreeLoweredCopy(copy);
+            copy->mapMatrixIndex = loadedMap->mapMatrixIndex;
+            copy->matrixID = matrixID;
+            copy->landDataID = landDataID;
+            copy->failed = TRUE;
+        }
+    }
+
+    copy->used = sPortLoweredCalls;
+
+    if (copy->failed) {
+        return NULL;
+    }
+
+    if (copy->block == NULL) {
+        if (sPortLoweredCutScene == sPortLoweredScene || copy->numShp != shapes->dict.numEntry) {
+            return NULL; // (a side already cut in this scene: the next one in the next)
+        }
+
+        sPortLoweredCutScene = sPortLoweredScene;
+
+        // (the strip in the lists' own coordinates: the map's middle at 0,
+        // half its width either side; a tile more past the border, as the
+        // south strips of Port_EdgeCopyOf)
+        int cut = copy->sidesCut;
+        s32 tile = (s32)(((s64)MAP_OBJECT_TILE_SIZE << FX32_SHIFT) / info->posScale);
+        s32 half = tile * MAP_TILES_COUNT_X / 2;
+        int axis = cut == PORT_SIDE_NORTH || cut == PORT_SIDE_SOUTH ? 2 : 0;
+        s32 lo = cut == PORT_SIDE_NORTH || cut == PORT_SIDE_WEST ? -half - tile : half - PORT_LOWERED_STRIP * tile;
+        s32 hi = cut == PORT_SIDE_NORTH || cut == PORT_SIDE_WEST ? -half + PORT_LOWERED_STRIP * tile : half + tile;
+
+        for (int i = 0; i < copy->numShp && !copy->failed; i++) {
+            NNSG3dResShpData *shp = NNS_G3dGetShpDataByIdx(shapes, i);
+            const void *list = NNS_G3dGetShpDLPtr(shp);
+            u32 size = NNS_G3dGetShpDLSize(shp), room = size + size / 2 + 64;
+            int k = cut * copy->numShp + i;
+
+            copy->cuts[k] = malloc(room);
+            copy->cutSize[k] = copy->cuts[k] == NULL ? 0 : NitroPort_Gx3dTrimList(list, size, copy->cuts[k], room, axis, lo, hi);
+            copy->failed = copy->cutSize[k] == 0; // (a list that can't be cut: not done)
+        }
+
+        if (!copy->failed && ++copy->sidesCut == PORT_SIDES) {
+            copy->block = Port_CopyWithCuts(loadedMap->mapModelFile, copy->cuts, copy->cutSize, copy->cutOfs, PORT_SIDES * copy->numShp);
+            copy->failed = copy->block == NULL;
+
+            if (!copy->failed) {
+                copy->model = NNS_G3dGetMdlByIdx(NNS_G3dGetMdlSet((NNSG3dResFileHeader *)copy->block), 0);
+
+                for (int i = 0; i < copy->numShp; i++) {
+                    copy->wholeBytes += NNS_G3dGetShpDLSize(NNS_G3dGetShpDataByIdx(shapes, i));
+
+                    for (int side = 0; side < PORT_SIDES; side++) {
+                        copy->sideBytes[side] += copy->cutSize[side * copy->numShp + i];
+                    }
+                }
+            }
+
+            for (int i = 0; i < PORT_SIDES * copy->numShp; i++) {
+                free(copy->cuts[i]);
+            }
+
+            free(copy->cuts);
+            copy->cuts = NULL;
+        }
+
+        if (copy->failed) {
+            int keep[3] = { copy->mapMatrixIndex, copy->matrixID, copy->landDataID };
+
+            Port_FreeLoweredCopy(copy);
+            copy->mapMatrixIndex = keep[0];
+            copy->matrixID = keep[1];
+            copy->landDataID = keep[2];
+            copy->failed = TRUE;
+            copy->used = sPortLoweredCalls;
+        }
+
+        return NULL;
+    }
+
+    NNSG3dResShp *cutShapes = NNS_G3dGetShp(copy->model);
+
+    for (int i = 0; i < copy->numShp; i++) {
+        NNSG3dResShpData *shp = NNS_G3dGetShpDataByIdx(cutShapes, i);
+        int k = side * copy->numShp + i;
+
+        shp->ofsDL = (u32)(copy->block + copy->cutOfs[k] - (u8 *)shp);
+        shp->sizeDL = copy->cutSize[k];
+    }
+
+    return copy->model;
+}
+
+// Whether the loaded map's strips by those sides (a mask) are fewer lists
+// than its whole model: TRUE too while they aren't cut yet (or can't be:
+// Port_LoweredStripOf then has it drawn whole).
+static BOOL Port_LoweredStripsCheaper(const LandDataManager *landDataMan, u8 index, int sides)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+    int landDataID = MapMatrix_GetLandDataIDByIndex(loadedMap->mapMatrixIndex, landDataMan->mapMatrix);
+
+    for (int k = 0; k < PORT_LOWERED_COPIES; k++) {
+        const PortLoweredCopy *copy = &sPortLoweredCopies[k];
+        u32 bytes = 0;
+
+        if (copy->block == NULL || !Port_LoweredCopyIs(copy, loadedMap->mapMatrixIndex, matrixID, landDataID)) {
+            continue;
+        }
+
+        for (int side = 0; side < PORT_SIDES; side++) {
+            bytes += (sides & (1 << side)) ? copy->sideBytes[side] : 0;
+        }
+
+        return bytes < copy->wholeBytes;
+    }
+
+    return TRUE;
+}
+
 static void Port_FreeMirrorCopies(void)
 {
     for (int i = 0; i < PORT_MIRROR_COPIES; i++) {
@@ -4563,6 +4912,7 @@ void LandDataManager_End(LandDataManager *landDataMan)
 {
 #ifdef SDK_PORT_3DS
     Port_FreeMirrorCopies();
+    Port_FreeLoweredCopies();
     Port_FreeEdgeCopies();
     Port_FreeBesideMaps();
     Port_FreeOtherAreas();
