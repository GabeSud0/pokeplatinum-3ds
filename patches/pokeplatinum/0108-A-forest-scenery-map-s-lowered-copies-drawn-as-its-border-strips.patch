From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Sat, 7 Nov 2026 05:30:00 -0700
Subject: [PATCH] A forest scenery map's lowered copies drawn as its border
 strips (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A scenery map higher than a loaded map beside it is drawn again below
itself, from the lowest neighbour's height up, 2 tiles apart, to fill the
slit along the border (Port_RenderSceneryMapLowered, patch 0068). That was
made for the mountains' scenery map (MAP_175, 16 polygons). The forests'
(MAP_173 beside Route 204, Floaroma, Valley Windworks' west and Eterna;
MAP_176 beside Route 215, Veilstone, Solaceon and Hearthome) are 21 KB
files, and drawn whole their copies were a quarter of the vertices sent a
scene by Valley Windworks' south side (3.5k of 13k at 236,666 on the PC,
62 of their triangles left after clipping). In a log of 2026-11-07
the 3DS's geometry took 30 ms a scene there, busy 90% of the time, a few
scenes left out a second while walking, the follower seen to jump in the
tall grass.

The copies are seen only through the slit: elsewhere they're under the
scenery map itself. So for a model file over 8 KB, each copy is now drawn
as its strips by the sides with a lower map beside it on the matrix
(loaded or not): the polygons within PORT_LOWERED_STRIP (4) tiles of that
border (NitroPort_Gx3dTrimList), each strip only while its box is in the
view, and the copy whole as before when the strips in the view are as
many lists as all of it (the forests' four strips are 102% of it, their
north and south ones 14-18% each, east and west 35%). The strips are cut
from the loaded map's model a side a scene (0.1 ms a side on the PC), the
copies drawn whole meanwhile, and kept for 6 maps (Port_LoweredStripOf).
MAP_175 is drawn as before.

On the PC, the pictures the same, pixel for pixel, at Valley Windworks (10
spots), Floaroma (5), Route 204 (9), Jubilife (4), Eterna (3), Route 205
(4), Route 206 (8), Veilstone (4), Solaceon (3), Hearthome (3) and Route
210 (2), but for people walking about (and Route 215's rain). Vertices a
scene: Floaroma's west side 17.5k to 11.1k, Eterna 620,560 7.1k to 3.9k,
Valley Windworks 236,666 13.0k to 10.1k and 226,668 15.7k to 11.7k, Route
215 640,600 14.2k to 11.2k, Hearthome 480,680 12.9k to 10.6k; where no
such map is in the view, the same as before.
---
diff --git a/src/overlay005/land_data.c b/src/overlay005/land_data.c
index c8f11ba5..5dbcdd11 100644
--- a/src/overlay005/land_data.c
+++ b/src/overlay005/land_data.c
@@ -1767,6 +1767,77 @@ static BOOL Port_HasNorthStrip(const LandDataManager *landDataMan, int mapMatrix
 // itself, from the height of the lowest map beside it up, 2 tiles apart:
 // those copies fill the slit as a wall would, under the map itself
 // everywhere else (they're small: 16 polygons each).
+//
+// The forests' scenery maps aren't small (MAP_173 beside Route 204,
+// Floaroma and Valley Windworks' west; MAP_176 beside Route 215,
+// Veilstone, Solaceon and Hearthome; 21 KB files): their copies, drawn
+// whole, were a quarter of the vertices sent a scene by Valley Windworks'
+// south side (3.5k of 13k at 236,666 on the PC, 62 of their triangles left
+// after clipping; in a log of 2026-11-07 the 3DS's geometry took 30 ms a
+// scene by Valley Windworks, busy 90% of the time). Seen only through the
+// slit, each copy of such a map is drawn as its strips by the borders with
+// a lower map
+// (Port_LoweredStripOf): the polygons within PORT_LOWERED_STRIP tiles of
+// that border, cut once. The same picture on the PC (Valley Windworks,
+// Floaroma, Route 204, Eterna, Jubilife, Route 215, Veilstone, Solaceon,
+// Hearthome); Floaroma's west side 17.5k vertices a scene to 11.1k, Route
+// 215 at 640,600 14.2k to 11.2k.
+#define PORT_LOWERED_STRIP       4           // (tiles from the border)
+#define PORT_LOWERED_WHOLE_BYTES (8 * 1024)  // (a model file this size or smaller drawn whole, as before)
+
+enum {
+    PORT_SIDE_NORTH,
+    PORT_SIDE_SOUTH,
+    PORT_SIDE_WEST,
+    PORT_SIDE_EAST,
+    PORT_SIDES,
+};
+
+static NNSG3dResMdl *Port_LoweredStripOf(const LandDataManager *landDataMan, u8 index, int side);
+static BOOL Port_LoweredStripsCheaper(const LandDataManager *landDataMan, u8 index, int sides);
+static u32 sPortLoweredScene, sPortLoweredCutScene; // (Port_RenderSceneryMapsLowered's scenes; the last one a side was cut in)
+
+// The box of the loaded map's strip by a side, at position (the map's
+// middle), in the view.
+static BOOL Port_LoweredStripInView(const NNSG3dResMdl *model, const VecFx32 *position, int side)
+{
+    const NNSG3dResMdlInfo *info = NNS_G3dGetMdlInfo((NNSG3dResMdl *)model);
+    VecFx32 scale = { FX32_ONE, FX32_ONE, FX32_ONE };
+    MtxFx33 rotationMatrix = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+    int across = PORT_LOWERED_STRIP + 1;
+    VecFx32 corner = {
+        position->x - (MAP_TILES_COUNT_X / 2) * MAP_OBJECT_TILE_SIZE,
+        position->y + FX_Mul((fx32)info->boxY, info->boxPosScale),
+        position->z - (MAP_TILES_COUNT_Z / 2) * MAP_OBJECT_TILE_SIZE,
+    };
+    fx32 width = MAP_TILES_COUNT_X * MAP_OBJECT_TILE_SIZE, depth = MAP_TILES_COUNT_Z * MAP_OBJECT_TILE_SIZE;
+    GFXTestBox box;
+
+    switch (side) {
+    case PORT_SIDE_NORTH:
+        corner.z -= MAP_OBJECT_TILE_SIZE;
+        depth = across * MAP_OBJECT_TILE_SIZE;
+        break;
+    case PORT_SIDE_SOUTH:
+        corner.z += (MAP_TILES_COUNT_Z - PORT_LOWERED_STRIP) * MAP_OBJECT_TILE_SIZE;
+        depth = across * MAP_OBJECT_TILE_SIZE;
+        break;
+    case PORT_SIDE_WEST:
+        corner.x -= MAP_OBJECT_TILE_SIZE;
+        width = across * MAP_OBJECT_TILE_SIZE;
+        break;
+    default:
+        corner.x += (MAP_TILES_COUNT_X - PORT_LOWERED_STRIP) * MAP_OBJECT_TILE_SIZE;
+        width = across * MAP_OBJECT_TILE_SIZE;
+        break;
+    }
+
+    NNS_G3dGlbSetBaseRot(&rotationMatrix);
+    NNS_G3dGlbSetBaseScale(&scale);
+    GFXBoxTest_MakeBox(width, FX_Mul((fx32)info->boxH, info->boxPosScale), depth, &box);
+    return GFXBoxTest_IsBoxAtPositionInView(&corner, &box);
+}
+
 static void Port_RenderSceneryMapLowered(const u8 index, const LandDataManager *landDataMan)
 {
     LoadedMap *loadedMap = landDataMan->loadedMaps[index];
@@ -1817,6 +1888,24 @@ static void Port_RenderSceneryMapLowered(const u8 index, const LandDataManager *
     position.x += landDataMan->offset.x;
     position.z += landDataMan->offset.z;
 
+    // (a big one: the sides with a lower map beside it on the matrix, loaded
+    // or not, as the whole copies covered them all)
+    int sides = 0;
+
