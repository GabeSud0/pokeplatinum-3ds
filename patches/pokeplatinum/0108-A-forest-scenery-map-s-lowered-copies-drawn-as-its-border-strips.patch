+                sides |= 1 << side;
+            }
+        }
+    }
+
     // (at heights 2 tiles apart, from the lowest beside it up: the map
     // beside has its own hills at its edge, and seen from the side the
     // slit is between this map and those; each copy shows below the one
@@ -1824,7 +1913,45 @@ static void Port_RenderSceneryMapLowered(const u8 index, const LandDataManager *
     for (int a = lowest; a < altitude; a += 4) {
         position.y = a * (MAP_OBJECT_TILE_SIZE / 2) + landDataMan->offset.y - (a == stripsBelow ? PORT_NORTH_SCENERY_DROP : 0);
 
-        if (GFXBoxTest_IsModelInView(loadedMap->mapRenderObj.resMdl, &position, &rotationMatrix, &scale)) {
+        if (!GFXBoxTest_IsModelInView(loadedMap->mapRenderObj.resMdl, &position, &rotationMatrix, &scale)) {
+            continue;
+        }
+
+        NNSG3dResMdl *own = loadedMap->mapRenderObj.resMdl;
+        int seen = 0;
+
+        for (int side = 0; side < PORT_SIDES; side++) {
+            if ((sides & (1 << side)) && Port_LoweredStripInView(own, &position, side)) {
+                seen |= 1 << side;
+            }
+        }
+
+        if (sides != 0 && seen == 0) {
+            continue; // (none of its strips in the view: nothing of it to see)
+        }
+
+        // (whole as before if those strips are as many lists as all of it)
+        BOOL whole = sides == 0 || !Port_LoweredStripsCheaper(landDataMan, index, seen);
+
+        for (int side = 0; side < PORT_SIDES && !whole; side++) {
+            if (!(seen & (1 << side))) {
