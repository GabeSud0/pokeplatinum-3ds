+        int x = mapMatrixIndex % width, z = mapMatrixIndex / width, height = landDataMan->mapMatrixHeight;
+        static const s8 sSideDx[PORT_SIDES] = { 0, 0, -1, 1 }, sSideDz[PORT_SIDES] = { -1, 1, 0, 0 };
