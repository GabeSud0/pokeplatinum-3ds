diff --git a/src/overlay005/land_data.c b/src/overlay005/land_data.c
index efceef4a..67f49628 100644
--- a/src/overlay005/land_data.c
+++ b/src/overlay005/land_data.c
@@ -30,6 +30,7 @@
 #ifdef SDK_PORT_3DS
 #include <nnsys/g3d/gecom.h>
 
+#include "constants/field/bdhc.h"
 #include "generated/map_headers.h"
 
 #include "gfx_box_test.h"
@@ -3168,12 +3169,119 @@ static void Port_FreeBesideMap(PortBesideMap *map)
     map->mapMatrixIndex = INVALID_MAP_MATRIX_INDEX;
 }
 
+// The collision of a map beside the loaded ones, read from its land data
+// and kept, for the ground under the people the wider field shows there
+// (TerrainCollisionManager_PortBesideHeight): the game finds none for them
+// till their map's loaded, and hides them. On the 3DS people at the
+// screen's corners, 17-19 tiles to the side, came into the picture a third
+// of a second to a second after they were in view (logs of 2026-11-06 and
+// 07, patch 0104's lines). 4 kept (the one asked for longest ago let go),
+// let go with the beside maps; at most one read a scene.
+#define PORT_BESIDE_BDHCS 4
+
+typedef struct PortBesideBDHC {
+    int mapMatrixIndex, matrixID, landDataID;
+    BOOL failed;
+    u32 used;
+    u8 *buffer;
+    BDHC bdhc;
+} PortBesideBDHC;
+
+static PortBesideBDHC sPortBesideBDHCs[PORT_BESIDE_BDHCS];
+static u32 sPortBesideBDHCCalls, sPortBesideBDHCReadFrame = (u32)-1;
+
+static void Port_FreeBesideBDHCs(void)
+{
+    for (int i = 0; i < PORT_BESIDE_BDHCS; i++) {
+        free(sPortBesideBDHCs[i].buffer);
+        memset(&sPortBesideBDHCs[i], 0, sizeof(sPortBesideBDHCs[i]));
+    }
+
+    sPortBesideBDHCReadFrame = (u32)-1;
+}
+
+// The collision of the map at mapMatrixIndex (for a map not loaded: the
+// caller's to tell), NULL if it has none or can't be read (yet: one read a
+// scene).
+const BDHC *LandDataManager_PortBesideBDHC(const LandDataManager *landDataMan, int mapMatrixIndex)
+{
+    if (landDataMan == NULL || landDataMan->mapMatrix == NULL || mapMatrixIndex < 0
+        || mapMatrixIndex >= landDataMan->mapMatrixWidth * landDataMan->mapMatrixHeight) {
+        return NULL;
+    }
+
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+    int landDataID = MapMatrix_GetLandDataIDByIndex(mapMatrixIndex, landDataMan->mapMatrix);
+    PortBesideBDHC *entry = NULL;
+
+    sPortBesideBDHCCalls++;
+
+    for (int i = 0; i < PORT_BESIDE_BDHCS; i++) {
+        PortBesideBDHC *e = &sPortBesideBDHCs[i];
+
+        if ((e->buffer != NULL || e->failed) && e->mapMatrixIndex == mapMatrixIndex && e->matrixID == matrixID && e->landDataID == landDataID) {
+            e->used = sPortBesideBDHCCalls;
+            return e->failed ? NULL : &e->bdhc;
+        }
+    }
+
+    if (sPortBesideBDHCReadFrame == sPortBesideFrame) {
+        return NULL; // (one read a scene: the rest the next)
+    }
+
+    for (int i = 0; i < PORT_BESIDE_BDHCS; i++) {
+        PortBesideBDHC *e = &sPortBesideBDHCs[i];
+
+        if (entry == NULL || (int)(e->used - entry->used) < 0) {
+            entry = e;
+        }
+    }
+
+    free(entry->buffer);
+    memset(entry, 0, sizeof(*entry));
+    entry->mapMatrixIndex = mapMatrixIndex;
+    entry->matrixID = matrixID;
+    entry->landDataID = landDataID;
+    entry->used = sPortBesideBDHCCalls;
+    entry->failed = TRUE; // (till it's read)
+    sPortBesideBDHCReadFrame = sPortBesideFrame;
+
+    if (sPortBesideNARC == NULL) {
+        sPortBesideNARC = NARC_ctor(NARC_INDEX_FIELDDATA__LAND_DATA__LAND_DATA, HEAP_ID_FIELD1);
+    }
+
+    if (sPortBesideNARC == NULL) {
+        return NULL;
+    }
+
+    LandDataHeader header;
+
+    LandDataHeader_Load(sPortBesideNARC, landDataID, &header);
+
+    if (header.bdhcSize <= 0 || header.terrainAttributesSize < 0 || header.mapPropsSize < 0 || header.mapModelSize < 0) {
+        return NULL;
+    }
+
+    entry->buffer = malloc(BDHC_BUFFER_SIZE); // (as the game's own: its arrays fit)
+
+    if (entry->buffer == NULL) {
+        return NULL;
+    }
+
+    NARC_Seek(sPortBesideNARC, header.terrainAttributesSize + header.mapPropsSize + header.mapModelSize);
+    BDHC_Load(sPortBesideNARC, header.bdhcSize, &entry->bdhc, entry->buffer);
+    entry->failed = FALSE;
+    return &entry->bdhc;
+}
+
 static void Port_FreeBesideMaps(void)
 {
     for (int i = 0; i < PORT_BESIDE_SLOTS; i++) {
         Port_FreeBesideMap(&sPortBesideMaps[i]);
     }
 
+    Port_FreeBesideBDHCs();
+
     if (sPortBesideNARC != NULL) {
         NARC_dtor(sPortBesideNARC);
         sPortBesideNARC = NULL;
diff --git a/src/terrain_collision_manager.c b/src/terrain_collision_manager.c
index 362b1227..e43d3117 100644
--- a/src/terrain_collision_manager.c
+++ b/src/terrain_collision_manager.c
@@ -136,6 +136,69 @@ static const fx32 GetHeight(const FieldSystem *fieldSystem, const fx32 objectHei
     return newObjectHeight;
 }
 
+#ifdef SDK_PORT_3DS
+// (the 3DS port) The ground's height at a place in a map not loaded, from
+// its collision read for the wider field (LandDataManager_PortBesideBDHC),
+// as GetHeight finds it once the map's loaded: for the people the wider
+// field shows beside the loaded maps, whom the game hides while it finds
+// no ground under them (MapObject_RecalculateObjectHeight). FALSE in a
+// loaded map, on a moving height's tile (DynamicTerrainHeightManager), in
+// a field with the simple collisions, or with none found.
+BOOL TerrainCollisionManager_PortBesideHeight(const FieldSystem *fieldSystem, const fx32 objectHeight, const fx32 objectX, const fx32 objectZ, fx32 *height)
+{
+    if (fieldSystem->terrainCollisionMan != &sTerrainCollisionManagerFuncs || fieldSystem->landDataMan == NULL || fieldSystem->mapMatrix == NULL) {
+        return FALSE;
+    }
+
+    const LandDataManager *landDataMan = fieldSystem->landDataMan;
+    VecFx32 offset;
+    LandDataManager_GetOffset(landDataMan, &offset);
+
+    if (objectX - offset.x < 0 || objectZ - offset.z < 0) {
+        return FALSE;
+    }
+
+    int mapMatrixWidth = MapMatrix_GetWidth(fieldSystem->mapMatrix);
+    int mapMatrixHeight = MapMatrix_GetHeight(fieldSystem->mapMatrix);
+    int mapMatrixWidthTiles = mapMatrixWidth * MAP_TILES_COUNT_X;
+    u32 tileX = (objectX - offset.x) / MAP_OBJECT_TILE_SIZE;
+    u32 tileZ = (objectZ - offset.z) / MAP_OBJECT_TILE_SIZE;
+    u32 mapMatrixX = tileX / MAP_TILES_COUNT_X;
+    u32 mapMatrixZ = tileZ / MAP_TILES_COUNT_Z;
+
+    if (mapMatrixX >= (u32)mapMatrixWidth || mapMatrixZ >= (u32)mapMatrixHeight) {
+        return FALSE;
+    }
+
+    u32 mapMatrixIndex = mapMatrixX + mapMatrixZ * mapMatrixWidth;
+    u32 tileIndex = tileX + tileZ * mapMatrixWidthTiles;
+    u8 tileMapQuadrant = LandDataManager_CalculateMapQuadrantOfTile(tileIndex, mapMatrixWidthTiles);
+    u8 dynHeightPlateIndex;
+
+    if (LandDataManager_GetRelativeLoadedMapsQuadrant(mapMatrixIndex, tileMapQuadrant, landDataMan) <= QUADRANT_COUNT - 1
+        || DynamicTerrainHeightManager_GetPlateIndexOfTile(tileX, tileZ, fieldSystem->dynamicTerrainHeightMan, &dynHeightPlateIndex)) {
+        return FALSE;
+    }
+
+    const BDHC *bdhc = LandDataManager_PortBesideBDHC(landDataMan, mapMatrixIndex);
+
+    if (bdhc == NULL) {
+        return FALSE;
+    }
+
+    fx32 currentMapOriginX = (mapMatrixX * MAP_TILES_COUNT_X + MAP_TILES_COUNT_X / 2) * MAP_OBJECT_TILE_SIZE;
+    fx32 currentMapOriginZ = (mapMatrixZ * MAP_TILES_COUNT_Z + MAP_TILES_COUNT_Z / 2) * MAP_OBJECT_TILE_SIZE;
+    fx32 y = 0;
+
+    if (!CalculateObjectHeight(objectHeight - offset.y, objectX - currentMapOriginX - offset.x, objectZ - currentMapOriginZ - offset.z, bdhc, &y)) {
+        return FALSE;
+    }
+
+    *height = y + offset.y;
+    return TRUE;
+}
+#endif
+
 static const fx32 GetSimpleHeight(const FieldSystem *fieldSystem, const fx32 objectHeight, const fx32 objectX, const fx32 objectZ, u8 *newObjectHeightSourceOut)
 {
     int tileX = objectX / MAP_OBJECT_TILE_SIZE;
