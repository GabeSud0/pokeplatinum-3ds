+// One line of a tile as the map shows it (flipped as its entry says).
+static void CryWide_TileLine(const u8 *chars, u16 entry, int line, u8 *out)
+{
+    const u8 *row = chars + (entry & 0x3FF) * TILE_SIZE_4BPP + ((entry & 0x800) ? 7 - line : line) * 4;
+
+    for (int k = 0; k < 4; k++) {
+        u8 b = (entry & 0x400) ? row[3 - k] : row[k];
+
+        out[k] = (entry & 0x400) ? (u8)((b >> 4) | (b << 4)) : b;
+    }
+}
+
+// The band's lower edge 3 lines lower: its row of tiles made again (on
+// BG2, over BG3's: the same tiles and palettes), their first 3 lines the
+// band's (the row above's), then the edge's first 5 (its colours, the
+// page's background under it left out).
+static void CryWide_LowerEdge(BgConfig *bgConfig, BOOL on)
+{
+    u16 *map = Bg_GetTilemapBuffer(bgConfig, BG_LAYER_MAIN_3), *over = Bg_GetTilemapBuffer(bgConfig, BG_LAYER_MAIN_2);
+    const u8 *chars = Bg_GetCharPtr(BG_LAYER_MAIN_3);
+    static u8 tiles[8][TILE_SIZE_4BPP];
+    u16 made[8][2];
+    int n = 0;
+
+    if (map == NULL || over == NULL || chars == NULL) {
+        return;
+    }
+
+    for (int x = 0; x < 32; x++) {
+        u16 band = map[(CRY_EDGE_ROW - 1) * 32 + x], edge = map[CRY_EDGE_ROW * 32 + x];
+        int k;
+
+        over[CRY_EDGE_ROW * 32 + x] = 0;
+
+        if (!on || (band >> 12) != (edge >> 12)) {
+            continue; // (in palettes apart: as it is)
+        }
+
+        for (k = 0; k < n && (made[k][0] != band || made[k][1] != edge); k++) {
+        }
+
+        if (k == n) {
+            if (n == 8) {
+                continue;
+            }
+
+            for (int line = 0; line < 8; line++) {
+                CryWide_TileLine(chars, line < CRY_EDGE_DOWN ? band : edge, line < CRY_EDGE_DOWN ? line : line - CRY_EDGE_DOWN, tiles[n] + line * 4);
+            }
+
+            made[n][0] = band;
+            made[n][1] = edge;
+            n++;
+        }
+
+        over[CRY_EDGE_ROW * 32 + x] = (u16)((CRY_EDGE_TILE - k) | (edge & 0xF000));
+    }
+
+    for (int k = 0; k < n; k++) {
+        DC_FlushRange(tiles[k], TILE_SIZE_4BPP);
+        Bg_LoadTiles(bgConfig, BG_LAYER_MAIN_2, tiles[k], TILE_SIZE_4BPP, CRY_EDGE_TILE - k);
+    }
+
+    Bg_ScheduleTilemapTransfer(bgConfig, BG_LAYER_MAIN_2);
+}
+
+// The page up on the wider screen: BG1 512 wide, the wave's window, its
+// layout; the band's edge lower.
+static void CryWide_Start(UnkStruct_ov21_021E4108 *param0)
+{
