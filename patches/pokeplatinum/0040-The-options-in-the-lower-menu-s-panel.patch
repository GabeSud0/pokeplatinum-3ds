+// A card's value into panel->text. FALSE: it has no arrows (an action).
+static BOOL OptionsPanel_CardValue(OptionsPanel *panel, const OptionsCard *card)
+{
+    switch (card->kind) {
+    case OPK_GAME:
+        MessageLoader_GetString(panel->loader, sGameValueEntry[card->id] + OptionsPanel_GameValue(panel, card->id), panel->text);
+        return TRUE;
+    case OPK_PORT:
+        OptionsPanel_SetLetters(panel->text, OptionsPanel_PortValueName(card->id, NitroPort_Option(card->id)));
+        return TRUE;
+    case OPK_GIVE:
+        if (card->id == OPG_POCKET) {
+            OptionsPanel_SetLetters(panel->text, sGivePocketNames[panel->givePocket]);
+        } else if (card->id == OPG_ITEM) {
+            int item = OptionsPanel_GiveItem(panel);
+
+            if (item != ITEM_NONE) {
+                Item_LoadName(panel->text, item, OP_HEAP);
+            } else {
+                OptionsPanel_SetLetters(panel->text, "-");
+            }
+        } else {
+            String_FormatInt(panel->text, panel->giveHowMany, 2, PADDING_MODE_NONE, CHARSET_MODE_EN);
+        }
+        return TRUE;
+    default:
+        OptionsPanel_SetLetters(panel->text,
+            card->id == OPA_OPEN_GIVE ? "TAP TO OPEN"
+                : card->id == OPA_BACK ? "BACK TO CHEATS"
+                : panel->giveDone > 0 ? "GIVEN"
+                : panel->giveDone < 0 ? "NO ROOM"
+                                      : "TAP TO GIVE");
+        return FALSE;
+    }
+}
