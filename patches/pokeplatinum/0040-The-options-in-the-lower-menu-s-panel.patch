+static void OptionsPanel_Cursor(OptionsPanel *panel, int x0, int y0, int x1, int y1)
+{
+    for (int t = 0; t < 2; t++) {
+        int a0 = x0 - 1 + t, b0 = y0 - 1 + t, a1 = x1 + 1 - t, b1 = y1 + 1 - t;
+
+        OptionsPanel_Fill(panel, OPC_CURSOR, a0 + 2 - t, b0, a1 - 2 + t, b0);
+        OptionsPanel_Fill(panel, OPC_CURSOR, a0 + 2 - t, b1, a1 - 2 + t, b1);
+        OptionsPanel_Fill(panel, OPC_CURSOR, a0, b0 + 2 - t, a0, b1 - 2 + t);
+        OptionsPanel_Fill(panel, OPC_CURSOR, a1, b0 + 2 - t, a1, b1 - 2 + t);
+    }
+
+    OptionsPanel_Fill(panel, OPC_CURSOR, x0, y0, x0, y0);
+    OptionsPanel_Fill(panel, OPC_CURSOR, x1, y0, x1, y0);
+    OptionsPanel_Fill(panel, OPC_CURSOR, x0, y1, x0, y1);
