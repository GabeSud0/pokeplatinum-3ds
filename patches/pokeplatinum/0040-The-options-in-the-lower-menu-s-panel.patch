+// GIVE ITEMS's lists: the items of each pocket it gives (the unused ones
+// left out), read once.
+static void OptionsPanel_ReadGiveItems(OptionsPanel *panel)
+{
+    ItemData *table;
+    int p, item, n = 0;
+
+    if (panel->giveItems != NULL) {
+        return;
+    }
+
+    panel->giveItems = Heap_Alloc(OP_HEAP, sizeof(u16) * NUM_ITEMS);
+    table = ItemTable_Load(OP_HEAP);
+
+    for (p = 0; p < (int)OP_GIVE_POCKETS; p++) {
+        panel->giveFirst[p] = n;
+
+        for (item = 1; item <= NUM_ITEMS - 1 && table != NULL && panel->giveItems != NULL; item++) {
+            if (item >= ITEM_UNUSED_113 && item <= ITEM_UNUSED_134) {
+                continue;
+            }
+
+            if (Item_Get(ItemTable_Index(table, Item_FileID(item, ITEM_FILE_TYPE_DATA)), ITEM_PARAM_FIELD_POCKET) == sGivePockets[p]) {
+                panel->giveItems[n++] = item;
+            }
+        }
+
+        panel->giveCount[p] = n - panel->giveFirst[p];
+    }
+
+    if (table != NULL) {
+        Heap_Free(table);
+    }
+}
+
+static int OptionsPanel_GiveItem(OptionsPanel *panel)
+{
+    if (panel->giveItems == NULL || panel->giveCount[panel->givePocket] == 0) {
+        return ITEM_NONE;
+    }
+
+    return panel->giveItems[panel->giveFirst[panel->givePocket] + panel->giveItem];
+}
