+#ifndef POKEPLATINUM_OPTIONS_PANEL_H
+#define POKEPLATINUM_OPTIONS_PANEL_H
+
+#ifdef SDK_PORT_3DS
+#include "field/field_system_decl.h"
+
+// The options in the 3DS remaster's lower menu's panel (options_panel.c):
+// a page drawn on the DS's lower screen, tall, in tabs (SETTINGS,
+// ENHANCEMENTS, CHEATS; CHEATS's GIVE ITEMS a page of its own). Opened with
+// the field's bottom screen (the Pokétch) stepped aside, the start menu's
+// task running it a frame at a time.
+
+// OptionsPanel_Update's answers besides one of the menu's buttons pressed
+// (the start menu acts on it once the page is closed).
+#define OPTIONS_PANEL_STAY  -1
+#define OPTIONS_PANEL_CLOSE -2
+
+// Where the page was when it closed (the start menu keeps it, so the page
+// opens again on the tab and the cards it was on).
+#define OPTIONS_PANEL_PAGES 4
+
+typedef struct OptionsPanelPlace {
+    int page;
+    int cursor[OPTIONS_PANEL_PAGES];
+} OptionsPanelPlace;
+
+void OptionsPanel_Open(FieldSystem *fieldSystem, const OptionsPanelPlace *place);
+void OptionsPanel_Close(FieldSystem *fieldSystem, OptionsPanelPlace *place);
+BOOL OptionsPanel_IsOpen(void);
+int OptionsPanel_Update(void);
+#endif
+
+#endif // POKEPLATINUM_OPTIONS_PANEL_H
