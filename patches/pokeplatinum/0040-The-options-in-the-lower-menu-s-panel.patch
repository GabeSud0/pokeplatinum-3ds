+static void OptionsPanel_SetLetters(String *string, const char *letters)
+{
+    String_Clear(string);
+
+    for (; *letters; letters++) {
+        int c = (unsigned char)*letters;
+        charcode_t code;
+
+        if (c >= 'A' && c <= 'Z') {
+            code = 0x12B + (c - 'A');
+        } else if (c >= 'a' && c <= 'z') {
+            code = 0x145 + (c - 'a');
+        } else if (c >= '0' && c <= '9') {
+            code = 0x121 + (c - '0');
+        } else {
+            switch (c) {
+            case ' ':
+                code = 0x1DE;
+                break;
+            case '.':
+                code = 0x1AE;
+                break;
+            case '/':
+                code = 0x1B1;
+                break;
+            case '-':
+                code = 0x1BE;
+                break;
+            case '&':
+                code = 0x1C2;
+                break;
+            case '`':
+                code = 0x188; // é
+                break;
+            case '<':
+                code = 0x11B; // ←
+                break;
+            case '>':
+                code = 0x11E; // →
+                break;
+            default:
+                continue;
+            }
+        }
+
+        String_AppendChar(string, code);
+    }
+}
