+static void OptionsPanel_CardEdges(OptionsPanel *panel, int x0, int y0, int x1, int y1, u8 edge, BOOL inner)
+{
+    OptionsPanel_Fill(panel, edge, x0 + 1, y0, x1 - 1, y0);
