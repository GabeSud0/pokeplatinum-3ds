+#include "font.h"
+#include "game_options.h"
+#include "graphics.h"
+#include "heap.h"
+#include "item.h"
+#include "port_options.h"
+#include "message.h"
+#include "render_window.h"
+#include "save_player.h"
+#include "savedata.h"
+#include "sound.h"
+#include "sound_playback.h"
+#include "string_gf.h"
+#include "system.h"
+#include "text.h"
+
+#include "res/text/bank/options_menu.h"
+
+// ------------------------------------------------------------------------
+// The options page (the approved mock-ups, after the Emerald project's
+// layout in the look of Platinum's own options screen): tabs at the top
+// (SETTINGS, ENHANCEMENTS, CHEATS), then the settings as cards in two
+// columns, each its name and, in red, its value between arrows. 256 x 248
+// DS pixels, on the lower screen's BG0 alone.
+//
+// The page is drawn into a window off the screen as one picture (the cards
+// filled, the game's text on them, then their edges and the cursor over it)
+// and cut into tiles, alike ones shared: drawn whole again when anything
+// changes. Touches: the port's panel buttons (the page is taller than the
+// DS's 192 rows the game's touch reaches), a card's left half its left
+// arrow, its right half its right one.
+//
+// The game's six settings go in its save (as its options screen sets them);
+// the port's own (60 FPS, smooth 3D, the start tab, the enhancements and
+// cheats) in the port's file beside it (nitro_port_options.h), saved when
+// the page closes.
+// ------------------------------------------------------------------------
+
+extern void NitroPort_LowerMenuSetPanelButtons(const short (*rects)[4], int count);
+extern int NitroPort_LowerMenuPressPending(void);
+extern int NitroPort_LowerMenuTakePress(void);
+
+#define PORT_BUTTON_OPTIONS  7 // (start_menu.c's PORT_BUTTON_OPTIONS)
+#define PORT_BUTTON_COUNT    8
+#define PORT_BUTTON_PRESS(k) (10 + 1 + 4 + (k)) // NITRO_LOWERMENU_BUTTON_PRESS
+#define PORT_BUTTONS_MAX     32                 // NITRO_LOWERMENU_BUTTONS_MAX
+
+#define OP_HEAP       HEAP_ID_POKETCH_APP // (the Pokétch's, stepped aside)
+#define OP_LAYER      BG_LAYER_SUB_0
+#define OP_W          32 // the page in tiles: 256 x 248
+#define OP_H          31
+#define OP_TILES      (OP_W * OP_H)
+#define OP_TILES_MAX  (0xB800 / TILE_SIZE_4BPP) // (the tiles below the tilemap, 48 KB of VRAM)
+#define OP_PAGE_LINES 248
+
+// The page's colours (the sub BG's palette 0).
+enum {
+    OPC_BACK = 1, // (0 the backdrop: the same)
+    OPC_WHITE,
+    OPC_SLATE,
+    OPC_SLATE_DARK,
+    OPC_PALE,
+    OPC_INK,
+    OPC_INK_SHADOW,
+    OPC_RED,
+    OPC_RED_SHADOW,
+    OPC_CURSOR,
+};
+
+static const u16 sOptionsPanelColours[16] = {
+    GX_RGB(24, 25, 26), // (198, 206, 214): the options screen's background
+    GX_RGB(24, 25, 26),
+    GX_RGB(31, 31, 31),
+    GX_RGB(9, 12, 15), // (74, 99, 123): its window's slate
+    GX_RGB(6, 9, 12), // (49, 74, 99)
+    GX_RGB(21, 23, 24), // (173, 189, 198): its pale edge
+    GX_RGB(11, 11, 10), // (90, 90, 82): its names' grey
+    GX_RGB(21, 23, 23), // (173, 189, 189)
+    GX_RGB(29, 4, 2), // (239, 33, 16): its chosen value's red
+    GX_RGB(31, 21, 23), // (255, 173, 189)
+    GX_RGB(31, 0, 0), // (255, 0, 0): its cursor
+};
+
+// The FRAME card is drawn in the frame chosen, as a message box of it would
+// be (the options screen shows its frame on its message box): its tiles in
+// the sub BG's palette 1, the frame's colours 5 to 15 (as the frames have
+// them), below them the few the card's text and its cursor need.
+enum {
+    OPF_INK = 1,
+    OPF_INK_SHADOW,
+    OPF_RED, // (the cursor too: near enough its red)
+    OPF_RED_SHADOW,
+    OPF_FRAME_FIRST, // (5: the frames' first colour)
+    OPF_WHITE = 15, // (the frames' white: inside a message box)
+};
+
+#define OP_FRAME_PALETTE 1
+#define OP_FRAME_CARD    5 // (SETTINGS's FRAME: the left column's last)
+
+// ----- the pages and their cards
+
+enum OptionsPage {
+    OP_PAGE_SETTINGS,
+    OP_PAGE_ENHANCEMENTS,
+    OP_PAGE_CHEATS,
+    OP_PAGE_GIVE, // (CHEATS 2/2)
+    OP_PAGE_COUNT
+};
+
+// (the start menu keeps a cursor a page: OptionsPanelPlace)
+typedef char OptionsPanelPagesCheck[OP_PAGE_COUNT == OPTIONS_PANEL_PAGES ? 1 : -1];
+
+enum OptionsCardKind {
+    OPK_GAME, // the game's setting `id` (OptionsPanel_Game*)
+    OPK_PORT, // the port's setting `id`
+    OPK_ACTION, // a value that does something: `id` an OPA_
+    OPK_GIVE, // GIVE ITEMS's POCKET, ITEM, HOW MANY: `id` an OPG_
+};
+
+enum {
+    OPA_OPEN_GIVE,
+    OPA_BACK,
+    OPA_GIVE,
+};
+
+enum {
+    OPG_POCKET,
+    OPG_ITEM,
+    OPG_COUNT,
+};
+
+typedef struct OptionsCard {
+    const char *name; // (the port's: in its letters; NULL: the options screen's `entry`)
+    u16 entry;
+    u8 kind;
+    u8 id;
+} OptionsCard;
+
+#define OP_CARDS_MAX 12 // (a page's, both columns)
+
+typedef struct OptionsPageDef {
+    const char *tab;
+    const OptionsCard *cards;
+    u8 left; // (the first `left` in the left column, top to bottom; the rest in the right)
+    u8 count;
+} OptionsPageDef;
+
