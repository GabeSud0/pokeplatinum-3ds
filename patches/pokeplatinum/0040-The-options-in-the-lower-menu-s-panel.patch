+typedef struct OptionsPanel {
+    FieldSystem *fieldSystem;
+    Options *options;
+    BgConfig *bgConfig; // (its own: the page's layer and window, on its heap)
+    Window canvas;
+    MessageLoader *loader;
+    String *text;
+    u8 *tiles; // (the page's tiles, alike ones once)
+    u16 hashHead[256];
+    u16 hashNext[OP_TILES + 1];
+    int page;
+    int cursor[OP_PAGE_COUNT];
+    // (the touch rectangles as last drawn: a tab, or a card and its step)
+    short rects[PORT_BUTTONS_MAX][4];
+    s8 rectTab[PORT_BUTTONS_MAX];
+    s8 rectCard[PORT_BUTTONS_MAX];
+    s8 rectStep[PORT_BUTTONS_MAX];
+    int rectCount;
+    // GIVE ITEMS: each pocket's items, from `giveFirst[p]`, `giveCount[p]` of them
+    u16 *giveItems;
+    u16 giveFirst[OP_GIVE_POCKETS];
+    u16 giveCount[OP_GIVE_POCKETS];
+    int givePocket, giveItem, giveHowMany;
+    int giveDone; // (frames left showing what GIVE did: > 0 given, < 0 no room)
+} OptionsPanel;
+
+static OptionsPanel *sOptionsPanel;
+
+// ----- drawing
+
+static void OptionsPanel_SetLetters(String *string, const char *letters)
+{
+    String_Clear(string);
+
+    for (; *letters; letters++) {
+        int c = (unsigned char)*letters;
+        charcode_t code;
+
+        if (c >= 'A' && c <= 'Z') {
+            code = 0x12B + (c - 'A');
+        } else if (c >= 'a' && c <= 'z') {
+            code = 0x145 + (c - 'a');
+        } else if (c >= '0' && c <= '9') {
+            code = 0x121 + (c - '0');
+        } else {
+            switch (c) {
+            case ' ':
+                code = 0x1DE;
+                break;
+            case '.':
+                code = 0x1AE;
+                break;
+            case '/':
+                code = 0x1B1;
+                break;
+            case '-':
+                code = 0x1BE;
+                break;
+            case '&':
+                code = 0x1C2;
+                break;
+            case '`':
+                code = 0x188; // é
+                break;
+            case '<':
+                code = 0x11B; // ←
+                break;
+            case '>':
+                code = 0x11E; // →
+                break;
+            default:
+                continue;
+            }
+        }
+
+        String_AppendChar(string, code);
+    }
+}
+
+static void OptionsPanel_Fill(OptionsPanel *panel, u8 colour, int x0, int y0, int x1, int y1)
+{
+    if (x1 >= x0 && y1 >= y0) {
+        Window_FillRectWithColor(&panel->canvas, colour, x0, y0, x1 - x0 + 1, y1 - y0 + 1);
+    }
+}
+
+// A small window: its fill (the text goes on it before its edges).
+static void OptionsPanel_CardFill(OptionsPanel *panel, int x0, int y0, int x1, int y1, u8 fill)
+{
+    OptionsPanel_Fill(panel, fill, x0, y0, x1, y1);
+}
+
+// Its edge with the corners rounded off, a pale line inside it.
+static void OptionsPanel_CardEdges(OptionsPanel *panel, int x0, int y0, int x1, int y1, u8 edge, BOOL inner)
+{
+    OptionsPanel_Fill(panel, edge, x0 + 1, y0, x1 - 1, y0);
+    OptionsPanel_Fill(panel, edge, x0 + 1, y1, x1 - 1, y1);
+    OptionsPanel_Fill(panel, edge, x0, y0 + 1, x0, y1 - 1);
+    OptionsPanel_Fill(panel, edge, x1, y0 + 1, x1, y1 - 1);
+    OptionsPanel_Fill(panel, OPC_BACK, x0, y0, x0, y0);
+    OptionsPanel_Fill(panel, OPC_BACK, x1, y0, x1, y0);
+    OptionsPanel_Fill(panel, OPC_BACK, x0, y1, x0, y1);
+    OptionsPanel_Fill(panel, OPC_BACK, x1, y1, x1, y1);
+    OptionsPanel_Fill(panel, edge, x0 + 1, y0 + 1, x0 + 1, y0 + 1);
+    OptionsPanel_Fill(panel, edge, x1 - 1, y0 + 1, x1 - 1, y0 + 1);
+    OptionsPanel_Fill(panel, edge, x0 + 1, y1 - 1, x0 + 1, y1 - 1);
+    OptionsPanel_Fill(panel, edge, x1 - 1, y1 - 1, x1 - 1, y1 - 1);
+
+    if (inner) {
+        OptionsPanel_Fill(panel, OPC_PALE, x0 + 2, y0 + 1, x1 - 2, y0 + 1);
+        OptionsPanel_Fill(panel, OPC_PALE, x0 + 2, y1 - 1, x1 - 2, y1 - 1);
+        OptionsPanel_Fill(panel, OPC_PALE, x0 + 1, y0 + 2, x0 + 1, y1 - 2);
+        OptionsPanel_Fill(panel, OPC_PALE, x1 - 1, y0 + 2, x1 - 1, y1 - 2);
+    }
+}
+
+// Platinum's options cursor: a red frame two pixels thick round the card,
+// its corners rounded.
+static void OptionsPanel_Cursor(OptionsPanel *panel, int x0, int y0, int x1, int y1)
+{
+    for (int t = 0; t < 2; t++) {
+        int a0 = x0 - 1 + t, b0 = y0 - 1 + t, a1 = x1 + 1 - t, b1 = y1 + 1 - t;
+
+        OptionsPanel_Fill(panel, OPC_CURSOR, a0 + 2 - t, b0, a1 - 2 + t, b0);
+        OptionsPanel_Fill(panel, OPC_CURSOR, a0 + 2 - t, b1, a1 - 2 + t, b1);
+        OptionsPanel_Fill(panel, OPC_CURSOR, a0, b0 + 2 - t, a0, b1 - 2 + t);
+        OptionsPanel_Fill(panel, OPC_CURSOR, a1, b0 + 2 - t, a1, b1 - 2 + t);
+    }
+
+    OptionsPanel_Fill(panel, OPC_CURSOR, x0, y0, x0, y0);
+    OptionsPanel_Fill(panel, OPC_CURSOR, x1, y0, x1, y0);
+    OptionsPanel_Fill(panel, OPC_CURSOR, x0, y1, x0, y1);
+    OptionsPanel_Fill(panel, OPC_CURSOR, x1, y1, x1, y1);
+}
+
+// The text in panel->text, at x (or centred between x and x1 when x1 >= 0).
+static void OptionsPanel_Print(OptionsPanel *panel, int x, int x1, int y, u8 ink, u8 shadow, u8 back)
+{
+    if (x1 >= 0) {
+        x += (x1 - x + 1 - (int)Font_CalcStringWidth(FONT_SYSTEM, panel->text, 0)) / 2;
+    }
+
+    Text_AddPrinterWithParamsAndColor(&panel->canvas, FONT_SYSTEM, panel->text, x, y, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(ink, shadow, back), NULL);
+}
+
+static int OptionsPanel_TextWidth(OptionsPanel *panel)
+{
+    return (int)Font_CalcStringWidth(FONT_SYSTEM, panel->text, 0);
+}
+
+static void OptionsPanel_CardBox(int page, int card, int *x0, int *y0, int *x1, int *y1)
+{
+    const OptionsPageDef *def = &sOptionsPages[page];
+    int column = card >= def->left, row = column ? card - def->left : card;
+
+    *x0 = sOptionsColumns[column][0];
+    *x1 = sOptionsColumns[column][1];
+    *y0 = OP_CARD_Y0 + row * (OP_CARD_H + OP_CARD_GAP);
+    *y1 = *y0 + OP_CARD_H - 1;
+}
+
+// ----- the settings' values
+
+static int OptionsPanel_GameValue(OptionsPanel *panel, int k)
+{
+    switch (k) {
+    case 0:
+        return Options_TextSpeed(panel->options);
+    case 1:
+        return Options_SoundMode(panel->options);
+    case 2:
+        return Options_BattleScene(panel->options);
+    case 3:
+        return Options_BattleStyle(panel->options);
+    case 4:
+        return Options_ButtonMode(panel->options);
+    default:
+        return Options_Frame(panel->options);
+    }
+}
+
+// (as the options screen sets them when it closes; the sound and the
+// buttons at once, as it does)
+static void OptionsPanel_SetGameValue(OptionsPanel *panel, int k, int value)
+{
+    switch (k) {
+    case 0:
+        Options_SetTextSpeed(panel->options, value);
+        break;
+    case 1:
+        Options_SetSoundMode(panel->options, value);
+        Sound_SetPlaybackMode(value);
+        break;
+    case 2:
+        Options_SetBattleScene(panel->options, value);
+        break;
+    case 3:
+        Options_SetBattleStyle(panel->options, value);
+        break;
+    case 4:
+        Options_SetButtonMode(panel->options, value);
+        Options_SetSystemButtonMode(NULL, value);
+        break;
+    default:
+        Options_SetFrame(panel->options, value);
+        break;
+    }
+}
+
+static const char *OptionsPanel_PortValueName(int id, int value)
+{
+    switch (id) {
+    case PORT_OPT_FPS60:
+        return sFpsValues[value];
+    case PORT_OPT_SMOOTH3D:
+        return sSmoothValues[value];
+    case PORT_OPT_START_TAB:
+        return sStartTabValues[value];
+    case PORT_OPT_SPEED:
+        return sSpeedValues[value];
+    case PORT_OPT_ENCOUNTERS:
+        return sEncounterValues[value];
+    case PORT_OPT_SHINY:
+        return sShinyValues[value];
+    default:
+        return sFpsValues[value != 0]; // (OFF, ON)
+    }
+}
+
+// GIVE ITEMS's lists: the items of each pocket it gives (the unused ones
+// left out), read once.
+static void OptionsPanel_ReadGiveItems(OptionsPanel *panel)
+{
+    ItemData *table;
+    int p, item, n = 0;
+
+    if (panel->giveItems != NULL) {
+        return;
+    }
+
+    panel->giveItems = Heap_Alloc(OP_HEAP, sizeof(u16) * NUM_ITEMS);
+    table = ItemTable_Load(OP_HEAP);
+
+    for (p = 0; p < (int)OP_GIVE_POCKETS; p++) {
+        panel->giveFirst[p] = n;
+
+        for (item = 1; item <= NUM_ITEMS - 1 && table != NULL && panel->giveItems != NULL; item++) {
+            if (item >= ITEM_UNUSED_113 && item <= ITEM_UNUSED_134) {
+                continue;
+            }
+
+            if (Item_Get(ItemTable_Index(table, Item_FileID(item, ITEM_FILE_TYPE_DATA)), ITEM_PARAM_FIELD_POCKET) == sGivePockets[p]) {
+                panel->giveItems[n++] = item;
+            }
+        }
+
+        panel->giveCount[p] = n - panel->giveFirst[p];
+    }
+
+    if (table != NULL) {
+        Heap_Free(table);
+    }
+}
+
+static int OptionsPanel_GiveItem(OptionsPanel *panel)
+{
+    if (panel->giveItems == NULL || panel->giveCount[panel->givePocket] == 0) {
+        return ITEM_NONE;
+    }
+
+    return panel->giveItems[panel->giveFirst[panel->givePocket] + panel->giveItem];
+}
+
+// A card's value into panel->text. FALSE: it has no arrows (an action).
+static BOOL OptionsPanel_CardValue(OptionsPanel *panel, const OptionsCard *card)
+{
+    switch (card->kind) {
+    case OPK_GAME:
+        MessageLoader_GetString(panel->loader, sGameValueEntry[card->id] + OptionsPanel_GameValue(panel, card->id), panel->text);
+        return TRUE;
+    case OPK_PORT:
+        OptionsPanel_SetLetters(panel->text, OptionsPanel_PortValueName(card->id, NitroPort_Option(card->id)));
+        return TRUE;
+    case OPK_GIVE:
+        if (card->id == OPG_POCKET) {
+            OptionsPanel_SetLetters(panel->text, sGivePocketNames[panel->givePocket]);
+        } else if (card->id == OPG_ITEM) {
+            int item = OptionsPanel_GiveItem(panel);
+
+            if (item != ITEM_NONE) {
+                Item_LoadName(panel->text, item, OP_HEAP);
+            } else {
+                OptionsPanel_SetLetters(panel->text, "-");
+            }
+        } else {
+            String_FormatInt(panel->text, panel->giveHowMany, 2, PADDING_MODE_NONE, CHARSET_MODE_EN);
+        }
+        return TRUE;
+    default:
+        OptionsPanel_SetLetters(panel->text,
+            card->id == OPA_OPEN_GIVE ? "TAP TO OPEN"
+                : card->id == OPA_BACK ? "BACK TO CHEATS"
+                : panel->giveDone > 0 ? "GIVEN"
+                : panel->giveDone < 0 ? "NO ROOM"
+                                      : "TAP TO GIVE");
+        return FALSE;
+    }
+}
+
+static void OptionsPanel_AddRect(OptionsPanel *panel, int x0, int y0, int x1, int y1, int tab, int card, int step)
+{
+    int k = panel->rectCount;
+
+    if (k >= PORT_BUTTONS_MAX) {
+        return;
+    }
+
+    panel->rects[k][0] = x0;
+    panel->rects[k][1] = y0;
+    panel->rects[k][2] = x1;
+    panel->rects[k][3] = y1;
+    panel->rectTab[k] = tab;
+    panel->rectCard[k] = card;
+    panel->rectStep[k] = step;
+    panel->rectCount++;
+}
+
+// The page as it is now: drawn, cut into tiles, put on the screen; its
+// touch rectangles given to the port.
+static void OptionsPanel_Draw(OptionsPanel *panel)
+{
+    const OptionsPageDef *def = &sOptionsPages[panel->page];
+    u16 *map = Bg_GetTilemapBuffer(panel->bgConfig, OP_LAYER);
+    const u8 *pixels = panel->canvas.pixels;
+    int k, n, t;
+
+    OptionsPanel_Fill(panel, OPC_BACK, 0, 0, 255, OP_PAGE_LINES - 1);
+    panel->rectCount = 0;
+
+    // The tabs: the page's filled slate, its name white; the others white.
+    for (k = 0; k < 3; k++) {
+        int x0 = sOptionsTabs[k][0], x1 = sOptionsTabs[k][1];
+        int shown = panel->page == OP_PAGE_GIVE ? OP_PAGE_CHEATS : panel->page;
+        const char *name = k == OP_PAGE_CHEATS && panel->page == OP_PAGE_GIVE ? sOptionsPages[OP_PAGE_GIVE].tab : sOptionsPages[k].tab;
+
+        OptionsPanel_SetLetters(panel->text, name);
+
+        if (k == shown) {
+            OptionsPanel_CardFill(panel, x0, 2, x1, 21, OPC_SLATE);
+            OptionsPanel_Print(panel, x0, x1, 3, OPC_WHITE, OPC_SLATE_DARK, OPC_SLATE);
+            OptionsPanel_CardEdges(panel, x0, 2, x1, 21, OPC_SLATE_DARK, FALSE);
+        } else {
+            OptionsPanel_CardFill(panel, x0, 2, x1, 21, OPC_WHITE);
+            OptionsPanel_Print(panel, x0, x1, 3, OPC_INK, OPC_INK_SHADOW, OPC_WHITE);
+            OptionsPanel_CardEdges(panel, x0, 2, x1, 21, OPC_SLATE, TRUE);
+        }
+
+        OptionsPanel_AddRect(panel, x0, 2, x1, 21, k, -1, 0);
+    }
+
+    // The cards: the name, under it the value in red between the arrows.
+    for (k = 0; k < def->count; k++) {
+        const OptionsCard *card = &def->cards[k];
+        int x0, y0, x1, y1;
+        BOOL arrows;
+
+        OptionsPanel_CardBox(panel->page, k, &x0, &y0, &x1, &y1);
+        OptionsPanel_CardFill(panel, x0, y0, x1, y1, OPC_WHITE);
+
+        if (card->name != NULL) {
+            OptionsPanel_SetLetters(panel->text, card->name);
+        } else {
+            MessageLoader_GetString(panel->loader, card->entry, panel->text);
+        }
+
+        OptionsPanel_Print(panel, x0, x1, y0 + 1, OPC_INK, OPC_INK_SHADOW, OPC_WHITE);
+
+        arrows = OptionsPanel_CardValue(panel, card);
+        OptionsPanel_Print(panel, x0, x1, y0 + 16, OPC_RED, OPC_RED_SHADOW, OPC_WHITE);
+
+        if (arrows) {
+            OptionsPanel_SetLetters(panel->text, "<");
+            OptionsPanel_Print(panel, x0 + 7, -1, y0 + 16, OPC_INK, OPC_INK_SHADOW, OPC_WHITE);
+            OptionsPanel_SetLetters(panel->text, ">");
+            OptionsPanel_Print(panel, x1 - 6 - OptionsPanel_TextWidth(panel), -1, y0 + 16, OPC_INK, OPC_INK_SHADOW, OPC_WHITE);
+            OptionsPanel_AddRect(panel, x0, y0, (x0 + x1) / 2, y1, -1, k, -1);
+            OptionsPanel_AddRect(panel, (x0 + x1) / 2 + 1, y0, x1, y1, -1, k, 1);
+        } else {
+            OptionsPanel_AddRect(panel, x0, y0, x1, y1, -1, k, 0);
+        }
+
+        OptionsPanel_CardEdges(panel, x0, y0, x1, y1, OPC_SLATE, TRUE);
+    }
+
+    if (def->count > 0) {
+        int x0, y0, x1, y1;
+
+        OptionsPanel_CardBox(panel->page, panel->cursor[panel->page], &x0, &y0, &x1, &y1);
+        OptionsPanel_Cursor(panel, x0, y0, x1, y1);
+    }
+
+    // Cut into tiles: tile 0 the plain background (the rows under the
+    // page), then each tile not seen before.
+    memset(panel->hashHead, 0xFF, sizeof(panel->hashHead));
+    memset(panel->tiles, (OPC_BACK << 4) | OPC_BACK, TILE_SIZE_4BPP);
+    n = 1;
+
+    for (t = 0; t < OP_TILES; t++) {
+        const u8 *tile = pixels + t * TILE_SIZE_4BPP;
+        u32 hash = 0;
+        int i, found = -1;
+
+        for (i = 0; i < TILE_SIZE_4BPP; i++) {
+            hash = hash * 31 + tile[i];
+        }
+
+        hash = (hash ^ (hash >> 8) ^ (hash >> 16) ^ (hash >> 24)) & 0xFF;
+
+        if (memcmp(tile, panel->tiles, TILE_SIZE_4BPP) == 0) {
+            found = 0;
+        }
+
+        for (i = panel->hashHead[hash]; found < 0 && i != 0xFFFF; i = panel->hashNext[i]) {
+            if (memcmp(tile, panel->tiles + i * TILE_SIZE_4BPP, TILE_SIZE_4BPP) == 0) {
+                found = i;
+            }
+        }
+
+        if (found < 0 && n < OP_TILES + 1 && n < OP_TILES_MAX) {
+            found = n++;
+            memcpy(panel->tiles + found * TILE_SIZE_4BPP, tile, TILE_SIZE_4BPP);
+            panel->hashNext[found] = panel->hashHead[hash];
+            panel->hashHead[hash] = found;
+        }
+
+        map[(t / OP_W) * 32 + t % OP_W] = found < 0 ? 0 : found;
+    }
+
+    for (t = OP_TILES; t < 32 * 32; t++) {
+        map[t] = 0;
+    }
+
+    Bg_LoadTiles(panel->bgConfig, OP_LAYER, panel->tiles, n * TILE_SIZE_4BPP, 0);
+    Bg_CopyTilemapBufferToVRAM(panel->bgConfig, OP_LAYER);
+    NitroPort_LowerMenuSetPanelButtons((const short(*)[4])panel->rects, panel->rectCount);
+}
+
+// ----- open, close
+
+void OptionsPanel_Open(FieldSystem *fieldSystem)
+{
+    OptionsPanel *panel;
+    BgTemplate template = {
+        .x = 0,
+        .y = 0,
+        .bufferSize = 0x800,
+        .baseTile = 0,
+        .screenSize = BG_SCREEN_SIZE_256x256,
+        .colorMode = GX_BG_COLORMODE_16,
+        .screenBase = GX_BG_SCRBASE_0xb800,
+        .charBase = GX_BG_CHARBASE_0x00000,
+        .bgExtPltt = GX_BG_EXTPLTT_01,
+        .priority = 0,
+        .areaOver = 0,
+        .mosaic = FALSE,
+    };
+    static u16 colours[16];
+
+    Heap_Create(HEAP_ID_APPLICATION, OP_HEAP, HEAP_SIZE_PRE_POKETCH_SUBSCREEN);
+    panel = Heap_Alloc(OP_HEAP, sizeof(OptionsPanel));
+    memset(panel, 0, sizeof(*panel));
+    panel->fieldSystem = fieldSystem;
+    panel->options = SaveData_GetOptions(fieldSystem->saveData);
+    panel->page = OP_PAGE_SETTINGS;
+    panel->givePocket = 0;
+    panel->giveHowMany = 1;
+
+    // The sub engine: 48 KB of BG VRAM, BG0 alone.
+    GX_SetBankForSubOBJ(GX_VRAM_SUB_OBJ_NONE);
+    GX_SetBankForSubBG(GX_VRAM_SUB_BG_48_HI);
+    GXS_SetGraphicsMode(GX_BGMODE_0);
+    G2S_BlendNone();
+    GXS_SetVisibleWnd(GX_WNDMASK_NONE);
+    G2S_SetBG0Offset(0, 0);
+
+    panel->bgConfig = BgConfig_New(OP_HEAP);
+    Bg_InitFromTemplate(panel->bgConfig, OP_LAYER, &template, BG_TYPE_STATIC);
+    Bg_ClearTilemap(panel->bgConfig, OP_LAYER);
+    memcpy(colours, sOptionsPanelColours, sizeof(colours));
+    DC_FlushRange(colours, sizeof(colours));
+    GXS_LoadBGPltt(colours, 0, sizeof(colours));
+
+    Window_Init(&panel->canvas);
+    Window_AddToTopLeftCorner(panel->bgConfig, &panel->canvas, OP_W, OP_H, 0, OPC_BACK);
+    panel->canvas.bgLayer = OP_LAYER; // (its pixels 4 bits each, as the layer's: the fills and text ask it)
+    panel->tiles = Heap_Alloc(OP_HEAP, (OP_TILES + 1) * TILE_SIZE_4BPP);
+    panel->loader = MessageLoader_Init(MSG_LOADER_PRELOAD_ENTIRE_BANK, NARC_INDEX_MSGDATA__PL_MSG, TEXT_BANK_OPTIONS_MENU, OP_HEAP);
+    panel->text = String_Init(64, OP_HEAP);
+    sOptionsPanel = panel;
+
+    OptionsPanel_Draw(panel);
+    GXS_SetVisiblePlane(GX_PLANEMASK_BG0);
+}
+
+void OptionsPanel_Close(FieldSystem *fieldSystem)
+{
+    OptionsPanel *panel = sOptionsPanel;
+
+    if (panel == NULL) {
+        return;
+    }
+
+    NitroPort_LowerMenuSetPanelButtons(NULL, 0);
+    NitroPort_OptionsSave();
+    GXS_SetVisiblePlane(0);
+
+    if (panel->giveItems != NULL) {
+        Heap_Free(panel->giveItems);
+    }
+
+    String_Free(panel->text);
+    MessageLoader_Free(panel->loader);
+    Heap_Free(panel->tiles);
+    Window_Remove(&panel->canvas);
+    Bg_FreeTilemapBuffer(panel->bgConfig, OP_LAYER);
+    Heap_Free(panel->bgConfig);
+    GX_SetBankForSubBG(GX_VRAM_SUB_BG_32_H);
+    GX_SetBankForSubOBJ(GX_VRAM_SUB_OBJ_16_I);
+
+    sOptionsPanel = NULL;
+    Heap_Free(panel);
+    Heap_Destroy(OP_HEAP);
+}
+
+BOOL OptionsPanel_IsOpen(void)
+{
+    return sOptionsPanel != NULL;
+}
+
+// ----- input
+
+static void OptionsPanel_ShowPage(OptionsPanel *panel, int page)
+{
+    if (page == OP_PAGE_GIVE) {
+        OptionsPanel_ReadGiveItems(panel);
+    }
+
+    panel->page = page;
+    panel->giveDone = 0;
+}
+
+// A card's value stepped (-1 left, 1 right; wrapping round), or its action.
+static void OptionsPanel_Step(OptionsPanel *panel, int k, int step)
+{
+    const OptionsCard *card = &sOptionsPages[panel->page].cards[k];
+    int values, value;
+
+    switch (card->kind) {
+    case OPK_GAME:
+        values = sGameValueCount[card->id];
+        value = (OptionsPanel_GameValue(panel, card->id) + values + step) % values;
+        OptionsPanel_SetGameValue(panel, card->id, value);
+        break;
+    case OPK_PORT:
+        values = NitroPort_OptionValues(card->id);
+        value = (NitroPort_Option(card->id) + values + step) % values;
+        NitroPort_OptionSet(card->id, value);
+        break;
+    case OPK_GIVE:
+        if (card->id == OPG_POCKET) {
+            panel->givePocket = (panel->givePocket + OP_GIVE_POCKETS + step) % OP_GIVE_POCKETS;
+            panel->giveItem = 0;
+        } else if (card->id == OPG_ITEM) {
+            values = panel->giveCount[panel->givePocket];
+
+            if (values > 0) {
+                panel->giveItem = (panel->giveItem + values + step) % values;
+            }
+        } else {
+            panel->giveHowMany = (panel->giveHowMany - 1 + OP_GIVE_MAX + step) % OP_GIVE_MAX + 1;
+        }
+
+        panel->giveDone = 0;
+        break;
+    default:
+        if (card->id == OPA_OPEN_GIVE) {
+            OptionsPanel_ShowPage(panel, OP_PAGE_GIVE);
+        } else if (card->id == OPA_BACK) {
+            OptionsPanel_ShowPage(panel, OP_PAGE_CHEATS);
+        } else {
+            int item = OptionsPanel_GiveItem(panel);
+
+            if (item != ITEM_NONE && Bag_TryAddItem(SaveData_GetBag(panel->fieldSystem->saveData), item, panel->giveHowMany, OP_HEAP)) {
+                panel->giveDone = 1;
+            } else {
+                panel->giveDone = -1;
+                Sound_PlayEffect(SEQ_SE_DP_BEEP_sseq);
+                return;
+            }
+        }
+        break;
+    }
+
+    Sound_PlayEffect(SE_CONFIRM_sseq_3);
+}
+
+int OptionsPanel_Update(void)
+{
+    OptionsPanel *panel = sOptionsPanel;
+    const OptionsPageDef *def;
+    int press = -1, *cursor, redraw = FALSE;
+
+    if (panel == NULL) {
+        return OPTIONS_PANEL_CLOSE;
+    }
+
+    def = &sOptionsPages[panel->page];
+    cursor = &panel->cursor[panel->page];
+
+    if (NitroPort_LowerMenuPressPending() >= 0) {
+        press = NitroPort_LowerMenuTakePress();
+    }
+
+    // The menu's buttons: OPTIONS closes the page; the others close it and
+    // are acted on after.
+    if (press >= 0 && press < PORT_BUTTON_COUNT) {
+        Sound_PlayEffect(SE_CONFIRM_sseq_3);
+        return press == PORT_BUTTON_OPTIONS ? OPTIONS_PANEL_CLOSE : press;
+    }
+
+    if (press >= PORT_BUTTON_PRESS(0) && press < PORT_BUTTON_PRESS(panel->rectCount)) {
+        int k = press - PORT_BUTTON_PRESS(0);
+
+        if (panel->rectTab[k] >= 0) {
+            int page = panel->rectTab[k];
+
+            if (page != (panel->page == OP_PAGE_GIVE ? OP_PAGE_CHEATS : panel->page)) {
+                OptionsPanel_ShowPage(panel, page);
+                Sound_PlayEffect(SE_CONFIRM_sseq_3);
+                redraw = TRUE;
+            }
+        } else {
+            *cursor = panel->rectCard[k];
+            OptionsPanel_Step(panel, panel->rectCard[k], panel->rectStep[k] != 0 ? panel->rectStep[k] : 1);
+            redraw = TRUE;
+        }
+    } else if (JOY_NEW(PAD_BUTTON_X)) {
+        Sound_PlayEffect(SE_CONFIRM_sseq_3);
+        return OPTIONS_PANEL_CLOSE;
+    } else if (JOY_NEW(PAD_BUTTON_B)) {
+        Sound_PlayEffect(SE_CONFIRM_sseq_3);
+
+        if (panel->page != OP_PAGE_GIVE) {
+            return OPTIONS_PANEL_CLOSE;
+        }
+
+        OptionsPanel_ShowPage(panel, OP_PAGE_CHEATS);
+        redraw = TRUE;
+    } else if (JOY_NEW(PAD_BUTTON_L | PAD_BUTTON_R)) {
+        int shown = panel->page == OP_PAGE_GIVE ? OP_PAGE_CHEATS : panel->page;
+        int page = shown + (JOY_NEW(PAD_BUTTON_R) ? 1 : -1);
+
+        if (page >= OP_PAGE_SETTINGS && page <= OP_PAGE_CHEATS) {
+            OptionsPanel_ShowPage(panel, page);
+            Sound_PlayEffect(SE_CONFIRM_sseq_3);
+            redraw = TRUE;
+        }
+    } else if (JOY_NEW(PAD_KEY_UP | PAD_KEY_DOWN) && def->count > 0) {
+        // (down the left column, then the right; round again)
+        *cursor = (*cursor + def->count + (JOY_NEW(PAD_KEY_DOWN) ? 1 : -1)) % def->count;
+        Sound_PlayEffect(SEQ_SE_DP_SELECT78_sseq);
+        redraw = TRUE;
+    } else if (JOY_NEW(PAD_KEY_LEFT | PAD_KEY_RIGHT) && def->count > 0) {
+        const OptionsCard *card = &def->cards[*cursor];
+
+        if (card->kind != OPK_ACTION) {
+            OptionsPanel_Step(panel, *cursor, JOY_NEW(PAD_KEY_RIGHT) ? 1 : -1);
+            redraw = TRUE;
+        }
+    } else if (JOY_NEW(PAD_BUTTON_A) && def->count > 0) {
+        OptionsPanel_Step(panel, *cursor, 1);
+        redraw = TRUE;
+    }
+
+    // (what GIVE did shown a second)
+    if (panel->giveDone != 0 && !redraw) {
+        panel->giveDone += panel->giveDone > 0 ? 1 : -1;
+
+        if (panel->giveDone > 30 || panel->giveDone < -30) {
+            panel->giveDone = 0;
+            redraw = TRUE;
+        }
+    }
+
+    if (redraw) {
+        OptionsPanel_Draw(panel);
+    }
+
+    return OPTIONS_PANEL_STAY;
+}
+#endif
