+// (the 3DS remaster) A weather's sprites on the wider, taller upper screen:
+// the DS's 256 x 192 with ex columns beside it each side and et lines above
+// and below it (NitroPort_EngineABeside; 0 and 0 on the DS's screen, all as
+// before). The drops live on the DS's screen with 64 pixels round it, going
+// off one side and on at the other (ov5_021D630C); round the wider screen
+// instead. Each comes on where the game puts it on the DS's screen
+// stretched onto the wider one, or as far beside the wider one as the game
+// has it beside the DS's (the first place the game gives it, after
+// ov5_021D6F00: ov5_PortPlaceWide), more of them for the wider screen
+// (ov5_PortWeatherCount); and they're taken away as far below or above the
+// wider screen as the game has them below or above the DS's.
+static Sprite *sPortComingOn;
+static u32 sPortCountCarry;
+
+static void ov5_PortBeside(int *ex, int *et)
+{
+    NitroPort_EngineABeside(ex, et);
+
+    if (*ex < 0 || *ex > 128) {
+        *ex = 0;
+    }
+
+    if (*et < 0 || *et > 64) {
+        *et = 0;
+    }
+}
+
+// (the lines above and below the DS's screen: ov5_PortBeside's et)
+static int ov5_PortTop(void)
+{
+    int ex, et;
+
+    ov5_PortBeside(&ex, &et);
+    return et;
+}
+
+enum {
+    PORT_WEATHER_SPREAD_AREA, // (they come on all over the screen)
+    PORT_WEATHER_SPREAD_WIDTH, // (along its top)
+    PORT_WEATHER_SPREAD_HEIGHT, // (down its side)
+};
+
+// How many to bring on for count on the DS's screen: as many again for each
+// part of the wider screen as the DS's has (its area, width or height, as
+// they come on), the parts of one left over kept for the next time.
+static int ov5_PortWeatherCount(int count, int spread)
+{
+    int ex, et;
+    u32 w, h, ratio, n;
+
+    ov5_PortBeside(&ex, &et);
+
+    if (count <= 0 || (ex == 0 && et == 0)) {
+        return count;
+    }
+
+    w = ((u32)(256 + 2 * ex) << 12) / 256;
+    h = ((u32)(192 + 2 * et) << 12) / 192;
+    ratio = spread == PORT_WEATHER_SPREAD_AREA ? (w * h) >> 12 : spread == PORT_WEATHER_SPREAD_WIDTH ? w : h;
+    n = (u32)count * ratio + sPortCountCarry;
+    sPortCountCarry = n & 0xfff;
+
+    return (int)(n >> 12);
+}
+
+// (ov5_PortPlaceWide) A place on the DS's screen stretched onto the wider
+// one (span: the DS's last pixel, 255 or 191); beside it, as far beside the
+// wider one.
+static fx32 ov5_PortStretch(fx32 v, int span, int extra)
+{
+    if (v < 0) {
+        return v - extra * FX32_ONE;
+    }
+
+    if (v > span * FX32_ONE) {
+        return v + extra * FX32_ONE;
+    }
+
+    return (fx32)(((s64)v * (span + 2 * extra)) / span) - extra * FX32_ONE;
+}
+
+// (ov5_021D630C on the wider screen) Where a drop goes now: one just come on
+// where the game put it on the DS's (round it as the DS has it), stretched;
+// round the wider screen with 64 pixels round it as the DS's is.
+static void ov5_PortPlaceWide(Sprite *sprite, VecFx32 *pos, int ex, int et)
+{
+    fx32 w = (255 + 64 + 2 * ex) * FX32_ONE, h = (192 + 64 + 2 * et) * FX32_ONE;
+
+    if (sprite == sPortComingOn) {
+        sPortComingOn = NULL;
+
+        if (pos->x > ((255 << FX32_SHIFT) + 64 * FX32_ONE)) {
+            pos->x %= ((255 << FX32_SHIFT) + 64 * FX32_ONE);
+        } else if (pos->x < (-64 * FX32_ONE)) {
+            pos->x += ((255 << FX32_SHIFT) + 64 * FX32_ONE);
+        }
+
+        if (pos->y > ((192 << FX32_SHIFT) + 64 * FX32_ONE)) {
+            pos->y %= ((192 << FX32_SHIFT) + 64 * FX32_ONE);
+        } else if (pos->y < (-64 * FX32_ONE)) {
+            pos->y += ((192 << FX32_SHIFT) + 64 * FX32_ONE);
+        }
+
+        pos->x = ov5_PortStretch(pos->x, 255, ex);
+        pos->y = ov5_PortStretch(pos->y, 191, et);
+    }
+
+    if (pos->x > (255 + 64 + ex) * FX32_ONE) {
+        pos->x = (pos->x + ex * FX32_ONE) % w - ex * FX32_ONE;
+    } else if (pos->x < (-64 - ex) * FX32_ONE) {
+        pos->x += w;
+    }
+
+    if (pos->y > (192 + 64 + et) * FX32_ONE) {
+        pos->y = (pos->y + et * FX32_ONE) % h - et * FX32_ONE;
+    } else if (pos->y < (-64 - et) * FX32_ONE) {
+        pos->y += h;
+    }
+}
 #endif
 
