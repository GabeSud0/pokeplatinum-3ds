+// (NitroPort_EngineABeside: the wider screen, the field at the DS's pixel
+// size), whatever's shown there.
+static BOOL IsObjectInViewBeside(const NNSG2dCellData *cellData, const MtxFx32 *objectCoords, const NNSG2dViewRect *viewRect)
+{
+    NNSG2dViewRect view = *viewRect;
+    int x, top;
+
+    NitroPort_EngineABeside(&x, &top);
+    view.posTopLeft.x -= x << FX32_SHIFT;
+    view.sizeView.x += (2 * x) << FX32_SHIFT;
+    view.posTopLeft.y -= top << FX32_SHIFT;
+    view.sizeView.y += (2 * top) << FX32_SHIFT;
+    return IsObjectInView(cellData, objectCoords, &view);
+}
