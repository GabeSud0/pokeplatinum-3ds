+// The loaded map drawn mirrored past the scenery whole, as its copy is
+// (Port_MirroredWaterShape too), while that copy's being made: the
+// polygons the copy leaves out are past what's seen, thrown away by the 3D.
+static void Port_RenderMirroredWhole(const u8 index, const int dir, const VecFx32 *position, const LandDataManager *landDataMan, ModelAttributes *const modelAttrs)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+    VecFx32 mirrored = *position;
+    VecFx32 scale = { -FX32_ONE, FX32_ONE, FX32_ONE };
+    MtxFx33 rotationMatrix = { FX32_ONE, 0, 0, 0, FX32_ONE, 0, 0, 0, FX32_ONE };
+    NNSG3dResMdl *model = loadedMap->mapRenderObj.resMdl;
+
+    mirrored.x += dir * MAP_TILES_COUNT_X * MAP_OBJECT_TILE_SIZE;
+    Port_SwapModelCulling(model);
+    NNS_G3dRenderObjSetCallBack(&loadedMap->mapRenderObj, Port_MirroredWaterShape, NULL, NNS_G3D_SBC_SHP, NNS_G3D_SBC_CALLBACK_TIMING_A);
+    Easy3D_DrawRenderObj(&loadedMap->mapRenderObj, &mirrored, &rotationMatrix, &scale);
+    NNS_G3dGeFlushBuffer();
+    NNS_G3dRenderObjResetCallBack(&loadedMap->mapRenderObj);
+    Port_SwapModelCulling(model);
+
+    if (loadedMap->mapPropManager != NULL && Port_MirrorsPropsToo(landDataMan, index)) {
+        MapPropManager_RenderMirrored(&mirrored, landDataMan->areaDataMan, AreaDataManager_IsOutdoorsLighting(landDataMan->areaDataMan), modelAttrs, loadedMap->mapPropManager);
+    }
+}
