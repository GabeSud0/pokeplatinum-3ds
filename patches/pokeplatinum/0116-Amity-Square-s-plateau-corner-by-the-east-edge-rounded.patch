+            box[3 + a] = pieces[k].box[3 + a] > box[3 + a] ? pieces[k].box[3 + a] : box[3 + a];
+        }
+    }
+
+    made += numPieces;
+
     for (u32 g = 0; g < count; g++) {
+        if (sPortExtrudeMark[g] == PORT_CELL_NEVER) {
+            continue;
+        }
+
         s32 *box = copy->box[sPortExtrudeMark[g]];
 
         for (int k = 0; k < 3; k++) {
@@ -4756,7 +4921,7 @@ static BOOL Port_RenderMapCells(const LandDataManager *landDataMan, u8 index, co
             u32 size = 0;
 
             for (u32 r = copy->firstRun[i]; r < copy->firstRun[i + 1]; r++) {
