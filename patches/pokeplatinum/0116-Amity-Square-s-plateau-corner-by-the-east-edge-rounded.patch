+
+    for (u32 g = 0; g < count; g++) {
         runs += g == 0 || sPortExtrudeMark[g] != sPortExtrudeMark[g - 1];
     }
 
-    runs++; // (what the list leaves set, sent after the rest: PORT_CELL_ALWAYS)
+    for (int k = 0; k < numPieces; k++) {
+        piecesSize += pieces[k].size;
+    }
+
+    runs += 1 + numPieces; // (what the list leaves set, sent after the rest: PORT_CELL_ALWAYS; the pieces)
+
+    BOOL ok = TRUE;
 
     if (copy->runs + runs > copy->runRoom) {
         u32 room = copy->runRoom * 2 > copy->runs + runs ? copy->runRoom * 2 : copy->runs + runs + 256;
@@ -4460,33 +4589,69 @@ static BOOL Port_CellShape(PortCellCopy *copy, NNSG3dResMdl *model, int i)
         }
 
         cells = bytes != NULL ? realloc(copy->runCell, room) : NULL;
+        ok = cells != NULL;
 
-        if (cells == NULL) {
-            NitroPort_Gx3dFreeSurvey(survey);
-            return FALSE;
+        if (ok) {
+            copy->runCell = cells;
+            copy->runRoom = room;
         }
-
-        copy->runCell = cells;
-        copy->runRoom = room;
     }
 
     // (each run's list: its polygons, a few commands more)
-    u32 room = NNS_G3dGetShpDLSize(shp) + runs * 64 + 64;
-    u8 *bytes = malloc(room);
-    u32 made = bytes != NULL ? NitroPort_Gx3dSurveyRuns(survey, sPortExtrudeMark, count, bytes, room, copy->runBytes + copy->runs, copy->runCell + copy->runs, runs) : 0;
+    u32 room = NNS_G3dGetShpDLSize(shp) + runs * 64 + 64 + piecesSize;
+    u8 *bytes = ok ? malloc(room) : NULL;
+    u32 made = bytes != NULL ? NitroPort_Gx3dSurveyRuns(survey, sPortExtrudeMark, count, bytes, room, copy->runBytes + copy->runs, copy->runCell + copy->runs, runs - numPieces) : 0;
 
     NitroPort_Gx3dFreeSurvey(survey);
 
-    if (bytes == NULL) {
-        return FALSE;
-    }
+    if (bytes == NULL || made == 0) {
+        BOOL whole = bytes != NULL; // (not cut into runs: sent whole; else no room)
+
+        for (int k = 0; k < numPieces; k++) {
+            free(pieces[k].bytes);
+        }
 
-    if (made == 0) {
         free(bytes);
-        return TRUE;
+        return whole;
     }
 
+    // (the pieces before what the list leaves set, if it's there)
+    u32 *runBytes = copy->runBytes + copy->runs;
+    u8 *runCell = copy->runCell + copy->runs;
+    u32 tail = runCell[made - 1] == PORT_CELL_ALWAYS ? 1 : 0, at = 0;
+
+    for (u32 r = 0; r < made - tail; r++) {
