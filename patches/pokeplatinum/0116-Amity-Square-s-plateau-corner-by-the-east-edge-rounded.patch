     NitroGx3dListSurvey *survey = NitroPort_Gx3dSurveyList(NNS_G3dGetShpDLPtr(shp), NNS_G3dGetShpDLSize(shp));
-    u32 count = survey != NULL ? NitroPort_Gx3dSurveyGroups(survey, sPortExtrudeBox, NULL, PORT_EXTRUDE_GROUPS) : 0, runs = 0;
+    u32 count = survey != NULL ? NitroPort_Gx3dSurveyGroups(survey, sPortExtrudeBox, NULL, PORT_EXTRUDE_GROUPS) : 0, runs = 0, piecesSize = 0;
+    PortPieceList pieces[PORT_CELL_PIECES];
+    int numPieces;
 
     copy->firstRun[i] = copy->firstRun[i + 1] = copy->runs;
 
@@ -4439,16 +4557,27 @@ static BOOL Port_CellShape(PortCellCopy *copy, NNSG3dResMdl *model, int i)
         return TRUE;
     }
 
-    // (each polygon's cell; the runs of them)
+    // (each polygon's cell; its pieces; the runs of them)
     for (u32 g = 0; g < count; g++) {
         int cx = Port_CellOf(copy, sPortExtrudeBox[g][0] + sPortExtrudeBox[g][3]);
         int cz = Port_CellOf(copy, sPortExtrudeBox[g][2] + sPortExtrudeBox[g][5]);
 
         sPortExtrudeMark[g] = (u8)(cz * PORT_CELLS + cx);
+    }
+
