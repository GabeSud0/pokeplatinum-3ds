+        runBytes[made - 1 + numPieces] = runBytes[made - 1];
+        runCell[made - 1 + numPieces] = PORT_CELL_ALWAYS;
+    }
+
+    for (int k = 0; k < numPieces; k++) {
+        memcpy(bytes + at, pieces[k].bytes, pieces[k].size);
+        at += pieces[k].size;
+        runBytes[made - tail + k] = pieces[k].size;
+        runCell[made - tail + k] = pieces[k].cell;
+        free(pieces[k].bytes);
+
+        s32 *box = copy->box[pieces[k].cell];
+
+        for (int a = 0; a < 3; a++) {
