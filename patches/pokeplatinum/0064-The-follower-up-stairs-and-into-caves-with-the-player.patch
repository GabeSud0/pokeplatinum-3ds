+#ifdef SDK_PORT_3DS
+// (the port's follower, port_follower.c) Whether the field is in a warp's
+// way in or out (the task sub_02056BDC and sub_02056C18 start), before or
+// after the map changes: PORT_WARP_DOOR through a building's door (in by
+// it: transition 1; out onto it: the player's on a door when they're
+// there), else PORT_WARP_OTHER (stairs, an escalator, a cave's or a
+// forest's way in or out); PORT_WARP_NONE when not in one.
+int FieldSystem_PortWarpKind(FieldSystem *fieldSystem)
+{
+    FieldTask *task;
+
+    for (task = fieldSystem->task; task != NULL; task = task->prev) {
+        if (task->func == sub_02056CFC) {
+            UnkStruct_02056BDC *v1 = task->env;
+
+            if (v1->unk_20 == 1) {
+                return PORT_WARP_DOOR;
+            }
+
+            if (v1->unk_00 >= 3 && fieldSystem->playerAvatar != NULL
+                && TileBehavior_IsDoor(TerrainCollisionManager_GetTileBehavior(fieldSystem,
+                    PlayerAvatar_GetXPos(fieldSystem->playerAvatar), PlayerAvatar_GetZPos(fieldSystem->playerAvatar)))) {
+                return PORT_WARP_DOOR;
+            }
+
+            return PORT_WARP_OTHER;
+        }
+    }
+
+    return PORT_WARP_NONE;
+}
+#endif
