From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Sun, 8 Nov 2026 19:20:00 -0700
Subject: [PATCH] Route 216's terraces go on south (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Route 216's snowy terraces step down to its south edge, above the snowy
forest's filler, and the faces the DS never showed were black under
them; past its middle map the high snow's filler (altitude 22) floated
over them. The west map's terraces and the middle map's are drawn on
south (sPortExtrudeColumns), the forest's trees under them left out with
its ground kept (sPortMapCuts' keepShapes), and the high snow's first
rows left out. A cut's rows can start a tile north of its edge (zFrom -1,
now signed): the tops of its first trees lean past it.
---
diff --git a/src/overlay005/land_data.c b/src/overlay005/land_data.c
index 1cb98961..e50ddf11 100644
--- a/src/overlay005/land_data.c
+++ b/src/overlay005/land_data.c
@@ -4182,6 +4182,8 @@ static const PortExtrudeColumns sPortExtrudeColumns[] = {
     { 0, 672, 1, -16, -6 }, // (Route 208's west map: its mountain's slopes by the west edge)
     { 0, 670, -1, 10, 16 }, // (Route 207's east map: its east cliffs, north over the mountain's filler)
     { 0, 670, 1, -3, 16 },  // (and its cliffs and plateau, south over the mountain's filler)
+    { 0, 369, 1, 4, 16 },   // (Route 216's west map: its terraces by the south edge, south over the snowy forest's filler (its trees there left out: sPortMapCuts))
+    { 0, 370, 1, -16, 16 }, // (and its middle map's, south over the high snow's filler (left out there: sPortMapCuts))
 };
 
 static const PortExtrudeColumns *Port_ExtrudeColumnsOf(const LandDataManager *landDataMan, int mapMatrixIndex, int dirZ)
@@ -7038,16 +7040,19 @@ static void Port_RenderMapPieces(const LandDataManager *landDataMan)
 typedef struct PortMapCut {
     u8 matrixID;
     u16 mapMatrixIndex;
-    u8 zFrom, zTo; // (zFrom <= z < zTo)
+    s8 zFrom, zTo; // (polygons starting in zFrom <= z < zTo; -1: from its edge's tile north, for the tops of its first trees leaning past it)
     u16 piecesBy;
     u8 noLowered;  // (its copies under itself not drawn while it's cut: Port_RenderSceneryMapLowered)
     u8 xFrom, xTo; // (only these columns' polygons left out, tiles from its west edge; 0, 0 all)
+    u8 keepShapes; // (shapes left whole, a bit each: its ground under trees left out)
 } PortMapCut;
 
 static const PortMapCut sPortMapCuts[] = {
     { 0, 668, 24, 32, 669 }, // (Route 207's west filler: its last row of ground, z 728-735)
     { 0, 521, 0, 16, 491, TRUE }, // (Route 211's south filler: its first two rows, z 544-559; its copies under it over the canyon)
     { 0, 461, 16, 32, 491, TRUE, 8, 32 }, // (and its north filler's last two, z 496-511, over the canyon: x 360-383)
+    { 0, 399, -1, 12, 369, TRUE, 20, 32, 1 },
+    { 0, 400, -1, 12, 370, TRUE }, // (and the high snow's filler beside it, by Route 216's middle map: its first rows, a plain floating over the terraces drawn on south) // (Route 216's south filler: its trees under the west map's terraces drawn on south, x 308-319, z 416-427; its ground kept)
 };
 
 #define PORT_CUT_COPIES 2
@@ -7148,6 +7153,13 @@ static PortPieceCopy *Port_CutCopyOf(const LandDataManager *landDataMan, u8 inde
         u32 bytes = NNS_G3dGetShpDLSize(shp), room = 3 * (bytes + 64);
 
         cuts[i] = malloc(room);
+
+        if (cuts[i] != NULL && (cut->keepShapes & (1u << i))) {
+            memcpy(cuts[i], list, bytes);
+            sizes[i] = bytes;
+            continue;
+        }
+
         sizes[i] = cuts[i] != NULL ? NitroPort_Gx3dTrimListRows(list, bytes, cuts[i], room, INT32_MIN, INT32_MAX, north + cut->zFrom * tile, north + cut->zTo * tile, FALSE) : 0;
         ok = sizes[i] > 0;
 
