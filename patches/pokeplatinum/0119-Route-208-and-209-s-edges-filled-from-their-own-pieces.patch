+// Maps drawn on past their south (or north) border in some of their
+// columns only, over the scenery map there, which is still drawn: the
+// polygons centred in those columns (tiles from the map's middle) only.
+// The camera is south of the player: on a map's south edge it sees the
+// faces that look south, which the DS's 192 lines never reached and so
+// were never made. Route 208's west map: its mountain's slopes by the west
+// edge, up to 13 tiles high, stopped there, the 3D's white behind them, a
+// triangle in the screen's bottom corner (a screenshot of 2026-11-07, by
+// the route's sign); drawn on south they go on past the screen's bottom.
+// (The slope by them, 1 tile lower, is drawn on south as a piece of the
+// map, sPortMapPieces: drawn on with these, its corner pieces repeated
+// left gaps the water showed through.)
+typedef struct PortExtrudeColumns {
+    u8 matrixID;
+    u16 mapMatrixIndex;
+    s8 dirZ;
+    s8 colLo, colHi;
+} PortExtrudeColumns;
+
+static const PortExtrudeColumns sPortExtrudeColumns[] = {
+    { 0, 672, 1, -16, -6 }, // (Route 208's west map: its mountain's slopes by the west edge)
+};
+
+static const PortExtrudeColumns *Port_ExtrudeColumnsOf(const LandDataManager *landDataMan, int mapMatrixIndex, int dirZ)
+{
+    int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
+
+    for (int k = 0; k < (int)NELEMS(sPortExtrudeColumns); k++) {
+        const PortExtrudeColumns *c = &sPortExtrudeColumns[k];
+
+        if (c->matrixID == matrixID && c->mapMatrixIndex == mapMatrixIndex && (dirZ == 0 || c->dirZ == dirZ)) {
+            return c;
+        }
+    }
+
+    return NULL;
+}
+
 static const PortExtrudeForest *Port_ExtrudeForestOf(const LandDataManager *landDataMan, int mapMatrixIndex, int dirX)
 {
     int matrixID = MapMatrix_GetMatrixID(landDataMan->mapMatrix);
@@ -4199,6 +4276,10 @@ static PortExtrudeCopy *Port_ExtrudeCopyFor(const LandDataManager *landDataMan,
     copy->outdoors = AreaDataManager_IsOutdoorsLighting(landDataMan->areaDataMan) == TRUE;
 
     const PortExtrudeForest *forest = band != 0 ? Port_ExtrudeForestOf(landDataMan, from, dirX) : NULL;
+    const PortExtrudeColumns *columns = dirX == 0 && dirZ != 0 ? Port_ExtrudeColumnsOf(landDataMan, from, dirZ) : NULL;
+
+    copy->colLo = columns != NULL ? columns->colLo : -MAP_TILES_COUNT_X / 2;
+    copy->colHi = columns != NULL ? columns->colHi : MAP_TILES_COUNT_X / 2;
 
     if (forest != NULL) {
         copy->bandLo = forest->bandLo;
@@ -4298,6 +4379,13 @@ static void Port_ExtrudeAhead(const LandDataManager *landDataMan)
                 dirsZ[numZ++] = -1;
             }
 
+            // (in some columns, over the scenery past it)
