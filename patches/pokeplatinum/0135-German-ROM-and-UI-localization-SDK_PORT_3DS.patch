From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sheldor <sh3ld0r@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:00:00 +0100
Subject: [PATCH] German (CPUD) ROM support and 3DS UI localization under SDK_PORT_3DS

- Add dynamic German (CPUD) UI string selection via NitroPort_IsGerman() and UTF-8 umlaut/Eszett decoding in trainer_case/main.c, overlay005/options_panel.c, battle/battle_script.c, and port_follower.c.
- Skip loading US-only op_demo.narc members 113..115 in ov77_021D25B0.c when running with German op_demo.narc (113 members).
- Return message ID 223 ("Ende") in EndCreditsStrings_GetLastMessageID() when running with German credits bank (224 entries).
---
diff --git a/src/applications/trainer_case/main.c b/src/applications/trainer_case/main.c
index 16187df..ced4ec4 100644
--- a/src/applications/trainer_case/main.c
+++ b/src/applications/trainer_case/main.c
@@ -176,10 +176,13 @@ static const TrainerCasePortRun sTrainerCasePortBadgesOpen[] = {
     { 231, 16, PORT_FROM_LOWER, 176, 1, 0, 0 },
 };
 
+extern BOOL NitroPort_IsGerman(void);
+
 // The panel as the tab shown has it.
 static void TrainerCasePort_Show(void)
 {
     static const char *const labels[2] = { "TRAINER CARD", "BADGES" };
+    static const char *const labelsDe[2] = { "TRAINERPASS", "ORDEN" };
     static const TrainerCasePortTabStyle style = {
         .back = 0x737373,
         .fill = 0xEFE79C,
@@ -198,7 +201,7 @@ static void TrainerCasePort_Show(void)
         NitroPort_LowerMenuSetPanelRuns(sTrainerCasePortBadgesOpen, NELEMS(sTrainerCasePortBadgesOpen));
     }
 
-    NitroPort_LowerMenuSetTabs(2, labels, sTrainerCasePortTab, &style);
+    NitroPort_LowerMenuSetTabs(2, NitroPort_IsGerman() ? labelsDe : labels, sTrainerCasePortTab, &style);
 }
 
 static void TrainerCasePort_ChooseTab(int tab, BOOL sound)
