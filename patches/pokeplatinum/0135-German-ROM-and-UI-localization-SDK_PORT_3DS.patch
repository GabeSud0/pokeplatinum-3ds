+extern BOOL NitroPort_IsGerman(void);
+
 static void BattleScript_PortAppendLetters(String *string, const char *letters)
 {
     for (; *letters; letters++) {
         int c = (unsigned char)*letters;
 
-        if (c >= 'A' && c <= 'Z') {
+        if (c == 0xC3 && letters[1]) {
+            int n = (unsigned char)*++letters;
+
+            switch (n) {
+            case 0x84: String_AppendChar(string, 0x0163); break; // Ä
+            case 0x96: String_AppendChar(string, 0x0175); break; // Ö
+            case 0x9C: String_AppendChar(string, 0x017B); break; // Ü
+            case 0x9F: String_AppendChar(string, 0x017E); break; // ß
+            case 0xA4: String_AppendChar(string, 0x0183); break; // ä
+            case 0xA9: String_AppendChar(string, 0x0188); break; // é
+            case 0xB6: String_AppendChar(string, 0x0195); break; // ö
+            case 0xBC: String_AppendChar(string, 0x019B); break; // ü
+            }
+        } else if (c >= 'A' && c <= 'Z') {
             String_AppendChar(string, 0x12B + (c - 'A'));
         } else if (c >= 'a' && c <= 'z') {
             String_AppendChar(string, 0x145 + (c - 'a'));
@@ -9794,6 +9809,10 @@ static void BattleScript_PortAppendLetters(String *string, const char *letters)
             String_AppendChar(string, 0x1DE);
         } else if (c == '.') {
             String_AppendChar(string, 0x1AE);
+        } else if (c == ',') {
+            String_AppendChar(string, 0x1AD);
+        } else if (c == '-') {
+            String_AppendChar(string, 0x1BE);
         } else if (c == '!') {
             String_AppendChar(string, 0x1AB);
         } else if (c == '?') {
@@ -9812,12 +9831,13 @@ static u8 BattleScript_PortPartyExpMessage(BattleSystem *battleSys, u32 exp)
 {
     String *string = String_Init(64, HEAP_ID_BATTLE);
     String *number = String_Init(16, HEAP_ID_BATTLE);
+    BOOL de = NitroPort_IsGerman();
     u8 printerID;
 
-    BattleScript_PortAppendLetters(string, "Your party gained\n");
+    BattleScript_PortAppendLetters(string, de ? "Dein Team erhält\n" : "Your party gained\n");
     String_FormatInt(number, exp, 10, PADDING_MODE_NONE, CHARSET_MODE_EN);
     String_Concat(string, number);
-    BattleScript_PortAppendLetters(string, " Exp. Points!");
+    BattleScript_PortAppendLetters(string, de ? " EP!" : " Exp. Points!");
     String_AppendChar(string, 0x25BC); // (the end of a page, as the game's: \r)
 
     printerID = BattleMessage_PrintString(battleSys, string, BattleSystem_GetTextSpeed(battleSys));
@@ -10550,31 +10570,32 @@ static u8 BattleScript_PortPrintTake(BattleSystem *battleSys, Pokemon *caught, P
 {
     String *string = String_Init(160, HEAP_ID_BATTLE);
     String *name = String_Init(32, HEAP_ID_BATTLE);
+    BOOL de = NitroPort_IsGerman();
     u8 printerID;
 
     switch (what) {
     case 0: // the question
-        BattleScript_PortAppendLetters(string, "Your party is full.\nAdd ");
+        BattleScript_PortAppendLetters(string, de ? "Dein Team ist voll.\n" : "Your party is full.\nAdd ");
         Pokemon_GetValue(caught, MON_DATA_NICKNAME_STRING, name);
         String_Concat(string, name);
-        BattleScript_PortAppendLetters(string, " to your party?");
+        BattleScript_PortAppendLetters(string, de ? " ins Team aufnehmen?" : " to your party?");
         break;
     case 1: // the one picked can't go to the PC
         Pokemon_GetValue(picked, MON_DATA_NICKNAME_STRING, name);
         String_Concat(string, name);
         if (Item_IsMail(Pokemon_GetValue(picked, MON_DATA_HELD_ITEM, NULL))) {
-            BattleScript_PortAppendLetters(string, " is holding Mail.\nIt can't be sent to the PC.");
+            BattleScript_PortAppendLetters(string, de ? " trägt einen Brief.\nPC-Transfer nicht möglich." : " is holding Mail.\nIt can't be sent to the PC.");
         } else {
-            BattleScript_PortAppendLetters(string, " has a Ball Capsule.\nIt can't be sent to the PC.");
+            BattleScript_PortAppendLetters(string, de ? " hat eine Ballkapsel.\nPC-Transfer nicht möglich." : " has a Ball Capsule.\nIt can't be sent to the PC.");
         }
         break;
     default: // done
         Pokemon_GetValue(caught, MON_DATA_NICKNAME_STRING, name);
         String_Concat(string, name);
-        BattleScript_PortAppendLetters(string, " was added to the party\nand ");
+        BattleScript_PortAppendLetters(string, de ? " wurde ins Team aufgenommen\nund " : " was added to the party\nand ");
         Pokemon_GetValue(picked, MON_DATA_NICKNAME_STRING, name);
         String_Concat(string, name);
-        BattleScript_PortAppendLetters(string, " was sent to the PC.");
+        BattleScript_PortAppendLetters(string, de ? " auf den PC übertragen." : " was sent to the PC.");
         break;
     }
 
