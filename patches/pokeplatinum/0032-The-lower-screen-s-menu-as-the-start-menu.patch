+// The 3DS remaster's lower screen as the start menu (start_menu.c): the
+// field, while the player could open the menu, says which of its buttons
+// can be used, and opens the menu when one's tapped.
+void StartMenu_PortUpdateButtons(FieldSystem *fieldSystem);
+BOOL StartMenu_PortTapOpens(void);
+#endif
 
 #endif // POKEPLATINUM_START_MENU_H
