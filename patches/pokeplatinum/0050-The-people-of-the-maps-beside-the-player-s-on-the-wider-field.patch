+
+// The people of a map beside the player's, for the 3DS's wider field
+// (map_object.h, MAP_OBJ_STATUS_PORT_NEIGHBOUR): its object events, as
+// MapHeaderData_Load reads them. How many, at most max.
+int MapHeaderData_PortObjectEvents(enum MapHeaderID mapHeaderID, ObjectEvent *objectEvents, int max)
+{
+    static u32 buf[512]; // (as tmpEventsBuf)
+    const u8 *events = (const u8 *)buf;
+    int eventsID = MapHeader_GetEventsArchiveID(mapHeaderID);
+    u32 n;
+
+    if (NARC_GetMemberSizeByIndexPair(NARC_INDEX_FIELDDATA__EVENTDATA__ZONE_EVENT, eventsID) >= sizeof(buf)) {
+        return 0;
+    }
+
+    NARC_ReadWholeMemberByIndexPair(buf, NARC_INDEX_FIELDDATA__EVENTDATA__ZONE_EVENT, eventsID);
+
+    n = *(const u32 *)events; // (the bg events first)
+    events += sizeof(u32) + n * sizeof(BgEvent);
+    n = *(const u32 *)events;
+    events += sizeof(u32);
+
+    if (n > (u32)max) {
+        n = (u32)max;
+    }
+
+    memcpy(objectEvents, events, n * sizeof(ObjectEvent));
+    MapHeaderData_PortWideMovesOf(objectEvents, (int)n, mapHeaderID);
+
+    return (int)n;
+}
 #endif
 
