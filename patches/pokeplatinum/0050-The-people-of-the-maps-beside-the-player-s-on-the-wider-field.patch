+
+#ifdef SDK_PORT_3DS
+// The people of the maps beside the player's, on the 3DS's wider field
+// (map_object.h). On while the field is wider than the DS's, outside the
+// Distortion World (fieldmap.c, FieldMap_PortNeighbours).
+static BOOL sPortNeighboursOn;
+
+void MapObjectMan_PortSetNeighboursOn(BOOL on)
+{
+    sPortNeighboursOn = on;
+}
+
+BOOL MapObject_PortIsNeighbour(const MapObject *mapObj)
+{
+    return MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_PORT_NEIGHBOUR) != 0;
+}
+
+void MapObject_PortSetNeighbour(MapObject *mapObj)
+{
+    MapObject_SetStatusFlagOn(mapObj, MAP_OBJ_STATUS_PORT_NEIGHBOUR);
+}
+
+BOOL MapObject_PortInReach(int x, int z, int playerX, int playerZ, int further)
+{
+    return x >= playerX - MAP_OBJ_PORT_NEAR_X - further && x <= playerX + MAP_OBJ_PORT_NEAR_X + further
+        && z >= playerZ - MAP_OBJ_PORT_NEAR_N - further && z <= playerZ + MAP_OBJ_PORT_NEAR_S + further;
+}
+
+int MapObjectMan_PortFreeSlots(const MapObjectManager *mapObjMan)
+{
+    int i, n = 0;
+    int maxObjects = MapObjectMan_GetMaxObjects(mapObjMan);
+    const MapObject *mapObj = MapObjectMan_GetMapObjectStatic(mapObjMan);
+
+    for (i = 0; i < maxObjects; i++, mapObj++) {
+        if (!MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_0)) {
+            n++;
+        }
+    }
+
+    return n;
+}
+
+// The map left's people, at the zone change: kept beside while the 3DS's
+// screen may show them (the game's own handed on ones, MAP_OBJ_STATUS_25,
+// and the link's players aside: as the DS does them).
+static BOOL MapObjectMan_PortKeepBeside(const MapObjectManager *mapObjMan, const MapObject *mapObj)
+{
+    FieldSystem *fieldSystem = MapObjectMan_FieldSystem(mapObjMan);
+
+    if (!sPortNeighboursOn || fieldSystem == NULL || fieldSystem->playerAvatar == NULL
+        || sub_02062E94(mapObj) == TRUE || MapObject_GetLocalID(mapObj) >= 0xff
+        || MapObject_GetGraphicsID(mapObj) == OBJ_EVENT_GFX_INVISIBLE // (nothing to see: a script's camera, a trigger)
+        || MapObject_GetMovementType(mapObj) == MOVEMENT_TYPE_VS_SEEKER_SPIN) { // (the DS stops it walking away)
+        return FALSE;
+    }
+
+    return MapObject_PortInReach(MapObject_GetX(mapObj), MapObject_GetZ(mapObj),
+        PlayerAvatar_GetXPos(fieldSystem->playerAvatar), PlayerAvatar_GetZPos(fieldSystem->playerAvatar), MAP_OBJ_PORT_FAR);
+}
+
+static MapObject *MapObjectMan_PortNeighbourOf(const MapObjectManager *mapObjMan, int localID, enum MapHeaderID mapHeaderID)
+{
+    int i = 0;
+    MapObject *mapObj;
+
+    while (MapObjectMan_FindObjectWithStatus(mapObjMan, &mapObj, &i, MAP_OBJ_STATUS_0) == TRUE) {
+        if (MapObject_PortIsNeighbour(mapObj) && MapObject_GetLocalID(mapObj) == localID
+            && MapObject_GetMapHeaderID(mapObj) == mapHeaderID) {
+            return mapObj;
+        }
+    }
+
+    return NULL;
+}
+
+static MapObject *MapObjectMan_PortFurthestNeighbour(const MapObjectManager *mapObjMan)
+{
+    FieldSystem *fieldSystem = MapObjectMan_FieldSystem(mapObjMan);
+    int i = 0, d, best = -1, x = 0, z = 0;
+    MapObject *mapObj, *furthest = NULL;
+
+    if (fieldSystem != NULL && fieldSystem->playerAvatar != NULL) {
+        x = PlayerAvatar_GetXPos(fieldSystem->playerAvatar);
+        z = PlayerAvatar_GetZPos(fieldSystem->playerAvatar);
+    }
+
+    while (MapObjectMan_FindObjectWithStatus(mapObjMan, &mapObj, &i, MAP_OBJ_STATUS_0) == TRUE) {
+        if (MapObject_PortIsNeighbour(mapObj)) {
+            d = MATH_IAbs(MapObject_GetX(mapObj) - x) + MATH_IAbs(MapObject_GetZ(mapObj) - z);
+
+            // (the player's map's last: about to be taken as the game's own)
+            if (fieldSystem != NULL && MapObject_GetMapHeaderID(mapObj) != fieldSystem->location->mapHeaderID) {
+                d += 0x10000;
+            }
+
+            if (d > best) {
+                best = d;
+                furthest = mapObj;
+            }
+        }
+    }
+
+    return furthest;
+}
+
+// The object at (x, z), not one of the people beside (sub_0206326C).
+MapObject *MapObjectMan_PortObjectAt(const MapObjectManager *mapObjMan, int x, int z)
+{
+    int i = 0;
+    MapObject *mapObj;
+
+    while (MapObjectMan_FindObjectWithStatus(mapObjMan, &mapObj, &i, MAP_OBJ_STATUS_0) == TRUE) {
+        if (!MapObject_PortIsNeighbour(mapObj) && MapObject_GetX(mapObj) == x && MapObject_GetZ(mapObj) == z) {
+            return mapObj;
+        }
+    }
+
+    return NULL;
+}
+#endif
