From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Fri, 6 Nov 2026 01:30:00 -0700
Subject: [PATCH] The follower stays out as a trainer sees the player
 (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A trainer that sees the player as they step into its sight starts its
script on that step. The follower took the step for the game moving the
player and went into its ball before every trainer's battle. The tile
the player is on as a script starts, and through the rest of a step
already under way then (at most 16 frames), is now where they are. A
script's own walk of the player still sends it in, as does someone
coming to its tile.

---
diff --git a/src/port_follower.c b/src/port_follower.c
index fe2d9391..dba2a49b 100644
--- a/src/port_follower.c
+++ b/src/port_follower.c
@@ -1229,9 +1229,14 @@ static void PortFollower_TakeBallKind(FieldSystem *fieldSystem)
     }
 }
 
+// (PortFollower_Update) A script's first frames while the player's own
+// step goes on: at most a running or walking step's.
+#define PORT_OWN_STEP_FRAMES 16
+
 void PortFollower_Update(FieldSystem *fieldSystem)
 {
-    static int sWait, sPlayerX, sPlayerZ, sNoRoom;
+    static int sWait, sPlayerX, sPlayerZ, sNoRoom, sOwnStep;
+    static BOOL sScriptStarted;
     static MapObject *sLast;
     MapObject *mapObj, *player;
     int graphicsID = 0, x, z, dx, dz;
@@ -1293,6 +1298,30 @@ void PortFollower_Update(FieldSystem *fieldSystem)
     x = PlayerAvatar_GetXPos(fieldSystem->playerAvatar);
     z = PlayerAvatar_GetZPos(fieldSystem->playerAvatar);
 
+    // (the player's own step, under way as a script starts, isn't the game
+    // moving them: a trainer seeing them as they step into its sight starts
+    // its script on that step, and the follower went into its ball before
+    // every trainer's battle. Their tile as the script starts, and through
+    // the rest of that step, is where they are.)
+    if (!scripted) {
+        sScriptStarted = FALSE;
+    } else if (!sScriptStarted) {
+        sScriptStarted = TRUE;
+        sOwnStep = PORT_OWN_STEP_FRAMES;
+        sPlayerX = x;
+        sPlayerZ = z;
+    }
+
+    if (scripted && sOwnStep > 0) {
+        if (MapObject_IsMoving(player) || PortFollower_PlayerStepping(fieldSystem)) {
+            sOwnStep--;
+            sPlayerX = x;
+            sPlayerZ = z;
+        } else {
+            sOwnStep = 0;
+        }
+    }
+
     if (mapObj != NULL && sIn > 0) {
         // Going in: smaller each frame, then gone.
         sIn--;
