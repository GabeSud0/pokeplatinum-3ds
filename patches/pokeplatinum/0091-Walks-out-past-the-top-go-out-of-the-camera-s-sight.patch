 }
 
+static BOOL ScrCmd_PortTallRows(FieldSystem *fieldSystem, int x, int z, fx32 y, int *top, int *bottom);
+
+// (ScrCmd_PortWideFindWay) Past the picture's top or bottom from the middle
+// (dz tiles): far enough for the DS's rows; and with search->outOfSight, on
+// the taller field, out of its sight as the camera has it (its feet and
+// shadow above the top, its head below the bottom). Roark leaving Oreburgh
+// Mine's B2F up its east passage went 9 rows up, and was taken away with
+// his feet still on the screen (2026-11-06).
+static BOOL ScrCmd_PortWidePastEdge(PortWidePathSearch *search, int x, int z, fx32 y, int dz)
+{
+    int top, bottom;
+
+    if (dz > -PORT_WIDE_TOP_TILES && dz < PORT_WIDE_BOTTOM_TILES) {
+        return FALSE;
+    }
+
+    if (!search->outOfSight || !NitroPort_PixelField() || !ScrCmd_PortTallRows(search->fieldSystem, x, z, y, &top, &bottom)) {
+        return TRUE;
+    }
+
+    return dz < 0 ? bottom <= -PORT_WIDE_TALL_ROWS : top >= 192 + PORT_WIDE_TALL_ROWS;
+}
+
