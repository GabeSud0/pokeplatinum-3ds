     const int dirs[3] = { search->outDir, DIR_NORTH, DIR_SOUTH };
     int dx = x - search->midX, dz = z - search->midZ, i;
 
-    if ((search->outDir == DIR_EAST ? dx : -dx) >= search->out || dz <= -PORT_WIDE_TOP_TILES || dz >= PORT_WIDE_BOTTOM_TILES) {
+    if ((search->outDir == DIR_EAST ? dx : -dx) >= search->out || ScrCmd_PortWidePastEdge(search, x, z, y, dz)) {
