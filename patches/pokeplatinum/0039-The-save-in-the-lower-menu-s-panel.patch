+// ----- YES / NO: two buttons, in the style of Platinum's CANCEL, wider
+
+static void SavePanel_DrawButton(Window *window, int x0, int x1, u32 entry, BOOL selected)
+{
+    const int y0 = 7, y1 = 30; // (rows 215-238)
+    MessageLoader *loader = MessageLoader_Init(MSG_LOADER_LOAD_ON_DEMAND, NARC_INDEX_MSGDATA__PL_MSG, TEXT_BANK_MENU_ENTRIES, SAVE_PANEL_HEAP);
+    String *label = MessageLoader_GetNewString(loader, entry);
+    int x, y;
+
+    // (inside the button: its corners rounded)
+#define SP_INSIDE(X, Y) ((X) >= x0 + ((Y) == y0 || (Y) == y1 ? 2 : (Y) == y0 + 1 || (Y) == y1 - 1 ? 1 : 0) \
+    && (X) <= x1 - ((Y) == y0 || (Y) == y1 ? 2 : (Y) == y0 + 1 || (Y) == y1 - 1 ? 1 : 0) && (Y) >= y0 && (Y) <= y1)
+
+    Window_FillTilemap(window, 0);
+
+    for (y = y0 - 3; y <= y1 + 3; y++) {
+        for (x = x0 - 3; x <= x1 + 3; x++) {
+            int dx, dy, near = 0;
+
+            if (x < 0 || y < 0 || x >= Window_GetWidth(window) * 8 || y >= Window_GetHeight(window) * 8) {
+                continue;
+            }
+
+            for (dy = -2; dy <= 2; dy++) {
+                for (dx = -2; dx <= 2; dx++) {
+                    BOOL in = SP_INSIDE(x + dx, y + dy);
+
+                    near += in;
+                }
+            }
+
+            if (SP_INSIDE(x, y)) {
+                BOOL outline = !SP_INSIDE(x - 1, y) || !SP_INSIDE(x + 1, y) || !SP_INSIDE(x, y - 1) || !SP_INSIDE(x, y + 1)
+                    || !SP_INSIDE(x - 1, y - 1) || !SP_INSIDE(x + 1, y - 1) || !SP_INSIDE(x - 1, y + 1) || !SP_INSIDE(x + 1, y + 1);
+                BOOL edge = !outline && (!SP_INSIDE(x - 2, y) || !SP_INSIDE(x + 2, y) || !SP_INSIDE(x, y - 2) || !SP_INSIDE(x, y + 2));
+
+                Window_FillRectWithColor(window, outline ? 1 : edge ? 2 : 3, x, y, 1, 1);
+            } else if (selected && near > 0) {
+                Window_FillRectWithColor(window, 4, x, y, 1, 1); // (the cursor's ring, 2 pixels)
+            }
+
+        }
+    }
+
+#undef SP_INSIDE
+
+    x = x0 + (x1 - x0 + 1 - (int)Font_CalcStringWidth(FONT_SYSTEM, label, 0)) / 2;
+    Text_AddPrinterWithParamsAndColor(window, FONT_SYSTEM, label, x, y0 + 4, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(5, 6, 3), NULL);
+    Window_CopyToVRAM(window);
+
+    String_Free(label);
+    MessageLoader_Free(loader);
+}
