+static void SavePanel_DrawIcons(SavePanel *panel, SavePanelStrip *strips[2], Party *party)
+{
+    NARC *narc = NARC_ctor(NARC_INDEX_POKETOOL__ICONGRA__PL_POKE_ICON, SAVE_PANEL_HEAP);
+    int count = Party_GetCurrentCount(party), k, x, y;
+
+    Graphics_LoadPaletteFromOpenNARC(narc, PokeIconPalettesFileIndex(), PAL_LOAD_SUB_BG, PLTT_OFFSET(SP_PAL_ICONS), PALETTE_SIZE_BYTES * 3, SAVE_PANEL_HEAP);
+
+    for (k = 0; k < count && k < MAX_PARTY_SIZE; k++) {
+        Pokemon *mon = Party_GetPokemonBySlotIndex(party, k);
+        NNSG2dCharacterData *charData;
+        void *charBuf;
+        const u8 *tiles;
+        int left = SavePanel_IconX(k) - 16;
+        s8 pal = (s8)(SP_PAL_ICONS + Pokemon_IconPaletteIndex(mon));
+
+        if (Pokemon_GetValue(mon, MON_DATA_SPECIES, NULL) == SPECIES_NONE) {
+            continue;
+        }
+
+        charBuf = Graphics_GetCharDataFromOpenNARC(narc, Pokemon_IconSpriteIndex(mon), FALSE, &charData, SAVE_PANEL_HEAP);
+        tiles = charData->pRawData;
+
+        for (y = 0; y < 32; y++) {
+            for (x = 0; x < 32; x++) {
+                u8 b = tiles[((y / 8) * 4 + x / 8) * 32 + (y % 8) * 4 + (x % 8) / 2];
+
+                SavePanel_StripPut(strips[(k & 1) ^ 1], left + x, SP_ICON_Y + y, (x & 1) ? b >> 4 : b & 15, pal);
+            }
+        }
+
+        Heap_Free(charBuf);
+    }
+
+    NARC_dtor(narc);
+}
