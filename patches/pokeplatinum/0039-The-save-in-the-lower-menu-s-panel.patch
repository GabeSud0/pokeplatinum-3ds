+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME, SP_CARD_X - 1, SP_CARD_Y - 1, 1, 1, SP_PAL_FRAME);
+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME + 1, SP_CARD_X, SP_CARD_Y - 1, SP_CARD_W, 1, SP_PAL_FRAME);
+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME + 2, SP_CARD_X + SP_CARD_W, SP_CARD_Y - 1, 1, 1, SP_PAL_FRAME);
+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME + 3, SP_CARD_X - 1, SP_CARD_Y, 1, SP_CARD_H, SP_PAL_FRAME);
+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME + 5, SP_CARD_X + SP_CARD_W, SP_CARD_Y, 1, SP_CARD_H, SP_PAL_FRAME);
+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME + 6, SP_CARD_X - 1, SP_CARD_Y + SP_CARD_H, 1, 1, SP_PAL_FRAME);
+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME + 7, SP_CARD_X, SP_CARD_Y + SP_CARD_H, SP_CARD_W, 1, SP_PAL_FRAME);
+    Bg_FillTilemapRect(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME + 8, SP_CARD_X + SP_CARD_W, SP_CARD_Y + SP_CARD_H, 1, 1, SP_PAL_FRAME);
+
+    // The pale box (a floor under the feet), the trainer over it (BG1).
+    Window_Add(bgConfig, &panel->box, SAVE_PANEL_CARD, SP_CARD_X, SP_CARD_Y, 8, 10, SP_PAL_CARD, SP_TILE_BOX);
+    Window_FillTilemap(&panel->box, SP_WHITE);
+    Window_FillRectWithColor(&panel->box, SP_PALE, boxX0 + 1, boxY0, boxX1 - boxX0 - 1, boxY1 - boxY0 + 1);
+    Window_FillRectWithColor(&panel->box, SP_PALE, boxX0, boxY0 + 1, boxX1 - boxX0 + 1, boxY1 - boxY0 - 1);
+    Window_FillRectWithColor(&panel->box, SP_BOX, boxX0 + 1, boxY0 + 1, boxX1 - boxX0 - 1, boxY1 - boxY0 - 1);
+    Window_FillRectWithColor(&panel->box, SP_PALE2, boxX0 + 1, boxY1 - 12, boxX1 - boxX0 - 1, 12);
+    Window_CopyToVRAM(&panel->box);
+
+    // The lines beside it: the name, IDNo.; a line; the place (red);
+    // POKéDEX; TIME.
+    Window_Add(bgConfig, &panel->text, SAVE_PANEL_CARD, 9, SP_CARD_Y, 22, 10, SP_PAL_CARD, SP_TILE_TEXT);
+    Window_FillTilemap(&panel->text, SP_WHITE);
+    SavePanel_Print(&panel->text, infoLoader, template, SAVE_INFO_PLAYER_NAME, 6, 4, FALSE);
+    String_FormatInt(buf, TrainerInfo_ID_LowHalf(saveInfo.trainerInfo), 5, PADDING_MODE_ZEROES, CHARSET_MODE_EN);
+    x = idRight - Font_CalcStringWidth(FONT_SYSTEM, buf, 0);
+    Text_AddPrinterWithParamsAndColor(&panel->text, FONT_SYSTEM, buf, x, 4, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(1, 2, SP_WHITE), NULL);
+    {
+        String *id = MessageLoader_GetNewString(cardLoader, TrainerCard_Text_IDNo);
+
+        Text_AddPrinterWithParamsAndColor(&panel->text, FONT_SYSTEM, id, x - Font_CalcStringWidth(FONT_SYSTEM, id, 0), 4, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(1, 2, SP_WHITE), NULL);
+        String_Free(id);
+    }
+    Window_FillRectWithColor(&panel->text, SP_PALE, 6, 21, idRight - 6 + 1, 1);
+    SavePanel_Print(&panel->text, infoLoader, template, SAVE_INFO_LABEL_MAP_NAME, 6, 24, FALSE);
