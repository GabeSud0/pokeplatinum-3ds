+// ----- the trainer: the trainer card's own picture
+
+// Its pale box: x 12-67, rows 60-135 (the trainer's middle in it, its
+// feet 4 pixels over the box's bottom).
+#define SP_BOX_X0 12
+#define SP_BOX_X1 67
+#define SP_BOX_Y0 60
+#define SP_BOX_Y1 135
+
+static void SavePanel_DrawTrainer(SavePanel *panel, NARC *narc, TrainerInfo *trainerInfo, SavePanelStrip *strip)
+{
+    BOOL female = TrainerInfo_Gender(trainerInfo) == GENDER_FEMALE;
+    NNSG2dCharacterData *charData;
+    NNSG2dScreenData *screenData;
+    NNSG2dPaletteData *palData;
+    void *charBuf = Graphics_GetCharDataFromOpenNARC(narc, player_tiles_NCGR, FALSE, &charData, SAVE_PANEL_HEAP);
+    void *scrBuf = Graphics_GetScrnDataFromOpenNARC(narc, female ? lucas_NSCR + 1 : lucas_NSCR, FALSE, &screenData, SAVE_PANEL_HEAP);
+    void *palBuf = Graphics_GetPlttDataFromOpenNARC(narc, trainer_card_normal_NCLR, &palData, SAVE_PANEL_HEAP);
+    const u16 *entries = (const u16 *)screenData->rawData;
+    BOOL eightBit = charData->pixelFmt == GX_TEXFMT_PLTT256;
+    u8 *pic = Heap_Alloc(SAVE_PANEL_HEAP, 40 * 80);
+    int tx, ty, y, x, row = -1, minX = 40, maxX = -1, minY = 80, maxY = -1, left, top;
+
+    // Its picture: the trainer card's 5 x 10 tiles (its own colours: the
+    // boy's palette, or the girl's).
+    memset(pic, 0, 40 * 80);
+
+    for (ty = 0; ty < 10; ty++) {
+        for (tx = 0; tx < 5; tx++) {
+            u16 e = entries[(ty + 6) * 32 + tx + 23];
+            int t = e & 0x3FF;
+
+            for (y = 0; y < 8; y++) {
+                for (x = 0; x < 8; x++) {
+                    int sx = (e & 0x400) ? 7 - x : x, sy = (e & 0x800) ? 7 - y : y, v;
+
+                    if (eightBit) {
+                        v = ((const u8 *)charData->pRawData)[t * 64 + sy * 8 + sx];
+                    } else {
+                        u8 b = ((const u8 *)charData->pRawData)[t * 32 + sy * 4 + sx / 2];
+                        v = (sx & 1) ? b >> 4 : b & 15;
+                    }
+
+                    if (v != 0) {
+                        int px = tx * 8 + x, py = ty * 8 + y;
+
+                        row = eightBit ? v / 16 : (e >> 12);
+                        pic[py * 40 + px] = v & 15;
+                        minX = px < minX ? px : minX, maxX = px > maxX ? px : maxX;
+                        minY = py < minY ? py : minY, maxY = py > maxY ? py : maxY;
+                    }
+                }
+            }
+        }
+    }
+
+    if (row >= 0) {
+        DC_FlushRange(palData->pRawData, PLTT_OFFSET(row + 1));
+        GXS_LoadBGPltt((const u8 *)palData->pRawData + PLTT_OFFSET(row), PLTT_OFFSET(SP_PAL_TRAINER), PALETTE_SIZE_BYTES);
+        left = SP_BOX_X0 + (SP_BOX_X1 - SP_BOX_X0 + 1 - (maxX - minX + 1)) / 2;
+        top = SP_BOX_Y1 - 4 - (maxY - minY + 1);
+
+        for (y = minY; y <= maxY; y++) {
+            for (x = minX; x <= maxX; x++) {
+                SavePanel_StripPut(strip, left + x - minX, top + y - minY, pic[y * 40 + x], SP_PAL_TRAINER);
+            }
+        }
+    }
+
+    Heap_Free(pic);
+    Heap_Free(palBuf);
+    Heap_Free(scrBuf);
+    Heap_Free(charBuf);
+}
