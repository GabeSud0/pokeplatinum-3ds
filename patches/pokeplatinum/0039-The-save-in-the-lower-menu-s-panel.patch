+    SavePanel_DrawBadges(panel, narc, strips, trainerInfo);
+    NARC_dtor(narc);
+    SavePanel_DrawIcons(panel, strips, SaveData_GetParty(fieldSystem->saveData));
+    SavePanel_DrawCard(panel);
+
+    SavePanel_StripToLayer(panel, strips[0], SAVE_PANEL_PICS, &panel->picsNext, SP_PICS_TILES - 1);
+    SavePanel_StripToLayer(panel, strips[1], SAVE_PANEL_MSG, &panel->msgPicsNext, SP_TILE_MSG_BOX - 1);
+    SavePanel_FreeStrip(strips[1]);
+    SavePanel_FreeStrip(strips[0]);
+
+    // YES / NO.
+    Window_Add(bgConfig, &panel->yes, SAVE_PANEL_CARD, 0, 26, 16, 4, SP_PAL_BUTTON, SP_TILE_YES);
+    Window_Add(bgConfig, &panel->no, SAVE_PANEL_CARD, 16, 26, 16, 4, SP_PAL_BUTTON, SP_TILE_NO);
+    SavePanel_DrawButtons(panel);
+    NitroPort_LowerMenuSetPanelButtons(buttons, 2);
+
+    Bg_CopyTilemapBufferToVRAM(bgConfig, SAVE_PANEL_MSG);
+    Bg_CopyTilemapBufferToVRAM(bgConfig, SAVE_PANEL_PICS);
+    Bg_CopyTilemapBufferToVRAM(bgConfig, SAVE_PANEL_CARD);
+    GXS_SetVisiblePlane(GX_PLANEMASK_BG0 | GX_PLANEMASK_BG1 | GX_PLANEMASK_BG2 | GX_PLANEMASK_BG3);
+}
+
+void SavePanel_Close(FieldSystem *fieldSystem)
+{
+    SavePanel *panel = sSavePanel;
+    BgConfig *bgConfig = fieldSystem->bgConfig;
+
+    if (panel == NULL) {
+        return;
+    }
+
+    NitroPort_LowerMenuSetPanelButtons(NULL, 0);
+    GXS_SetVisiblePlane(0);
+    Window_Remove(&panel->yes);
+    Window_Remove(&panel->no);
+    Window_Remove(&panel->shadows);
+    Window_Remove(&panel->line);
+    Window_Remove(&panel->text);
+    Window_Remove(&panel->box);
+    Bg_SetOffset(bgConfig, SAVE_PANEL_BACK, BG_OFFSET_UPDATE_SET_Y, 0);
+    Bg_FreeTilemapBuffer(bgConfig, SAVE_PANEL_MSG);
+    Bg_FreeTilemapBuffer(bgConfig, SAVE_PANEL_PICS);
+    Bg_FreeTilemapBuffer(bgConfig, SAVE_PANEL_CARD);
+    Bg_FreeTilemapBuffer(bgConfig, SAVE_PANEL_BACK);
+    GX_SetBankForSubBG(GX_VRAM_SUB_BG_32_H);
+    GX_SetBankForSubOBJ(GX_VRAM_SUB_OBJ_16_I);
+
+    sSavePanel = NULL;
+    Heap_Free(panel);
+    Heap_Destroy(SAVE_PANEL_HEAP);
+}
+
+// The save script's message box (script_message.c), at the panel's top.
+void SavePanel_AddMessageWindow(BgConfig *bgConfig, Window *window)
+{
+    Window_Add(bgConfig, window, SAVE_PANEL_MSG, 2, 1, 27, 4, SP_PAL_MSG_TEXT, SP_TILE_MESSAGE);
+}
+
+// The save script's YES / NO (scrcmd.c): the cursor on YES, as the DS's.
+void SavePanel_StartYesNo(void)
+{
+    if (sSavePanel == NULL) {
+        return;
+    }
+
+    sSavePanel->selected = 0;
+    SavePanel_DrawButtons(sSavePanel);
+}
+
+// Tapped (let go on it), A on the one the cursor's on, B: NO. Left (up):
+// the cursor on YES, right (down): on NO. MENU_NOTHING_CHOSEN till then.
+int SavePanel_YesNoResult(void)
+{
+    SavePanel *panel = sSavePanel;
+    int press = -1, chosen = -1;
+
+    if (panel == NULL) {
+        return MENU_NO;
+    }
+
+    if (NitroPort_LowerMenuPressPending() >= 0) {
+        press = NitroPort_LowerMenuTakePress();
+    }
+
+    if (press == PORT_BUTTON_PRESS(0) || press == PORT_BUTTON_PRESS(1)) {
+        chosen = press - PORT_BUTTON_PRESS(0);
+    } else if (JOY_NEW(PAD_BUTTON_A)) {
+        chosen = panel->selected;
+    } else if (JOY_NEW(PAD_BUTTON_B)) {
+        chosen = 1;
+    } else if (JOY_NEW(PAD_KEY_LEFT | PAD_KEY_RIGHT | PAD_KEY_UP | PAD_KEY_DOWN)) {
+        int next = JOY_NEW(PAD_KEY_LEFT | PAD_KEY_UP) ? 0 : 1;
+
+        if (next != panel->selected) {
+            Sound_PlayEffect(SEQ_SE_DP_SELECT78_sseq);
+            panel->selected = next;
+            SavePanel_DrawButtons(panel);
+        }
+    }
+
+    if (chosen < 0) {
+        return MENU_NOTHING_CHOSEN;
+    }
+
+    Sound_PlayEffect(SE_CONFIRM_sseq_3);
+    panel->selected = -1;
+    SavePanel_DrawButtons(panel);
+
+    return chosen == 0 ? MENU_YES : MENU_NO;
+}
+#endif
