+#ifdef SDK_PORT_3DS
+// The save from the lower menu, in its panel (save_info_window.c: its
+// message box, report card and YES / NO there, the upper screen keeping
+// the field): the panel fades to black, the menu kept on, the field's
+// bottom screen (the Pokétch) steps aside behind it and the save's page
+// comes and pops in, then the save's script runs as on the DS. Done, the
+// panel fades to black again, the page goes, the Pokétch comes back behind
+// it, and the panel fades in on the map: back to walking. (Where the menu
+// isn't on, or the save can't be made (another adventure's on the card),
+// it's the DS's.)
+static int sPortSavePhase;
+static int sPortSaveFrames;
+
+// Before the save's script: TRUE while the page comes (the state stays).
+static BOOL StartMenu_PortSaveOpening(FieldSystem *fieldSystem)
+{
+    switch (sPortSavePhase) {
+    case 0:
+        if (!gStartMenuPortMenu || !NitroPort_LowerMenuAvailable() || !NitroPort_LowerMenuOn() || fieldSystem->bottomScreen != 1
+            || SaveData_OverwriteCheck(fieldSystem->saveData)) {
+            return FALSE;
+        }
+
+        NitroPort_LowerMenuKeepShown(TRUE);
+        NitroPort_LowerMenuFadePanel(TRUE);
+        sPortSavePhase = 1;
+        return TRUE;
+    case 1:
+        if (NitroPort_LowerMenuPanelFade() < PORT_FADE_BLACK) {
+            return TRUE;
+        }
+
+        FieldSystem_EndBottomScreen(fieldSystem);
+        sPortSavePhase = 2;
+        return TRUE;
+    case 2:
+        if (!FieldSystem_IsBottomScreenDone(fieldSystem)) {
+            return TRUE;
+        }
+
+        SavePanel_Open(fieldSystem);
+        NitroPort_LowerMenuSelect(PORT_BUTTON_SAVE); // (lit while it's up, as the bag's button)
+        NitroPort_LowerMenuShow(TRUE);
+        NitroPort_LowerMenuSetTall(TRUE);
+        NitroPort_LowerMenuSetPanel(PORT_PANEL_DS);
+        NitroPort_LowerMenuSetPanelTouch(FALSE);
+        sPortSaveFrames = 2;
+        sPortSavePhase = 3;
+        return TRUE;
+    case 3:
+        if (--sPortSaveFrames > 0) {
+            return TRUE;
+        }
+
+        NitroPort_LowerMenuFadePanel(PORT_CLEAR_NOW);
+        NitroPort_LowerMenuKeepShown(FALSE);
+        sPortSavePhase = 4;
+        return FALSE;
+    default:
+        return FALSE;
+    }
+}
+
+// After it: TRUE while the page goes and the Pokétch comes back.
+static BOOL StartMenu_PortSaveClosing(FieldSystem *fieldSystem)
+{
+    switch (sPortSavePhase) {
+    case 4:
+        NitroPort_LowerMenuKeepShown(TRUE);
+        NitroPort_LowerMenuFadePanel(TRUE);
+        sPortSavePhase = 5;
+        return TRUE;
+    case 5:
+        if (NitroPort_LowerMenuPanelFade() < PORT_FADE_BLACK) {
+            return TRUE;
+        }
+
+        SavePanel_Close(fieldSystem);
+        FieldSystem_InitBottomScreen(fieldSystem);
+        sPortSaveFrames = 3;
+        sPortSavePhase = 6;
+        return TRUE;
+    case 6:
+        // (the Pokétch drawn first, a few frames)
+        if (--sPortSaveFrames > 0) {
+            return TRUE;
+        }
+
+        StartMenu_PortShowPanel(fieldSystem);
+        NitroPort_LowerMenuSelect(-1);
+        NitroPort_LowerMenuFadePanel(FALSE);
+        NitroPort_LowerMenuKeepShown(FALSE);
+        sPortSavePhase = 0;
+        return FALSE;
+    default:
+        sPortSavePhase = 0;
+        return FALSE;
+    }
+}
+#endif
