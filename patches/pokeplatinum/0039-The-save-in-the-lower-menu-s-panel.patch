+// ----- the panel
+
+void SavePanel_Open(FieldSystem *fieldSystem)
+{
+    static const short buttons[2][4] = { { 8, 215, 122, 238 }, { 133, 215, 247, 238 } };
+    SavePanel *panel;
+    BgConfig *bgConfig = fieldSystem->bgConfig;
+    TrainerInfo *trainerInfo = SaveData_GetTrainerInfo(fieldSystem->saveData);
+    SavePanelStrip *strips[2];
+    NARC *narc;
+    u16 *map;
+    u32 zero[8] = { 0 }, white[8];
+    int k;
+
+    Heap_Create(HEAP_ID_APPLICATION, SAVE_PANEL_HEAP, HEAP_SIZE_PRE_POKETCH_SUBSCREEN);
+    panel = Heap_Alloc(SAVE_PANEL_HEAP, sizeof(SavePanel));
+    memset(panel, 0, sizeof(*panel));
+    panel->fieldSystem = fieldSystem;
+    panel->bgConfig = bgConfig;
+    panel->selected = -1;
+    panel->msgPicsNext = SP_TILE_MSG_PICS;
+    sSavePanel = panel;
+
+    // The sub engine: 48 KB of BG VRAM, four layers, no OBJs.
+    GX_SetBankForSubOBJ(GX_VRAM_SUB_OBJ_NONE);
+    GX_SetBankForSubBG(GX_VRAM_SUB_BG_48_HI);
+    GXS_SetGraphicsMode(GX_BGMODE_0);
+    G2S_BlendNone();
+    GXS_SetVisibleWnd(GX_WNDMASK_NONE);
+    SavePanel_InitLayer(bgConfig, SAVE_PANEL_MSG, GX_BG_SCRBASE_0xa000, GX_BG_CHARBASE_0x00000, 0);
+    SavePanel_InitLayer(bgConfig, SAVE_PANEL_PICS, GX_BG_SCRBASE_0xa800, GX_BG_CHARBASE_0x08000, 1);
+    SavePanel_InitLayer(bgConfig, SAVE_PANEL_CARD, GX_BG_SCRBASE_0xb000, GX_BG_CHARBASE_0x00000, 2);
+    SavePanel_InitLayer(bgConfig, SAVE_PANEL_BACK, GX_BG_SCRBASE_0xb800, GX_BG_CHARBASE_0x00000, 3);
+
+    for (k = 0; k < 8; k++) {
+        white[k] = 0xFFFFFFFF;
+    }
+
+    DC_FlushRange(zero, sizeof(zero));
+    DC_FlushRange(white, sizeof(white));
+    Bg_LoadTiles(bgConfig, SAVE_PANEL_MSG, zero, sizeof(zero), 0);
+    Bg_LoadTiles(bgConfig, SAVE_PANEL_PICS, zero, sizeof(zero), 0);
+    Bg_LoadTiles(bgConfig, SAVE_PANEL_MSG, white, sizeof(white), SP_TILE_WHITE);
+
+    SavePanel_LoadColours(sSavePanelCardColours, SP_PAL_CARD);
+    SavePanel_LoadColours(sSavePanelButtonColours, SP_PAL_BUTTON);
+    SavePanel_LoadColours(sSavePanelPaleColours, SP_PAL_PALE);
+    Font_LoadTextPalette(PAL_LOAD_SUB_BG, PLTT_OFFSET(SP_PAL_MSG_TEXT), SAVE_PANEL_HEAP);
+
+    // The background: the lower screen's own, 27 lines down (its first and
+    // last rows' colour round it).
+    narc = NARC_ctor(NARC_INDEX_GRAPHIC__POKETCH, SAVE_PANEL_HEAP);
+    Graphics_LoadTilesToBgLayerFromOpenNARC(narc, unavailable_bg_tiles_NCGR_lz, bgConfig, SAVE_PANEL_BACK, SP_TILE_BACK, 0, TRUE, SAVE_PANEL_HEAP);
+    Graphics_LoadTilemapToBgLayerFromOpenNARC(narc, unavailable_NSCR_lz, bgConfig, SAVE_PANEL_BACK, 0, 0, TRUE, SAVE_PANEL_HEAP);
+    Graphics_LoadPaletteFromOpenNARC(narc, unavailable_bg_tiles_NCLR, PAL_LOAD_SUB_BG, PLTT_OFFSET(SP_PAL_BACK), PALETTE_SIZE_BYTES, SAVE_PANEL_HEAP);
+    NARC_dtor(narc);
+    map = Bg_GetTilemapBuffer(bgConfig, SAVE_PANEL_BACK);
+
+    for (k = 0; k < 24 * 32; k++) {
+        map[k] = (map[k] & 0xFC00) | ((map[k] & 0x3FF) + SP_TILE_BACK);
+    }
+
+    for (k = 24 * 32; k < 32 * 32; k++) {
+        map[k] = map[0]; // (rows 192-255: its corner's tile, plain)
+    }
+
+    Bg_CopyTilemapBufferToVRAM(bgConfig, SAVE_PANEL_BACK);
+    Bg_SetOffset(bgConfig, SAVE_PANEL_BACK, BG_OFFSET_UPDATE_SET_Y, -27);
+
+    // The trainer, the card, the badges and icons.
+    strips[0] = SavePanel_NewStrip(SP_TRAINER_Y0, SP_STRIP_Y0 + SP_STRIP_ROWS - SP_TRAINER_Y0);
+    strips[1] = SavePanel_NewStrip(SP_STRIP_Y0, SP_STRIP_ROWS);
+    panel->picsNext = 1;
+
+    narc = NARC_ctor(NARC_INDEX_GRAPHIC__TRAINER_CASE, SAVE_PANEL_HEAP);
