+    // Its frame (the report window's) round its inside, white.
+    LoadStandardWindowGraphics(bgConfig, SAVE_PANEL_CARD, SP_TILE_FRAME, SP_PAL_FRAME, STANDARD_WINDOW_SYSTEM, SAVE_PANEL_HEAP);
