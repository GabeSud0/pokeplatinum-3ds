+// The party: each Pokémon's icon (its first frame), every other one in the
+// other layer's; their shadows in the card (SavePanel_DrawCard).
+static int SavePanel_IconX(int slot)
+{
+    return SP_CARD_X * 8 + 2 + ((SP_CARD_W * 8 - 5) * (2 * slot + 1)) / 12;
+}
