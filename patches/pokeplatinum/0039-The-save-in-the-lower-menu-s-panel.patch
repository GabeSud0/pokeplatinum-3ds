+    Window_Add(bgConfig, &panel->shadows, SAVE_PANEL_CARD, SP_CARD_X, SP_SHADOW_Y / 8, SP_CARD_W, 1, SP_PAL_CARD, SP_TILE_SHADOWS);
+    Window_FillTilemap(&panel->shadows, SP_WHITE);
