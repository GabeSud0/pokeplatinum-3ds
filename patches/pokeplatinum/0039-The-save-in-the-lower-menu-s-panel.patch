+static void SavePanel_DrawButtons(SavePanel *panel)
+{
+    SavePanel_DrawButton(&panel->yes, 8, 122, MenuEntries_Text_Yes, panel->selected == 0);
+    SavePanel_DrawButton(&panel->no, 5, 119, MenuEntries_Text_No, panel->selected == 1);
+}
