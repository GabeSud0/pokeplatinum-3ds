+#ifdef SDK_PORT_3DS
+// ------------------------------------------------------------------------
+// The save in the 3DS remaster's lower menu's panel (an approved mock-up,
+// 2026-10-24, after the Emerald project's layout, Platinum's own pieces):
+// SAVE in the lower menu shows, in the panel, the save's question in
+// Platinum's message box at the top; a report card in its window frame
+// (the player's trainer card picture in a pale box, the name, IDNo., the
+// place in red, POKéDEX, TIME; the eight badges at half size, the ones not
+// earned yet a pale outline of their own shape; the party's icons, each on
+// a shadow); and YES / NO as two buttons. The save's script runs as on the
+// DS (common script 5), its message box, YES/NO and report here instead of
+// on the upper screen, which keeps the field.
+//
+// Drawn on the DS's lower screen, 248 lines tall (the port's tall panel),
+// while the Pokétch steps aside (the field's bottom screen ended behind the
+// panel's black, and started again once the save's done: start_menu.c).
+// The sub engine's BGs, 48 KB of VRAM (H and I; I is the sub OBJ's, none
+// meanwhile):
+//   BG0 (priority 0): the message box; half the badges and icons
+//   BG1 (priority 1): the trainer; the other badges and icons
+//   BG2 (priority 2): the report card (its frame, its windows), YES / NO
+//   BG3 (priority 3): the lower screen's own empty background (the Pokétch
+//                     unavailable one's), 27 lines down, its colour round it
+// The badges and icons sit at any pixel: drawn into a picture of their
+// rows and cut into tiles, a layer every other one (no tile shared by two:
+// a tile has one palette). The badges halved crisply from the badge case's
+// own badges (each 2 x 2 its commonest colour, a tie to the darker, then a
+// clean outline in the badge's darkest edge colour): no blends, only the
+// badge's colours, made at run time from the ROM.
+// ------------------------------------------------------------------------
+
+extern void NitroPort_LowerMenuSetPanelButtons(const short (*rects)[4], int count);
+extern int NitroPort_LowerMenuPressPending(void);
+extern int NitroPort_LowerMenuTakePress(void);
+#define PORT_BUTTON_PRESS(k) (10 + 1 + 4 + (k)) // NITRO_LOWERMENU_BUTTON_PRESS
+
+#define SAVE_PANEL_HEAP     HEAP_ID_POKETCH_APP // (the Pokétch's, stepped aside)
+#define SAVE_PANEL_MSG      BG_LAYER_SUB_0
+#define SAVE_PANEL_PICS     BG_LAYER_SUB_1
+#define SAVE_PANEL_CARD     BG_LAYER_SUB_2
+#define SAVE_PANEL_BACK     BG_LAYER_SUB_3
+
+// The sub BG's palettes.
+enum {
+    SP_PAL_BACK = 0,
+    SP_PAL_CARD = 1, // the card's colours, its lettering
+    SP_PAL_BUTTON = 2,
+    SP_PAL_FRAME = 3, // the report's window frame
+    SP_PAL_TRAINER = 4,
+    SP_PAL_PALE = 6, // the badges not earned yet
+    SP_PAL_ICONS = 7, // 7-9: the icons' three
+    SP_PAL_MSG_FRAME = 10,
+    SP_PAL_MSG_TEXT = 13,
+};
+static const u8 sSavePanelBadgePals[4] = { 11, 12, 14, 15 };
+
+// The card's colours: 1-2 the report's lettering, 3-4 its red (COLOR 1),
+// 5 pale edge, 6 the box's fill, 7 pale fill, 15 white.
+#define SP_INK       1
+#define SP_PALE      5
+#define SP_BOX       6
+#define SP_PALE2     7
+#define SP_WHITE     15
+static const u16 sSavePanelCardColours[16] = {
+    0, GX_RGB(90 >> 3, 90 >> 3, 82 >> 3), GX_RGB(173 >> 3, 189 >> 3, 189 >> 3), GX_RGB(239 >> 3, 33 >> 3, 16 >> 3),
+    GX_RGB(255 >> 3, 173 >> 3, 189 >> 3), GX_RGB(173 >> 3, 189 >> 3, 198 >> 3), GX_RGB(231 >> 3, 239 >> 3, 247 >> 3),
+    GX_RGB(214 >> 3, 222 >> 3, 231 >> 3), 0, 0, 0, 0, 0, 0, 0, GX_RGB(31, 31, 31)
+};
+
+// YES / NO: 1 outline, 2 inner edge, 3 fill, 4 the cursor's orange ring,
+// 5 lettering, 6 its shadow.
+static const u16 sSavePanelButtonColours[16] = {
+    0, GX_RGB(82 >> 3, 82 >> 3, 82 >> 3), GX_RGB(0, 66 >> 3, 231 >> 3), GX_RGB(0, 90 >> 3, 255 >> 3),
+    GX_RGB(239 >> 3, 90 >> 3, 0), GX_RGB(31, 31, 31), GX_RGB(41 >> 3, 41 >> 3, 41 >> 3)
+};
+
+static const u16 sSavePanelPaleColours[16] = {
+    0, GX_RGB(173 >> 3, 189 >> 3, 198 >> 3), GX_RGB(214 >> 3, 222 >> 3, 231 >> 3)
+};
+
+// The tiles: BG0, BG2, BG3 share the first 32 KB (char base 0); BG1 its own
+// 8 KB (char base 0x8000); the tilemaps after them.
+#define SP_TILE_WHITE    1
+#define SP_TILE_BACK     64 // (the background's 64)
+#define SP_TILE_MESSAGE  128 // (27 x 4)
+#define SP_TILE_FRAME    236 // (9)
+#define SP_TILE_TEXT     250 // (22 x 10)
+#define SP_TILE_BOX      470 // (8 x 10)
+#define SP_TILE_LINE     550 // (30)
+#define SP_TILE_SHADOWS  580 // (30)
+#define SP_TILE_YES      610 // (16 x 4)
+#define SP_TILE_NO       674 // (16 x 4)
+#define SP_TILE_MSG_PICS 740 // (the badges and icons in BG0, up to the message box's frame)
+#define SP_TILE_MSG_BOX  (1024 - (18 + 12))
+#define SP_PICS_TILES    256
+
+// The card (tiles): its inside x 1-30, rows 7-24; YES / NO rows 26-29.
+#define SP_CARD_X 1
+#define SP_CARD_Y 7
+#define SP_CARD_W 30
+#define SP_CARD_H 18
+
+// The badges' and icons' rows (pixels 136-199: tile rows 17-24); in BG1
+// the trainer's too (from row 56).
+#define SP_STRIP_Y0     136
+#define SP_STRIP_ROWS   64
+#define SP_TRAINER_Y0   56
+#define SP_BADGE_Y      141
+#define SP_ICON_Y     167
+#define SP_SHADOW_Y   195
+
+typedef struct SavePanelStrip {
+    int y0, rows;
+    u8 *px; // (rows x 256)
+    s8 pal[(SP_STRIP_Y0 + SP_STRIP_ROWS - SP_TRAINER_Y0) / 8][32];
+} SavePanelStrip;
+
+typedef struct SavePanelBadge {
+    u8 w, h;
+    u8 px[32][32]; // (indices into rgb; 0: none)
+    u16 rgb[16];
+} SavePanelBadge;
+
+typedef struct SavePanel {
+    FieldSystem *fieldSystem;
+    BgConfig *bgConfig;
+    Window text, box, line, shadows, yes, no;
+    int selected; // (YES 0, NO 1; -1: not asking)
+    int msgPicsNext, picsNext;
+} SavePanel;
+
+static SavePanel *sSavePanel;
+
+BOOL SavePanel_IsOpen(void)
+{
+    return sSavePanel != NULL;
+}
+
+static void SavePanel_LoadColours(const u16 *colours, int slot)
+{
+    static u16 buf[16];
+
+    memcpy(buf, colours, sizeof(buf));
+    DC_FlushRange(buf, sizeof(buf));
+    GXS_LoadBGPltt(buf, PLTT_OFFSET(slot), sizeof(buf));
+}
+
+static void SavePanel_InitLayer(BgConfig *bgConfig, u8 layer, u32 screenBase, u32 charBase, u8 priority)
+{
+    BgTemplate template = {
+        .x = 0,
+        .y = 0,
+        .bufferSize = 0x800,
+        .baseTile = 0,
+        .screenSize = BG_SCREEN_SIZE_256x256,
+        .colorMode = GX_BG_COLORMODE_16,
+        .screenBase = screenBase,
+        .charBase = charBase,
+        .bgExtPltt = GX_BG_EXTPLTT_01,
+        .priority = priority,
+        .areaOver = 0,
+        .mosaic = FALSE,
+    };
+
+    Bg_InitFromTemplate(bgConfig, layer, &template, BG_TYPE_STATIC);
+    Bg_ClearTilemap(bgConfig, layer);
+}
+
+// ----- the badges and icons, at any pixel
+
+static SavePanelStrip *SavePanel_NewStrip(int y0, int rows)
+{
+    SavePanelStrip *strip = Heap_Alloc(SAVE_PANEL_HEAP, sizeof(SavePanelStrip));
+
+    strip->y0 = y0;
+    strip->rows = rows;
+    strip->px = Heap_Alloc(SAVE_PANEL_HEAP, rows * 256);
+    memset(strip->px, 0, rows * 256);
+    memset(strip->pal, -1, sizeof(strip->pal));
+    return strip;
+}
+
+static void SavePanel_FreeStrip(SavePanelStrip *strip)
+{
+    Heap_Free(strip->px);
+    Heap_Free(strip);
+}
+
+static void SavePanel_StripPut(SavePanelStrip *strip, int x, int y, u8 colour, s8 pal)
+{
+    int sy = y - strip->y0;
+    s8 *tilePal;
+
+    if (colour == 0 || x < 0 || x > 255 || sy < 0 || sy >= strip->rows) {
+        return;
+    }
+
+    tilePal = &strip->pal[sy / 8][x / 8];
+
+    if (*tilePal >= 0 && *tilePal != pal) {
+        return; // (a tile has one palette: the first one's)
+    }
+
+    *tilePal = pal;
+    strip->px[sy * 256 + x] = colour;
+}
+
+// The strip cut into tiles (one each, the same ones once), in the layer's
+// tilemap. next: the layer's next free tile, up to last.
+static void SavePanel_StripToLayer(SavePanel *panel, SavePanelStrip *strip, u8 layer, int *next, int last)
+{
+    u16 *map = Bg_GetTilemapBuffer(panel->bgConfig, layer);
+    u8 tile[32];
+    int tx, ty, y, x, first = *next;
+    u8 *made = Heap_Alloc(SAVE_PANEL_HEAP, (last - first + 1) * 32);
+
+    for (ty = 0; ty < strip->rows / 8; ty++) {
+        for (tx = 0; tx < 32; tx++) {
+            int k, any = 0;
+
+            if (strip->pal[ty][tx] < 0) {
+                continue;
+            }
+
+            for (y = 0; y < 8; y++) {
+                for (x = 0; x < 8; x += 2) {
+                    u8 lo = strip->px[(ty * 8 + y) * 256 + tx * 8 + x], hi = strip->px[(ty * 8 + y) * 256 + tx * 8 + x + 1];
+
+                    tile[y * 4 + x / 2] = lo | (hi << 4);
+                    any |= lo | hi;
+                }
+            }
+
+            if (!any) {
+                continue;
+            }
+
+            for (k = first; k < *next && memcmp(&made[(k - first) * 32], tile, 32) != 0; k++) {
+            }
+
+            if (k == *next) {
+                if (*next > last) {
+                    continue; // (no room: left out)
+                }
+
+                memcpy(&made[(k - first) * 32], tile, 32);
+                (*next)++;
+            }
+
+            map[(strip->y0 / 8 + ty) * 32 + tx] = k | (strip->pal[ty][tx] << 12);
+        }
+    }
+
+    if (*next > first) {
+        DC_FlushRange(made, (*next - first) * 32);
+        Bg_LoadTiles(panel->bgConfig, layer, made, (*next - first) * 32, first);
+    }
+
+    Heap_Free(made);
+}
+
+static int SavePanel_Luma(u16 c)
+{
+    return (c & 31) * 30 + ((c >> 5) & 31) * 59 + ((c >> 10) & 31) * 11;
+}
+
+// A badge of the badge case's, halved crisply (see above): its 64 x 64
+// sprite's pixels (4 bits each, 1D) and its clean palette.
+static void SavePanel_HalveBadge(const u8 *tiles, const u16 *pal, SavePanelBadge *out)
+{
+    static u8 src[64][64];
+    static u8 peel[64 * 64 * 2];
+    int x, y, i, j, x0 = 64, y0 = 64, x1 = -1, y1 = -1, n = 0, w, h, sw, sh, pass;
+    int counts[16], best = -1;
+
+    for (y = 0; y < 64; y++) {
+        for (x = 0; x < 64; x++) {
+            u8 b = tiles[((y / 8) * 8 + x / 8) * 32 + (y % 8) * 4 + (x % 8) / 2];
+
+            src[y][x] = (x & 1) ? b >> 4 : b & 15;
+        }
+    }
+
+    // The case's mounting round it peeled off (its grey ring and light rim:
+    // the badge's own colours inside), a ring at a time, two at most.
+    for (pass = 0; pass < 2; pass++) {
+        n = 0;
+
+        for (y = 0; y < 64; y++) {
+            for (x = 0; x < 64; x++) {
+                u16 c = pal[src[y][x]];
+                BOOL rim = c == GX_RGB(98 >> 3, 98 >> 3, 98 >> 3) || c == GX_RGB(172 >> 3, 189 >> 3, 197 >> 3) || c == GX_RGB(31, 31, 31)
+                    || c == GX_RGB(230 >> 3, 255 >> 3, 255 >> 3) || c == GX_RGB(214 >> 3, 247 >> 3, 255 >> 3);
+                BOOL edge = x == 0 || y == 0 || x == 63 || y == 63 || !src[y][x - 1] || !src[y][x + 1] || !src[y - 1][x] || !src[y + 1][x];
+
+                if (src[y][x] && rim && edge) {
+                    peel[n++] = (u8)y;
+                    peel[n++] = (u8)x;
+                }
+            }
+        }
+
+        for (i = 0; i < n; i += 2) {
+            src[peel[i]][peel[i + 1]] = 0;
+        }
+
+        if (n == 0) {
+            break;
+        }
+    }
+
+    for (y = 0; y < 64; y++) {
+        for (x = 0; x < 64; x++) {
+            if (src[y][x]) {
+                x0 = x < x0 ? x : x0, x1 = x > x1 ? x : x1;
+                y0 = y < y0 ? y : y0, y1 = y > y1 ? y : y1;
+            }
+        }
+    }
+
+    memset(out, 0, sizeof(*out));
+    memcpy(out->rgb, pal, sizeof(out->rgb));
+
+    if (x1 < 0) {
+        return;
+    }
+
+    w = x1 - x0 + 1, h = y1 - y0 + 1;
+    sw = (w + 1) / 2, sh = (h + 1) / 2;
+    out->w = sw > 32 ? 32 : sw;
+    out->h = sh > 32 ? 32 : sh;
+
+    // Each 2 x 2 its commonest colour, a tie to the darker; kept where at
+    // least half of it is badge.
+    for (j = 0; j < out->h; j++) {
+        for (i = 0; i < out->w; i++) {
+            int seen = 0, a, b, c, pick = 0;
+
+            memset(counts, 0, sizeof(counts));
+
+            for (a = 0; a < 2; a++) {
+                for (b = 0; b < 2; b++) {
+                    if (2 * i + a < w && 2 * j + b < h && (c = src[y0 + 2 * j + b][x0 + 2 * i + a]) != 0) {
+                        counts[c]++, seen++;
+                    }
+                }
+            }
+
+            if (seen < 2) {
+                continue;
+            }
+
+            for (c = 1; c < 16; c++) {
+                if (counts[c] > counts[pick] || (counts[c] == counts[pick] && counts[c] > 0 && SavePanel_Luma(pal[c]) < SavePanel_Luma(pal[pick]))) {
+                    pick = c;
+                }
+            }
+
+            out->px[j][i] = (u8)pick;
+        }
+    }
+
+    // Its outline: the darkest colour used 3 times or more in its outer two
+    // pixels.
+    memset(counts, 0, sizeof(counts));
+
+    for (y = y0; y <= y1; y++) {
+        for (x = x0; x <= x1; x++) {
+            int dy, dx;
+            BOOL near = FALSE;
+
+            if (!src[y][x]) {
+                continue;
+            }
+
+            for (dy = -2; dy <= 2 && !near; dy++) {
+                for (dx = -2; dx <= 2 && !near; dx++) {
+                    int yy = y + dy, xx = x + dx;
+
+                    if ((dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy) > 2) {
+                        continue;
+                    }
+
+                    near = yy < 0 || xx < 0 || yy > 63 || xx > 63 || !src[yy][xx];
+                }
+            }
+
+            if (near) {
+                counts[src[y][x]]++;
+            }
+        }
+    }
+
+    for (i = 1; i < 16; i++) {
+        if (counts[i] >= 3 && (best < 0 || SavePanel_Luma(pal[i]) < SavePanel_Luma(pal[best]))) {
+            best = i;
+        }
+    }
+
+    if (best < 0) {
+        return;
+    }
+
+    {
+        static u8 edge[32][32];
+
+        memset(edge, 0, sizeof(edge));
+
+        for (j = 0; j < out->h; j++) {
+            for (i = 0; i < out->w; i++) {
+                edge[j][i] = out->px[j][i]
+                    && (i == 0 || j == 0 || i == out->w - 1 || j == out->h - 1 || !out->px[j][i - 1] || !out->px[j][i + 1] || !out->px[j - 1][i] || !out->px[j + 1][i]);
+            }
+        }
+
+        for (j = 0; j < out->h; j++) {
+            for (i = 0; i < out->w; i++) {
+                if (edge[j][i]) {
+                    out->px[j][i] = (u8)best;
+                }
+            }
+        }
+    }
+}
+
+// The badges: halved, their colours packed into four palettes (two badges
+// a palette, as their colours fit), drawn into the strips, every other
+// one in the other layer's; the ones not earned yet their pale outline.
+static void SavePanel_DrawBadges(SavePanel *panel, NARC *narc, SavePanelStrip *strips[2], TrainerInfo *trainerInfo)
+{
+    static const u32 badgePals[MAX_BADGES] = {
+        coal_badge_NCLR, forest_badge_NCLR, cobble_badge_NCLR, fen_badge_NCLR,
+        relic_badge_NCLR, mine_badge_NCLR, icicle_badge_NCLR, beacon_badge_NCLR
+    };
+    NNSG2dCharacterData *charData;
+    void *charBuf = Graphics_GetCharDataFromOpenNARC(narc, badge_case_sprites_NCGR, FALSE, &charData, SAVE_PANEL_HEAP);
+    SavePanelBadge *badges = Heap_Alloc(SAVE_PANEL_HEAP, sizeof(SavePanelBadge) * MAX_BADGES);
+    u16 packed[4][16];
+    int packedCount[4] = { 1, 1, 1, 1 }, sumW = 0, k, i, j, slots = 0;
+    u8 remap[MAX_BADGES][16];
+    s8 badgePal[MAX_BADGES];
+    fx32 x, gap;
+
+    for (k = 0; k < MAX_BADGES; k++) {
+        NNSG2dPaletteData *palData;
+        void *palBuf = Graphics_GetPlttDataFromOpenNARC(narc, badgePals[k], &palData, SAVE_PANEL_HEAP);
+
+        SavePanel_HalveBadge((const u8 *)charData->pRawData + k * 64 * 32, palData->pRawData, &badges[k]);
+        Heap_Free(palBuf);
+        sumW += badges[k].w;
+    }
+
+    Heap_Free(charBuf);
+    memset(packed, 0, sizeof(packed));
+
+    // (each earned badge's colours into the first palette they fit in)
+    for (k = 0; k < MAX_BADGES; k++) {
+        BOOL used[16];
+
+        badgePal[k] = -1;
+        memset(remap[k], 0, sizeof(remap[k]));
+
+        if (!TrainerInfo_HasBadge(trainerInfo, k)) {
+            continue;
+        }
+
+        memset(used, 0, sizeof(used));
+
+        for (j = 0; j < badges[k].h; j++) {
+            for (i = 0; i < badges[k].w; i++) {
+                used[badges[k].px[j][i]] = TRUE;
+            }
+        }
+
+        for (slots = 0; slots < 4 && badgePal[k] < 0; slots++) {
+            int need = 0, c, m;
+
+            for (c = 1; c < 16; c++) {
+                if (used[c]) {
+                    for (m = 1; m < packedCount[slots] && packed[slots][m] != badges[k].rgb[c]; m++) {
+                    }
+
+                    need += m == packedCount[slots];
+                }
+            }
+
+            if (packedCount[slots] + need > 16) {
+                continue;
+            }
+
+            for (c = 1; c < 16; c++) {
+                if (used[c]) {
+                    for (m = 1; m < packedCount[slots] && packed[slots][m] != badges[k].rgb[c]; m++) {
+                    }
+
+                    if (m == packedCount[slots]) {
+                        packed[slots][packedCount[slots]++] = badges[k].rgb[c];
+                    }
+
+                    remap[k][c] = (u8)m;
+                }
+            }
+
+            badgePal[k] = (s8)slots;
+        }
+    }
+
+    for (slots = 0; slots < 4; slots++) {
+        SavePanel_LoadColours(packed[slots], sSavePanelBadgePals[slots]);
+    }
+
+    // (as the mock-up has them: from x 14, spread over 227 pixels)
+    gap = (FX32_ONE * (227 - sumW)) / 7;
+    x = FX32_ONE * 14;
+
+    for (k = 0; k < MAX_BADGES; k++) {
+        SavePanelStrip *strip = strips[k & 1];
+        int X = FX_Whole(x + FX32_ONE / 2), Y = SP_BADGE_Y + (24 - badges[k].h) / 2;
+
+        for (j = 0; j < badges[k].h; j++) {
+            for (i = 0; i < badges[k].w; i++) {
+                u8 c = badges[k].px[j][i];
+
+                if (!c) {
+                    continue;
+                }
+
+                if (badgePal[k] >= 0) {
+                    SavePanel_StripPut(strip, X + i, Y + j, remap[k][c], (s8)sSavePanelBadgePals[badgePal[k]]);
+                } else if (!TrainerInfo_HasBadge(trainerInfo, k)) {
+                    BOOL edge = i == 0 || j == 0 || i == badges[k].w - 1 || j == badges[k].h - 1 || !badges[k].px[j][i - 1]
+                        || !badges[k].px[j][i + 1] || !badges[k].px[j - 1][i] || !badges[k].px[j + 1][i];
+
+                    SavePanel_StripPut(strip, X + i, Y + j, edge ? 1 : 2, SP_PAL_PALE);
+                }
+            }
+        }
+
+        x += FX32_CONST(badges[k].w) + gap;
+    }
+
+    Heap_Free(badges);
+}
