+                    dirsZ[numZ++] = dir;
+                }
             }
 
             for (int dir = -1; dir <= 1 && Port_ExtrudedBesideScenery(header); dir += 2) {
@@ -6662,7 +6664,7 @@ static void Port_RenderForestOnSouth(const LandDataManager *landDataMan)
