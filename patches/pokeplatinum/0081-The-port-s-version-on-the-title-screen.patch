From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Thu, 5 Nov 2026 12:30:00 -0700
Subject: [PATCH] The port's version on the title screen (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The title screen's lower screen has "Developed by GAME FREAK inc." in
its corner, on a layer of its own (the copyright layer, BG1: rows 22 and
23 of its map). Now that line is taken away, and the port's version is
written there in its white (palette 1, index 15, the grey round the
letters 13), in the game's font: PORT_VERSION (the Makefile's: git's
name for the commit built, as v0.1.0-alpha.1-154-g4f7152a; a release's
tag alone, as v0.1.1). With no version known, the line is taken away
alone.

---
diff --git a/src/applications/title_screen.c b/src/applications/title_screen.c
index ee5774cb..3d18ade4 100644
--- a/src/applications/title_screen.c
+++ b/src/applications/title_screen.c
@@ -175,6 +175,10 @@ typedef struct TitleScreen {
         u16 blinkCounter;
     };
     Window pressStartWindow;
+#ifdef SDK_PORT_3DS
+    Window portVersionWindow; // (TitleScreen_PortShowVersion)
+    BOOL portVersionShown;
+#endif
     VecFx32 titleCamTarget;
     VecFx32 titleCamPos;
     BOOL enableInputs;
@@ -1283,6 +1287,88 @@ static BOOL TitleScreen_ReleaseGfx(TitleScreen *titleScreen, BgConfig *bgConfig,
     return TRUE;
 }
 
+#ifdef SDK_PORT_3DS
+// (the 3DS remaster) The port's version (PORT_VERSION, the Makefile's: git's
+// name for the commit built, a release's tag alone) where the DS's title
+// screen has "Developed by GAME FREAK inc.": that line taken away from its
+// layer, and the version written there in the line's white, at its corner of
+// the lower screen. With no version known, the line taken away alone.
+#ifndef PORT_VERSION
+#define PORT_VERSION ""
+#endif
+
+static void TitleScreen_PortLetters(String *string, const char *letters)
+{
+    String_Clear(string);
+
+    for (; *letters; letters++) {
+        int c = (unsigned char)*letters;
+        charcode_t code;
+
+        if (c >= 'A' && c <= 'Z') {
+            code = 0x12B + (c - 'A');
+        } else if (c >= 'a' && c <= 'z') {
+            code = 0x145 + (c - 'a');
+        } else if (c >= '0' && c <= '9') {
+            code = 0x121 + (c - '0');
+        } else {
+            switch (c) {
+            case ' ':
+                code = 0x1DE;
+                break;
+            case '.':
+                code = 0x1AE;
+                break;
+            case '-':
+                code = 0x1BE;
+                break;
+            case '+':
+                code = 0x1BD;
+                break;
+            case '/':
+                code = 0x1B1;
+                break;
+            case '(':
+                code = 0x1B9;
+                break;
+            case ')':
+                code = 0x1BA;
+                break;
+            default:
+                continue;
+            }
+        }
+
+        String_AppendChar(string, code);
+    }
+}
+
+static void TitleScreen_PortShowVersion(BgConfig *bgConfig, enum HeapID heapID, TitleScreen *titleScreen)
+{
+    String *text;
+
+    // ("Developed by GAME FREAK inc.": the layer's rows 22 and 23)
+    Bg_FillTilemapRect(bgConfig, TITLE_SCREEN_LAYER_COPYRIGHT, 0, 0, 0, 32, 24, 0);
+    Bg_CopyTilemapBufferToVRAM(bgConfig, TITLE_SCREEN_LAYER_COPYRIGHT);
+    titleScreen->portVersionShown = FALSE;
+
+    if (PORT_VERSION[0] == '\0') {
+        return;
+    }
+
+    // (its palette, 1: index 15 its white, 13 the grey round its letters)
+    Window_Add(bgConfig, &titleScreen->portVersionWindow, TITLE_SCREEN_LAYER_COPYRIGHT, 0, 22, 32, 2, 1, 1);
+    Window_FillTilemap(&titleScreen->portVersionWindow, 0);
+    titleScreen->portVersionShown = TRUE;
+
+    text = String_Init(64, heapID);
+    TitleScreen_PortLetters(text, PORT_VERSION);
+    Text_AddPrinterWithParamsAndColor(&titleScreen->portVersionWindow, FONT_SYSTEM, text, 4, 0, TEXT_SPEED_NO_TRANSFER, TEXT_COLOR(15, 13, 0), NULL);
+    Window_CopyToVRAM(&titleScreen->portVersionWindow);
+    String_Free(text);
+}
+#endif
+
 static void TitleScreen_Load2DGfx(BgConfig *bgConfig, enum HeapID heapID, TitleScreen *titleScreen)
 {
     // Borders
@@ -1307,6 +1393,9 @@ static void TitleScreen_Load2DGfx(BgConfig *bgConfig, enum HeapID heapID, TitleS
     Graphics_LoadTilesToBgLayer(NARC_INDEX_DEMO__TITLE__TITLEDEMO, gf_presents_NCGR, bgConfig, TITLE_SCREEN_LAYER_COPYRIGHT, 0, 0, FALSE, heapID);
     Graphics_LoadTilemapToBgLayer(NARC_INDEX_DEMO__TITLE__TITLEDEMO, gf_presents_NSCR, bgConfig, TITLE_SCREEN_LAYER_COPYRIGHT, 0, 0, FALSE, heapID);
     Graphics_LoadPalette(NARC_INDEX_DEMO__TITLE__TITLEDEMO, gf_presents_NCLR, PAL_LOAD_MAIN_BG, PLTT_OFFSET(1), 3 * PALETTE_SIZE_BYTES, heapID);
+#ifdef SDK_PORT_3DS
+    TitleScreen_PortShowVersion(bgConfig, heapID, titleScreen);
+#endif
 
     Bg_MaskPalette(TITLE_SCREEN_LAYER_GIRATINA, COLOR_BLACK);
     Bg_MaskPalette(TITLE_SCREEN_LAYER_PRESS_START, COLOR_BLACK);
@@ -1351,6 +1440,12 @@ static void TitleScreen_Load2DGfx(BgConfig *bgConfig, enum HeapID heapID, TitleS
 static void TitleScreen_Release2DGfx(BgConfig *bgConfig, enum HeapID heapID, TitleScreen *titleScreen)
 {
     Window_Remove(&titleScreen->pressStartWindow);
+#ifdef SDK_PORT_3DS
+    if (titleScreen->portVersionShown) {
+        Window_Remove(&titleScreen->portVersionWindow);
+        titleScreen->portVersionShown = FALSE;
+    }
+#endif
 }
 
 static void TitleScreen_UpdateLight1(TitleScreen *titleScreen)
