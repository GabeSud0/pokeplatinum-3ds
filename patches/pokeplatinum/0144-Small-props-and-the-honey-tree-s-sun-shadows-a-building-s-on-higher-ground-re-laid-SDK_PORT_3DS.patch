+// (x, z inside one of the hull's parts, in the model's own coordinates)
+static BOOL MapProp_PortInHull(const PortHull *hull, s64 x, s64 z)
+{
+    u32 part, k;
+
+    for (part = 0; part < hull->parts; part++) {
+        int sign = 0;
+        BOOL inside = hull->count[part] >= 3;
+
+        for (k = 0; k < hull->count[part] && inside; k++) {
+            const s32 *a = hull->corners[part][k], *b = hull->corners[part][(k + 1) % hull->count[part]];
+            s64 cross = (s64)(b[0] - a[0]) * (z - a[1]) - (s64)(b[1] - a[1]) * (x - a[0]);
+            int sgn = cross > 0 ? 1 : cross < 0 ? -1 : 0;
+
+            if (sgn != 0) {
+                if (sign == 0) {
+                    sign = sgn;
+                } else if (sgn != sign) {
+                    inside = FALSE;
+                }
+            }
+        }
+
+        if (inside) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
