From d2b7fbddeeae1b5241dcbc5e844599d0f1bbea27 Mon Sep 17 00:00:00 2001
From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Sun, 25 Oct 2026 08:00:00 -0700
Subject: [PATCH] The save's pose taken off when the player walks
 (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The player's save pose (seen from behind) stayed on after a save on the
3DS: the player walked about seen from behind whichever way he went,
until the field was made again. The save's script puts the pose on
(ScrCmd_258) and takes it off (ScrCmd_259) through a task; without that
task, or with ScrCmd_259 missed, it stays.

- ov5_021E0EEC (called as the player starts a step) takes the save's
  poses off as it does the Pokétch's, ending the pose's task if it's
  still on, and logs it.
- ov5_021E0F54 logs when the pose's task can't start, and frees its data.
- ScrCmd_259 takes the pose off without a task as well, and forgets the
  task once ended.
---
 src/overlay005/ov5_021DFB54.c | 65 +++++++++++++++++++++++++++++++++++
 src/scrcmd.c                  | 10 ++++++
 2 files changed, 75 insertions(+)

diff --git a/src/overlay005/ov5_021DFB54.c b/src/overlay005/ov5_021DFB54.c
index 85afac38..1e8c2903 100644
--- a/src/overlay005/ov5_021DFB54.c
+++ b/src/overlay005/ov5_021DFB54.c
@@ -49,6 +49,32 @@
 #include "system.h"
 #include "unk_020655F4.h"
 
+#ifdef SDK_PORT_3DS
+#include "generated/object_events_gfx.h"
+
+extern void NitroPort_Log(const char *fmt, ...);
+
+// The player's sprites while saving (Player_GetSpriteFromStateAndGender:
+// PLAYER_AVATAR_SAVE, _26 in the Distortion World, _29 in Hearthome's gym).
+static BOOL PortPlayer_IsSavePose(int graphicsID)
+{
+    switch (graphicsID) {
+    case OBJ_EVENT_GFX_PLAYER_M_SAVE:
+    case OBJ_EVENT_GFX_PLAYER_F_SAVE:
+    case OBJ_EVENT_GFX_DIST_WORLD_PLAYER_M_SAVE:
+    case OBJ_EVENT_GFX_DIST_WORLD_PLAYER_F_SAVE:
+    case OBJ_EVENT_GFX_PLAYER_M_SAVE_HEARTHOME_GYM:
+    case OBJ_EVENT_GFX_PLAYER_F_SAVE_HEARTHOME_GYM:
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+// The save's pose's task while it's on (ov5_021E0F54 to ov5_021E0FC0).
+static SysTask *sPortSavePoseTask;
+#endif
+
 typedef struct MonRideTask {
     BOOL playCutIn;
     int playerGender;
@@ -1617,6 +1643,29 @@ void ov5_021E0EEC(PlayerAvatar *playerAvatar)
     {
         int v2 = MapObject_GetGraphicsID(v0);
 
+#ifdef SDK_PORT_3DS
+        // The save's pose (the player seen from behind) as well: it stayed
+        // on after a save on the 3DS, the player walking about seen from
+        // behind whichever way he went, till the field was made again (the
+        // bag). Only the save's script puts it on and takes it off
+        // (ScrCmd_258 / ScrCmd_259), the player standing still: left on
+        // when he walks (or at ScrCmd_259 without the pose's task).
+        if (PortPlayer_IsSavePose(v2)) {
+            SysTask *task = sPortSavePoseTask;
+            BOOL withTask = task != NULL && task->callback == ov5_021E0FF0
+                && ((UnkStruct_ov5_021E0FF0 *)task->param)->playerAvatar == playerAvatar;
+
+            NitroPort_Log("[player] the save's pose left on%s: back to walking (%d of %d tasks in use)",
+                withTask ? ", its task still on" : "", gSystem.mainTaskMgr->stackPointer, gSystem.mainTaskMgr->maxTasks);
+
+            if (withTask) {
+                ov5_021E0FC0(task); // (the walking sprite back, the task ended)
+                return;
+            }
+
+            sPortSavePoseTask = NULL;
+        } else
+#endif
         if ((v2 != 0xc4) && (v2 != 0xc5) && (v2 != 0x10e) && (v2 != 0x10f) && (v2 != 0x112) && (v2 != 0x113)) {
             return;
         }
@@ -1656,6 +1705,16 @@ static SysTask *ov5_021E0F54(FieldSystem *fieldSystem, u32 param1)
 
         v2 = SysTask_Start(ov5_021E0FF0, v4, 0xffff);
         GF_ASSERT(v2 != NULL);
+#ifdef SDK_PORT_3DS
+        // (without its task the pose isn't taken off at the end: ScrCmd_259
+        // gets NULL; ov5_021E0EEC takes it off at the first step)
+        if (v2 == NULL) {
+            NitroPort_Log("[player] the save's pose has no task (%d of %d tasks in use)",
+                gSystem.mainTaskMgr->stackPointer, gSystem.mainTaskMgr->maxTasks);
+            Heap_Free(v4);
+        }
+        sPortSavePoseTask = v2;
+#endif
 
         return v2;
     }
@@ -1667,6 +1726,12 @@ static void ov5_021E0FC0(SysTask *param0)
         return;
     }
 
+#ifdef SDK_PORT_3DS
+    if (param0 == sPortSavePoseTask) {
+        sPortSavePoseTask = NULL;
+    }
+#endif
+
     {
         UnkStruct_ov5_021E0FF0 *v0 = SysTask_GetParam(param0);
         PlayerAvatar *playerAvatar = v0->playerAvatar;
diff --git a/src/scrcmd.c b/src/scrcmd.c
index 659a6d58..fd62736c 100644
--- a/src/scrcmd.c
+++ b/src/scrcmd.c
@@ -6391,7 +6391,17 @@ static BOOL ScrCmd_259(ScriptContext *ctx)
 {
     SysTask **v0 = FieldSystem_GetScriptMemberPtr(ctx->fieldSystem, SCRIPT_MANAGER_PLAYER_TASK);
 
+#ifdef SDK_PORT_3DS
+    // (the pose put on without its task, ov5_021E0F54: off all the same)
+    if (*v0 == NULL) {
+        ov5_021E0EEC(ctx->fieldSystem->playerAvatar);
+        return TRUE;
+    }
+#endif
     ov5_021E100C(*v0);
+#ifdef SDK_PORT_3DS
+    *v0 = NULL;
+#endif
     return TRUE;
 }
 
-- 
