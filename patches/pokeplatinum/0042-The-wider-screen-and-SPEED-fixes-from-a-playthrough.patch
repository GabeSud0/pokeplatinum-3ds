+#ifdef SDK_PORT_3DS
+// The 3DS remaster's wider upper screen shows 2 tiles more each side than
+// the DS's. The scripts place the people who walk on (Dawn with the bag,
+// the rival, Looker) and send off the ones who leave (Rowan and Dawn,
+// Roark) just past the DS's edge, where nobody saw them: there they
+// popped into view, vanished, or walked through what's in the way, in the
+// wider picture's sides. So:
+//   one added beside the DS's picture, but not beyond the wider one's, is
+//     put beyond it and walks the extra tiles in with its first steps;
+//   one whose walk out ends there walks the extra tiles out before the
+//     script takes it away;
+//   one walking out through something in the way beside the DS's picture
+//     goes round it (outwards first, else up, else down) to beyond the
+//     wider picture.
+// Where it stays instead (it doesn't walk in, or isn't taken away), it goes
+// back where the script put it.
+
+#include "map_tile_behavior.h"
+#include "terrain_collision_manager.h"
+
+extern int NitroPort_WideScreenExtra(void);
+
+#define PORT_WIDE_DS_TILES      8  // from the middle of the picture to the DS's edge (tile 8 half on it)
+#define PORT_WIDE_SENT_TILES    9  // a walk out ending here or further: off the DS's picture
+#define PORT_WIDE_TOP_TILES     9  // above the middle, beyond the top of the picture
+#define PORT_WIDE_BOTTOM_TILES  8  // below it, beyond the bottom
+#define PORT_WIDE_SCRIPTED_MAX  8
+#define PORT_WIDE_PATH_MAX      48 // steps of a way round
+#define PORT_WIDE_SEARCH_MAX    512
+
+enum PortWideScriptedKind {
+    PORT_WIDE_ADDED = 1, // put further out: walks in further
+    PORT_WIDE_SENT,      // walked further out, or round
+};
+
+typedef struct PortWideScripted {
+    MapObject *mapObj;
+    u16 localID;
+    u16 mapHeaderID;
+    s8 shiftX, shiftZ; // tiles it was moved (east, south +), to be undone if it stays
+    u8 kind;
+} PortWideScripted;
+
+static PortWideScripted sPortWideScripted[PORT_WIDE_SCRIPTED_MAX];
+
+// The walks, a row a speed: north, south, west, east (DIR_*).
+static const u16 sPortWideWalks[][4] = {
+    { MOVEMENT_ACTION_WALK_SLOWER_NORTH, MOVEMENT_ACTION_WALK_SLOWER_SOUTH, MOVEMENT_ACTION_WALK_SLOWER_WEST, MOVEMENT_ACTION_WALK_SLOWER_EAST },
+    { MOVEMENT_ACTION_WALK_SLOW_NORTH, MOVEMENT_ACTION_WALK_SLOW_SOUTH, MOVEMENT_ACTION_WALK_SLOW_WEST, MOVEMENT_ACTION_WALK_SLOW_EAST },
+    { MOVEMENT_ACTION_WALK_NORMAL_NORTH, MOVEMENT_ACTION_WALK_NORMAL_SOUTH, MOVEMENT_ACTION_WALK_NORMAL_WEST, MOVEMENT_ACTION_WALK_NORMAL_EAST },
+    { MOVEMENT_ACTION_WALK_FAST_NORTH, MOVEMENT_ACTION_WALK_FAST_SOUTH, MOVEMENT_ACTION_WALK_FAST_WEST, MOVEMENT_ACTION_WALK_FAST_EAST },
+    { MOVEMENT_ACTION_WALK_FASTER_NORTH, MOVEMENT_ACTION_WALK_FASTER_SOUTH, MOVEMENT_ACTION_WALK_FASTER_WEST, MOVEMENT_ACTION_WALK_FASTER_EAST },
+    { MOVEMENT_ACTION_WALK_SLIGHTLY_FAST_NORTH, MOVEMENT_ACTION_WALK_SLIGHTLY_FAST_SOUTH, MOVEMENT_ACTION_WALK_SLIGHTLY_FAST_WEST, MOVEMENT_ACTION_WALK_SLIGHTLY_FAST_EAST },
+    { MOVEMENT_ACTION_WALK_SLIGHTLY_FASTER_NORTH, MOVEMENT_ACTION_WALK_SLIGHTLY_FASTER_SOUTH, MOVEMENT_ACTION_WALK_SLIGHTLY_FASTER_WEST, MOVEMENT_ACTION_WALK_SLIGHTLY_FASTER_EAST },
+    { MOVEMENT_ACTION_WALK_FASTEST_NORTH, MOVEMENT_ACTION_WALK_FASTEST_SOUTH, MOVEMENT_ACTION_WALK_FASTEST_WEST, MOVEMENT_ACTION_WALK_FASTEST_EAST },
+    { MOVEMENT_ACTION_RUN_NORTH, MOVEMENT_ACTION_RUN_SOUTH, MOVEMENT_ACTION_RUN_WEST, MOVEMENT_ACTION_RUN_EAST },
+    { MOVEMENT_ACTION_WALK_EVER_SO_SLIGHTLY_FAST_NORTH, MOVEMENT_ACTION_WALK_EVER_SO_SLIGHTLY_FAST_SOUTH, MOVEMENT_ACTION_WALK_EVER_SO_SLIGHTLY_FAST_WEST, MOVEMENT_ACTION_WALK_EVER_SO_SLIGHTLY_FAST_EAST },
+};
+
+// A walk's speed (its row) and direction (DIR_*), or FALSE.
+static BOOL ScrCmd_PortWalk(u16 action, int *speed, int *dir)
+{
+    int i, j;
+
+    for (i = 0; i < (int)NELEMS(sPortWideWalks); i++) {
+        for (j = 0; j < 4; j++) {
+            if (action == sPortWideWalks[i][j]) {
+                *speed = i;
+                *dir = j;
+                return TRUE;
+            }
+        }
+    }
+
+    return FALSE;
+}
+
+// A wait or a turn on the spot (no step).
+static BOOL ScrCmd_PortWideStill(u16 action)
+{
+    return (action >= MOVEMENT_ACTION_FACE_NORTH && action <= MOVEMENT_ACTION_FACE_EAST)
+        || (action >= MOVEMENT_ACTION_DELAY_1 && action <= MOVEMENT_ACTION_DELAY_32)
+        || (action >= MOVEMENT_ACTION_WALK_ON_SPOT_SLOWER_NORTH && action <= MOVEMENT_ACTION_WALK_ON_SPOT_FASTER_EAST)
+        || action == MOVEMENT_ACTION_EMOTE_EXCLAMATION_MARK;
+}
+
+// A step east (1) or west (-1), else 0.
+static int ScrCmd_PortWalkDx(u16 action)
+{
+    int speed, dir;
+
+    if (!ScrCmd_PortWalk(action, &speed, &dir)) {
+        return 0;
+    }
+
+    return dir == DIR_EAST ? 1 : dir == DIR_WEST ? -1 : 0;
+}
+
+// Beyond the wider picture's edge, the sprite's width and the view's
+// perspective (more shows at the top) counted: in tiles from its middle.
+// 0 on the DS's screen.
+static int ScrCmd_PortWideOutTiles(void)
+{
+    int extra = NitroPort_WideScreenExtra();
+
+    return extra > 0 ? PORT_WIDE_DS_TILES + (extra + 15) / 16 + 2 : 0;
+}
+
+// The picture's middle (the camera's target), in tiles.
+static void ScrCmd_PortWideMiddle(FieldSystem *fieldSystem, int *x, int *z)
+{
+    VecFx32 target = Camera_GetTarget(fieldSystem->camera);
+
+    *x = target.x / (16 * FX32_ONE);
+    *z = target.z / (16 * FX32_ONE);
+}
+
+static BOOL ScrCmd_PortWideEligible(FieldSystem *fieldSystem, MapObject *mapObj)
+{
+    MapObject **cameraObject = FieldSystem_GetScriptMemberPtr(fieldSystem, SCRIPT_MANAGER_CAMERA_OBJECT);
+
+    return mapObj != NULL && mapObj != PlayerAvatar_GetMapObject(fieldSystem->playerAvatar) && mapObj != *cameraObject;
+}
+
+static void ScrCmd_PortWideNudge(MapObject *mapObj, int tilesX, int tilesZ)
+{
+    VecFx32 pos;
+
+    if (tilesX == 0 && tilesZ == 0) {
+        return;
+    }
+
+    MapObject_GetPosPtr(mapObj, &pos);
+    pos.x += tilesX * (16 * FX32_ONE);
+    pos.z += tilesZ * (16 * FX32_ONE);
+    MapObject_SetPos(mapObj, &pos);
+    MapObject_SetX(mapObj, MapObject_GetX(mapObj) + tilesX);
+    MapObject_SetZ(mapObj, MapObject_GetZ(mapObj) + tilesZ);
+    MapObject_UpdateCoords(mapObj);
+    MapObject_RecalculateObjectHeight(mapObj);
+    MapObject_SetTileBehaviors(mapObj);
+
+    // Its sprite there now, not where it was till its own task's next turn:
+    // drawn a frame where the script put it (Rowan, Dawn, Looker flashed
+    // in the wider picture's side before walking in).
+    if (MapObject_CheckStatus(mapObj, MAP_OBJ_STATUS_14)) {
+        sub_02062B68(mapObj);
+    }
+}
+
+static PortWideScripted *ScrCmd_PortWideFind(FieldSystem *fieldSystem, MapObject *mapObj)
+{
+    int i;
+
+    for (i = 0; i < PORT_WIDE_SCRIPTED_MAX; i++) {
+        PortWideScripted *e = &sPortWideScripted[i];
+
+        if (e->kind != 0 && e->mapObj == mapObj) {
+            // (still that one: not taken away, the map not changed)
+            if (e->mapHeaderID == fieldSystem->location->mapHeaderID
+                && MapObjMan_LocalMapObjByIndex(fieldSystem->mapObjMan, e->localID) == mapObj) {
+                return e;
+            }
+
+            e->kind = 0;
+        }
+    }
+
+    return NULL;
+}
+
+static BOOL ScrCmd_PortWideRemember(FieldSystem *fieldSystem, MapObject *mapObj, int shiftX, int shiftZ, int kind)
+{
+    int i;
+
+    for (i = 0; i < PORT_WIDE_SCRIPTED_MAX; i++) {
+        PortWideScripted *e = &sPortWideScripted[i];
+
+        if (e->kind == 0) {
+            e->mapObj = mapObj;
+            e->localID = MapObject_GetLocalID(mapObj);
+            e->mapHeaderID = fieldSystem->location->mapHeaderID;
+            e->shiftX = shiftX;
+            e->shiftZ = shiftZ;
+            e->kind = kind;
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+static void ScrCmd_PortWideRemoved(MapObject *mapObj);
+
+static void ScrCmd_PortWideAdded(FieldSystem *fieldSystem, MapObject *mapObj)
+{
+    int out = ScrCmd_PortWideOutTiles(), midX, midZ, dx, shift;
+
+    // (a new object, wherever an old one was)
+    ScrCmd_PortWideRemoved(mapObj);
+
+    if (out == 0 || !ScrCmd_PortWideEligible(fieldSystem, mapObj)) {
+        return;
+    }
+
+    ScrCmd_PortWideMiddle(fieldSystem, &midX, &midZ);
+    dx = MapObject_GetX(mapObj) - midX;
+
+    if (dx >= PORT_WIDE_DS_TILES && dx < out) {
+        shift = out - dx;
+    } else if (-dx >= PORT_WIDE_DS_TILES && -dx < out) {
+        shift = -(out + dx);
+    } else {
+        return;
+    }
+
+    if (ScrCmd_PortWideRemember(fieldSystem, mapObj, shift, 0, PORT_WIDE_ADDED)) {
+        ScrCmd_PortWideNudge(mapObj, shift, 0);
+    }
+}
+
+// Something in the way of a step from (x, z), at height y, towards dir:
+// the ground (its collision, a ledge or a one-way tile, a cliff), not the
+// other people (they walk out together). The height there to *y.
+static BOOL ScrCmd_PortWideBlocked(FieldSystem *fieldSystem, int x, int z, fx32 *y, int dir)
+{
+    static BOOL (*const leaving[4])(u8) = {
+        TileBehavior_BlocksMovementNorthward,
+        TileBehavior_BlocksMovementSouthward,
+        TileBehavior_BlocksMovementWestward,
+        TileBehavior_BlocksMovementEastward
+    };
+    static BOOL (*const entering[4])(u8) = {
+        TileBehavior_BlocksMovementSouthward,
+        TileBehavior_BlocksMovementNorthward,
+        TileBehavior_BlocksMovementEastward,
+        TileBehavior_BlocksMovementWestward
+    };
+    VecFx32 pos;
+    int toX = x + MapObject_GetDxFromDir(dir), toZ = z + MapObject_GetDzFromDir(dir);
+    u8 from = TerrainCollisionManager_GetTileBehavior(fieldSystem, x, z);
+    u8 to = TerrainCollisionManager_GetTileBehavior(fieldSystem, toX, toZ);
+    u8 source;
+    fx32 height;
+
+    pos.x = MAP_OBJECT_COORD_CENTER_TO_FX32(x);
+    pos.y = *y;
+    pos.z = MAP_OBJECT_COORD_CENTER_TO_FX32(z);
+
+    if (to == GetNullTileBehaviorID() || leaving[dir](from) || entering[dir](to)
+        || TerrainCollisionManager_WillMapObjectCollide(fieldSystem, &pos, toX, toZ, NULL)) {
+        return TRUE;
+    }
+
+    height = TerrainCollisionManager_GetHeight(fieldSystem, *y, MAP_OBJECT_COORD_CENTER_TO_FX32(toX), MAP_OBJECT_COORD_CENTER_TO_FX32(toZ), &source);
+
+    if (source != CALCULATED_HEIGHT_SOURCE_NONE) {
+        *y = height;
+    }
+
+    return FALSE;
+}
+
+typedef struct PortWidePathSearch {
+    FieldSystem *fieldSystem;
+    MapObject *mapObj;
+    int midX, midZ, out, outDir;
+    int nodes;
+    u8 path[PORT_WIDE_PATH_MAX];
+    u16 seen[PORT_WIDE_SEARCH_MAX];
+    int seenCount;
+} PortWidePathSearch;
+
+// The people the script sets walking together (its ApplyMovement commands
+// before a WaitMovement: the ones given theirs already, and the ones the
+// next commands give theirs). They walk out together: not in each other's
+// way.
+#define PORT_WIDE_WALKERS_MAX 8
+static MapObject *sPortWideWalkers[PORT_WIDE_WALKERS_MAX];
+static int sPortWideWalkerCount;
+
+static void ScrCmd_PortWideAddWalker(MapObject *mapObj)
+{
+    int i;
+
+    if (mapObj == NULL) {
+        return;
+    }
+
+    for (i = 0; i < sPortWideWalkerCount; i++) {
+        if (sPortWideWalkers[i] == mapObj) {
+            return;
+        }
+    }
+
+    if (sPortWideWalkerCount < PORT_WIDE_WALKERS_MAX) {
+        sPortWideWalkers[sPortWideWalkerCount++] = mapObj;
+    }
+}
+
+static BOOL ScrCmd_PortWideIsWalker(MapObject *mapObj)
+{
+    int i;
+
+    for (i = 0; i < sPortWideWalkerCount; i++) {
+        if (sPortWideWalkers[i] == mapObj) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+// ctx: at an ApplyMovement's end (its walker, mapObj). movementsGoing:
+// the walks not over yet (none: a new group).
+static void ScrCmd_PortWideNoteWalkers(ScriptContext *ctx, MapObject *mapObj, int movementsGoing)
+{
+    const u8 *next = ctx->scriptPtr;
+    int n;
+
+    if (movementsGoing == 0) {
+        sPortWideWalkerCount = 0;
+    }
+
+    ScrCmd_PortWideAddWalker(mapObj);
+
+    for (n = 0; n < PORT_WIDE_WALKERS_MAX; n++, next += 8) {
+        u16 command = (u16)(next[0] | (next[1] << 8));
+        u16 localID = (u16)(next[2] | (next[3] << 8));
+
+        if (command >= gNumFieldScriptCommands || gFieldScriptCommands[command] != ScrCmd_ApplyMovement) {
+            break;
+        }
+
+        ScrCmd_PortWideAddWalker(GetLocalMapObjByIndex(ctx->fieldSystem, FieldSystem_TryGetVar(ctx->fieldSystem, localID)));
+    }
+}
+
+// Someone standing on (x, z), not walking a script's way (they walk out
+// together), nor the walker or the player.
+static BOOL ScrCmd_PortWideSomeoneThere(FieldSystem *fieldSystem, MapObject *walker, int x, int z)
+{
+    MapObject *other;
+    MapObject *player = PlayerAvatar_GetMapObject(fieldSystem->playerAvatar);
+    int i = 0;
+
+    while (MapObjectMan_FindObjectWithStatus(fieldSystem->mapObjMan, &other, &i, MAP_OBJ_STATUS_0) == TRUE) {
+        if (other == walker || other == player || MapObject_CheckStatus(other, MAP_OBJ_STATUS_4)
+            || ScrCmd_PortWideIsWalker(other)) {
+            continue;
+        }
+
+        if ((MapObject_GetX(other) == x && MapObject_GetZ(other) == z)
+            || (MapObject_GetXPrev(other) == x && MapObject_GetZPrev(other) == z)) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+static u16 ScrCmd_PortWideKey(PortWidePathSearch *search, int x, int z)
+{
+    return (u16)(((x - search->midX + 64) & 0xFF) | (((z - search->midZ + 64) & 0xFF) << 8));
+}
+
+static BOOL ScrCmd_PortWideSeen(PortWidePathSearch *search, int x, int z)
+{
+    u16 key = ScrCmd_PortWideKey(search, x, z);
+    int i;
+
+    for (i = 0; i < search->seenCount; i++) {
+        if (search->seen[i] == key) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+static void ScrCmd_PortWideSee(PortWidePathSearch *search, int x, int z)
+{
+    if (search->seenCount < PORT_WIDE_SEARCH_MAX) {
+        search->seen[search->seenCount++] = ScrCmd_PortWideKey(search, x, z);
+    }
+}
+
+// A way out of the wider picture from (x, z), depth steps taken: outwards
+// first, else up, else down (never back), as far as it goes before
+// turning.
+static BOOL ScrCmd_PortWideFindWay(PortWidePathSearch *search, int x, int z, fx32 y, int depth)
+{
+    const int dirs[3] = { search->outDir, DIR_NORTH, DIR_SOUTH };
+    int dx = x - search->midX, dz = z - search->midZ, i;
+
+    if ((search->outDir == DIR_EAST ? dx : -dx) >= search->out || dz <= -PORT_WIDE_TOP_TILES || dz >= PORT_WIDE_BOTTOM_TILES) {
+        search->path[depth] = 0xFF;
+        return TRUE;
+    }
+
+    if (depth >= PORT_WIDE_PATH_MAX - 1 || ++search->nodes > PORT_WIDE_SEARCH_MAX) {
+        return FALSE;
+    }
+
+    for (i = 0; i < 3; i++) {
+        int toX = x + MapObject_GetDxFromDir(dirs[i]), toZ = z + MapObject_GetDzFromDir(dirs[i]);
+        fx32 toY = y;
+
+        // (entered from here, not just seen: a ledge's tile may be entered
+        // from another side)
+        if (ScrCmd_PortWideSeen(search, toX, toZ) || ScrCmd_PortWideBlocked(search->fieldSystem, x, z, &toY, dirs[i])
+            || ScrCmd_PortWideSomeoneThere(search->fieldSystem, search->mapObj, toX, toZ)) {
+            continue;
+        }
+
+        ScrCmd_PortWideSee(search, toX, toZ);
+        search->path[depth] = dirs[i];
+
+        if (ScrCmd_PortWideFindWay(search, toX, toZ, toY, depth + 1)) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+// The movement the script gave, changed for the wider screen (a heap copy,
+// freed with the movement: sub_02040F28), or NULL to use the script's.
+static MapObjectAnimCmd *ScrCmd_PortWideMovement(FieldSystem *fieldSystem, MapObject *mapObj, const MapObjectAnimCmd *cmds)
+{
+    PortWideScripted *e;
+    MapObjectAnimCmd *copy;
+    int count, i, last = -1, out = ScrCmd_PortWideOutTiles(), at, speed = 0, dir;
+    int midX, midZ, startX, startZ, x, endX, endDx;
+    BOOL straight = TRUE;
+    int lead = -1;
+
+    if (out == 0 || !ScrCmd_PortWideEligible(fieldSystem, mapObj)) {
+        return NULL;
+    }
+
+    for (count = 0; cmds[count].movementAction != MOVEMENT_ACTION_END; count++) {
+        if (count >= 254) {
+            return NULL;
+        }
+    }
+
+    e = ScrCmd_PortWideFind(fieldSystem, mapObj);
+
+    if (e != NULL) {
+        int shiftX = e->shiftX, shiftZ = e->shiftZ;
+
+        e->kind = 0;
+
+        // Put further out when added: walking in, it walks in from there.
+        if (shiftZ == 0 && shiftX != 0 && count > 0 && cmds[0].count > 0 && ScrCmd_PortWalkDx(cmds[0].movementAction) == (shiftX > 0 ? -1 : 1)) {
+            copy = Heap_Alloc(HEAP_ID_FIELD1, sizeof(MapObjectAnimCmd) * (count + 2));
+            copy[0].movementAction = cmds[0].movementAction;
+            copy[0].count = shiftX > 0 ? shiftX : -shiftX;
+            memcpy(&copy[1], cmds, sizeof(MapObjectAnimCmd) * (count + 1));
+            return copy;
+        }
+
+        // Else (or sent further out before, and moving again): from where
+        // the script put it.
+        ScrCmd_PortWideNudge(mapObj, -shiftX, -shiftZ);
+    }
+
+    // Walking out: where to (the walks east and west; only those, else
+    // left as it is).
+    ScrCmd_PortWideMiddle(fieldSystem, &midX, &midZ);
+    startX = MapObject_GetX(mapObj);
+    startZ = MapObject_GetZ(mapObj);
+    x = startX;
+
+    for (i = 0; i < count; i++) {
+        int dx = ScrCmd_PortWalkDx(cmds[i].movementAction);
+
+        if (dx != 0) {
+            x += dx * cmds[i].count;
+            last = i;
+
+            if (lead < 0) {
+                lead = i;
+            }
+        } else if (lead >= 0 || !ScrCmd_PortWideStill(cmds[i].movementAction)) {
+            // (a wait or a turn before the walk is still a walk out: Rowan's)
+            straight = FALSE;
+        }
+    }
+
+    if (last < 0 || last != count - 1 || cmds[last].count == 0) {
+        return NULL;
+    }
+
+    ScrCmd_PortWalk(cmds[last].movementAction, &speed, &dir);
+    at = dir == DIR_EAST ? 1 : -1;
+    endX = x;
+    endDx = (x - midX) * at;
+
+    if (endDx < PORT_WIDE_DS_TILES) {
+        return NULL;
+    }
+
+    // (straight: every step that way)
+    for (i = lead; i < count; i++) {
+        if (ScrCmd_PortWalkDx(cmds[i].movementAction) != at) {
+            straight = FALSE;
+        }
+    }
+
+    // The tiles walked out beside the DS's picture and the extra ones to
+    // beyond the wider picture's edge, along the last row: something in the
+    // way there that the DS didn't show? (A walk straight out, one way:
+    // round it instead. Else as the script has it.)
+    {
+        int blockedAt = 0, endZ = startZ, n, from;
+        fx32 y;
+        VecFx32 pos;
+
+        for (i = 0; i < count; i++) {
+            int stepSpeed, stepDir;
+
+            if (ScrCmd_PortWalk(cmds[i].movementAction, &stepSpeed, &stepDir) && (stepDir == DIR_NORTH || stepDir == DIR_SOUTH)) {
+                endZ += MapObject_GetDzFromDir(stepDir) * cmds[i].count;
+            }
+        }
+
+        MapObject_GetPosPtr(mapObj, &pos);
+        y = pos.y;
+        from = straight ? startX : endX - at * cmds[last].count;
+
+        for (x = from, n = 0; (x - midX) * at < out && n < 64; x += at, n++) {
+            int stepDx = (x + at - midX) * at;
+
+            if (ScrCmd_PortWideBlocked(fieldSystem, x, straight ? startZ : endZ, &y, dir)
+                || ScrCmd_PortWideSomeoneThere(fieldSystem, mapObj, x + at, straight ? startZ : endZ)) {
+                blockedAt = stepDx;
+                break;
+            }
+        }
+
+        if (blockedAt != 0 && blockedAt < PORT_WIDE_DS_TILES) {
+            // (in the DS's picture too: as the DS has it)
+            return NULL;
+        }
+
+        if (blockedAt != 0 && straight) {
+            PortWidePathSearch *search = Heap_Alloc(HEAP_ID_FIELD1, sizeof(PortWidePathSearch));
+            int steps, runs, wayX = startX, wayZ = startZ;
+
+            memset(search, 0, sizeof(*search));
+            search->fieldSystem = fieldSystem;
+            search->mapObj = mapObj;
+            search->midX = midX;
+            search->midZ = midZ;
+            search->out = out;
+            search->outDir = dir;
+            ScrCmd_PortWideSee(search, startX, startZ);
+
+            if (ScrCmd_PortWideFindWay(search, startX, startZ, pos.y, 0)) {
+                for (steps = 0, runs = 0; search->path[steps] != 0xFF; steps++) {
+                    if (steps == 0 || search->path[steps] != search->path[steps - 1]) {
+                        runs++;
+                    }
+
+                    wayX += MapObject_GetDxFromDir(search->path[steps]);
+                    wayZ += MapObject_GetDzFromDir(search->path[steps]);
+                }
+
+                copy = Heap_Alloc(HEAP_ID_FIELD1, sizeof(MapObjectAnimCmd) * (lead + runs + 1));
+                // (the waits and turns before the walk, as the script has them)
+                memcpy(copy, cmds, sizeof(MapObjectAnimCmd) * lead);
+
+                for (i = 0, runs = lead; i < steps; i++) {
+                    if (i == 0 || search->path[i] != search->path[i - 1]) {
+                        copy[runs].movementAction = sPortWideWalks[speed][search->path[i]];
+                        copy[runs].count = 0;
+                        runs++;
+                    }
+
+                    copy[runs - 1].count++;
+                }
+
+                copy[runs].movementAction = MOVEMENT_ACTION_END;
+                copy[runs].count = 0;
+                Heap_Free(search);
+
+                if (!ScrCmd_PortWideRemember(fieldSystem, mapObj, wayX - endX, wayZ - startZ, PORT_WIDE_SENT)) {
+                    Heap_Free(copy);
+                    return NULL;
+                }
+
+                return copy;
+            }
+
+            Heap_Free(search);
+        }
+
+        if (blockedAt != 0) {
+            return NULL;
+        }
+    }
+
+    // Walking out to off the DS's picture, short of the wider one's edge:
+    // a few steps more.
+    if (endDx < PORT_WIDE_SENT_TILES || endDx >= out) {
+        return NULL;
+    }
+
+    if (!ScrCmd_PortWideRemember(fieldSystem, mapObj, at * (out - endDx), 0, PORT_WIDE_SENT)) {
+        return NULL;
+    }
+
+    copy = Heap_Alloc(HEAP_ID_FIELD1, sizeof(MapObjectAnimCmd) * (count + 1));
+    memcpy(copy, cmds, sizeof(MapObjectAnimCmd) * (count + 1));
+    copy[last].count += out - endDx;
+    return copy;
+}
+
+static void ScrCmd_PortWideRemoved(MapObject *mapObj)
+{
+    int i;
+
+    for (i = 0; i < PORT_WIDE_SCRIPTED_MAX; i++) {
+        if (sPortWideScripted[i].mapObj == mapObj) {
+            sPortWideScripted[i].kind = 0;
+        }
+    }
+}
+
+// The script over: the ones still beside the picture go back where the
+// script put them (they stay there).
+void ScrCmd_PortWideScriptEnd(FieldSystem *fieldSystem)
+{
+    int i;
+
+    for (i = 0; i < PORT_WIDE_SCRIPTED_MAX; i++) {
+        PortWideScripted *e = &sPortWideScripted[i];
+
+        if (e->kind != 0 && ScrCmd_PortWideFind(fieldSystem, e->mapObj) == e) {
+            ScrCmd_PortWideNudge(e->mapObj, -e->shiftX, -e->shiftZ);
+        }
+
+        e->kind = 0;
+    }
+}
