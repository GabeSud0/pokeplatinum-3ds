+
+// (the 3DS remaster's wider upper screen: InfoMain_PortWideEntry)
+static BOOL sPortWideEntry;
+
+void InfoMain_PortWideEntry(BOOL on)
+{
+    sPortWideEntry = on;
+}
+
+#define PORT_ENTRY_MAX_WIDTH 240
+
+// The entry's words on lines as wide as maxWidth allows (the DS's line
+// breaks taken out): a new string, or NULL (something in it besides plain
+// characters, spaces and line breaks: as it is).
+static String *InfoMain_PortRewrap(const String *src, u32 maxWidth, enum HeapID heapID)
+{
+    charcode_t *chars;
+    String *out, *line, *test, *word;
+    u32 i, n = String_Length(src), size = n + 8;
+
+    chars = Heap_Alloc(heapID, sizeof(charcode_t) * (n + 1));
+    String_ToChars(src, chars, n + 1);
+
+    for (i = 0; i < n; i++) {
+        if (chars[i] >= CHAR_CONTROL_SCREEN_INDICATOR && chars[i] != CHAR_CR) {
+            Heap_Free(chars);
+            return NULL;
+        }
+    }
+
+    out = String_Init(size, heapID);
+    line = String_Init(size, heapID);
+    test = String_Init(size, heapID);
+    word = String_Init(size, heapID);
+
+    for (i = 0; i <= n; i++) {
+        BOOL gap = i == n || chars[i] == CHAR_CR || chars[i] == CHAR_SPACE;
+
+        // (a word split over two lines at its hyphen: "10,000-\nhorsepower"
+        // stays one word, "10,000-horsepower")
+        if (i < n && chars[i] == CHAR_CR && String_Length(word) > 0 && chars[i - 1] == CHAR_MINUS) {
+            continue;
+        }
+
+        if (!gap) {
+            String_AppendChar(word, chars[i]);
+            continue;
+        }
+
+        if (String_Length(word) == 0) {
+            continue;
+        }
+
+        String_Copy(test, line);
+
+        if (String_Length(line) > 0) {
+            String_AppendChar(test, CHAR_SPACE);
+        }
+
+        String_Concat(test, word);
+
+        if (String_Length(line) > 0 && Font_CalcStringWidth(FONT_SYSTEM, test, 0) > maxWidth) {
+            if (String_Length(out) > 0) {
+                String_AppendChar(out, CHAR_CR);
+            }
+
+            String_Concat(out, line);
+            String_Copy(line, word);
+        } else {
+            String_Copy(line, test);
+        }
+
+        String_Clear(word);
+    }
+
+    if (String_Length(line) > 0) {
+        if (String_Length(out) > 0) {
+            String_AppendChar(out, CHAR_CR);
+        }
+
+        String_Concat(out, line);
+    }
+
+    String_Free(word);
+    String_Free(test);
+    String_Free(line);
+    Heap_Free(chars);
+    return out;
+}
+#endif
+
 static void RenderDexEntry(Window *window, enum HeapID heapID, int species, int entryOffset, u32 textColor)
 {
     String *entryString = PokedexText_DexEntry(species, GAME_LANGUAGE, entryOffset, heapID);
+#ifdef SDK_PORT_3DS
+    // On the wider screen's registration page (its text box across the
+    // screen) the entry on lines as wide as the DS's screen allows, not as
+    // the DS broke them for its narrower box, in the middle of the box as
+    // the DS's lines were.
+    if (sPortWideEntry && NitroPort_WideScreenExtra() > 0) {
+        String *wide = InfoMain_PortRewrap(entryString, PORT_ENTRY_MAX_WIDTH, heapID);
+
+        if (wide != NULL) {
+            u32 lines = String_NumLines(entryString), wideLines = String_NumLines(wide);
+            u32 wideWidth = Font_CalcMaxLineWidth(FONT_SYSTEM, wide, 0);
+            int y = 136 + (int)lines * 8 - (int)wideLines * 8;
+
+            Text_AddPrinterWithParamsAndColor(window, FONT_SYSTEM, wide, 128 - wideWidth / 2, y, TEXT_SPEED_INSTANT, textColor, NULL);
+            String_Free(wide);
+            PokedexText_Free(entryString);
+            return;
+        }
+    }
+#endif
     u32 stringWidth = Font_CalcMaxLineWidth(FONT_SYSTEM, entryString, 0);
     u32 xPosition = (stringWidth < 240) ? 128 - stringWidth / 2 : 8;
 
