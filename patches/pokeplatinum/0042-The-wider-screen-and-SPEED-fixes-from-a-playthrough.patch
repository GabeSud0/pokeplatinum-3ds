 }
+
+#ifdef SDK_PORT_3DS
+#include "item.h"
+
+/*
+ * A Pokémon caught with the party full: in the battle, before it goes to
+ * the PC, the player may pick a party member to go to the PC in its place
+ * (battle_script.c asks, and the battle's party screen picks: its SHIFT
+ * reads SEND TO PC, Encounter_PortPickingForPC). The battle puts the
+ * caught one in the PC as ever and notes where, and which party member
+ * was picked; once the battle's party is back in the save
+ * (UpdateFieldSystemFromDTO) the two change places. Not in the middle of
+ * the battle: its end writes the battlers back over their party slots.
+ */
+static struct {
+    int boxID; // (-1: none)
+    int pos;
+    u32 personality;
+    int slot; // (the party member picked; -1: none)
+    BOOL picking;
+} sPortCaught = { -1, 0, 0, -1, FALSE };
+
+void Encounter_PortCaughtToPC(int boxID, int pos, u32 personality)
+{
+    sPortCaught.boxID = boxID;
+    sPortCaught.pos = pos;
+    sPortCaught.personality = personality;
+}
+
+void Encounter_PortSetPartyPick(int slot)
+{
+    sPortCaught.slot = slot;
+}
+
+int Encounter_PortPartyPick(void)
+{
+    return sPortCaught.slot;
+}
+
+void Encounter_PortSetPickingForPC(BOOL on)
+{
+    sPortCaught.picking = on;
+}
+
+BOOL Encounter_PortPickingForPC(void)
+{
+    return sPortCaught.picking;
+}
+
+static void Encounter_PortForget(void)
+{
+    sPortCaught.boxID = -1;
+    sPortCaught.slot = -1;
+    sPortCaught.picking = FALSE;
+}
+
+// The PC takes no Pokémon holding Mail, nor one with a Ball Capsule.
+BOOL Encounter_PortCanGoToPC(Pokemon *mon)
+{
+    return !Item_IsMail(Pokemon_GetValue(mon, MON_DATA_HELD_ITEM, NULL))
+        && Pokemon_GetValue(mon, MON_DATA_BALL_CAPSULE_ID, NULL) == 0;
+}
+
+static void Encounter_PortApplySwap(FieldSystem *fieldSystem)
+{
+    Party *party = SaveData_GetParty(fieldSystem->saveData);
+    PCBoxes *pcBoxes = SaveData_GetPCBoxes(fieldSystem->saveData);
+    BoxPokemon *caught;
+    Pokemon *partyMon, *newMon;
+
+    if (sPortCaught.boxID < 0 || sPortCaught.boxID >= MAX_PC_BOXES
+        || sPortCaught.pos < 0 || sPortCaught.pos >= MAX_MONS_PER_BOX
+        || sPortCaught.slot < 0 || sPortCaught.slot >= Party_GetCurrentCount(party)) {
+        Encounter_PortForget();
+        return;
+    }
+
+    caught = PCBoxes_GetBoxMonAt(pcBoxes, sPortCaught.boxID, sPortCaught.pos);
+    partyMon = Party_GetPokemonBySlotIndex(party, sPortCaught.slot);
+
+    if (BoxPokemon_GetValue(caught, MON_DATA_SPECIES, NULL) != SPECIES_NONE
+        && BoxPokemon_GetValue(caught, MON_DATA_PERSONALITY, NULL) == sPortCaught.personality
+        && Encounter_PortCanGoToPC(partyMon)) {
+        newMon = Pokemon_New(HEAP_ID_FIELD2);
+        Pokemon_FromBoxPokemon(caught, newMon);
+        PCBoxes_InitBoxMonAt(pcBoxes, sPortCaught.boxID, sPortCaught.pos);
+        PCBoxes_TryStoreBoxMonAt(pcBoxes, sPortCaught.boxID, sPortCaught.pos, Pokemon_GetBoxPokemon(partyMon));
+        Party_AddPokemonBySlotIndex(party, sPortCaught.slot, newMon);
+        SaveData_SetFullSaveRequired();
+        Heap_Free(newMon);
+    }
+
+    Encounter_PortForget();
+}
+#endif
