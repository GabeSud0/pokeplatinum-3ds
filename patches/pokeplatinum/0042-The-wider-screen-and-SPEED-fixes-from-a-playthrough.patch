+#ifdef SDK_PORT_3DS
+// A Pokémon caught with the party full: asked whether it joins the party
+// in a party member's place (the question once a catch: sPortAskedTake).
+static BOOL sPortAskedTake;
+
+static void BattleScript_PortAppendLetters(String *string, const char *letters);
+
+static u8 BattleScript_PortPrintTake(BattleSystem *battleSys, Pokemon *caught, Pokemon *picked, int what)
+{
+    String *string = String_Init(160, HEAP_ID_BATTLE);
+    String *name = String_Init(32, HEAP_ID_BATTLE);
+    u8 printerID;
+
+    switch (what) {
+    case 0: // the question
+        BattleScript_PortAppendLetters(string, "Your party is full.\nAdd ");
+        Pokemon_GetValue(caught, MON_DATA_NICKNAME_STRING, name);
+        String_Concat(string, name);
+        BattleScript_PortAppendLetters(string, " to your party?");
+        break;
+    case 1: // the one picked can't go to the PC
+        Pokemon_GetValue(picked, MON_DATA_NICKNAME_STRING, name);
+        String_Concat(string, name);
+        if (Item_IsMail(Pokemon_GetValue(picked, MON_DATA_HELD_ITEM, NULL))) {
+            BattleScript_PortAppendLetters(string, " is holding Mail.\nIt can't be sent to the PC.");
+        } else {
+            BattleScript_PortAppendLetters(string, " has a Ball Capsule.\nIt can't be sent to the PC.");
+        }
+        break;
+    default: // done
+        Pokemon_GetValue(caught, MON_DATA_NICKNAME_STRING, name);
+        String_Concat(string, name);
+        BattleScript_PortAppendLetters(string, " was added to the party\nand ");
+        Pokemon_GetValue(picked, MON_DATA_NICKNAME_STRING, name);
+        String_Concat(string, name);
+        BattleScript_PortAppendLetters(string, " was sent to the PC.");
+        break;
+    }
+
+    printerID = BattleMessage_PrintString(battleSys, string, BattleSystem_GetTextSpeed(battleSys));
+    String_Free(name);
+    String_Free(string);
+    return printerID;
+}
+#endif
