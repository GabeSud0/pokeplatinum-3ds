From: pokeplatinum-3ds <noreply@users.noreply.github.com>
Date: Sun, 25 Oct 2026 08:00:00 -0700
Subject: [PATCH] The trainer case in the lower menu's panel (SDK_PORT_3DS)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On the 3DS remaster's lower menu, the trainer case shows in the panel, as
two folder tabs on the case (its approved mock-ups), and comes and goes as
the bag and the party do:

- Opened by the lower start menu (TRAINER, or switching from the bag or
  the party: StartMenu_PortAppIsMenus), the menu kept on and its panel
  black (NitroPort_LowerMenuKeptShown), the trainer case comes behind it
  and pops in two frames after it's whole, the upper screen keeping the
  field (NITRO_LOWERMENU_HOLD_FIELD); no fade, none of the wider upper
  screen's layouts.
- Its two screens are both in the panel, by turns: TRAINER CARD, the card
  (the upper screen's rows) above the case's clasp; BADGES, the badge case
  (the lower screen's) above it. The port puts the panel together from the
  two screens' rows (NitroPort_LowerMenuSetPanelRuns): the card's tab the
  card (rows 7-183, the case's corner at rows 7-8 left out), the clasp and
  the case's rounded bottom (rows 152-191); the badges' tab the lower
  screen's rows 0-191 in one piece (open, without the lid's strip at the
  top, rows 0-11: laid out so once the lid's up, and with it again as it
  comes down). The case's body above them a plain row of it from below the
  card (the upper screen's row 188), its light edge painted on where the
  rows haven't it. The tabs are the port's (NitroPort_LowerMenuSetTabs), in
  the case's colours.
- The lid shaped for the panel (TrainerCasePort_ShapeLid): its sides and
  rounded bottom corners moved in 6 pixels (on its GYM LEADERS rows only
  the side, the Poké Ball beside it staying), so it covers the badge case
  beneath by 2 pixels each side, and its bottom edge upside down over its
  plain top rows as its top edge: new tiles in slots its tilemap doesn't
  use (its entries a byte each, without flips); the case's top rows round
  it made plain. Shrinking towards its top as on the DS, it flips up from
  the badge case's top.
- A tab tapped (NITRO_LOWERMENU_TAB_PRESS), or Left / Right, shows it; the
  clasp in the card's tab shows the badges and opens the case; A turns the
  card in its tab; B, TRAINER or another of the menu's buttons leaves in
  the panel, faded to black, the menu kept on: the start menu does what
  the button says (StartMenu_ExitTrainerCase: StartMenu_PortAppGone,
  StartMenu_PortSwitchFromApp; BAG and POKéMON switch in the panel, the
  bag and the party switch to it so too, POKéDEX and OPTIONS open
  straight from it, MAP, POKéTCH and SAVE back in the field). The menu's
  other taps meanwhile: nobody's.
- Without the menu, or opened another way, it's as before.
---
 src/applications/trainer_case/main.c | 475 ++++++++++++++++++++++++++-
 src/start_menu.c                     |  40 ++-
 2 files changed, 499 insertions(+), 16 deletions(-)

diff --git a/src/applications/trainer_case/main.c b/src/applications/trainer_case/main.c
index eeba8692..81990ff0 100644
--- a/src/applications/trainer_case/main.c
+++ b/src/applications/trainer_case/main.c
@@ -71,6 +71,317 @@ static const short sWideCardBack[][7] = {
     // LINK TRADES
     { WIDE_CARD_TEXT, 88, 104, 140, -WIDE_CARD_SPREAD, WIDE_CARD_SPREAD, 0 },
 };
+
+// The 3DS remaster's lower menu (3ds_port/nitro/include/
+// nitro_port_lowermenu.h; the game has no port headers: plain calls).
+extern int NitroPort_LowerMenuAvailable(void);
+extern void NitroPort_LowerMenuShow(int on);
+extern void NitroPort_LowerMenuSetTall(int tall);
+extern void NitroPort_LowerMenuSetPanel(int shows);
+extern void NitroPort_LowerMenuSetPanelTouch(int on);
+extern void NitroPort_LowerMenuHoldUpper(int hold);
+extern int NitroPort_LowerMenuPressPending(void);
+extern int NitroPort_LowerMenuTakePress(void);
+extern void NitroPort_LowerMenuKeepShown(int on);
+extern int NitroPort_LowerMenuKeptShown(void);
+extern void NitroPort_LowerMenuFadePanel(int black);
+extern int NitroPort_LowerMenuPanelFade(void);
+extern BOOL StartMenu_PortAppIsMenus(ApplicationManager *appMan);
+extern BOOL StartMenu_PortButtonOpensApp(int button);
+extern void StartMenu_PortAppLeaving(int button);
+extern int gStartMenuPortAppPress; // (start_menu.c)
+
+// (NitroLowerPanelRun, NitroLowerTabStyle)
+typedef struct TrainerCasePortRun {
+    short y, rows, from, srcY, step;
+    unsigned short sides, sidesIn;
+} TrainerCasePortRun;
+
+typedef struct TrainerCasePortTabStyle {
+    u32 back, fill, fillOff, edge, ink, inkShadow, inkOff;
+} TrainerCasePortTabStyle;
+
+extern void NitroPort_LowerMenuSetPanelRuns(const TrainerCasePortRun *runs, int count);
+extern void NitroPort_LowerMenuSetTabs(int count, const char *const *labels, int active, const TrainerCasePortTabStyle *style);
+
+#define PORT_CLEAR_NOW     (-1) // NITRO_LOWERMENU_CLEAR_NOW
+#define PORT_FADE_BLACK    16   // (NitroPort_LowerMenuPanelFade: the panel black)
+#define PORT_PANEL_DS      0    // NITRO_LOWERMENU_PANEL_DS
+#define PORT_HOLD_FIELD    2    // NITRO_LOWERMENU_HOLD_FIELD
+#define PORT_MENU_BUTTONS  8    // NITRO_LOWERMENU_ITEM1: the menu's buttons before it
+#define PORT_TAB_PRESS(k)  (11 + (k)) // NITRO_LOWERMENU_TAB_PRESS
+#define PORT_FROM_LOWER    0    // NITRO_LOWERMENU_FROM_*
+#define PORT_FROM_UPPER    1
+#define PORT_FROM_TABS     2
+#define PORT_SIDE(r, g, b) ((unsigned short)(0x8000 | ((b) >> 3) << 10 | ((g) >> 3) << 5 | ((r) >> 3)))
+
+// The trainer case in the lower menu's panel (opened from the lower menu,
+// from the field or from its other apps: StartMenu_PortAppIsMenus): it comes
+// behind the panel faded to black, the menu kept on, and pops in once it's
+// whole, two frames on, the upper screen keeping the field. Its two
+// screens are both in the panel, by turns, as two folder tabs on the case
+// (the approved mock-ups, 2026-10-25): TRAINER CARD, the card (the upper
+// screen's rows) above the case's clasp; BADGES, the badge case (the lower
+// screen's: the lid, GYM LEADERS, or the badges once opened) above it.
+// The panel is put together from the two screens' rows (the port's runs,
+// nitro_port_lowermenu.h), the case's body drawn on where they leave a
+// gap (a plain row of it below the card, again: no sprite ever there, and
+// nobody's to touch), the case's light edge drawn on at the sides where
+// the rows haven't it: the card's tab the card (the upper screen's rows
+// 7-183, the tabs standing on the case's top instead of its rows 0-6), the
+// clasp and the case's rounded bottom (the lower screen's rows 152-191);
+// the badges' tab the lower screen's rows in one piece, the lid shaped for
+// the panel (TrainerCasePort_ShapeLid: about the badge case's width, with a
+// top edge; open, its strip at the top left out). The tabs
+// are the port's, drawn in its own font in the case's colours. A tab
+// tapped (or Left / Right) shows it; the clasp in the card's tab shows the
+// badges, opening the case. A flips the card in its tab, B closes; the
+// menu's buttons work as in the bag: TRAINER closes it, BAG and POKéMON
+// switch to them in the panel, POKéDEX and OPTIONS open straight from it,
+// MAP, POKéTCH and SAVE back in the field.
+static BOOL sTrainerCasePortPanel;
+static int sTrainerCasePortReveal;
+static int sTrainerCasePortTab;          // 0 the card, 1 the badges
+static BOOL sTrainerCasePortLid;         // (the badges' tab laid out with the lid: closed, or closing)
+static BOOL sTrainerCasePortLeaving;     // (left in the panel)
+static BOOL sTrainerCasePortBlack;       // (the screens made black for an app opened from it)
+
+#define TC_PORT_LIGHT PORT_SIDE(255, 255, 231)
+#define TC_PORT_CREAM PORT_SIDE(239, 231, 156)
+
+static const TrainerCasePortRun sTrainerCasePortCard[] = {
+    { 0, 25, PORT_FROM_TABS, 0, 1, 0, 0 },
+    { 25, 2, PORT_FROM_UPPER, 7, 1, TC_PORT_LIGHT, TC_PORT_CREAM }, // (the card's frame's top, the case's corner left out)
+    { 27, 175, PORT_FROM_UPPER, 9, 1, 0, 0 },
+    { 202, 5, PORT_FROM_UPPER, 188, 0, 0, 0 }, // (the case's body: a plain row of it)
+    { 207, 24, PORT_FROM_LOWER, 152, 1, TC_PORT_LIGHT, 0 },
+    { 231, 16, PORT_FROM_LOWER, 176, 1, 0, 0 },
+};
+
+// (the lid shaped for the panel: TrainerCasePort_ShapeLid. Its top edge at
+// canvas row 55, the lower screen's rows on without a gap: the clasp where
+// the card's tab has it)
+static const TrainerCasePortRun sTrainerCasePortBadgesLid[] = {
+    { 0, 25, PORT_FROM_TABS, 0, 1, 0, 0 },
+    { 25, 30, PORT_FROM_UPPER, 188, 0, 0, 0 },
+    { 55, 176, PORT_FROM_LOWER, 0, 1, TC_PORT_LIGHT, 0 },
+    { 231, 16, PORT_FROM_LOWER, 176, 1, 0, 0 },
+};
+
+// (open: the lid's strip, up at the top, left out)
+static const TrainerCasePortRun sTrainerCasePortBadgesOpen[] = {
+    { 0, 25, PORT_FROM_TABS, 0, 1, 0, 0 },
+    { 25, 42, PORT_FROM_UPPER, 188, 0, 0, 0 },
+    { 67, 164, PORT_FROM_LOWER, 12, 1, TC_PORT_LIGHT, 0 },
+    { 231, 16, PORT_FROM_LOWER, 176, 1, 0, 0 },
+};
+
+// The panel as the tab shown has it.
+static void TrainerCasePort_Show(void)
+{
+    static const char *const labels[2] = { "TRAINER CARD", "BADGES" };
+    static const TrainerCasePortTabStyle style = {
+        .back = 0x737373,
+        .fill = 0xEFE79C,
+        .fillOff = 0xE7D694,
+        .edge = 0xFFFFE7,
+        .ink = 0x848484,
+        .inkShadow = 0xA5A5A5,
+        .inkOff = 0xBDB584,
+    };
+
+    if (sTrainerCasePortTab == 0) {
+        NitroPort_LowerMenuSetPanelRuns(sTrainerCasePortCard, NELEMS(sTrainerCasePortCard));
+    } else if (sTrainerCasePortLid) {
+        NitroPort_LowerMenuSetPanelRuns(sTrainerCasePortBadgesLid, NELEMS(sTrainerCasePortBadgesLid));
+    } else {
+        NitroPort_LowerMenuSetPanelRuns(sTrainerCasePortBadgesOpen, NELEMS(sTrainerCasePortBadgesOpen));
+    }
+
+    NitroPort_LowerMenuSetTabs(2, labels, sTrainerCasePortTab, &style);
+}
+
+static void TrainerCasePort_ChooseTab(int tab, BOOL sound)
+{
+    if (tab == sTrainerCasePortTab) {
+        return;
+    }
+
+    if (sound) {
+        Sound_PlayEffect(SEQ_SE_DP_SELECT78_sseq);
+    }
+
+    sTrainerCasePortTab = tab;
+    TrainerCasePort_Show();
+}
+
+// Left in the panel (B, or a menu button: -1 for B): the panel faded to
+// black first, the menu kept on; the start menu does what the button says
+// (the app's state then its exit's).
+static void TrainerCasePort_Leave(void)
+{
+    sTrainerCasePortLeaving = TRUE;
+    sTrainerCasePortBlack = FALSE;
+    NitroPort_LowerMenuKeepShown(TRUE);
+    NitroPort_LowerMenuFadePanel(TRUE);
+    StartMenu_PortAppLeaving(gStartMenuPortAppPress);
+}
+
+// A new tile of the lid's (8 bits a pixel, 64 bytes): the one it had
+// (own) if the same, or one made already, or a new one in a slot its
+// tilemap doesn't use (work: all its tiles; freeSlots, used: how many of
+// them taken). -1: no room.
+static int TrainerCasePort_LidTile(const u8 *tile, u8 *work, int own, const u8 *freeSlots, int freeCount, int *used)
+{
+    int i;
+
+    if (memcmp(tile, &work[own * 64], 64) == 0) {
+        return own;
+    }
+
+    for (i = 0; i < *used; i++) {
+        if (memcmp(tile, &work[freeSlots[i] * 64], 64) == 0) {
+            return freeSlots[i];
+        }
+    }
+
+    if (*used >= freeCount) {
+        return -1;
+    }
+
+    memcpy(&work[freeSlots[*used] * 64], tile, 64);
+    return freeSlots[(*used)++];
+}
+
+#define TC_PORT_LID_IN 6 // (how far its sides move in: it covers the case's, 8 in, by 2)
+
+// In the panel the badge case's lid (BG_LAYER_MAIN_3) is about the width
+// of the case it covers (x 6-249; the case 8-247): its sides, their 4
+// pixels and its rounded bottom corners, moved in 6 pixels, nothing outside
+// them (on its GYM LEADERS rows only the side itself moves, the Poké Ball
+// beside it staying); and it has a top edge: its bottom edge (rows
+// 142-151) upside down, over its plain top rows (0-9). Shrinking towards its
+// top (TrainerCase_OpenCloseBadgeCase), it flips up from the case's top.
+// (Its tilemap's entries are a byte each, without flips: the tiles changed
+// are new tiles, in slots its tilemap doesn't use. The case (BG_LAYER_MAIN_2)
+// loaded already.)
+static void TrainerCasePort_ShapeLid(BgConfig *bgConfig, NARC *narc)
+{
+    NNSG2dCharacterData *charData;
+    void *buffer = Graphics_GetCharDataFromOpenNARC(narc, badge_case_lid_tiles_NCGR, FALSE, &charData, HEAP_ID_TRAINER_CASE);
+    int count = (int)(charData->szByte / 64), freeCount = 0, taken = 0, x, y, j, k;
+    u8 *map = Bg_GetTilemapBuffer(bgConfig, BG_LAYER_MAIN_3);
+    u8 *work = Heap_Alloc(HEAP_ID_TRAINER_CASE, 256 * 64);
+    u8 shaped[32 * 32], tile[64], used[256], freeSlots[128], strip[32], sides[4][64];
+    BOOL fits = count > 0 && count <= 256;
+
+    if (fits) {
+        memset(work, 0, 256 * 64);
+        memcpy(work, charData->pRawData, count * 64);
+    }
+
+    memset(used, 0, sizeof(used));
+
+    for (j = 0; j < 32 * 32; j++) {
+        used[map[j]] = 1;
+    }
+
+    for (j = 0; j < 256 && freeCount < (int)sizeof(freeSlots); j++) {
+        if (!used[j] || j >= count) {
+            freeSlots[freeCount++] = (u8)j;
+        }
+    }
+
+    memcpy(shaped, map, sizeof(shaped));
+
+    // The sides: each pixel row of the outer two tile columns each side.
+    for (y = 0; y < 32 * 8 && fits; y++) {
+        int ty = y / 8, row = y % 8, l0 = map[ty * 32], l1 = map[ty * 32 + 1], r0 = map[ty * 32 + 30], r1 = map[ty * 32 + 31];
+        u8 left[16], right[16];
+        BOOL keepInside = y >= 10 && y <= 21; // (GYM LEADERS: its ball 4 pixels from the side)
+
+        memcpy(strip, &work[l0 * 64 + row * 8], 8);
+        memcpy(strip + 8, &work[l1 * 64 + row * 8], 8);
+        memcpy(strip + 16, &work[r0 * 64 + row * 8], 8);
+        memcpy(strip + 24, &work[r1 * 64 + row * 8], 8);
+
+        for (k = 0; k < 16; k++) {
+            left[k] = k < TC_PORT_LID_IN ? 0 : keepInside && k >= TC_PORT_LID_IN + 4 ? strip[k] : strip[k - TC_PORT_LID_IN];
+            right[k] = k >= 16 - TC_PORT_LID_IN ? 0 : strip[16 + k + TC_PORT_LID_IN];
+        }
+
+        // (a tile row's four tiles built a pixel row at a time, then put
+        // in place)
+        memcpy(&sides[0][row * 8], left, 8);
+        memcpy(&sides[1][row * 8], left + 8, 8);
+        memcpy(&sides[2][row * 8], right, 8);
+        memcpy(&sides[3][row * 8], right + 8, 8);
+
+        if (row == 7) {
+            static const int at[4] = { 0, 1, 30, 31 };
+
+            for (k = 0; k < 4 && fits; k++) {
+                int n = TrainerCasePort_LidTile(sides[k], work, map[ty * 32 + at[k]], freeSlots, freeCount, &taken);
+
+                if (n < 0) {
+                    fits = FALSE;
+                } else {
+                    shaped[ty * 32 + at[k]] = (u8)n;
+                }
+            }
+        }
+    }
+
+    // The top edge: rows 0-7 its rows 151-144; rows 8-9 its rows 143-142,
+    // then its own 10-15.
+    for (x = 0; x < 32 && fits; x++) {
+        int b17 = shaped[17 * 32 + x], b18 = shaped[18 * 32 + x], t0 = shaped[x], t1 = shaped[32 + x], n0, n1;
+
+        for (j = 0; j < 8; j++) {
+            memcpy(&tile[j * 8], &work[b18 * 64 + (7 - j) * 8], 8);
+        }
+
+        n0 = TrainerCasePort_LidTile(tile, work, t0, freeSlots, freeCount, &taken);
+        memcpy(tile, &work[t1 * 64], 64);
+        memcpy(&tile[0], &work[b17 * 64 + 7 * 8], 8);
+        memcpy(&tile[8], &work[b17 * 64 + 6 * 8], 8);
+        n1 = TrainerCasePort_LidTile(tile, work, t1, freeSlots, freeCount, &taken);
+
+        if (n0 < 0 || n1 < 0) {
+            fits = FALSE;
+            break;
+        }
+
+        shaped[x] = (u8)n0;
+        shaped[32 + x] = (u8)n1;
+    }
+
+    // (no room for the new tiles: the lid as on the DS)
+    if (fits) {
+        u16 *caseMap = Bg_GetTilemapBuffer(bgConfig, BG_LAYER_MAIN_2);
+
+        DC_FlushRange(work, 256 * 64);
+
+        for (j = 0; j < taken; j++) {
+            Bg_LoadTiles(bgConfig, BG_LAYER_MAIN_3, &work[freeSlots[j] * 64], 64, freeSlots[j]);
+        }
+
+        memcpy(map, shaped, sizeof(shaped));
+
+        // Round the lid, where it's narrower and its top corners are
+        // rounded: the case plain (its top rows, 0-15, where the lid's
+        // rolled up when open on the DS, as a plain tile of it from under
+        // the lid, row 19).
+        for (j = 0; j < 2 * 32; j++) {
+            caseMap[j] = caseMap[19 * 32 + 2];
+        }
+
+        Bg_CopyTilemapBufferToVRAM(bgConfig, BG_LAYER_MAIN_2);
+    }
+
+    Heap_Free(work);
+    Heap_Free(buffer);
+}
 #endif
 
 enum TrainerCaseState {
@@ -252,6 +563,27 @@ BOOL TrainerCaseApp_Init(ApplicationManager *appMan, int *state)
     SetAutorepeat(4, 8);
     Heap_Create(HEAP_ID_APPLICATION, HEAP_ID_TRAINER_CASE, HEAP_SIZE_TRAINER_CASE);
 
+#ifdef SDK_PORT_3DS
+    // In the lower menu's panel (from the lower menu): both screens there,
+    // the card's tab first; the upper screen keeping the field.
+    sTrainerCasePortPanel = NitroPort_LowerMenuAvailable() && NitroPort_LowerMenuKeptShown() && StartMenu_PortAppIsMenus(appMan);
+    sTrainerCasePortReveal = sTrainerCasePortPanel ? 2 : 0;
+    sTrainerCasePortLeaving = FALSE;
+    sTrainerCasePortBlack = FALSE;
+    gStartMenuPortAppPress = -1;
+
+    if (sTrainerCasePortPanel) {
+        sTrainerCasePortTab = 0;
+        sTrainerCasePortLid = TRUE;
+        NitroPort_LowerMenuHoldUpper(PORT_HOLD_FIELD);
+        NitroPort_LowerMenuShow(TRUE);
+        NitroPort_LowerMenuSetTall(FALSE);
+        NitroPort_LowerMenuSetPanel(PORT_PANEL_DS);
+        NitroPort_LowerMenuSetPanelTouch(TRUE);
+        TrainerCasePort_Show();
+    }
+#endif
+
     NARC *narc = NARC_ctor(NARC_INDEX_GRAPHIC__TRAINER_CASE, HEAP_ID_TRAINER_CASE);
     TrainerCaseApp *trainerCaseApp = ApplicationManager_NewData(appMan, sizeof(TrainerCaseApp), HEAP_ID_TRAINER_CASE);
 
@@ -331,13 +663,23 @@ BOOL TrainerCaseApp_Init(ApplicationManager *appMan, int *state)
 
     TrainerCase_ResetAffineTransforms();
 #ifdef SDK_PORT_3DS
-    NitroPort_WideSplitScreen(WIDE_CARD_ENGINE, &sWideCardFront[0][0], NELEMS(sWideCardFront));
+    // (in the panel: as on the DS, the panel the width it is)
+    if (!sTrainerCasePortPanel) {
+        NitroPort_WideSplitScreen(WIDE_CARD_ENGINE, &sWideCardFront[0][0], NELEMS(sWideCardFront));
+    }
 #endif
 
     SetVBlankCallback(TrainerCase_TransferGraphicsOnVBlank, NULL);
     NetworkIcon_InitIfConnected();
     Sound_SetPlayerVolume(PLAYER_FIELD, SOUND_VOLUME_MAX / 3);
+#ifdef SDK_PORT_3DS
+    // (in the panel: no fade, it pops in)
+    if (!sTrainerCasePortPanel) {
+        StartScreenFade(FADE_SUB_THEN_MAIN, FADE_TYPE_DOWNWARD_IN, FADE_TYPE_DOWNWARD_IN, COLOR_BLACK, 6, 1, HEAP_ID_TRAINER_CASE);
+    }
+#else
     StartScreenFade(FADE_SUB_THEN_MAIN, FADE_TYPE_DOWNWARD_IN, FADE_TYPE_DOWNWARD_IN, COLOR_BLACK, 6, 1, HEAP_ID_TRAINER_CASE);
+#endif
     NARC_dtor(narc);
 
     return TRUE;
@@ -347,8 +689,51 @@ BOOL TrainerCaseApp_Main(ApplicationManager *appMan, int *state)
 {
     TrainerCaseApp *trainerCaseApp = ApplicationManager_Data(appMan);
 
+#ifdef SDK_PORT_3DS
+    // (come behind the black panel: popping in once it's whole)
+    if (sTrainerCasePortReveal > 0 && --sTrainerCasePortReveal == 0) {
+        NitroPort_LowerMenuFadePanel(PORT_CLEAR_NOW);
+        NitroPort_LowerMenuKeepShown(FALSE);
+    }
+
+    // In the panel: a tab tapped, or Left / Right, shows it; one of the
+    // menu's buttons closes it, the start menu doing what the button says
+    // (start_menu.c). While it's busy (the card turning, the case opening),
+    // before it's shown or once it's leaving: nobody's.
+    if (sTrainerCasePortPanel) {
+        BOOL ready = *state == TRAINER_CASE_STATE_MAIN && sTrainerCasePortReveal == 0;
+
+        if (NitroPort_LowerMenuPressPending() >= 0) {
+            int press = NitroPort_LowerMenuTakePress();
+
+            if (ready && (press == PORT_TAB_PRESS(0) || press == PORT_TAB_PRESS(1))) {
+                TrainerCasePort_ChooseTab(press - PORT_TAB_PRESS(0), TRUE);
+            } else if (ready && press >= 0 && press < PORT_MENU_BUTTONS) {
+                Sound_PlayEffect(SE_CONFIRM_sseq_3);
+                gStartMenuPortAppPress = press;
+                TrainerCasePort_Leave();
+                *state = TRAINER_CASE_STATE_EXIT;
+                ready = FALSE;
+            }
+        }
+
+        if (ready && JOY_NEW(PAD_KEY_LEFT | PAD_KEY_RIGHT)) {
+            TrainerCasePort_ChooseTab(JOY_NEW(PAD_KEY_RIGHT) ? 1 : 0, TRUE);
+        }
+    }
+#endif
+
     switch (*state) {
     case TRAINER_CASE_STATE_INITIAL:
+#ifdef SDK_PORT_3DS
+        if (sTrainerCasePortPanel) {
+            if (sTrainerCasePortReveal == 0) {
+                *state = TRAINER_CASE_STATE_MAIN;
+            }
+
+            break;
+        }
+#endif
         if (IsScreenFadeDone()) {
             *state = TRAINER_CASE_STATE_MAIN;
         }
@@ -359,6 +744,20 @@ BOOL TrainerCaseApp_Main(ApplicationManager *appMan, int *state)
         int input = TrainerCase_GetPlayerInput(trainerCaseApp);
 
         if (input == INPUT_TOUCH_SCREEN_TAP) {
+#ifdef SDK_PORT_3DS
+            // (in the panel, the card's tab: the clasp shows the badges,
+            // the case opening if it's closed)
+            if (sTrainerCasePortPanel && sTrainerCasePortTab == 0 && trainerCaseApp->touchedRectangleIndex == TOUCH_RECTANGLE_OPEN_CLOSE_BADGE_CASE) {
+                TrainerCasePort_ChooseTab(1, trainerCaseApp->badgeCaseOpenState != BADGE_CASE_CLOSED);
+
+                if (trainerCaseApp->badgeCaseOpenState != BADGE_CASE_CLOSED) {
+                    trainerCaseApp->touchedRectangleIndex = TOUCHSCREEN_INPUT_NONE;
+                }
