         if (IsScreenFadeDone()) {
             return TRUE;
         }
@@ -485,6 +762,21 @@ BOOL TrainerCaseApp_Exit(ApplicationManager *appMan, int *state)
     Heap_Destroy(HEAP_ID_TRAINER_CASE);
     Sound_SetPlayerVolume(PLAYER_FIELD, SOUND_VOLUME_MAX);
 
