+// Rows of a listed map where, past the scenery, it isn't mirrored but
+// goes on as its own other side, moved over (the map again beside it, as
+// if it were repeated): under Route 206's bridge, a ridge and the grass
+// either side of it cross both borders, and their two halves meet, while
+// mirrored the ridge's half and its mounds and trees showed twice, the
+// same either side of the border (screenshots of 2026-11-02). Elsewhere
+// (the river, the ledges by it, the plateau north of the ridge) mirrored
+// as before. Tiles, in the matrix's z (the player's): fromZ <= z < toZ,
+// past the border on that side (-1 left, 1 right). Where the two ways
+// meet past the border, their ridges and cliffs don't line up; the rows
+// were picked, a side at a time, where no gap opens between them (a cliff
+// ending in the open: the white behind showed through); kept: rows of the
+// mirrored way drawn on past fromZ, under the moved ones' first (the
+// right side's: its ridge's cliff ended in a small white triangle).
+typedef struct PortMovedRows {
+    u16 header;
+    s8 side;
+    u8 kept;
+    u16 fromZ, toZ;
+} PortMovedRows;
+
+static const PortMovedRows sPortMovedRows[] = {
+    { MAP_HEADER_ROUTE_206, -1, 0, 617, 662 },
+    { MAP_HEADER_ROUTE_206, 1, 1, 624, 662 },
+};
+
+// The loaded map's own rows (0 to MAP_TILES_COUNT_Z) drawn moved over past
+// the scenery on side dir: from <= row < to (the mirrored way's left out
+// from *kept rows on); FALSE for none.
+static BOOL Port_MovedRowsOf(const LandDataManager *landDataMan, u8 index, int dir, int *from, int *to, int *kept)
+{
+    LoadedMap *loadedMap = landDataMan->loadedMaps[index];
+    u16 header = MapMatrix_GetMapHeaderIDAtIndex(landDataMan->mapMatrix, loadedMap->mapMatrixIndex);
+    int top = loadedMap->mapMatrixIndex / landDataMan->mapMatrixWidth * MAP_TILES_COUNT_Z;
+
+    for (int i = 0; i < (int)NELEMS(sPortMovedRows); i++) {
+        int f = sPortMovedRows[i].fromZ - top, t = sPortMovedRows[i].toZ - top;
+
+        if (sPortMovedRows[i].header != header || sPortMovedRows[i].side != dir) {
+            continue;
+        }
+
+        f = f < 0 ? 0 : f;
+        t = t > MAP_TILES_COUNT_Z ? MAP_TILES_COUNT_Z : t;
+
+        if (f < t) {
+            *from = f;
+            *to = t;
+            *kept = sPortMovedRows[i].fromZ - top >= 0 ? sPortMovedRows[i].kept : 0;
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
 
