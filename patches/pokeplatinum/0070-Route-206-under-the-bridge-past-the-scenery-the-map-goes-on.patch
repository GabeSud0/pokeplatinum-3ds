+// The model file copied with the cut lists after it (cuts[i], sizes[i]
+// bytes; ofs[i] set to each one's place in the block), or NULL.
+static u8 *Port_CopyWithCuts(const NNSG3dResFileHeader *file, void **cuts, const u32 *sizes, u32 *ofs, int total)
+{
+    u32 fileSize = (file->fileSize + 3) & ~3u, cutBytes = 0;
+
+    for (int i = 0; i < total; i++) {
+        cutBytes += cuts[i] != NULL ? sizes[i] : 0;
+    }
+
+    u8 *block = malloc(fileSize + cutBytes);
+
+    if (block == NULL) {
+        return NULL;
+    }
+
+    memcpy(block, file, file->fileSize);
+
+    u32 at = fileSize;
+
+    for (int i = 0; i < total; i++) {
+        if (cuts[i] != NULL) {
+            memcpy(block + at, cuts[i], sizes[i]);
+            ofs[i] = at;
+            at += sizes[i];
+        }
+    }
+
+    return block;
+}
